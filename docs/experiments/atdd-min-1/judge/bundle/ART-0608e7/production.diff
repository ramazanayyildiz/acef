+<?php
+
+declare(strict_types=1);
+
+namespace App\Modules\Events\Exceptions;
+
+use App\Modules\Events\Models\Event;
+
+/**
+ * T6 — a lifecycle move that is only safe on an untouched event was attempted
+ * on an event that already has registrations (revert-to-draft).
+ *
+ * Distinct from EventStateLocked (cancelled) and IllegalStateTransition
+ * (edge missing from the canonical table) so support tooling can tell the
+ * three refusal reasons apart.
+ */
+class EventHasRegistrations extends EventDomainException
+{
+    public function __construct(
+        public readonly Event $event,
+        public readonly int $registrationCount,
+    ) {
+        parent::__construct("Event {$event->getKey()} has {$registrationCount} registration(s)");
+    }
+
+    public static function for(Event $event, int $registrationCount): self
+    {
+        return new self($event, $registrationCount);
+    }
+
+    public function errorCode(): string
+    {
+        return 'JKM-EVT-1006';
+    }
+
+    public function httpStatus(): int
+    {
+        return 409;
+    }
+}
