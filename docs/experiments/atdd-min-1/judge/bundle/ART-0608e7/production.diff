+    /**
+     * T6 — Platform-admin revert of a PUBLISHED event back to DRAFT.
+     *
+     * Authority: `events.publish.global` (platform-only; the team-scoped publish
+     * cap does not admit). Delegated to EventAuthorizationService, and re-asserted
+     * inside transition() through the revert-authority context so the platform cap
+     * cannot widen into arbitrary state changes.
+     *
+     * Pre-conditions the canonical table cannot express live here:
+     *   - source state must be PUBLISHED (a non-PUBLISHED source is refused with
+     *     IllegalStateTransition rather than silently no-op'ing on DRAFT→DRAFT);
+     *   - the event must have zero registrations — pulling a landing page private
+     *     under people who already signed up is never a support-safe move.
+     *
+     * Both are re-checked while holding the events row lock, in the SAME
+     * transaction that transition() then writes state + audit in: the public
+     * registration path takes the same row lock before inserting, so a
+     * registration cannot slip in between the count and the state write.
+     * Cancellation is NOT re-checked here — transition()'s own cancelled_at
+     * re-check inside the lock owns that rule and keeps cancellation winning
+     * over backward moves exactly as it does over forward ones.
+     */
+    public function revertToDraft(Event $event, User $actor, string $reason = ''): Event
+    {
+        $this->authz->authorizeRevertToDraft($event, $actor);
+
+        if ($event->state !== EventState::PUBLISHED) {
+            throw IllegalStateTransition::between($event->state, EventState::DRAFT);
+        }
+
+        return DB::transaction(function () use ($event, $actor, $reason): Event {
+            $fresh = $this->events->lockEventForServiceWrite($event->getKey());
+
+            // Re-check under the lock — a concurrent publish/prepare may have
+            // moved the row since the pre-check above.
+            if ($fresh->state !== EventState::PUBLISHED) {
+                throw IllegalStateTransition::between($fresh->state, EventState::DRAFT);
+            }
+
+            $registrationCount = $this->registrations->countRegistrantsForEvent($fresh->getKey());
+
+            if ($registrationCount > 0) {
+                throw EventHasRegistrations::for($fresh, $registrationCount);
+            }
+
+            // Guarded path: transition() re-locks the same row (re-entrant inside
+            // this transaction), re-checks cancellation, and writes state + the
+            // event.transitioned audit row atomically.
+            return $this->stateMachine->transition(
+                $fresh,
+                EventState::DRAFT,
+                $actor,
+                $reason,
+                allowRevertToDraftAuthority: true,
+            );
+        });
+    }
+
     /**
      * @return array{visible: bool, can_suspend: bool, can_reactivate: bool, can_force_end: bool}
      */
