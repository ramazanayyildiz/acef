+    /**
+     * Capsule T1 — Duplicate an event into a fresh DRAFT.
+     *
+     * Two independent guards, both enforced here rather than in the UI:
+     * read access to the source (authorizeView) and the create capability on
+     * the destination team (asserted inside createDraft). The copy always
+     * lands in the actor's CURRENT team, never the source's team, so a
+     * cross-team duplicate by a globally-scoped actor cannot silently write
+     * into somebody else's workspace.
+     *
+     * @throws AuthorizationException
+     */
+    public function duplicate(Event $source, User $actor): Event
+    {
+        $this->authz->authorizeView($source, $actor);
+
+        $team = $actor->currentTeam;
+
+        if ($team === null) {
+            throw new AuthorizationException('A team context is required to duplicate an event.');
+        }
+
+        return $this->metadata->duplicate($source, $team, $actor);
+    }
+
