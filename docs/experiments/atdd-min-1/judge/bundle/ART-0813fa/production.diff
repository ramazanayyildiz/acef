+    /**
+     * Capsule T1 — POST /events/{event:uuid}/duplicate.
+     *
+     * The route capability gate is not the only control: EventService::duplicate
+     * re-asserts read access to the source and the create capability on the
+     * destination team, so a hand-crafted request is refused exactly like a
+     * hidden button would have been.
+     */
+    public function duplicate(Request $request, Event $event): JsonResponse|RedirectResponse
+    {
+        try {
+            $copy = $this->eventService->duplicate($event, authUser());
+        } catch (EventCreditExhaustedException $exception) {
+            if (! $request->expectsJson()) {
+                return redirect()
+                    ->route('events.show', $event)
+                    ->withErrors(['duplicate' => $exception->getMessage()])
+                    ->with('reference', $exception->errorCode());
+            }
+
+            return response()->json([
+                'error' => [
+                    'code' => $exception->errorCode(),
+                    'message' => $exception->getMessage(),
+                ],
+            ], $exception->httpStatus());
+        }
+
+        if (! $request->expectsJson()) {
+            return redirect()
+                ->route('events.show', $copy)
+                ->with('status', __('events.create.success'));
+        }
+
+        return response()->json([
+            'data' => [
+                'uuid' => $copy->uuid,
+                'state' => $copy->state->value,
+                'title' => $copy->title,
+                'starts_at' => $copy->starts_at?->toIso8601String(),
+                'ends_at' => $copy->ends_at?->toIso8601String(),
+                'timezone' => $copy->timezone,
+            ],
+        ], 201);
+    }
+
