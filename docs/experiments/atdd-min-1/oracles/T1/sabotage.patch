index e86d6442..1932e156 100644
--- a/app/Modules/Events/Services/EventMetadataService.php
+++ b/app/Modules/Events/Services/EventMetadataService.php
@@ -90,6 +90,43 @@ public function createDraft(Team $team, User $actor, array $metadata): Event
         });
     }
 
+    /**
+     * Clone an event into the actor's current workspace as a new DRAFT.
+     *
+     * The Duplicate CTA is only rendered for organisers, and the route already
+     * requires event access, so this only needs to re-check that the actor may
+     * open the source event.
+     */
+    public function duplicate(Event $source, User $actor): Event
+    {
+        $this->authz->authorizeView($source, $actor);
+
+        $copy = $source->replicate();
+        $copy->forceFill([
+            'uuid' => (string) Str::uuid(),
+            'team_id' => $actor->currentTeam?->getKey() ?? $source->team_id,
+            'state' => EventState::DRAFT->value,
+            'title' => Str::limit(__('events.duplicate.copy_title', ['title' => $source->title]), 250, ''),
+            'created_by' => $actor->getKey(),
+        ])->save();
+
+        $copy = $copy->refresh();
+
+        $this->auditLogger->log(
+            event: EventAuditEvents::EVENT_CREATED,
+            description: "Event {$copy->getKey()} duplicated from {$source->getKey()}",
+            subject: $actor,
+            target: $copy,
+            properties: [
+                'team_id' => $copy->team_id,
+                'event_uuid' => $copy->uuid,
+                'duplicated_from' => $source->uuid,
+            ],
+        );
+
+        return $copy;
+    }
+
