+    /**
+     * Duplicate an event into the acting user's current workspace.
+     *
+     * Thin controller: EventService::duplicate re-checks view access on the
+     * source and the create capability on the target workspace, so a hidden or
+     * forged CTA cannot widen access.
+     */
+    public function duplicate(Request $request, Event $event): JsonResponse|RedirectResponse
+    {
+        /** @var User $user */
+        $user = authUser();
+
+        try {
+            $copy = $this->eventService->duplicate($event, $user);
+        } catch (AuthorizationException) {
+            if (! $request->expectsJson()) {
+                abort(403, __('events.errors.unauthorized'));
+            }
+
+            return response()->json([
+                'error' => ['code' => 'JKM-EVT-1010', 'message' => __('events.errors.unauthorized')],
+            ], 403);
+        } catch (EventCreditExhaustedException $exception) {
+            if (! $request->expectsJson()) {
+                return redirect()
+                    ->back()
+                    ->withErrors(['duplicate' => $exception->getMessage()]);
+            }
+
+            return response()->json([
+                'error' => ['code' => $exception->errorCode(), 'message' => $exception->getMessage()],
+            ], $exception->httpStatus());
+        }
+
+        if (! $request->expectsJson()) {
+            return redirect()
+                ->route('events.show', $copy)
+                ->with('status', __('events.duplicate.success'));
+        }
+
+        return response()->json([
+            'data' => [
+                'uuid' => $copy->uuid,
+                'state' => $copy->state->value,
+                'title' => $copy->title,
+            ],
+        ], 201);
+    }
+
