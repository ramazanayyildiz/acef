+    /**
+     * Clone an existing event as a fresh DRAFT in the actor's current team.
+     *
+     * Authorization is enforced here, not in the UI: the actor must be able to
+     * view the source event AND hold the create capability for the target team.
+     * Only organiser-authored metadata is carried over — the copy is built by
+     * createDraft(), so lifecycle state, cancellation and registrations of the
+     * source can never leak into it.
+     *
+     * @throws \Illuminate\Auth\Access\AuthorizationException
+     */
+    public function duplicate(Event $source, User $actor): Event
+    {
+        $this->authz->authorizeView($source, $actor);
+
+        $target = $actor->currentTeam;
+
+        if ($target === null) {
+            throw new AuthorizationException('An active workspace is required to duplicate an event.');
+        }
+
+        return $this->createDraft($target, $actor, [
+            'title' => Str::limit(__('events.duplicate.copy_title', ['title' => $source->title]), 250, ''),
+            'description' => $source->description,
+            'type' => $source->type->value,
+            'starts_at' => $source->starts_at,
+            'ends_at' => $source->ends_at,
+            'timezone' => $source->timezone,
+            'registrant_capacity_limit' => $source->registrant_capacity_limit,
+            'default_locale' => $source->default_locale,
+        ]);
+    }
