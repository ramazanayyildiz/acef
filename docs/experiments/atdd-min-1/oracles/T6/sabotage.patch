+    /**
+     * Platform-admin revert: PUBLISHED -> DRAFT for an event published by
+     * mistake that nobody has registered for yet.
+     *
+     * Un-publishing is publish authority, so the same guard as publish() runs
+     * here. Reverting is the exact inverse of publish: there is no plan gate,
+     * no landing prerequisite and no AI-audit decision to recompute, so the
+     * event row is simply moved back to DRAFT once the three refusal rules
+     * (state, cancellation, registrations) have been checked.
+     *
+     * @throws IllegalStateTransition when the event is not PUBLISHED
+     * @throws EventStateLocked when the event is cancelled
+     * @throws EventRevertBlocked when the event already has registrations
+     */
+    public function revertToDraft(Event $event, User $actor): Event
+    {
+        $this->authz->authorizePublish($event, $actor);
+
+        if ($event->state !== EventState::PUBLISHED) {
+            throw IllegalStateTransition::between($event->state, EventState::DRAFT);
+        }
+
+        if ($event->cancelled_at !== null) {
+            throw EventStateLocked::for($event);
+        }
+
+        if ($event->registrations()->exists()) {
+            throw EventRevertBlocked::hasRegistrations($event);
+        }
+
+        $event->forceFill(['state' => EventState::DRAFT->value])->save();
+
+        return $event->refresh();
+    }
