+<?php
+
+declare(strict_types=1);
+
+namespace App\Modules\Events\Exceptions;
+
+use App\Modules\Events\Models\Event;
+
+/**
+ * Raised when a PUBLISHED event cannot be pulled back to DRAFT because
+ * registrants already exist. Reverting would hide a landing page people
+ * already signed up on, so the action is refused instead.
+ */
+class EventRevertBlocked extends EventDomainException
+{
+    public function __construct(public readonly string $reason)
+    {
+        parent::__construct("Event revert to draft blocked: {$reason}");
+    }
+
+    public static function hasRegistrations(Event $event): self
+    {
+        return new self("event {$event->getKey()} already has registrations");
+    }
+
+    public function errorCode(): string
+    {
+        return 'JKM-EVT-1012';
+    }
+
+    public function httpStatus(): int
+    {
+        return 409;
+    }
+}
