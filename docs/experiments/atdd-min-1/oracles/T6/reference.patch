+    /**
+     * Platform-admin revert: PUBLISHED -> DRAFT for an event published by
+     * mistake that nobody has registered for yet.
+     *
+     * Authority mirrors publish(): un-publishing is publish authority. The
+     * route gate (`admin.events.revert-to-draft`) restricts the HTTP surface
+     * to the global capability; this guard is the service-layer re-check.
+     *
+     * The state write itself goes through EventStateMachineService::transition
+     * — that is what takes the row lock, re-checks `cancelled_at` inside the
+     * lock, validates the edge against the canonical table, and writes the
+     * transition audit row atomically with the state change.
+     *
+     * @throws IllegalStateTransition when the event is not PUBLISHED
+     * @throws EventRevertBlocked when the event already has registrations
+     * @throws EventStateLocked when the event is cancelled
+     */
+    public function revertToDraft(Event $event, User $actor): Event
+    {
+        $this->authz->authorizePublish($event, $actor);
+
+        return DB::transaction(function () use ($event, $actor): Event {
+            $fresh = $this->events->lockEventForServiceWrite($event->getKey());
+
+            if ($fresh->state !== EventState::PUBLISHED) {
+                throw IllegalStateTransition::between($fresh->state, EventState::DRAFT);
+            }
+
+            if ($fresh->registrations()->exists()) {
+                throw EventRevertBlocked::hasRegistrations($fresh);
+            }
+
+            return $this->stateMachine->transition(
+                $fresh,
+                EventState::DRAFT,
+                $actor,
+                'admin.revert_to_draft',
+            );
+        }, attempts: 1);
+    }
