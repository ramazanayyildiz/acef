+    /**
+     * Platform-admin revert of a mistakenly published event (PUBLISHED → DRAFT).
+     * Thin controller: delegation + error envelope. Every rule (capability,
+     * state, registrations, cancellation) lives in the service.
+     */
+    public function revertToDraft(Request $request, Event $event): JsonResponse|RedirectResponse
+    {
+        try {
+            $result = $this->eventService->revertToDraft($event, authUser());
+        } catch (EventDomainException $e) {
+            return $this->domainErrorResponse($request, $e, 'moderation');
+        } catch (AuthorizationException) {
+            if (! $request->expectsJson()) {
+                return redirect()
+                    ->back()
+                    ->withErrors(['moderation' => __('events.errors.unauthorized')]);
+            }
+
+            return response()->json([
+                'error' => ['code' => 'JKM-EVT-1010', 'message' => __('events.errors.unauthorized')],
+            ], 403);
+        }
+
+        if (! $request->expectsJson()) {
+            return redirect()
+                ->back()
+                ->with('status', __('events.show.moderation.messages.reverted_to_draft'));
+        }
+
+        return response()->json([
+            'data' => ['uuid' => $result->uuid, 'state' => $result->state->value],
+        ]);
+    }
+
