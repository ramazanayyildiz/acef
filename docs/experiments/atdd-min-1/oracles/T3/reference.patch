index 00000000..0a69115f
--- /dev/null
+++ b/app/Navigation/NavigationScrollContract.php
@@ -0,0 +1,132 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Navigation;
+
+use Illuminate\Http\Request;
+
+/**
+ * Server-rendered contract behind the primary navigation's current state and
+ * the scroll-restoration markers.
+ *
+ * Two things have to agree for a request:
+ *   - which navigation item is *the* current page (announced with
+ *     `aria-current`, and identical in the desktop and mobile renderings), and
+ *   - which stored scroll offset belongs to the page being rendered.
+ *
+ * Both are derived here — once — so the desktop nav, the mobile drawer and the
+ * layout's scroll region can never disagree.
+ *
+ * The legacy `active` flag stays untouched: `ActiveStateResolver` marks a whole
+ * section active (every item whose route prefix matches), which is right for
+ * styling but wrong for `aria-current`, where exactly one item may be current.
+ */
+class NavigationScrollContract
+{
+    /**
+     * Route suffixes that `ActiveStateResolver` treats as the terminal action
+     * segment of a resource route.
+     */
+    private const ACTION_SUFFIX = '/\.(index|show|create|edit|store|update|destroy)$/';
+
+    public function __construct(
+        private readonly Request $request,
+    ) {}
+
+    /**
+     * Stable scroll-restoration key for a navigation item.
+     *
+     * Derived from the item alone — never from the request or the rendering
+     * variant — so the desktop and mobile renderings of one item share a key
+     * and that key survives across requests.
+     *
+     * @param  array<string, mixed>  $item
+     */
+    public function keyFor(array $item): string
+    {
+        foreach (['key', 'route', 'data_testid'] as $field) {
+            $value = (string) ($item[$field] ?? '');
+
+            if ($value !== '') {
+                return 'nav:' . $value;
+            }
+        }
+
+        return 'nav:unknown';
+    }
+
+    /**
+     * Key of the single item that represents the page being rendered, or null
+     * when the current route is not reachable from the primary navigation.
+     *
+     * The most specific match wins: an exact route match beats a section
+     * prefix match, and a longer prefix beats a shorter one. Ties keep the
+     * first declared item, so the result is deterministic for a given menu.
+     *
+     * @param  array<int, array<string, mixed>>  $items
+     */
+    public function currentKey(array $items): ?string
+    {
+        $currentRoute = (string) ($this->request->route()?->getName() ?? '');
+
+        if ($currentRoute === '') {
+            return null;
+        }
+
+        $bestScore = 0;
+        $bestKey = null;
+
+        foreach ($items as $item) {
+            $route = (string) ($item['route'] ?? '');
+
+            if ($route === '') {
+                continue;
+            }
+
+            $score = $this->specificity($route, $currentRoute);
+
+            if ($score > $bestScore) {
+                $bestScore = $score;
+                $bestKey = $this->keyFor($item);
+            }
+        }
+
+        return $bestKey;
+    }
+
+    /**
+     * Identifier of the page being rendered, used as the scroll-restoration
+     * region marker so Back/Forward can look up the offset stored for the page
+     * it is returning to.
+     *
+     * @param  array<int, array<string, mixed>>  $items
+     */
+    public function pageKey(array $items): string
+    {
+        $current = $this->currentKey($items);
+
+        if ($current !== null) {
+            return $current;
+        }
+
+        $routeName = (string) ($this->request->route()?->getName() ?? '');
+
+        return 'page:' . ($routeName !== '' ? $routeName : trim($this->request->path(), '/'));
+    }
+
+    private function specificity(string $itemRoute, string $currentRoute): int
+    {
+        if ($itemRoute === $currentRoute) {
+            return 1000 + strlen($itemRoute);
+        }
+
+        $prefix = (string) preg_replace(self::ACTION_SUFFIX, '', $itemRoute);
+
+        if ($prefix !== '' && str_starts_with($currentRoute, $prefix . '.')) {
+            return strlen($prefix);
+        }
+
+        return 0;
+    }
+}
