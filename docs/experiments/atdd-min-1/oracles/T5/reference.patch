+<?php
+
+declare(strict_types=1);
+
+namespace App\Modules\Events\Http\Controllers;
+
+use App\Modules\Events\Models\Event;
+use App\Modules\Events\Models\LandingPage;
+use App\Modules\Events\Services\LandingShareLinkService;
+use App\Modules\Events\Support\LandingPreviewPayload;
+use App\Modules\Events\Support\LocaleResolver;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Routing\Controller;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * T5 — organiser mints a review link; an unauthenticated reviewer opens a
+ * read-only rendering of the landing preview.
+ */
+class LandingShareController extends Controller
+{
+    public function __construct(
+        private readonly LandingShareLinkService $shareLinks,
+    ) {}
+
+    /**
+     * Mint a time-limited review link for this event's landing preview.
+     */
+    public function store(Event $event): RedirectResponse
+    {
+        $actor = authUser();
+
+        abort_if($actor === null, 403);
+
+        $link = $this->shareLinks->mintFor($event, $actor);
+
+        return back()
+            ->with('landing_share_link', $link)
+            ->with('status', __('events.landing.share.minted'));
+    }
+
+    /**
+     * Serve the read-only landing preview behind a valid share link.
+     *
+     * The signed-URL guard runs as route middleware, so by the time this
+     * method executes the link has been proven unaltered and unexpired.
+     */
+    public function show(string $eventUuid): Response
+    {
+        $event = $this->shareLinks->findSharedEvent($eventUuid);
+
+        if (! $event instanceof Event) {
+            abort(404);
+        }
+
+        app()->setLocale(LocaleResolver::resolve($event->default_locale));
+
+        $landing = $event->landingPage;
+
+        return response()->view('events::public.landing-share', [
+            'event' => $event,
+            'previewData' => $landing instanceof LandingPage
+                ? $landing->previewPayload($event)
+                : LandingPreviewPayload::build($event, []),
+        ])->header('X-Robots-Tag', 'noindex, nofollow');
+    }
+}
