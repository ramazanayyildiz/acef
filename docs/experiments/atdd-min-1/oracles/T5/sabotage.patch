diff --git a/app/Modules/Events/Services/LandingShareLinkService.php b/app/Modules/Events/Services/LandingShareLinkService.php
new file mode 100644
index 00000000..ed2e2134
--- /dev/null
+++ b/app/Modules/Events/Services/LandingShareLinkService.php
@@ -0,0 +1,60 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Modules\Events\Services;
+
+use App\Models\User;
+use App\Modules\Events\Models\Event;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\URL;
+
+/**
+ * T5 — shareable landing-preview links.
+ *
+ * The link is a framework temporary signed URL: time-limited and
+ * tamper-evident without any new column or bespoke token format.
+ */
+final class LandingShareLinkService
+{
+    /**
+     * How long a freshly minted review link stays usable.
+     */
+    public const LINK_LIFETIME_HOURS = 72;
+
+    public function __construct(
+        private readonly EventService $events,
+    ) {}
+
+    /**
+     * Mint a read-only review link for the event's landing preview.
+     *
+     * The "Share for review" button only renders on the landing preview page,
+     * which organisers reach through the event-update gate, so seeing the
+     * event is enough here.
+     *
+     * @throws AuthorizationException
+     */
+    public function mintFor(Event $event, User $actor): string
+    {
+        $this->events->authorizeViewAccess($event, $actor);
+
+        return URL::temporarySignedRoute(
+            'events.public.landing-share',
+            now()->addHours(self::LINK_LIFETIME_HOURS),
+            ['eventUuid' => $event->uuid],
+        );
+    }
+
+    /**
+     * Resolve the event behind an already-verified share link.
+     *
+     * The signature guard runs in the route middleware, ahead of this call —
+     * see the TeamScope bypass convention for visitor surfaces with no tenant
+     * context.
+     */
+    public function findSharedEvent(string $eventUuid): ?Event
+    {
+        return $this->events->findPublicLandingEvent($eventUuid);
+    }
+}
