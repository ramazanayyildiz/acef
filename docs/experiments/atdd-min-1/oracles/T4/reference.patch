+<?php
+
+declare(strict_types=1);
+
+namespace App\Modules\SuperAdmin\Http\Controllers;
+
+use App\Models\User;
+use App\Modules\Events\Models\Event;
+use App\Modules\SuperAdmin\Services\AdminEventRegistrationExportService;
+use Illuminate\Support\Facades\Gate;
+use Symfony\Component\HttpFoundation\StreamedResponse;
+
+/**
+ * Streams one event's registration list as CSV for platform support staff.
+ *
+ * Registration rows carry attendee personal data, so the endpoint re-states the
+ * capability that `config/route_permissions.php` maps to this route rather than
+ * relying on whatever else the admin area happens to allow.
+ */
+class EventRegistrationExportController
+{
+    private const CAPABILITY = 'events.view.global';
+
+    public function __invoke(Event $event, AdminEventRegistrationExportService $exports): StreamedResponse
+    {
+        $actor = authUser();
+
+        abort_if(! $actor instanceof User, 403);
+        abort_unless(Gate::forUser($actor)->allows(self::CAPABILITY), 403);
+
+        return $exports->response($event);
+    }
+}
