+    /**
+     * T1 — duplicate an event into a fresh DRAFT owned by the actor's current team.
+     *
+     * Authorization is enforced here, not by the caller: the actor must be able
+     * to view the source event AND hold the create capability for the team the
+     * copy lands in (asserted by createDraft). Both guards run before any write,
+     * so a refused duplicate never leaves an event row behind.
+     *
+     * Only reusable metadata is carried over. Lifecycle state, publication and
+     * cancellation columns, registrations and other child records are NOT copied:
+     * the copy is created through the same createDraft path as a hand-made event,
+     * so it starts DRAFT, unbound to the source, and burns its own event credit.
+     *
+     * @throws AuthorizationException
+     */
+    public function duplicate(Event $source, User $actor): Event
+    {
+        $this->authz->authorizeView($source, $actor);
+
+        $team = $actor->currentTeam;
+
+        if ($team === null) {
+            throw new AuthorizationException('A team context is required to duplicate an event.');
+        }
+
+        return $this->createDraft($team, $actor, [
+            'title' => $source->title,
+            'description' => $source->description,
+            'type' => $source->type->value,
+            'starts_at' => $source->starts_at,
+            'ends_at' => $source->ends_at,
+            'timezone' => $source->timezone,
+            'registrant_capacity_limit' => $source->registrant_capacity_limit,
+            'default_locale' => $source->default_locale,
+        ]);
+    }
