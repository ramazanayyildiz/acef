diff --git a/app/Modules/Events/Services/EventLifecycleService.php b/app/Modules/Events/Services/EventLifecycleService.php
index 68d5f295..e43a6661 100644
--- a/app/Modules/Events/Services/EventLifecycleService.php
+++ b/app/Modules/Events/Services/EventLifecycleService.php
@@ -14,6 +14,7 @@
 use App\Modules\Events\Enums\EventOperationalLockKey;
 use App\Modules\Events\Enums\EventState;
 use App\Modules\Events\Events\EventCancelled;
+use App\Modules\Events\Exceptions\EventHasRegistrations;
 use App\Modules\Events\Exceptions\EventOperationalLockActive;
 use App\Modules\Events\Exceptions\EventStateLocked;
 use App\Modules\Events\Exceptions\IllegalStateTransition;
@@ -245,6 +246,52 @@ public function publishReadiness(Event $event, ?User $actor): array
         ];
     }
 
+    /**
+     * T6 — Revert a published event back to DRAFT (platform-admin support action).
+     *
+     * Mirrors publish()'s phase-2 shape: authorize outside every transaction,
+     * then take the event row lock and re-read the gates before handing the
+     * write to EventStateMachineService, which stays the sole state writer and
+     * owns the cancellation re-check plus the transition audit row.
+     *
+     * Narrower than the PUBLISHED→DRAFT edge it rides on:
+     *   - the source state must be exactly PUBLISHED (a DRAFT source would
+     *     otherwise land on transition()'s same-state no-op and read as success);
+     *   - the event must have no registrations — publishing is what makes the
+     *     landing page reachable, so an audience means the publish is no longer
+     *     a mistake that can be quietly undone.
+     */
+    public function revertToDraft(Event $event, User $actor): Event
+    {
+        $this->authz->authorizeRevertToDraft($event, $actor);
+
+        return DB::transaction(function () use ($event, $actor): Event {
+            $fresh = $this->events->lockEventForServiceWrite($event->getKey());
+
+            if ($fresh->state !== EventState::PUBLISHED) {
+                throw IllegalStateTransition::between($fresh->state, EventState::DRAFT);
+            }
+
+            if ($this->hasRegistrations($fresh)) {
+                throw EventHasRegistrations::for($fresh);
+            }
+
+            return $this->stateMachine->transition($fresh, EventState::DRAFT, $actor, 'admin.revert_to_draft');
+        }, attempts: 1);
+    }
+
+    /**
+     * Registration presence is a state guard, not a read for the current
+     * tenant, so it deliberately ignores TeamScope: a platform admin acting
+     * cross-team must see the same answer the owning workspace would.
+     */
+    private function hasRegistrations(Event $event): bool
+    {
+        return $event->registrations()
+            ->withoutGlobalScope(TeamScope::class)
+            ->exists();
+    }
+
     private function auditStatusMessage(AiAuditOrganizerStatus $status): string
     {
         return __("events.publish.audit_status.{$status->value}");
