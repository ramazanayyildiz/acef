+<?php
+
+declare(strict_types=1);
+
+namespace App\Modules\Events\Exceptions;
+
+use App\Modules\Events\Models\Event;
+
+/**
+ * T6 — a lifecycle move was refused because the event already has registrants.
+ *
+ * Reverting a published event to DRAFT would hide a landing page people have
+ * already signed up through, so the revert is only offered while the audience
+ * is still empty.
+ */
+class EventHasRegistrations extends EventDomainException
+{
+    public function __construct(public readonly Event $event)
+    {
+        parent::__construct("Event {$event->getKey()} has registrations and cannot be reverted");
+    }
+
+    public static function for(Event $event): self
+    {
+        return new self($event);
+    }
+
+    public function errorCode(): string
+    {
+        return 'JKM-EVT-1013';
+    }
+
+    public function httpStatus(): int
+    {
+        return 409;
+    }
+}
