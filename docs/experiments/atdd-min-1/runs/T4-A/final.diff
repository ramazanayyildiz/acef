+<?php
+
+declare(strict_types=1);
+
+namespace App\Modules\SuperAdmin\Http\Controllers;
+
+use App\Models\User;
+use App\Modules\Events\Models\Event;
+use App\Modules\SuperAdmin\Services\SuperAdminEventRegistrationExportService;
+use Illuminate\Routing\Controller;
+use Symfony\Component\HttpFoundation\StreamedResponse;
+
+/**
+ * Capsule T4 — GET /admin/events/{event}/registrations/export.
+ *
+ * Thin by design: the capability guard and the CSV assembly both live in
+ * SuperAdminEventRegistrationExportService.
+ */
+class EventRegistrationExportController extends Controller
+{
+    public function __construct(
+        private readonly SuperAdminEventRegistrationExportService $exports,
+    ) {}
+
+    public function __invoke(Event $event): StreamedResponse
+    {
+        $actor = authUser();
+        abort_if(! $actor instanceof User, 403);
+
+        return $this->exports->response($event, $actor);
+    }
+}
