+@extends('layouts.public')
+
+{{--
+    T5 — read-only landing preview served to an unauthenticated reviewer
+    holding a signed share link. It renders the same marketing templates as
+    the public landing page, but pinned to the review-only branch: no
+    registrant session, no viewer shell, and no registration submission. It
+    is deliberately noindex — the link is a time-limited review link, not a
+    permanent public URL.
+--}}
+@section('title', $event->title)
+@section('meta_description', $event->description ?: __('common.meta.description'))
+@section('robots', 'noindex')
+
+@section('content')
+@php
+    /** @var array<string, mixed> $previewData */
+    $branding     = $previewData['branding'] ?? [];
+    $blocks       = $previewData['blocks'] ?? [];
+    $agenda       = $blocks['agenda'] ?? ['visible' => false, 'items' => []];
+    $speakers     = $blocks['speakers'] ?? ['visible' => false, 'items' => []];
+    foreach ($speakers['items'] as &$_s) {
+        if (!empty($_s['photo_path']) && !str_starts_with((string) $_s['photo_path'], 'http')) {
+            $_s['photo_path'] = Storage::disk('public')->url($_s['photo_path']);
+        }
+    }
+    unset($_s);
+    $template     = in_array(($previewData['template'] ?? 'classic'), ['classic', 'modern', 'bold'], true) ? $previewData['template'] : 'classic';
+    $accent       = $branding['primary_color'] ?? '#F26524';
+    $coverPath    = !empty($branding['cover_image_path'])
+        ? (str_starts_with($branding['cover_image_path'], 'http') ? $branding['cover_image_path'] : Storage::disk('public')->url($branding['cover_image_path']))
+        : null;
+    $logoPath     = !empty($branding['logo_path'])
+        ? (str_starts_with($branding['logo_path'], 'http') ? $branding['logo_path'] : Storage::disk('public')->url($branding['logo_path']))
+        : null;
+    $description  = trim((string) ($event->description ?? ''));
+
+    // Review-only flags. The reviewer is not a registrant and holds no
+    // session, so every viewer/replay branch stays closed and the templates
+    // render their marketing content without a registration form.
+    $registrant                 = null;
+    $viewerShell                = null;
+    $viewerName                 = null;
+    $accessError                = null;
+    $replayPresentation         = null;
+    $registrationOpen           = false;
+    $showPublicMarketingContent = true;
+@endphp
+
+<div class="min-h-screen bg-white" style="font-family: 'Poppins', sans-serif;" data-testid="landing-share-preview">
+    <div class="border-b border-[#E0E0E0] bg-[#F3F0F0] px-6 py-3 text-center text-[13px] text-[#4F4F4F]" data-testid="landing-share-preview-notice">
+        {{ __('events.landing.share.notice') }}
+    </div>
+
+    @include("events::public.templates.$template", get_defined_vars())
+
+    <footer class="flex items-center justify-center border-t border-gray-100 bg-[#F3F0F0] px-4 py-6 text-center text-[12px] text-[#828282] sm:justify-start sm:px-10 sm:text-left">
+        <span>{!! __('events.public_landing.powered_by_html', ['year' => now()->year]) !!}</span>
+    </footer>
+</div>
+@endsection
diff --git a/app/Modules/Events/Services/LandingShareLinkService.php b/app/Modules/Events/Services/LandingShareLinkService.php
new file mode 100644
index 00000000..e31dc757
--- /dev/null
+++ b/app/Modules/Events/Services/LandingShareLinkService.php
@@ -0,0 +1,49 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Modules\Events\Services;
+
+use App\Models\User;
+use App\Modules\Events\Models\Event;
+use Illuminate\Support\Facades\URL;
+
+/**
+ * T5 — shareable landing-preview links for unauthenticated reviewers.
+ *
+ * The link is a framework temporary signed route, so there is no share token
+ * column and no new migration. The signature covers the whole URL — event
+ * uuid included — which is what makes the link tamper-evident and
+ * event-scoped: re-pointing it at another event, or adding a parameter,
+ * invalidates it. The `expires` claim makes it time-limited rather than a
+ * permanent public URL. Both refusals are enforced by the `signed`
+ * middleware on events.public.landing-share, before anything is resolved.
+ */
+final class LandingShareLinkService
+{
+    /** Long enough for a colleague to review, short enough to lapse on its own. */
+    public const TTL_HOURS = 72;
+
+    public function __construct(
+        private readonly EventService $events,
+    ) {}
+
+    /**
+     * Mint a review link for this event's landing preview.
+     *
+     * Re-checks the event-update capability the route already gated on, so
+     * the link cannot be minted by an actor who may only view the event.
+     *
+     * @throws \Illuminate\Auth\Access\AuthorizationException
+     */
+    public function mintForReview(Event $event, User $actor): string
+    {
+        $this->events->authorizeLandingFormAccess($event, $actor);
+
+        return URL::temporarySignedRoute(
+            'events.public.landing-share',
+            now()->addHours(self::TTL_HOURS),
+            ['eventUuid' => $event->uuid],
+        );
+    }
+}
