{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acef.local/schemas/lightweight-run-v2.schema.json",
  "title": "ACEF Fix or Standard Lifecycle v2",
  "type": "object",
  "required": [
    "schema",
    "runId",
    "workflowId",
    "assuranceProfile",
    "status",
    "implementationActorId",
    "reviewActorId",
    "steps",
    "promotion"
  ],
  "properties": {
    "schema": { "const": "acef.lightweight-run.v2" },
    "runId": { "type": "string", "minLength": 1 },
    "workflowId": { "enum": ["quick-fix", "lightweight"] },
    "quickFixContract": { "const": "single-review-v1" },
    "assuranceProfile": { "enum": ["baseline", "guarded"] },
    "status": { "enum": ["active", "blocked", "complete"] },
    "implementationActorId": { "type": "string", "minLength": 1 },
    "reviewActorId": { "type": "string", "minLength": 1 },
    "redOwnershipContract": { "const": "integrated-developer-v1" },
    "steps": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "status", "evidencePaths"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PENDING", "PASS", "BLOCKED"] },
          "evidencePaths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "promotion": {
      "type": "object",
      "required": ["decision", "triggers"],
      "properties": {
        "decision": {
          "enum": ["stay-lightweight", "promote-full-bmad", "human-risk-acceptance"]
        },
        "triggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "surfaces": { "type": "array", "items": { "type": "string" } },
    "surfaceEvidence": { "type": "array" },
    "quickFix": {
      "type": "object",
      "properties": {
        "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "applicationCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "redEvidenceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "greenEvidenceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "revertProofEvidenceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "productEvidenceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "productVerification": { "enum": ["PASS", "DEV_DONE_ONLY", "NOT_APPLICABLE"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "reviewCycle": { "type": "integer", "minimum": 0, "maximum": 1 },
        "frameworkFailures": { "type": "integer", "minimum": 0 }
      }
    },
    "updatedAt": { "type": ["string", "null"] }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "required": ["quickFixContract"] },
      "then": {
        "properties": { "workflowId": { "const": "quick-fix" } },
        "required": ["quickFix"]
      }
    }
  ]
}
