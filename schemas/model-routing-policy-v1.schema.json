{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acef.local/schemas/model-routing-policy-v1.schema.json",
  "title": "ACEF Model Routing Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policyId", "activeProvider", "roles", "providers"],
  "properties": {
    "schema": { "const": "acef.model-routing-policy.v1" },
    "policyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "activeProvider": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "note": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executionClass", "reasoningTier", "sessionPolicy", "evidence"],
        "properties": {
          "executionClass": { "enum": ["orchestration", "semantic-standard", "semantic-critical"] },
          "reasoningTier": { "enum": ["low", "medium", "high", "xhigh", "max"] },
          "sessionPolicy": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["models", "reasoning"],
        "properties": {
          "models": {
            "type": "object",
            "additionalProperties": false,
            "required": ["orchestration", "semantic-standard", "semantic-critical"],
            "properties": {
              "orchestration": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:/-]+$" },
              "semantic-standard": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:/-]+$" },
              "semantic-critical": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:/-]+$" }
            }
          },
          "roleModels": {
            "description": "Optional per-role model over the class mapping. Keys are role ids from roles; null uses the class mapping. The reasoning tier still comes from the role.",
            "type": "object",
            "propertyNames": { "pattern": "^[a-z0-9-]+$" },
            "additionalProperties": {
              "anyOf": [
                { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:/-]+$" },
                { "type": "null" }
              ]
            }
          },
          "modelRank": {
            "description": "Models ordered weakest first. The only source of model strength for review-role floors.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]+$" }
          },
          "reviewModelFloors": {
            "description": "ACEF-owned minimum model per review role (code-review, patch-assurance, process-judge, epic-process-judge); update-acef-installation resets host edits.",
            "type": "object",
            "propertyNames": { "enum": ["code-review", "patch-assurance", "process-judge", "epic-process-judge"] },
            "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]+$" }
          },
          "roleModelExemptions": {
            "description": "Host owner exemption per review role: a reason that allows that role's policy model below its floor.",
            "type": "object",
            "propertyNames": { "enum": ["code-review", "patch-assurance", "process-judge", "epic-process-judge"] },
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "reasoning": {
            "type": "object",
            "additionalProperties": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] }
          },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
