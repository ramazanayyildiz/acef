{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acef.local/schemas/model-review-floors-v1.schema.json",
  "title": "ACEF Review Model Floors v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "providers"
  ],
  "properties": {
    "schema": {
      "const": "acef.model-review-floors.v1"
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelRank",
          "reviewModelFloors"
        ],
        "properties": {
          "modelRank": {
            "description": "Models weakest first; the only source of model strength.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/-]+$"
            }
          },
          "reviewModelFloors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code-review",
              "patch-assurance",
              "process-judge",
              "epic-process-judge"
            ],
            "properties": {
              "code-review": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "patch-assurance": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "process-judge": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "epic-process-judge": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/-]+$"
              }
            }
          }
        }
      }
    }
  }
}
