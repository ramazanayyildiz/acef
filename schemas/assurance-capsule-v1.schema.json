{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acef.local/schemas/assurance-capsule-v1.schema.json",
  "title": "ACEF Assurance Capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "runId", "fullFlowContract", "runtimeContract", "story", "role", "actorInstanceId",
    "reviewCycle", "baseCommit", "inputCommit", "inputTree", "scopePaths", "acceptanceIds",
    "currentContext", "diff", "sourceBlobs", "redEvidence", "greenEvidence", "reviewPolicy",
    "allowedCommands", "integrity"
  ],
  "properties": {
    "schema": { "type": "string", "const": "acef.assurance-capsule.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "fullFlowContract": { "type": "string", "const": "four-actor-v3" },
    "runtimeContract": { "type": "string", "enum": ["capsule-supervisor-v1", "capsule-supervisor-v2"] },
    "story": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "enum": ["code-review", "patch-assurance"] },
    "actorInstanceId": { "type": "string", "minLength": 1 },
    "reviewCycle": { "type": "integer", "minimum": 0, "maximum": 2 },
    "baseCommit": { "type": "string", "minLength": 1 },
    "inputCommit": { "type": "string", "minLength": 1 },
    "inputTree": { "type": "string", "minLength": 1 },
    "scopePaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "acceptanceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "currentContext": { "$ref": "#/$defs/blob" },
    "diff": { "$ref": "#/$defs/blob" },
    "sourceBlobs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/blob" } },
    "redEvidence": { "type": "object" },
    "greenEvidence": { "type": "object" },
    "previousFindings": { "type": "array", "items": { "type": "object" } },
    "repairReceipt": { "type": ["object", "null"] },
    "reviewPolicy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowedCommands": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "payloadSha256"],
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "payloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "$defs": {
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "content"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "content": { "type": "string" }
      }
    }
  }
}
