{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acef.local/schemas/active-run-v2.schema.json",
  "title": "ACEF Active Run v2",
  "type": "object",
  "required": ["schema", "runId", "repo", "workflowId", "assuranceProfile", "scopeUnit", "status", "activeStory", "activePhase", "ledgerPath"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "acef.active-run.v2" },
    "runId": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "enum": ["quick-fix", "lightweight", "full-bmad"] },
    "fullFlowContract": {
      "type": "string",
      "enum": ["six-actor-v2", "four-actor-v3"]
    },
    "runtimeContract": {
      "type": "string",
      "enum": ["capsule-supervisor-v1"]
    },
    "assuranceProfile": { "type": "string", "enum": ["baseline", "guarded"] },
    "scopeUnit": { "type": "string", "enum": ["work-item", "story", "epic"] },
    "expectedStories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assuranceRationale": { "type": ["string", "null"] },
    "assuranceApprovalId": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "repo": { "type": "string", "minLength": 1 },
    "track": { "type": ["string", "null"], "enum": ["mechanical", "standard", null] },
    "status": { "type": "string", "enum": ["active", "paused", "blocked", "complete"] },
    "terminalDisposition": { "type": "string", "enum": ["PASS", "FAIL", "REPLAN", "BLOCKED"] },
    "terminalGateId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "activeEpic": { "type": ["string", "null"] },
    "activeStory": { "type": "string", "minLength": 1 },
    "activePhase": { "type": "string", "minLength": 1 },
    "activeGoal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "userFacing": { "type": "boolean" },
        "completionMode": {
          "type": "string",
          "enum": ["backend-capability", "product-workspace", "internal"]
        }
      }
    },
    "goalCoverage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "INCOMPLETE"] },
        "storyType": {
          "type": "string",
          "enum": ["foundation", "backend-capability", "ui-surface", "integration", "closeout"]
        },
        "requiredSurfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "coveredSurfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/surface" }
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "missing": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "workerRole": { "type": ["string", "null"] },
    "activeActorId": { "type": ["string", "null"] },
    "workflowRationale": { "type": ["string", "null"] },
    "intakeDecision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["route", "confidence"],
      "properties": {
        "route": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "clarifyingQuestions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inferredAnswers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "unresolvedQuestions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "briefApproved": { "type": "boolean" },
        "approvalRequired": { "type": "boolean" },
        "executionApproved": { "type": "boolean" }
      }
    },
    "riskTriggers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "specReadinessPath": { "type": ["string", "null"] },
    "specReadiness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["PASS", "NEEDS_PM", "NEEDS_DISCOVERY", "NEEDS_BMAD", "NEEDS_GUARDED_DISCOVERY", "REJECT"]
        }
      }
    },
    "workerScopePath": { "type": ["string", "null"] },
    "workflowPath": { "type": ["string", "null"] },
    "workflowNodeId": { "type": ["string", "null"] },
    "fullLedgerAccess": { "type": ["string", "null"] },
    "maxLines": { "type": ["integer", "null"], "minimum": 1, "maximum": 150 },
    "nextAllowedStep": { "type": ["string", "null"] },
    "ledgerPath": { "type": "string", "minLength": 1 },
    "contextPath": { "type": ["string", "null"] },
    "updatedAt": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "fullFlowContract": { "const": "four-actor-v3" } }, "required": ["fullFlowContract"] },
      "then": { "required": ["expectedStories"] }
    },
    {
      "if": { "required": ["runtimeContract"] },
      "then": {
        "properties": {
          "workflowId": { "const": "full-bmad" },
          "fullFlowContract": { "const": "four-actor-v3" }
        },
        "required": ["fullFlowContract"]
      }
    },
    {
      "if": {
        "properties": {
          "runtimeContract": { "const": "capsule-supervisor-v1" },
          "status": { "const": "complete" }
        },
        "required": ["runtimeContract", "status"]
      },
      "then": {
        "properties": {
          "scopeUnit": { "const": "epic" },
          "activePhase": { "const": "closeout" },
          "workerRole": { "const": "epic-process-judge" },
          "activeActorId": { "const": "acef_epic_process_judge" }
        },
        "required": ["terminalDisposition", "terminalGateId", "workerRole", "activeActorId"]
      }
    },
    {
      "if": {
        "properties": { "status": { "not": { "const": "complete" } } },
        "required": ["status"]
      },
      "then": {
        "allOf": [
          { "not": { "required": ["terminalDisposition"] } },
          { "not": { "required": ["terminalGateId"] } }
        ]
      }
    }
  ],
  "$defs": {
    "surface": {
      "type": "string",
      "enum": [
        "ui",
        "admin",
        "mobile",
        "api",
        "http",
        "cli",
        "queue",
        "job",
        "scheduler",
        "storage",
        "email",
        "notification",
        "webhook",
        "integration",
        "config",
        "database",
        "library",
        "internal"
      ]
    }
  }
}
