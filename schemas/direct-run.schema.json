{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acef.local/schemas/direct-run.schema.json",
  "title": "ACEF Direct Task Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "runId",
    "lane",
    "status",
    "scope",
    "acceptance",
    "technicalBoundary",
    "reversible",
    "riskTriggers",
    "promotion"
  ],
  "properties": {
    "schema": { "type": "string", "const": "acef.direct-run.v1" },
    "version": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "const": "direct" },
    "status": { "type": "string", "enum": ["active", "complete", "promoted"] },
    "scope": { "type": "string", "minLength": 1 },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "technicalBoundary": {
      "type": "string",
      "enum": [
        "copy",
        "style",
        "localized-ui",
        "localized-config",
        "docs",
        "localized-bugfix",
        "internal-mechanical"
      ]
    },
    "reversible": { "type": "boolean", "const": true },
    "riskTriggers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "baseCommit": { "type": ["string", "null"], "minLength": 6 },
    "changedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exitCode"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reasons"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "stay-direct",
            "promote-lightweight",
            "promote-full-bmad",
            "promote-guarded"
          ]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "unresolvedRisks"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "unresolvedRisks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "updatedAt": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "complete" } } },
      "then": {
        "required": ["changedPaths", "verification", "handoff"],
        "properties": {
          "changedPaths": { "minItems": 1 },
          "verification": { "minItems": 1 },
          "promotion": {
            "properties": {
              "decision": { "const": "stay-direct" },
              "reasons": { "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "promoted" } } },
      "then": {
        "properties": {
          "promotion": {
            "properties": {
              "decision": {
                "enum": [
                  "promote-lightweight",
                  "promote-full-bmad",
                  "promote-guarded"
                ]
              },
              "reasons": { "minItems": 1 }
            }
          }
        }
      }
    }
  ]
}
