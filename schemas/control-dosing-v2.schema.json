{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acef.local/schemas/control-dosing-v2.schema.json",
  "title": "ACEF Control Dosing v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "retiredAdmissions",
    "controls",
    "workflowBundles",
    "assuranceOverlays"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "acef.control-dosing.v2"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "retiredAdmissions": {
      "type": "array",
      "contains": {
        "const": "direct"
      },
      "items": {
        "type": "string",
        "enum": [
          "direct",
          "quick-fix",
          "lightweight",
          "guarded",
          "full-bmad"
        ]
      }
    },
    "controls": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "notes": {
      "type": "string"
    },
    "workflowBundles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quick-fix",
        "lightweight",
        "full-bmad"
      ],
      "properties": {
        "quick-fix": {
          "$ref": "#/$defs/controlIds"
        },
        "lightweight": {
          "$ref": "#/$defs/controlIds"
        },
        "full-bmad": {
          "$ref": "#/$defs/controlIds"
        }
      }
    },
    "assuranceOverlays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guarded"
      ],
      "properties": {
        "guarded": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundleAdds",
            "description"
          ],
          "properties": {
            "bundleAdds": {
              "$ref": "#/$defs/controlIds"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "controlId": {
      "type": "string",
      "enum": [
        "worker-scope",
        "cold-read-current-context",
        "active-run-next-action",
        "actor-records",
        "approval-receipts",
        "evidence-manifest",
        "runner-proof",
        "gate-verdict",
        "surface-contract",
        "test-integrity",
        "lean-evidence"
      ]
    },
    "controlIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controlId"
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "primaryFailureMode",
        "role",
        "trustCeiling",
        "workflowDoses",
        "assuranceDoses"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/controlId"
        },
        "primaryFailureMode": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "active-enforcement",
            "active-guidance",
            "scope-guard",
            "evidence-guard",
            "decision-guard",
            "runtime-floor",
            "audit-telemetry",
            "test-integrity-guard"
          ]
        },
        "trustCeiling": {
          "type": "string",
          "enum": [
            "mechanical",
            "cooperative-local",
            "audit-only",
            "human-confirmed"
          ]
        },
        "notes": {
          "type": "string"
        },
        "workflowDoses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quick-fix",
            "lightweight",
            "full-bmad"
          ],
          "properties": {
            "quick-fix": {
              "$ref": "#/$defs/dose"
            },
            "lightweight": {
              "$ref": "#/$defs/dose"
            },
            "full-bmad": {
              "$ref": "#/$defs/dose"
            }
          }
        },
        "assuranceDoses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "guarded"
          ],
          "properties": {
            "guarded": {
              "$ref": "#/$defs/dose"
            }
          }
        }
      }
    },
    "dose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "dose",
        "enforcementLevel",
        "backstop"
      ],
      "properties": {
        "requirement": {
          "type": "string",
          "enum": [
            "required",
            "required-if-triggered",
            "optional",
            "not-required"
          ]
        },
        "dose": {
          "type": "string",
          "enum": [
            "full",
            "compact",
            "light",
            "none"
          ]
        },
        "enforcementLevel": {
          "type": "string",
          "enum": [
            "mechanical",
            "validator",
            "hook",
            "audit",
            "human",
            "documented",
            "not-applicable"
          ]
        },
        "backstop": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
