#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const {
  canonicalRoutingRole,
  loadModelRoutingPolicy,
  resolveActorRuntime,
  resolveRoleRuntime,
  runRoutingSelection,
  validateModelRoutingPolicy,
  validateRoleModels,
} = require("./lib/acef-model-routing");

const repoRoot = path.resolve(__dirname, "..");
const loaded = loadModelRoutingPolicy(repoRoot);
const codeReview = resolveRoleRuntime(loaded.record, "code-review");
const patchAssurance = resolveRoleRuntime(loaded.record, "patch-assurance");
const conductor = resolveRoleRuntime(loaded.record, "conductor");

if (codeReview.model !== "gpt-6.1-sol" || codeReview.reasoningEffort !== "medium"
  || codeReview.executionClass !== "semantic-standard") {
  throw new Error("calibrated Code Review route was not resolved");
}
if (patchAssurance.reasoningEffort !== "high" || patchAssurance.executionClass !== "semantic-critical") {
  throw new Error("unmeasured Patch Assurance floor was lowered");
}
if (conductor.reasoningEffort !== "medium" || conductor.executionClass !== "orchestration") {
  throw new Error("compiled conductor route was not resolved");
}
if (canonicalRoutingRole("developer", "development") !== "development"
  || canonicalRoutingRole("reviewer", "code-review") !== "code-review"
  || canonicalRoutingRole("process-judge", "review") !== "process-judge") {
  throw new Error("actor role aliases do not resolve to calibrated policy roles");
}
const standardDeveloper = resolveActorRuntime(loaded.record, "developer", "development");
if (standardDeveloper.model !== "gpt-6.1-sol" || standardDeveloper.reasoningEffort !== "high") {
  throw new Error("Standard/Fix Developer route was not resolved");
}

const anthropicDeveloper = resolveRoleRuntime(loaded.record, "development", "anthropic");
if (!/^claude-/.test(anthropicDeveloper.model) || anthropicDeveloper.provider !== "anthropic"
  || !["low", "medium", "high", "xhigh", "max"].includes(anthropicDeveloper.reasoningEffort)) {
  throw new Error("anthropic provider mapping did not resolve the development role");
}
if (anthropicDeveloper.model !== "claude-sonnet-5-5"
  || resolveRoleRuntime(loaded.record, "code-review", "anthropic").model !== "claude-sonnet-5-5"
  || resolveRoleRuntime(loaded.record, "conductor", "anthropic").model !== "claude-sonnet-5-5") {
  throw new Error("anthropic mapping drifted from the 2026-10-27 owner decision (Sonnet for development, ATDD, Conductor and Code Review)");
}
if (!/MODEL_CHOICE\.md/.test(loaded.record.note || "")) {
  throw new Error("policy note must point ordinary subagent model choice to method/MODEL_CHOICE.md");
}
if (resolveRoleRuntime(loaded.record, "code-review").provider !== "openai") {
  throw new Error("default provider changed; activeProvider must remain openai");
}

const portable = structuredClone(loaded.record);
portable.activeProvider = "future-provider";
portable.providers["future-provider"] = {
  models: {
    orchestration: "future-fast-model",
    "semantic-standard": "future-standard-model",
    "semantic-critical": "future-frontier-model"
  },
  reasoning: { low: "low", medium: "medium", high: "high", xhigh: "xhigh", max: "max" }
};
validateModelRoutingPolicy(portable);
const futureCodeReview = resolveRoleRuntime(portable, "code-review");
if (futureCodeReview.model !== "future-standard-model" || futureCodeReview.reasoningEffort !== "medium") {
  throw new Error("provider-neutral role assignment did not survive provider remapping");
}

const invalid = structuredClone(loaded.record);
delete invalid.providers.openai.models["semantic-standard"];
let rejected = false;
try { validateModelRoutingPolicy(invalid); } catch { rejected = true; }
if (!rejected) throw new Error("incomplete provider mapping was accepted");

// ---------- per-role models (roleModels) ----------
const assert = require("node:assert/strict");
{
  // Default anthropic routing: development and Code Review stay Sonnet; Patch Assurance and both Judges run on Opus.
  const expected = {
    conductor: ["claude-sonnet-5-5", "class"],
    atdd: ["claude-sonnet-5-5", "class"],
    development: ["claude-sonnet-5-5", "class"],
    "code-review": ["claude-sonnet-5-5", "class"],
    "patch-assurance": ["claude-opus-5-5", "role"],
    "process-judge": ["claude-opus-5-5", "role"],
    "epic-process-judge": ["claude-opus-5-5", "role"],
  };
  for (const [role, [model, source]] of Object.entries(expected)) {
    const runtime = resolveRoleRuntime(loaded.record, role, "anthropic");
    assert.equal(runtime.model, model, `anthropic ${role} model`);
    assert.equal(runtime.modelSource, source, `anthropic ${role} model source`);
    assert.equal(runtime.reasoningEffort, loaded.record.providers.anthropic.reasoning[loaded.record.roles[role].reasoningTier],
      `anthropic ${role} effort still follows the role tier`);
  }
  // Aliases resolve before the per-role lookup.
  assert.equal(resolveActorRuntime(loaded.record, "test-reviewer", "", "anthropic").model, "claude-opus-5-5");
  assert.equal(resolveActorRuntime(loaded.record, "story-judge", "", "anthropic").model, "claude-opus-5-5");
  assert.equal(resolveActorRuntime(loaded.record, "developer", "development", "anthropic").model, "claude-sonnet-5-5");
  // OpenAI keeps one model for every role and has no per-role default.
  assert.equal(loaded.record.providers.openai.roleModels, undefined, "openai must not ship a roleModels default");
  for (const role of Object.keys(expected)) {
    const runtime = resolveRoleRuntime(loaded.record, role, "openai");
    assert.equal(runtime.model, "gpt-6.1-sol");
    assert.equal(runtime.modelSource, "class");
  }
}
{
  // Resolution order: run override per role -> policy roleModels -> class mapping.
  const policy = structuredClone(loaded.record);
  policy.providers.anthropic.roleModels = { ...policy.providers.anthropic.roleModels, "patch-assurance": "policy-role-model", "code-review": null };
  validateModelRoutingPolicy(policy);
  const classOnly = resolveRoleRuntime(policy, "development", "anthropic");
  assert.deepEqual([classOnly.model, classOnly.modelSource], ["claude-sonnet-5-5", "class"]);
  const policyRole = resolveRoleRuntime(policy, "patch-assurance", "anthropic");
  assert.deepEqual([policyRole.model, policyRole.modelSource], ["policy-role-model", "role"]);
  const nullRole = resolveRoleRuntime(policy, "code-review", "anthropic");
  assert.deepEqual([nullRole.model, nullRole.modelSource], ["claude-sonnet-5-5", "class"], "null per-role value falls back to the class");
  const selection = { provider: "anthropic", roleModels: { "patch-assurance": "run-model", development: "run-dev-model" } };
  const runRole = resolveRoleRuntime(policy, "patch-assurance", selection);
  assert.deepEqual([runRole.model, runRole.modelSource, runRole.provider], ["run-model", "run-override", "anthropic"]);
  assert.equal(resolveRoleRuntime(policy, "development", selection).model, "run-dev-model", "run override beats the class mapping");
  assert.equal(resolveRoleRuntime(policy, "process-judge", selection).model, "claude-opus-5-5", "roles the run does not name keep the policy");
  assert.equal(resolveRoleRuntime(policy, "development", selection).reasoningEffort, "high", "run override keeps the role tier");
  // runRoutingSelection reads the active-run fields; a run without them is the plain provider path.
  assert.deepEqual(runRoutingSelection({ routingProvider: "anthropic", routingRoleModels: { atdd: "x" } }),
    { provider: "anthropic", roleModels: { atdd: "x" } });
  assert.deepEqual(runRoutingSelection({}), { provider: null, roleModels: null });
  assert.equal(resolveRoleRuntime(loaded.record, "patch-assurance", runRoutingSelection({})).model, "gpt-6.1-sol");
  // A host policy copy that names a role wins over ACEF's per-role default (it is the loaded policy).
  const host = structuredClone(loaded.record);
  host.providers.anthropic.roleModels["process-judge"] = "host-judge-model";
  host.providers.anthropic.roleModels.development = "claude-opus-5-5";
  validateModelRoutingPolicy(host);
  assert.equal(resolveRoleRuntime(host, "process-judge", "anthropic").model, "host-judge-model");
  assert.equal(resolveRoleRuntime(host, "development", "anthropic").model, "claude-opus-5-5");
}
{
  // Unknown or alias role keys and unsafe model ids are rejected, for inactive providers too.
  for (const [roleModels, pattern] of [
    [{ reviewer: "claude-opus-5-5" }, /unknown role reviewer/],
    [{ "not-a-role": "claude-opus-5-5" }, /unknown role not-a-role/],
    [{ "code-review": "" }, /invalid model/],
    [{ "code-review": "bad model" }, /invalid model/],
    [{ "code-review": 7 }, /invalid model/],
    [["claude-opus-5-5"], /must be an object/],
  ]) {
    const bad = structuredClone(loaded.record);
    bad.providers.anthropic.roleModels = roleModels;
    assert.equal(bad.activeProvider, "openai", "the anthropic block is inactive in this check");
    assert.throws(() => validateModelRoutingPolicy(bad), pattern);
  }
  assert.throws(() => validateRoleModels({ "epic-judge": "m" }, loaded.record.roles, "run"), /unknown role epic-judge/);
}
{
  // A v1 policy without roleModels resolves exactly as before: every role through its class mapping.
  const v1 = structuredClone(loaded.record);
  delete v1.providers.anthropic.roleModels;
  validateModelRoutingPolicy(v1);
  for (const [role, assignment] of Object.entries(v1.roles)) {
    for (const provider of Object.keys(v1.providers)) {
      const runtime = resolveRoleRuntime(v1, role, provider);
      assert.equal(runtime.model, v1.providers[provider].models[assignment.executionClass], `${provider} ${role}`);
      assert.equal(runtime.modelSource, "class");
      assert.equal(runtime.reasoningEffort, v1.providers[provider].reasoning[assignment.reasoningTier]);
    }
  }
  assert.equal(resolveRoleRuntime(v1, "patch-assurance", "anthropic").model, "claude-sonnet-5-5");
}
{
  // The JSON schema declares roleModels so external validators accept the shipped policy.
  const schema = JSON.parse(fs.readFileSync(path.join(repoRoot, "schemas", "model-routing-policy-v1.schema.json"), "utf8"));
  const providerProps = schema.properties.providers.additionalProperties.properties;
  assert.ok(providerProps.roleModels, "schema must declare providers.*.roleModels");
  assert.equal(schema.$id, "https://acef.local/schemas/model-routing-policy-v1.schema.json", "pure addition keeps the v1 id");
}

if (!/^[a-f0-9]{64}$/.test(loaded.sha256)
  || !fs.existsSync(path.join(repoRoot, "schemas", "model-routing-policy-v1.schema.json"))) {
  throw new Error("model routing policy lacks durable hash/schema evidence");
}

console.log("acef model routing tests passed");
