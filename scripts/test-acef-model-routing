#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const {
  canonicalRoutingRole,
  loadModelRoutingPolicy,
  resolveActorRuntime,
  resolveRoleRuntime,
  runRoutingSelection,
  validateModelRoutingPolicy,
  validateRoleModels,
  validateRunRouting,
  MODEL_ID_SOURCE,
  REVIEW_ROLES,
} = require("./lib/acef-model-routing");
const { formatViolations, loadReviewFloors, policyFloorViolations, rankShortfall, validateReviewFloors } = require("./lib/acef-review-floors");

const repoRoot = path.resolve(__dirname, "..");
const loaded = loadModelRoutingPolicy(repoRoot);
// The current ids come from the policy's families map (owner decision 2026-11-28), never from a literal in this test.
const FAMILIES = loaded.record.providers.openai.families;
const SOL = FAMILIES.sol;
const codeReview = resolveRoleRuntime(loaded.record, "code-review");
const patchAssurance = resolveRoleRuntime(loaded.record, "patch-assurance");
const conductor = resolveRoleRuntime(loaded.record, "conductor");

if (codeReview.model !== SOL || codeReview.reasoningEffort !== "medium"
  || codeReview.executionClass !== "semantic-standard") {
  throw new Error("calibrated Code Review route was not resolved");
}
if (patchAssurance.reasoningEffort !== "high" || patchAssurance.executionClass !== "semantic-critical") {
  throw new Error("unmeasured Patch Assurance floor was lowered");
}
if (conductor.reasoningEffort !== "medium" || conductor.executionClass !== "orchestration") {
  throw new Error("compiled conductor route was not resolved");
}
if (canonicalRoutingRole("developer", "development") !== "development"
  || canonicalRoutingRole("reviewer", "code-review") !== "code-review"
  || canonicalRoutingRole("process-judge", "review") !== "process-judge") {
  throw new Error("actor role aliases do not resolve to calibrated policy roles");
}
const standardDeveloper = resolveActorRuntime(loaded.record, "developer", "development");
if (standardDeveloper.model !== SOL || standardDeveloper.reasoningEffort !== "high") {
  throw new Error("Standard/Fix Developer route was not resolved");
}

const anthropicDeveloper = resolveRoleRuntime(loaded.record, "development", "anthropic");
if (!/^claude-/.test(anthropicDeveloper.model) || anthropicDeveloper.provider !== "anthropic"
  || !["low", "medium", "high", "xhigh", "max"].includes(anthropicDeveloper.reasoningEffort)) {
  throw new Error("anthropic provider mapping did not resolve the development role");
}
if (anthropicDeveloper.model !== "claude-sonnet-5-5"
  || resolveRoleRuntime(loaded.record, "code-review", "anthropic").model !== "claude-sonnet-5-5"
  || resolveRoleRuntime(loaded.record, "conductor", "anthropic").model !== "claude-sonnet-5-5") {
  throw new Error("anthropic mapping drifted from the 2026-10-27 owner decision (Sonnet for development, ATDD, Conductor and Code Review)");
}
if (!/MODEL_CHOICE\.md/.test(loaded.record.note || "")) {
  throw new Error("policy note must point ordinary subagent model choice to method/MODEL_CHOICE.md");
}
if (resolveRoleRuntime(loaded.record, "code-review").provider !== "openai") {
  throw new Error("default provider changed; activeProvider must remain openai");
}

const portable = structuredClone(loaded.record);
portable.activeProvider = "future-provider";
portable.providers["future-provider"] = {
  models: {
    orchestration: "future-fast-model",
    "semantic-standard": "future-standard-model",
    "semantic-critical": "future-frontier-model"
  },
  reasoning: { low: "low", medium: "medium", high: "high", xhigh: "xhigh", max: "max" }
};
validateModelRoutingPolicy(portable);
const futureCodeReview = resolveRoleRuntime(portable, "code-review");
if (futureCodeReview.model !== "future-standard-model" || futureCodeReview.reasoningEffort !== "medium") {
  throw new Error("provider-neutral role assignment did not survive provider remapping");
}

const invalid = structuredClone(loaded.record);
delete invalid.providers.openai.models["semantic-standard"];
let rejected = false;
try { validateModelRoutingPolicy(invalid); } catch { rejected = true; }
if (!rejected) throw new Error("incomplete provider mapping was accepted");

// ---------- per-role models (roleModels) ----------
const assert = require("node:assert/strict");
{
  // Default anthropic routing: development and Code Review stay Sonnet; Patch Assurance and both Judges run on Opus.
  const expected = {
    conductor: ["claude-sonnet-5-5", "class"],
    atdd: ["claude-sonnet-5-5", "class"],
    development: ["claude-sonnet-5-5", "class"],
    "code-review": ["claude-sonnet-5-5", "class"],
    "patch-assurance": ["claude-opus-5-5", "role"],
    "process-judge": ["claude-opus-5-5", "role"],
    "epic-process-judge": ["claude-opus-5-5", "role"],
  };
  for (const [role, [model, source]] of Object.entries(expected)) {
    const runtime = resolveRoleRuntime(loaded.record, role, "anthropic");
    assert.equal(runtime.model, model, `anthropic ${role} model`);
    assert.equal(runtime.modelSource, source, `anthropic ${role} model source`);
    assert.equal(runtime.reasoningEffort, loaded.record.providers.anthropic.reasoning[loaded.record.roles[role].reasoningTier],
      `anthropic ${role} effort still follows the role tier`);
  }
  // Aliases resolve before the per-role lookup.
  assert.equal(resolveActorRuntime(loaded.record, "test-reviewer", "", "anthropic").model, "claude-opus-5-5");
  assert.equal(resolveActorRuntime(loaded.record, "story-judge", "", "anthropic").model, "claude-opus-5-5");
  assert.equal(resolveActorRuntime(loaded.record, "developer", "development", "anthropic").model, "claude-sonnet-5-5");
  // OpenAI keeps one model for every role and has no per-role default.
  assert.equal(loaded.record.providers.openai.roleModels, undefined, "openai must not ship a roleModels default");
  for (const role of Object.keys(expected)) {
    const runtime = resolveRoleRuntime(loaded.record, role, "openai");
    assert.equal(runtime.model, SOL);
    assert.equal(runtime.modelSource, "class");
  }
}
{
  // Resolution order: run override per role -> policy roleModels -> class mapping.
  const policy = structuredClone(loaded.record);
  policy.providers.anthropic.roleModels = { ...policy.providers.anthropic.roleModels, atdd: "policy-atdd-model" };
  validateModelRoutingPolicy(policy);
  const classOnly = resolveRoleRuntime(policy, "development", "anthropic");
  assert.deepEqual([classOnly.model, classOnly.modelSource], ["claude-sonnet-5-5", "class"]);
  const policyRole = resolveRoleRuntime(policy, "atdd", "anthropic");
  assert.deepEqual([policyRole.model, policyRole.modelSource], ["policy-atdd-model", "role"]);
  const selection = { provider: "anthropic", roleModels: { atdd: "run-atdd-model", development: "run-dev-model", "code-review": "claude-opus-5-5" } };
  const runRole = resolveRoleRuntime(policy, "atdd", selection);
  assert.deepEqual([runRole.model, runRole.modelSource, runRole.provider], ["run-atdd-model", "run-override", "anthropic"]);
  assert.equal(resolveRoleRuntime(policy, "development", selection).model, "run-dev-model", "run override beats the class mapping");
  assert.equal(resolveRoleRuntime(policy, "process-judge", selection).model, "claude-opus-5-5", "roles the run does not name keep the policy");
  assert.equal(resolveRoleRuntime(policy, "development", selection).reasoningEffort, "high", "run override keeps the role tier");
  // runRoutingSelection reads the active-run fields; a run without them is the plain provider path.
  assert.deepEqual(runRoutingSelection({ routingProvider: "anthropic", routingRoleModels: { atdd: "x" }, routingRoleModelExemptions: { "code-review": "r" } }),
    { provider: "anthropic", roleModels: { atdd: "x" }, exemptions: { "code-review": "r" } });
  assert.deepEqual(runRoutingSelection({}), { provider: null, roleModels: null, exemptions: null });
  assert.equal(resolveRoleRuntime(loaded.record, "patch-assurance", runRoutingSelection({})).model, SOL);
  // A host policy copy that names a role wins over ACEF's per-role default (it is the loaded policy).
  const host = structuredClone(loaded.record);
  host.providers.anthropic.roleModels.development = "claude-opus-5-5";
  host.providers.anthropic.roleModels["code-review"] = "claude-opus-5-5";
  validateModelRoutingPolicy(host);
  assert.equal(resolveRoleRuntime(host, "development", "anthropic").model, "claude-opus-5-5");
  assert.equal(resolveRoleRuntime(host, "code-review", "anthropic").model, "claude-opus-5-5", "a host may raise a review role");
}
{
  // Review floors (owner decision 2026-10-27): ACEF-owned floors and ranks, loaded apart from the host policy.
  assert.deepEqual([...REVIEW_ROLES], ["code-review", "patch-assurance", "process-judge", "epic-process-judge"]);
  const floorsFile = loadReviewFloors();
  assert.equal(path.relative(repoRoot, floorsFile.path), path.join("method", "model-review-floors-v1.json"));
  const floors = floorsFile.record;
  // openai: the mapped Sol and Astra are ranked, every Sol below every Astra, Terra unranked (owner decision 2026-11-28).
  const openaiRank = floors.providers.openai.modelRank;
  assert.ok(openaiRank.includes(FAMILIES.sol) && openaiRank.includes(FAMILIES.astra), "the mapped Sol and Astra are ranked");
  assert.ok(!openaiRank.includes(FAMILIES.terra), "terra stays unranked");
  const lastSol = Math.max(...openaiRank.map((model, index) => (/-sol$/.test(model) ? index : -1)));
  assert.ok(lastSol >= 0 && lastSol < openaiRank.findIndex((model) => /-astra$/.test(model)), "every Sol ranks below every Astra");
  assert.deepEqual(floors.providers.anthropic.modelRank, ["claude-sonnet-5-5", "claude-opus-5-5"]);
  // The shipped resolved model per review role meets its shipped floor, and the openai floors stay on Sol (a floor names
  // the oldest accepted version of its family; a newer version ranked above it passes without moving the floor).
  for (const providerId of Object.keys(floors.providers)) {
    for (const role of REVIEW_ROLES) {
      const floor = floors.providers[providerId].reviewModelFloors[role];
      assert.equal(rankShortfall(floors, providerId, resolveRoleRuntime(loaded.record, role, providerId).model, floor), null, `${providerId} ${role} meets its floor`);
    }
  }
  assert.equal(floors.providers.anthropic.reviewModelFloors["patch-assurance"], resolveRoleRuntime(loaded.record, "patch-assurance", "anthropic").model);
  for (const role of REVIEW_ROLES) assert.match(floors.providers.openai.reviewModelFloors[role], /-sol$/, `openai ${role} floor stays on Sol`);
  // Floors and ranks no longer live in a routing policy.
  const misplaced = structuredClone(loaded.record);
  misplaced.providers.openai.modelRank = ["gpt-6.1-sol"];
  assert.throws(() => validateModelRoutingPolicy(misplaced), /belongs in the ACEF-owned method\/model-review-floors-v1\.json/);
  const run = (roleModels, exemptions = null) => ({ provider: "anthropic", roleModels, exemptions });
  // run override: downgrade rejected, same/upgrade accepted, unranked rejected for review roles only
  assert.throws(() => resolveRoleRuntime(loaded.record, "patch-assurance", run({ "patch-assurance": "claude-sonnet-5-5" })),
    (error) => error.code === "ACEF_REVIEW_FLOOR" && /below the review floor claude-opus-5-5/.test(error.message) && /--routing-role-model-exemption/.test(error.message));
  assert.equal(resolveRoleRuntime(loaded.record, "process-judge", run({ "process-judge": "claude-opus-5-5" })).model, "claude-opus-5-5");
  const upgrade = resolveRoleRuntime(loaded.record, "code-review", run({ "code-review": "claude-opus-5-5" }));
  assert.deepEqual([upgrade.model, upgrade.floor, upgrade.exemption], ["claude-opus-5-5", "claude-sonnet-5-5", undefined]);
  assert.throws(() => resolveRoleRuntime(loaded.record, "code-review", run({ "code-review": "claude-mystery-9" })), /not in the ACEF modelRank for anthropic/);
  assert.equal(resolveRoleRuntime(loaded.record, "development", run({ development: "claude-mystery-9" })).model, "claude-mystery-9");
  const exempt = resolveRoleRuntime(loaded.record, "patch-assurance", run({ "patch-assurance": "claude-sonnet-5-5" }, { "patch-assurance": "owner: cost test 2026-10-27" }));
  assert.deepEqual([exempt.model, exempt.exemption, exempt.floor], ["claude-sonnet-5-5", "owner: cost test 2026-10-27", "claude-opus-5-5"]);
  assert.throws(() => resolveRoleRuntime(loaded.record, "development", run({}, { development: "x" })), /not a review role/);
  assert.throws(() => resolveRoleRuntime(loaded.record, "code-review", run({}, { "code-review": " " })), /needs a reason/);
  // openai: astra is an upgrade over sol for Code Review; terra is unranked
  assert.equal(resolveRoleRuntime(loaded.record, "code-review", { provider: "openai", roleModels: { "code-review": "gpt-6-astra" } }).model, "gpt-6-astra");
  assert.throws(() => resolveRoleRuntime(loaded.record, "code-review", { provider: "openai", roleModels: { "code-review": FAMILIES.terra } }), /not in the ACEF modelRank for openai/);
  // a run override back to an older Sol is below the policy's latest Sol, so it needs an exemption
  const olderSol = openaiRank[openaiRank.indexOf(SOL) - 1];
  if (olderSol && /-sol$/.test(olderSol)) {
    assert.throws(() => resolveRoleRuntime(loaded.record, "code-review", { provider: "openai", roleModels: { "code-review": olderSol } }), /below the review floor/);
  }
  // persisted run keys are checked against canonical roles before resolving
  assert.throws(() => resolveRoleRuntime(loaded.record, "code-review", run({ reviewer: "claude-opus-5-5" })), /active-run routingRoleModels names unknown role reviewer/);
  assert.throws(() => validateRunRouting(loaded.record, { routingProvider: "anthropic", routingRoleModels: { reviewer: "claude-opus-5-5" } }), /unknown role reviewer/);
  assert.throws(() => validateRunRouting(loaded.record, { routingProvider: "anthropic", routingRoleModels: { "patch-assurance": "claude-sonnet-5-5" } }), /below the review floor/);
  validateRunRouting(loaded.record, { routingProvider: "anthropic", routingRoleModels: { "patch-assurance": "claude-sonnet-5-5" }, routingRoleModelExemptions: { "patch-assurance": "owner ok" } });
  // effective host policy (any file): a lower or null review model is rejected at resolve time unless exempted;
  // non-review roles on the same policy still resolve.
  for (const lowered of ["claude-sonnet-5-5", null]) {
    const hostLow = structuredClone(loaded.record);
    hostLow.providers.anthropic.roleModels["patch-assurance"] = lowered;
    validateModelRoutingPolicy(hostLow);
    assert.throws(() => resolveRoleRuntime(hostLow, "patch-assurance", "anthropic"),
      (error) => error.code === "ACEF_REVIEW_FLOOR" && /roleModelExemptions/.test(error.message) && /below the review floor claude-opus-5-5/.test(error.message));
    assert.equal(resolveRoleRuntime(hostLow, "development", "anthropic").model, "claude-sonnet-5-5");
    hostLow.providers.anthropic.roleModelExemptions = { "patch-assurance": "owner: Sonnet assurance accepted" };
    const allowed = resolveRoleRuntime(hostLow, "patch-assurance", "anthropic");
    assert.deepEqual([allowed.model, allowed.exemption], ["claude-sonnet-5-5", "owner: Sonnet assurance accepted"]);
  }
  // a policy that drops roleModels (a pre-roleModels docs override) still meets the floor only by exemption
  const preRoleModels = structuredClone(loaded.record);
  delete preRoleModels.providers.anthropic.roleModels;
  assert.throws(() => resolveRoleRuntime(preRoleModels, "process-judge", "anthropic"), /below the review floor claude-opus-5-5/);
  // a class change that puts a review role on an unranked or lower model fails, even when the host edits ranks
  const hostUnranked = structuredClone(loaded.record);
  hostUnranked.providers.openai.models["semantic-critical"] = "gpt-cheap";
  assert.throws(() => resolveRoleRuntime(hostUnranked, "patch-assurance", "openai"), /gpt-cheap is not in the ACEF modelRank for openai/);
  // policyFloorViolations lists every violating role with the exemption line to add
  const listed = policyFloorViolations(preRoleModels, floors, "docs/ai/ACEF_MODEL_ROUTING_POLICY.json");
  assert.deepEqual(listed.map((entry) => `${entry.provider}:${entry.role}:${entry.model}:${entry.floor}`),
    ["anthropic:patch-assurance:claude-sonnet-5-5:claude-opus-5-5", "anthropic:process-judge:claude-sonnet-5-5:claude-opus-5-5", "anthropic:epic-process-judge:claude-sonnet-5-5:claude-opus-5-5"]);
  assert.match(formatViolations(listed), /docs\/ai\/ACEF_MODEL_ROUTING_POLICY\.json: "providers": \{ "anthropic": \{ "roleModelExemptions": \{ "patch-assurance": "<owner, date, reason>" \} \} \}/);
  // explicit floors argument (tests) and an uncovered provider: run overrides on review roles there need an exemption
  const openaiOnly = { ...floors, providers: { openai: floors.providers.openai } };
  assert.throws(() => resolveRoleRuntime(loaded.record, "code-review", run({ "code-review": "claude-opus-5-5" }), { reviewFloors: openaiOnly }), /do not cover that provider/);
  // Floors never come from a policy record (review of 7bc3bad): a serialized acefReviewFloors, top-level or per
  // provider, is rejected by validation, and a record carrying it in memory is ignored by the resolver.
  for (const place of ["top", "provider"]) {
    for (const key of ["acefReviewFloors", "modelRank", "reviewModelFloors"]) {
      const smuggled = structuredClone(loaded.record);
      const target = place === "top" ? smuggled : smuggled.providers.openai;
      target[key] = key === "modelRank" ? ["gpt-cheap"] : { providers: {} };
      assert.throws(() => validateModelRoutingPolicy(smuggled), /review floors belong in|belongs in the ACEF-owned/, `${place} ${key}`);
    }
  }
  const inMemory = structuredClone(loaded.record);
  inMemory.acefReviewFloors = { providers: {} };
  inMemory.providers.openai.models["semantic-critical"] = "gpt-cheap";
  assert.throws(() => resolveRoleRuntime(inMemory, "patch-assurance", "openai"), /gpt-cheap is not in the ACEF modelRank for openai/);
  {
    // The repro: a docs override with "acefReviewFloors":{"providers":{}} and openai semantic-critical gpt-cheap.
    const os = require("node:os");
    const host = fs.mkdtempSync(path.join(os.tmpdir(), "acef-floor-smuggle-"));
    try {
      const override = structuredClone(JSON.parse(fs.readFileSync(path.join(repoRoot, "method", "model-routing-policy-v1.json"), "utf8")));
      override.acefReviewFloors = { providers: {} };
      override.providers.openai.models["semantic-critical"] = "gpt-cheap";
      fs.mkdirSync(path.join(host, "docs", "ai"), { recursive: true });
      fs.writeFileSync(path.join(host, "docs", "ai", "ACEF_MODEL_ROUTING_POLICY.json"), JSON.stringify(override));
      assert.throws(() => loadModelRoutingPolicy(host), /acefReviewFloors is not allowed/);
      delete override.acefReviewFloors;
      fs.writeFileSync(path.join(host, "docs", "ai", "ACEF_MODEL_ROUTING_POLICY.json"), JSON.stringify(override));
      // The floors still come from the ACEF-owned file, so the cheap class model is refused for Patch Assurance.
      assert.throws(() => resolveRoleRuntime(loadModelRoutingPolicy(host).record, "patch-assurance", "openai"), /gpt-cheap is not in the ACEF modelRank for openai/);
    } finally {
      fs.rmSync(host, { recursive: true, force: true });
    }
  }
  // floors file shape checks
  assert.throws(() => validateReviewFloors({ ...floors, providers: { openai: { modelRank: ["a", "a"], reviewModelFloors: {} } } }), /twice/);
  assert.throws(() => validateReviewFloors({ ...floors, providers: { openai: { modelRank: ["a"], reviewModelFloors: { "code-review": "b" } } } }), /must be a model in its modelRank/);
}
{
  // One model id grammar: schemas, the active-run parser, the floors module and the hard-wall read MODEL_ID_SOURCE.
  const grammar = `^${MODEL_ID_SOURCE}$`;
  const policySchema = JSON.parse(fs.readFileSync(path.join(repoRoot, "schemas", "model-routing-policy-v1.schema.json"), "utf8"));
  const providerSchema = policySchema.properties.providers.additionalProperties.properties;
  assert.equal(providerSchema.roleModels.additionalProperties.anyOf[0].pattern, grammar);
  assert.equal(providerSchema.modelRank, undefined, "modelRank moved to the floors file");
  for (const executionClass of ["orchestration", "semantic-standard", "semantic-critical"]) {
    assert.equal(providerSchema.models.properties[executionClass].pattern, grammar);
  }
  const floorsSchema = JSON.parse(fs.readFileSync(path.join(repoRoot, "schemas", "model-review-floors-v1.schema.json"), "utf8"));
  const floorProvider = floorsSchema.properties.providers.additionalProperties.properties;
  assert.equal(floorProvider.modelRank.items.pattern, grammar);
  for (const role of REVIEW_ROLES) assert.equal(floorProvider.reviewModelFloors.properties[role].pattern, grammar);
  const runSchema = JSON.parse(fs.readFileSync(path.join(repoRoot, "schemas", "active-run-v2.schema.json"), "utf8"));
  assert.equal(runSchema.properties.routingRoleModels.additionalProperties.pattern, grammar);
  const parserSource = fs.readFileSync(path.join(repoRoot, "scripts", "lib", "acef-state-parser.js"), "utf8");
  assert.ok(parserSource.includes(`const SAFE_RUN_MODEL_ID = /${grammar}/;`), "active-run parser uses the shared grammar");
  const floorsSource = fs.readFileSync(path.join(repoRoot, "scripts", "lib", "acef-review-floors.js"), "utf8");
  assert.ok(floorsSource.includes(`const MODEL_ID = /${grammar}/;`), "floors module uses the shared grammar");
  const hookSource = fs.readFileSync(path.join(repoRoot, "claude-plugins", "acef-bmad-guard", "hooks", "acef-bmad-hard-wall.mjs"), "utf8");
  assert.ok(hookSource.includes("modelIdSource: library.MODEL_ID_SOURCE"), "hard-wall shell parser uses the library grammar");
  const slashedFloors = structuredClone(loadReviewFloors().record);
  slashedFloors.providers.anthropic.modelRank.push("anthropic/claude-opus-5-5:1");
  assert.equal(resolveRoleRuntime(loaded.record, "patch-assurance", { provider: "anthropic", roleModels: { "patch-assurance": "anthropic/claude-opus-5-5:1" } }, { reviewFloors: slashedFloors }).model, "anthropic/claude-opus-5-5:1");
}
{
  // Unknown or alias role keys and unsafe model ids are rejected, for inactive providers too.
  for (const [roleModels, pattern] of [
    [{ reviewer: "claude-opus-5-5" }, /unknown role reviewer/],
    [{ "not-a-role": "claude-opus-5-5" }, /unknown role not-a-role/],
    [{ "code-review": "" }, /invalid model/],
    [{ "code-review": "bad model" }, /invalid model/],
    [{ "code-review": "bad\\model" }, /invalid model/],
    [{ "code-review": 7 }, /invalid model/],
    [["claude-opus-5-5"], /must be an object/],
  ]) {
    const bad = structuredClone(loaded.record);
    bad.providers.anthropic.roleModels = roleModels;
    assert.equal(bad.activeProvider, "openai", "the anthropic block is inactive in this check");
    assert.throws(() => validateModelRoutingPolicy(bad), pattern);
  }
  assert.throws(() => validateRoleModels({ "epic-judge": "m" }, loaded.record.roles, "run"), /unknown role epic-judge/);
}
{
  // A v1 policy without roleModels resolves exactly as before: every role through its class mapping.
  const v1 = structuredClone(loaded.record);
  for (const mapping of Object.values(v1.providers)) {
    delete mapping.roleModels;
  }
  validateModelRoutingPolicy(v1);
  // The 2026-10-27 floors put anthropic Patch Assurance and both Judges on Opus: a v1 anthropic policy keeps its old
  // Sonnet route for them only with owner exemptions (review of 9269a8c). Everything else resolves exactly as before.
  for (const role of ["patch-assurance", "process-judge", "epic-process-judge"]) {
    assert.throws(() => resolveRoleRuntime(v1, role, "anthropic"), /below the review floor claude-opus-5-5/);
  }
  v1.providers.anthropic.roleModelExemptions = { "patch-assurance": "v1", "process-judge": "v1", "epic-process-judge": "v1" };
  for (const [role, assignment] of Object.entries(v1.roles)) {
    for (const provider of Object.keys(v1.providers)) {
      const runtime = resolveRoleRuntime(v1, role, provider);
      assert.equal(runtime.model, v1.providers[provider].models[assignment.executionClass], `${provider} ${role}`);
      assert.equal(runtime.modelSource, "class");
      assert.equal(runtime.reasoningEffort, v1.providers[provider].reasoning[assignment.reasoningTier]);
    }
  }
  assert.equal(resolveRoleRuntime(v1, "patch-assurance", "anthropic").model, "claude-sonnet-5-5");
}
{
  // The JSON schema declares roleModels so external validators accept the shipped policy.
  const schema = JSON.parse(fs.readFileSync(path.join(repoRoot, "schemas", "model-routing-policy-v1.schema.json"), "utf8"));
  const providerProps = schema.properties.providers.additionalProperties.properties;
  assert.ok(providerProps.roleModels, "schema must declare providers.*.roleModels");
  assert.equal(schema.$id, "https://acef.local/schemas/model-routing-policy-v1.schema.json", "pure addition keeps the v1 id");
}

{
  // Model families (owner decision 2026-11-28): the policy's families map is the one place exact ids live.
  const { resolveModelName } = require("./lib/acef-model-routing");
  assert.deepEqual(Object.keys(FAMILIES), ["sol", "astra", "terra"]);
  assert.deepEqual(Object.keys(loaded.record.providers.anthropic.families), ["opus", "sonnet"]);
  for (const model of Object.values(loaded.record.providers.openai.models)) assert.equal(model, SOL, "every openai class model is families.sol");
  assert.equal(loaded.record.providers.anthropic.families.opus, loaded.record.providers.anthropic.roleModels["patch-assurance"]);
  assert.equal(loaded.record.providers.anthropic.families.sonnet, loaded.record.providers.anthropic.models["semantic-standard"]);
  const schema = JSON.parse(fs.readFileSync(path.join(repoRoot, "schemas", "model-routing-policy-v1.schema.json"), "utf8"));
  assert.equal(schema.properties.providers.additionalProperties.properties.families.additionalProperties.pattern, `^${MODEL_ID_SOURCE}$`);
  for (const [mutate, pattern] of [
    [(p) => { p.providers.openai.families.review = "x"; }, /collides with a role name/],
    [(p) => { p.providers.openai.families["code-review"] = "x"; }, /collides with a role name/],
    [(p) => { p.providers.anthropic.families.sol = "x"; }, /also a family of provider openai/],
    [(p) => { p.providers.openai.families.sol = "bad id"; }, /not a valid model id/],
    [(p) => { p.providers.openai.families.Sol = "x"; }, /invalid family name/],
    [(p) => { p.providers.openai.families = ["x"]; }, /must be an object/],
  ]) {
    const bad = structuredClone(loaded.record);
    mutate(bad);
    assert.throws(() => validateModelRoutingPolicy(bad), pattern);
  }
  const noFamilies = structuredClone(loaded.record);
  for (const provider of Object.values(noFamilies.providers)) delete provider.families;
  validateModelRoutingPolicy(noFamilies);
  // resolveModelName: families first (unique), then roles through resolveRoleRuntime.
  assert.deepEqual(resolveModelName(loaded.record, "sol"), { kind: "family", name: "sol", provider: "openai", model: SOL });
  assert.equal(resolveModelName(loaded.record, "Opus").model, loaded.record.providers.anthropic.families.opus);
  assert.deepEqual(resolveModelName(loaded.record, "review"), { kind: "role", name: "code-review", provider: "openai", model: SOL, reasoningEffort: "medium" });
  assert.equal(resolveModelName(loaded.record, "review", { provider: "anthropic" }).model, loaded.record.providers.anthropic.families.sonnet);
  assert.equal(resolveModelName(loaded.record, "patch-assurance", { provider: "anthropic" }).model, loaded.record.providers.anthropic.families.opus);
  assert.throws(() => resolveModelName(loaded.record, "opus", { provider: "openai" }), (error) => error.code === "ACEF_MODEL_NAME_UNKNOWN");
  assert.throws(() => resolveModelName(loaded.record, "review", { familiesOnly: true }), (error) => error.code === "ACEF_MODEL_NAME_UNKNOWN");
  assert.throws(() => resolveModelName(noFamilies, "sol"), /none in this policy; run update-acef-installation/);
  assert.throws(() => resolveModelName(loaded.record, "sol", { provider: "nope" }), /no provider nope/);
  // A host copy installed before families: the three-way update adds families and moves untouched class models to the
  // new Sol, while a host-pinned class model stays.
  const { mergeHostConfig } = require("./lib/acef-installation");
  const before = structuredClone(noFamilies);
  for (const executionClass of Object.keys(before.providers.openai.models)) before.providers.openai.models[executionClass] = "gpt-older-sol";
  const hostCopy = structuredClone(before);
  hostCopy.providers.openai.models["semantic-critical"] = "gpt-host-pinned";
  const merged = mergeHostConfig(hostCopy, loaded.record, before).result;
  assert.deepEqual(merged.providers.openai.families, FAMILIES, "update adds the families map");
  assert.equal(merged.providers.openai.models["semantic-standard"], SOL, "untouched class model follows ACEF");
  assert.equal(merged.providers.openai.models["semantic-critical"], "gpt-host-pinned", "host-pinned class model stays");
}
{
  // scripts/acef-model: stdout carries only the answer; failures print nothing on stdout.
  const cp = require("node:child_process");
  const os = require("node:os");
  const cli = path.join(repoRoot, "scripts", "acef-model");
  const call = (args) => cp.spawnSync(process.execPath, [cli, ...args], { encoding: "utf8" });
  const ok = (args) => { const result = call(args); assert.equal(result.status, 0, result.stderr); return result.stdout; };
  assert.equal(ok(["--repo", repoRoot, "sol"]), `${SOL}\n`);
  assert.equal(ok(["--repo", repoRoot, "review"]), `${SOL}\n`);
  assert.equal(ok(["--repo", repoRoot, "--effort", "review"]), "medium\n");
  assert.equal(ok(["--repo", repoRoot, "--provider", "anthropic", "epic-judge"]), `${loaded.record.providers.anthropic.families.opus}\n`);
  for (const [args, status] of [[["--repo", repoRoot, "luna"], 1], [["--repo", repoRoot, "--effort", "sol"], 1], [["--repo", repoRoot, "--provider", "openai", "opus"], 1], [[], 2], [["--bogus", "sol"], 2]]) {
    const result = call(args);
    assert.equal(result.status, status, `acef-model ${args.join(" ")}`);
    assert.equal(result.stdout, "", `acef-model ${args.join(" ")} printed nothing on stdout`);
  }
  // A whole-file host override without families: roles use the override, families fall through to the next policy.
  const host = fs.mkdtempSync(path.join(os.tmpdir(), "acef-model-cli-"));
  try {
    const override = JSON.parse(fs.readFileSync(path.join(repoRoot, "method", "model-routing-policy-v1.json"), "utf8"));
    for (const provider of Object.values(override.providers)) delete provider.families;
    override.providers.openai.models["semantic-standard"] = "gpt-host-review";
    override.providers.openai.roleModelExemptions = { "code-review": "test: host review model" };
    fs.mkdirSync(path.join(host, "docs", "ai"), { recursive: true });
    fs.writeFileSync(path.join(host, "docs", "ai", "ACEF_MODEL_ROUTING_POLICY.json"), JSON.stringify(override));
    assert.equal(ok(["--repo", host, "review"]), "gpt-host-review\n");
    assert.equal(ok(["--repo", host, "sol"]), `${SOL}\n`, "family falls through to the ACEF source policy");
  } finally {
    fs.rmSync(host, { recursive: true, force: true });
  }
}
{
  // acef-version-check: newer family versions in a fixture Codex model cache (never the real ~/.codex one).
  const cp = require("node:child_process");
  const os = require("node:os");
  const work = fs.mkdtempSync(path.join(os.tmpdir(), "acef-version-models-"));
  try {
    const source = path.join(work, "acef");
    fs.mkdirSync(path.join(source, "method"), { recursive: true });
    fs.writeFileSync(path.join(source, "method", "FEEDBACK_LOOP.md"), "# fixture\n");
    const policy = JSON.parse(fs.readFileSync(path.join(repoRoot, "method", "model-routing-policy-v1.json"), "utf8"));
    policy.providers.openai.families = { sol: "gpt-6.1-sol", astra: "gpt-6.9-astra", terra: "gpt-6.1-terra" };
    fs.writeFileSync(path.join(source, "method", "model-routing-policy-v1.json"), JSON.stringify(policy));
    const codexHome = path.join(work, "codex");
    fs.mkdirSync(codexHome);
    const check = () => cp.spawnSync("python3", ["-I", path.join(repoRoot, "scripts", "acef-version-check"), "--repo", path.join(work, "nohost")],
      { encoding: "utf8", env: { ...process.env, ACEF_SOURCE: source, CODEX_HOME: codexHome } });
    const writeCache = (value) => fs.writeFileSync(path.join(codexHome, "models_cache.json"), typeof value === "string" ? value : JSON.stringify(value));
    const slugs = ["gpt-6.2-sol", "gpt-6.1-sol", "gpt-6.10-astra", "gpt-6.1-terra", "gpt-5.6-terra", "gpt-reserve", "codex-auto-review", "gpt-7-luna"];
    writeCache({ fetched_at: "fixture", models: slugs.map((slug) => ({ slug })) });
    let result = check();
    assert.equal(result.status, 2, "exit code keeps its meaning (no installation record)");
    assert.deepEqual(result.stdout.split("\n").filter((line) => line.startsWith("newer ")), [
      "newer sol model available: gpt-6.2-sol (ACEF map says gpt-6.1-sol)",
      "newer astra model available: gpt-6.10-astra (ACEF map says gpt-6.9-astra)",
    ], "6.10 ranks above 6.9; terra current; luna is not in the map; unversioned slugs ignored");
    writeCache(slugs.map((slug) => ({ slug })));
    assert.match(check().stdout, /newer sol model available: gpt-6\.2-sol/, "a bare list cache is read too");
    writeCache({ models: [{ slug: "gpt-6.1-sol" }, { slug: "gpt-6.9-astra" }] });
    result = check();
    assert.equal(result.status, 2);
    assert.doesNotMatch(result.stdout, /newer /, "nothing newer, nothing printed");
    writeCache("{not json");
    result = check();
    assert.equal(result.status, 2);
    assert.doesNotMatch(result.stdout + result.stderr, /newer |Traceback/, "an unreadable cache is skipped silently");
    fs.rmSync(path.join(codexHome, "models_cache.json"));
    result = check();
    assert.equal(result.status, 2);
    assert.doesNotMatch(result.stdout + result.stderr, /newer |Traceback/, "a missing cache is not an error");
  } finally {
    fs.rmSync(work, { recursive: true, force: true });
  }
}
{
  // acef-model-id-scan: literal ids outside the policy are listed; history, records and fixtures are excepted.
  const cp = require("node:child_process");
  const os = require("node:os");
  const scan = path.join(repoRoot, "scripts", "acef-model-id-scan");
  const work = fs.mkdtempSync(path.join(os.tmpdir(), "acef-model-id-scan-"));
  try {
    const write = (rel, text) => { fs.mkdirSync(path.dirname(path.join(work, rel)), { recursive: true }); fs.writeFileSync(path.join(work, rel), text); };
    write("method/model-routing-policy-v1.json", '{"sol": "gpt-6.2-sol"}\n');
    write("method/model-review-floors-v1.json", '["gpt-6.1-sol", "claude-opus-5-5"]\n');
    write("method/GUIDE.md", "Run reviews on latest Sol.\nRun reviews on gpt-6.2-sol, high.\nAstra (gpt-6-astra) only when named.\n");
    write("scripts/review.sh", 'codex exec -m "$(acef-model sol)"\ncodex exec -m claude-sonnet-5-5 x\nREVIEW_MODEL=gpt-5 run\n');
    write("CHANGELOG.md", "# Changelog\n\n## Unreleased — new (2026-11-28)\n- moved to gpt-7-sol\n\n## v3.0.0-beta.1 — old\n- used gpt-6.1-sol\n\n## Unreleased\n- older gpt-5.6-sol\n");
    write("docs/experiments/run/manifest.json", '{"model": "gpt-5.6-sol"}\n');
    write("scripts/test-thing", "model gpt-6.1-sol\n");
    write("scripts/fixtures/a.json", '"gpt-6.1-sol"\n');
    write("docs/ai/capabilities/x.json", '"gpt-5.6-sol"\n');
    write("README.md", "No ids here: gpt-reserve, codex-auto-review, my-gpt-6.1-sol-notes.\n");
    let result = cp.spawnSync("python3", ["-I", scan, "--root", work], { encoding: "utf8" });
    assert.equal(result.status, 1, result.stderr);
    assert.deepEqual(result.stdout.trim().split("\n"), [
      "CHANGELOG.md:4: gpt-7-sol",
      "method/GUIDE.md:2: gpt-6.2-sol",
      "method/GUIDE.md:3: gpt-6-astra",
      "scripts/review.sh:2: claude-sonnet-5-5",
      "scripts/review.sh:3: gpt-5",
    ]);
    assert.match(result.stderr, /literal model id\(s\) outside the routing policy/);
    for (const rel of ["CHANGELOG.md", "method/GUIDE.md", "scripts/review.sh"]) fs.rmSync(path.join(work, rel));
    result = cp.spawnSync("python3", ["-I", scan, "--root", work], { encoding: "utf8" });
    assert.equal(result.status, 0, result.stdout);
    assert.equal(result.stdout, "");
    // ACEF itself carries no literal id outside the policy (selfcheck runs the same scan).
    result = cp.spawnSync("python3", ["-I", scan, "--root", repoRoot], { encoding: "utf8" });
    assert.equal(result.status, 0, `literal model ids in ACEF:\n${result.stdout}`);
    const allowed = cp.spawnSync("python3", ["-I", scan, "--list-allowed"], { encoding: "utf8" });
    assert.match(allowed.stdout, /^method\/model-routing-policy-v1\.json\tpolicy: /m);
  } finally {
    fs.rmSync(work, { recursive: true, force: true });
  }
}

if (!/^[a-f0-9]{64}$/.test(loaded.sha256)
  || !fs.existsSync(path.join(repoRoot, "schemas", "model-routing-policy-v1.schema.json"))) {
  throw new Error("model routing policy lacks durable hash/schema evidence");
}

console.log("acef model routing tests passed");
