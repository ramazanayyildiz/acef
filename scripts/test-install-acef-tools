#!/usr/bin/env node
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const cp = require("node:child_process");

const repoRoot = path.resolve(__dirname, "..");
const installer = path.join(repoRoot, "scripts", "install-acef-tools");
const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "acef-tools-install-"));
const linkedWorktree = `${tmp}-linked`;

function run(command, args, options = {}) {
  const { allowFailure = false, ...execOptions } = options;
  try {
    return cp.execFileSync(command, args, {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "pipe"],
      ...execOptions,
    });
  } catch (error) {
    if (allowFailure) return error.stdout || "";
    throw error;
  }
}

try {
  fs.writeFileSync(path.join(tmp, "package.json"), JSON.stringify({ private: true, type: "module" }, null, 2));
  fs.writeFileSync(path.join(tmp, "AGENTS.md"), "# ACEF test repo\n");
  run("node", [installer, "--repo", tmp]);

  const validator = path.join(tmp, ".acef", "bin", "acef-process-validator");
  const state = path.join(tmp, ".acef", "bin", "acef-state");
  const status = path.join(tmp, ".acef", "bin", "acef-status");
  const next = path.join(tmp, ".acef", "bin", "acef-next");
  const updater = path.join(tmp, ".acef", "bin", "update-acef-installation");
  const nativeTest = path.join(tmp, ".acef", "bin", "acef-native-test");
  const workflowValidate = path.join(tmp, ".acef", "bin", "acef-workflow-validate");
  const parser = path.join(tmp, ".acef", "bin", "lib", "acef-state-parser.js");
  const authorization = path.join(tmp, ".acef", "bin", "lib", "acef-run-authorization.js");
  const assuranceRequirements = path.join(tmp, ".acef", "bin", "lib", "acef-assurance-requirements.js");
  const modelRouting = path.join(tmp, ".acef", "bin", "lib", "acef-model-routing.js");
  const executionPolicy = path.join(tmp, ".acef", "bin", "lib", "acef-execution-policy.js");
  const installationHelper = path.join(tmp, ".acef", "bin", "lib", "acef-installation.js");
  const schema = path.join(tmp, ".acef", "schemas", "active-run.schema.json");
  const activeRunV2Schema = path.join(tmp, ".acef", "schemas", "active-run-v2.schema.json");
  const objectiveSchema = path.join(tmp, ".acef", "schemas", "objective-supervision-v1.schema.json");
  const reviewReportV3Schema = path.join(tmp, ".acef", "schemas", "review-report-v3.schema.json");
  const developerRepairV3Schema = path.join(tmp, ".acef", "schemas", "developer-repair-v3.schema.json");
  const processJudgeDecisionV3Schema = path.join(tmp, ".acef", "schemas", "process-judge-decision-v3.schema.json");
  const atddCorrectionSchema = path.join(tmp, ".acef", "schemas", "atdd-correction.schema.json");
  const lightweightV2Schema = path.join(tmp, ".acef", "schemas", "lightweight-run-v2.schema.json");
  const directSchema = path.join(tmp, ".acef", "schemas", "direct-run.schema.json");
  const capabilitySchema = path.join(tmp, ".acef", "schemas", "capability-change.schema.json");
  const controlDosingSchema = path.join(tmp, ".acef", "schemas", "control-dosing.schema.json");
  const controlDosingV2Schema = path.join(tmp, ".acef", "schemas", "control-dosing-v2.schema.json");
  const controlDosingManifest = path.join(tmp, ".acef", "control-dosing.json");
  const modelRoutingManifest = path.join(tmp, ".acef", "model-routing-policy.json");
  const modelRoutingSchema = path.join(tmp, ".acef", "schemas", "model-routing-policy-v1.schema.json");
  const workflowSchema = path.join(tmp, ".acef", "schemas", "workflow.schema.json");
  const workflow = path.join(tmp, ".acef", "workflows", "lightweight-review.yaml");
  const runtimePackage = path.join(tmp, ".acef", "bin", "package.json");
  if (!fs.existsSync(validator)) throw new Error("validator wrapper was not installed");
  if (!fs.existsSync(state)) throw new Error("typed-state writer was not installed");
  if (!fs.existsSync(status)) throw new Error("status helper was not installed");
  if (!fs.existsSync(next)) throw new Error("next-action helper was not installed");
  if (!fs.existsSync(updater)) throw new Error("ACEF update helper was not installed");
  if (!fs.existsSync(nativeTest)) throw new Error("native speed test wrapper was not installed");
  if (!fs.existsSync(workflowValidate)) throw new Error("workflow validator was not installed");
  if (!fs.existsSync(parser)) throw new Error("parser support library was not installed");
  if (!fs.existsSync(authorization)) throw new Error("run authorization support library was not installed");
  if (!fs.existsSync(assuranceRequirements)) throw new Error("assurance requirements support library was not installed");
  if (!fs.existsSync(modelRouting)) throw new Error("model routing support library was not installed");
  if (!fs.existsSync(executionPolicy)) throw new Error("execution policy support library was not installed");
  const installedExecutionPolicy = require(executionPolicy);
  const bundledRepairFailures = installedExecutionPolicy.workflowSelectionFailures({
    workflowId: "full-bmad",
    assuranceProfile: "guarded",
    scopeUnit: "story",
    riskTriggers: ["bugfix", "broad-cross-surface", "shared-test-failures"],
  });
  if (!bundledRepairFailures.some((failure) => failure.includes("REPLAN/SPLIT"))) {
    throw new Error("installed execution policy did not reject bundled independent defects");
  }
  const nativeChildFailures = installedExecutionPolicy.workflowSelectionFailures({
    workflowId: "quick-fix",
    assuranceProfile: "guarded",
    scopeUnit: "work-item",
    intakeDecision: {
      routingPolicyVersion: "two-axis-v3",
      admissionDecision: "acef",
      reversible: true,
      technicalBoundaryCount: 1,
      productSurfaceCount: 1,
    },
    riskTriggers: ["bugfix", "root-cause-proven", "bounded-patch", "release-certification-integrity"],
  });
  if (!nativeChildFailures.some((failure) => failure.includes("NATIVE_WORKFLOW"))) {
    throw new Error("installed execution policy did not reject native-eligible split child admission");
  }
  if (!fs.existsSync(installationHelper)) throw new Error("installation support library was not installed");
  if (!fs.existsSync(schema)) throw new Error("typed-state schemas were not installed");
  if (!fs.existsSync(activeRunV2Schema)) throw new Error("active-run v2 schema was not installed");
  if (!fs.existsSync(objectiveSchema)) throw new Error("objective supervision schema was not installed");
  const installedActiveRunV2Schema = JSON.parse(fs.readFileSync(activeRunV2Schema, "utf8"));
  if (JSON.stringify(installedActiveRunV2Schema.properties?.terminalDisposition?.enum)
    !== JSON.stringify(["PASS", "FAIL", "REPLAN", "BLOCKED"])) {
    throw new Error("installed active-run v2 schema does not accept typed terminal dispositions");
  }
  if (installedActiveRunV2Schema.properties?.terminalGateId?.pattern !== "^[A-Za-z0-9._-]+$") {
    throw new Error("installed active-run v2 schema does not bind terminal completion to a safe gate id");
  }
  if (!fs.existsSync(reviewReportV3Schema)) throw new Error("review-report v3 schema was not installed");
  if (!fs.existsSync(developerRepairV3Schema)) throw new Error("developer-repair v3 schema was not installed");
  if (!fs.existsSync(processJudgeDecisionV3Schema)) throw new Error("Process Judge decision v3 schema was not installed");
  if (!fs.existsSync(atddCorrectionSchema)) throw new Error("ATDD correction schema was not installed");
  if (!fs.existsSync(lightweightV2Schema)) throw new Error("lightweight-run v2 schema was not installed");
  if (!fs.existsSync(directSchema)) throw new Error("direct-run schema was not installed");
  if (!fs.existsSync(capabilitySchema)) throw new Error("capability-change schema was not installed");
  if (!fs.existsSync(controlDosingSchema)) throw new Error("control-dosing schema was not installed");
  if (!fs.existsSync(controlDosingV2Schema)) throw new Error("control-dosing v2 schema was not installed");
  if (!fs.existsSync(controlDosingManifest)) throw new Error("control-dosing manifest was not installed");
  if (!fs.existsSync(modelRoutingManifest) || !fs.existsSync(modelRoutingSchema)) throw new Error("model routing policy/schema was not installed");
  const installedRouting = JSON.parse(fs.readFileSync(modelRoutingManifest, "utf8"));
  if (installedRouting.schema !== "acef.model-routing-policy.v1"
    || installedRouting.roles?.["code-review"]?.reasoningTier !== "medium"
    || installedRouting.providers?.openai?.models?.["semantic-standard"] !== "gpt-5.6-sol") {
    throw new Error("installed model routing policy lost calibrated provider-neutral role mapping");
  }
  const installedDosing = JSON.parse(fs.readFileSync(controlDosingManifest, "utf8"));
  if (installedDosing.schema !== "acef.control-dosing.v2") {
    throw new Error("installed control-dosing manifest is not workflow/assurance v2");
  }
  if (!installedDosing.retiredAdmissions.includes("direct")) {
    throw new Error("installed control-dosing manifest did not retire new direct admission");
  }
  if (!fs.existsSync(workflowSchema)) throw new Error("workflow schema was not installed");
  if (!fs.existsSync(workflow)) throw new Error("lightweight workflow was not installed");
  if (JSON.parse(fs.readFileSync(runtimePackage, "utf8")).type !== "commonjs") throw new Error("ACEF runtime CommonJS boundary was not installed");
  const installationManifest = path.join(tmp, "docs", "ai", "ACEF_INSTALLATION.json");
  if (!fs.existsSync(installationManifest)) throw new Error("ACEF installation manifest was not written");
  const installation = JSON.parse(fs.readFileSync(installationManifest, "utf8"));
  if (installation.schema !== "acef.installation.v1") throw new Error("installation manifest schema missing");
  if (!installation.acefVersion?.sourceCommit) throw new Error("installation manifest missing source commit");
  if (!installation.components?.tools) throw new Error("installation manifest missing tools component");
  if (installation.updateCommand.includes("--all-worktrees")) {
    throw new Error("ordinary single-target installation incorrectly persisted --all-worktrees");
  }
  if (!installation.components.tools.tools.includes("update-acef-installation")) throw new Error("tools component missing updater");
  if (!installation.components.tools.controlDosing) throw new Error("tools component missing control-dosing manifest");
  if (!installation.components.tools.modelRoutingPolicy) throw new Error("tools component missing model-routing policy");
  if (installation.components.tools.objectiveSupervisor !== "objective-supervisor-v1"
    || installation.components.tools.defaultRuntimeContract !== "capsule-supervisor-v2"
    || installation.components.tools.dispatchReadinessContract !== "full-v3-dispatch-readiness-v1"
    || installation.components.tools.freshnessContract !== "worktree-handshake-v1"
    || !installation.components.tools.sourceRuntimeDigest
    || !installation.components.tools.installedRuntimeDigest) {
    throw new Error("tools component missing objective/freshness supervision contract");
  }

  fs.mkdirSync(path.join(tmp, "docs", "ai"), { recursive: true });
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_demo_DELIVERY_AUDIT.md"), [
    "# Demo",
    "active_lane: Full BMAD v2",
    "",
    "## Session Handoff",
    "last_passed_gate: Story 1.1 ATDD PASS",
    "",
  ].join("\n"));
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_CURRENT_CONTEXT.md"), [
    "source_ledger: docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
    "active_story: story 1.1",
    "active_phase: development",
    "last_passed_gate: Story 1.1 ATDD PASS",
    "",
    "## Current Work",
    "Story 1.1",
    "## Gate State",
    "ATDD PASS",
    "## Allowed Scope",
    "Scope",
    "## Relevant Acceptance Criteria",
    "AC",
    "## Required Commands",
    "npm test",
    "## Deferred and Out of Scope",
    "None",
    "## Known Pitfalls",
    "None",
    "## Artifact Paths",
    "docs/ai/ACEF_CURRENT_CONTEXT.md",
    "## Role Inputs",
    "Inputs",
    "",
  ].join("\n"));
  run("git", ["init", "-q"], { cwd: tmp });
  run("git", ["config", "user.email", "acef@example.test"], { cwd: tmp });
  run("git", ["config", "user.name", "ACEF Test"], { cwd: tmp });
  run("git", ["add", "."], { cwd: tmp });
  run("git", ["commit", "-qm", "fixture"], { cwd: tmp });
  const retiredDirect = cp.spawnSync(state, [
    "direct-run", "--repo", tmp,
    "--run-id", "DIRECT-new-install-test",
    "--status", "active",
    "--scope", "Attempt a new direct run.",
    "--acceptance", "The retired admission rejects it.",
    "--technical-boundary", "internal-mechanical",
    "--reversible", "true",
  ], { cwd: tmp, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
  if (retiredDirect.status === 0 || !`${retiredDirect.stdout}${retiredDirect.stderr}`.includes("new direct-run admission is retired")) {
    throw new Error("installed state writer did not reject new direct admission");
  }
  const directBase = run("git", ["rev-parse", "HEAD"], { cwd: tmp }).trim();
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_DIRECT_RUN.json"), `${JSON.stringify({
    schema: "acef.direct-run.v1",
    version: "1.0.0",
    runId: "DIRECT-install-test",
    lane: "direct",
    status: "active",
    scope: "Close a legacy local direct-lane fixture.",
    acceptance: ["The fixture parses successfully."],
    technicalBoundary: "internal-mechanical",
    reversible: true,
    riskTriggers: [],
    baseCommit: directBase,
    changedPaths: ["src/direct.js"],
    verification: [],
    promotion: { decision: "stay-direct", reasons: [] },
  }, null, 2)}\n`);
  fs.mkdirSync(path.join(tmp, "src"), { recursive: true });
  fs.writeFileSync(path.join(tmp, "src", "direct.js"), "export const direct = true;\n");
  run(state, [
    "direct-run", "--repo", tmp,
    "--run-id", "DIRECT-install-test",
    "--status", "complete",
    "--changed-path", "src/direct.js",
    "--verification-command", "node --check src/direct.js",
    "--verification-exit-code", "0",
    "--summary", "Installed direct lane writes and validates its compact task record.",
  ]);
  const directOutput = run(validator, ["--repo", tmp, "--check", "direct-lifecycle"]);
  if (!directOutput.includes("PASS direct-lifecycle:")) {
    throw new Error(`installed validator did not validate direct lifecycle:\n${directOutput}`);
  }
  run(state, [
    "active-run", "--repo", tmp,
    "--run-id", "RUN-install-test",
    "--objective-id", "OBJ-install-test",
    "--objective-scope", "Validate the installed ACEF runtime",
    "--lane", "full-bmad",
    "--status", "active",
    "--story", "story 1.1",
    "--expected-story", "story 1.1",
    "--phase", "development",
    "--worker-role", "developer",
    "--last-passed-gate", "Story 1.1 ATDD PASS",
    "--next-allowed-step", "implement_to_green",
    "--full-ledger-access", "denied",
    "--max-lines", "120",
    "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
    "--context", "docs/ai/ACEF_CURRENT_CONTEXT.md",
  ]);
  const installedActiveRun = JSON.parse(fs.readFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), "utf8"));
  if (installedActiveRun.runtimeContract !== "capsule-supervisor-v2") {
    throw new Error(`new installed Full v3 run did not bind capsule-supervisor-v2: ${installedActiveRun.runtimeContract}`);
  }

  const output = run(validator, [
    "--repo", tmp,
    "--check", "current-context",
    "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
  ]);
  if (!output.includes("PASS current-context:")) {
    throw new Error(`installed validator did not use installed parser:\n${output}`);
  }
  const controlDosingOutput = run(validator, ["--repo", tmp, "--check", "control-dosing"]);
  if (!controlDosingOutput.includes("PASS control-dosing:")) {
    throw new Error(`installed validator did not validate installed control dosing:\n${controlDosingOutput}`);
  }
  const readinessActiveRun = JSON.parse(fs.readFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), "utf8"));
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), `${JSON.stringify({
    ...readinessActiveRun,
    activePhase: "readiness",
    workerRole: "test-author",
    activeActorId: null,
    nextAllowedStep: "write_failing_tests",
  }, null, 2)}\n`);
  const statusOutput = run(status, ["--repo", tmp, "--format", "json"], { allowFailure: true });
  const statusJson = JSON.parse(statusOutput);
  if (statusJson.status !== "needs-attention"
    || !statusJson.blockers.some((entry) => entry.startsWith("preflight:"))
    || !statusJson.dispatchReadiness.some((entry) => entry.name === "current-context")) {
    throw new Error(`installed status helper did not aggregate dispatch validators:\n${statusOutput}`);
  }
  if (statusJson.activeRun.activeStory !== "story 1.1") throw new Error("installed status helper did not read active run");
  if (statusJson.activeRun.workflowId !== "full-bmad" || statusJson.activeRun.assuranceProfile !== "baseline") {
    throw new Error("installed status helper did not expose separate workflow and assurance state");
  }
  if (!statusJson.readOrder.includes("docs/ai/ACEF_CURRENT_CONTEXT.md")) throw new Error("installed status helper did not include current-context read order");
  if (statusJson.installation.sourceCommit !== installation.acefVersion.sourceCommit) throw new Error("installed status helper did not report ACEF installation version");
  if (!statusJson.installation.components.includes("tools")) throw new Error("installed status helper missing installed components");
  if (statusJson.objective?.objectiveId !== "OBJ-install-test" || statusJson.objective?.runCount !== 1) {
    throw new Error("installed status helper did not expose parent-objective counters");
  }
  fs.writeFileSync(installationManifest, "{}\n");
  const invalidStatus = run(status, ["--repo", tmp, "--format", "json"], { allowFailure: true });
  const invalidJson = JSON.parse(invalidStatus);
  if (invalidJson.status !== "needs-attention") throw new Error("installed status helper accepted an invalid ACEF installation manifest");
  fs.writeFileSync(installationManifest, `${JSON.stringify(installation, null, 2)}\n`);
  const nextOutput = run(next, ["--repo", tmp, "--format", "json"], { allowFailure: true });
  const nextJson = JSON.parse(nextOutput);
  if (nextJson.status !== "blocked"
    || nextJson.active_state.next_allowed_action !== null
    || !nextJson.dispatch_readiness.some((entry) => entry.name === "current-context")) {
    throw new Error(`installed next helper did not block on dispatch validators:\n${nextOutput}`);
  }
  if (!nextJson.forbidden.actions.includes("start_next_story")) throw new Error("installed next helper missing story boundary");
  run(state, [
    "active-run", "--repo", tmp,
    "--run-id", "RUN-install-test",
    "--workflow-id", "full-bmad",
    "--status", "active",
    "--story", "story 1.1",
    "--expected-story", "story 1.1",
    "--phase", "readiness",
    "--worker-role", "planner",
    "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
    "--context", "docs/ai/ACEF_CURRENT_CONTEXT.md",
  ]);
  const blockedTransition = cp.spawnSync(state, [
    "phase-transition", "--repo", tmp, "--phase", "atdd",
  ], { cwd: tmp, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
  if (blockedTransition.status === 0
    || !`${blockedTransition.stdout}${blockedTransition.stderr}`.includes("readiness -> ATDD blocked: preflight:")) {
    throw new Error("installed phase transition did not fail closed on mandatory dispatch readiness");
  }
  if (JSON.parse(fs.readFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), "utf8")).activePhase !== "readiness") {
    throw new Error("blocked readiness transition mutated active phase");
  }
  const workflowOutput = run(workflowValidate, ["--repo", tmp, "--workflow", ".acef/workflows/lightweight-review.yaml"]);
  if (!workflowOutput.includes("PASS workflow lightweight-review:")) throw new Error("installed workflow validator did not validate installed workflow");
  run(updater, ["--repo", tmp, "--review-lenses"]);
  if (!fs.existsSync(path.join(tmp, ".acef", "hooks", "acef-bmad-hard-wall.mjs"))) throw new Error("installed updater did not refresh guard hook");
  if (!fs.existsSync(path.join(tmp, ".codex", "skills", "acef", "SKILL.md"))) throw new Error("installed updater did not refresh Codex skills");
  const refreshedInstallation = JSON.parse(fs.readFileSync(installationManifest, "utf8"));
  if (!refreshedInstallation.components?.bmadGuard) throw new Error("installed updater did not record guard component");
  if (!refreshedInstallation.components?.skills?.skills?.includes("bug-hunter")) throw new Error("installed updater did not record refreshed review lenses");
  if (!refreshedInstallation.updateCommand.endsWith(" --review-lenses")) {
    throw new Error(`installation updateCommand did not preserve review-lenses: ${refreshedInstallation.updateCommand}`);
  }
  run("git", ["worktree", "add", "-q", "-b", `acef-install-linked-${process.pid}`, linkedWorktree, "HEAD"], { cwd: tmp });
  const allWorktreeOutput = run(updater, ["--repo", tmp, "--all-worktrees", "--review-lenses", "--all-core"]);
  if (!allWorktreeOutput.includes(`UPDATED_WORKTREE ${fs.realpathSync(tmp)}`)
    || !allWorktreeOutput.includes(`UPDATED_WORKTREE ${fs.realpathSync(linkedWorktree)}`)) {
    throw new Error(`installed updater did not enumerate every active git worktree:\n${allWorktreeOutput}`);
  }
  if (!fs.existsSync(path.join(linkedWorktree, "docs", "ai", "ACEF_INSTALLATION.json"))) {
    throw new Error("linked worktree did not receive an ACEF installation/freshness stamp");
  }
  for (const target of [tmp, linkedWorktree]) {
    const targetInstallation = JSON.parse(fs.readFileSync(path.join(target, "docs", "ai", "ACEF_INSTALLATION.json"), "utf8"));
    for (const option of ["--all-worktrees", "--review-lenses", "--all-core"]) {
      if (!targetInstallation.updateCommand.includes(option)) {
        throw new Error(`linked updateCommand for ${target} did not preserve ${option}: ${targetInstallation.updateCommand}`);
      }
    }
  }
  run(updater, ["--repo", tmp, "--review-lenses", "--all-core"]);
  const singleTargetInstallation = JSON.parse(fs.readFileSync(installationManifest, "utf8"));
  if (singleTargetInstallation.updateCommand.includes("--all-worktrees")
    || !singleTargetInstallation.updateCommand.includes("--review-lenses")
    || !singleTargetInstallation.updateCommand.includes("--all-core")) {
    throw new Error(`single-target updateCommand did not drop only invocation-level --all-worktrees: ${singleTargetInstallation.updateCommand}`);
  }

  console.log("install-acef-tools tests passed");
} finally {
  try { run("git", ["worktree", "remove", "--force", linkedWorktree], { cwd: tmp }); } catch {}
  fs.rmSync(linkedWorktree, { recursive: true, force: true });
  fs.rmSync(tmp, { recursive: true, force: true });
}
