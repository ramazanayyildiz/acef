#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const crypto = require("node:crypto");
const os = require("node:os");
const path = require("node:path");
const cp = require("node:child_process");
const { performance } = require("node:perf_hooks");
const {
  acquireFinalizationClaim,
  assessTaskShape,
  buildPilotPlan,
  captureGitDiff,
  environmentPreflight,
  isPilotHarnessPath,
  parseIndependentTrace,
  parseLifecycleDispatchTrace,
  pilotAttemptHistory,
  preflightCatalog,
  readPilotResultRow,
  resolveCatalogTask,
  sha256,
  validateManifest,
} = require("./lib/acef-execution-assurance-experiment");
const { riskRequiresGuarded } = require("./lib/acef-execution-policy");
const { parseJsonLines, codexMetrics, isAllowedPath } = require("./lib/acef-empirical");
const { evaluateExpectations, linkDependencies } = require("./acef-empirical-validation");

const root = path.resolve(__dirname, "..");
const defaultManifest = path.join(root, "docs", "experiments", "execution-assurance-v2", "manifest.json");
const defaultResults = path.join(root, "docs", "experiments", "execution-assurance-v2", "runs", "stage0.jsonl");
const defaultPilotResults = path.join(root, "docs", "experiments", "execution-assurance-v2", "runs", "pilot.jsonl");

function usage() {
  console.log(`Usage: acef-execution-assurance-experiment [--manifest <path>] [--results <path>] [--preflight-output <path>] [--pilot-results <path>] [--workspace <path>] [--pilot-workspace <path>] [--plan] [--stage0] [--pilot-preflight] [--pilot-run <attempt-id>] [--pilot-finalize <attempt-id>] [--force] [--keep]

--plan    Print the preregistered 16-attempt pilot without executing agents.
--stage0  Execute the six deterministic mechanism/measurement traps in disposable repositories.
--pilot-preflight  Resolve every task/fixture/commit/dependency before any timed agent run.
--pilot-run <id>  Execute one preregistered single-task attempt and record a provisional, independently scored row.
--pilot-finalize <id>  Finalize the latest durable actor checkpoint after an interrupted parent session.
--force   Replace an existing Stage 0 result log. Without this flag results are immutable.`);
}

function parseArgs(argv) {
  const opts = {
    manifest: defaultManifest,
    results: defaultResults,
    preflightOutput: path.join(root, "docs", "experiments", "execution-assurance-v2", "pilot-preflight.json"),
    pilotResults: defaultPilotResults,
    workspace: path.join(os.tmpdir(), "acef-execution-assurance-v2-stage0"),
    pilotWorkspace: path.join(os.tmpdir(), "acef-execution-assurance-v2-pilot"),
    plan: false,
    stage0: false,
    pilotPreflight: false,
    pilotRun: "",
    pilotFinalize: "",
    pilotRetryInvalidated: false,
    force: false,
    keep: false,
  };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--help" || arg === "-h") { usage(); process.exit(0); }
    else if (arg === "--manifest") opts.manifest = path.resolve(argv[++index]);
    else if (arg === "--results") opts.results = path.resolve(argv[++index]);
    else if (arg === "--preflight-output") opts.preflightOutput = path.resolve(argv[++index]);
    else if (arg === "--pilot-results") opts.pilotResults = path.resolve(argv[++index]);
    else if (arg === "--workspace") opts.workspace = path.resolve(argv[++index]);
    else if (arg === "--pilot-workspace") opts.pilotWorkspace = path.resolve(argv[++index]);
    else if (arg === "--plan") opts.plan = true;
    else if (arg === "--stage0") opts.stage0 = true;
    else if (arg === "--pilot-preflight") opts.pilotPreflight = true;
    else if (arg === "--pilot-run") opts.pilotRun = argv[++index] || "";
    else if (arg === "--pilot-finalize") opts.pilotFinalize = argv[++index] || "";
    else if (arg === "--pilot-retry-invalidated") opts.pilotRetryInvalidated = true;
    else if (arg === "--force") opts.force = true;
    else if (arg === "--keep") opts.keep = true;
    else throw new Error(`unknown argument: ${arg}`);
  }
  if ([opts.plan, opts.stage0, opts.pilotPreflight, Boolean(opts.pilotRun), Boolean(opts.pilotFinalize)].filter(Boolean).length !== 1) {
    throw new Error("select exactly one of --plan, --stage0, --pilot-preflight, --pilot-run, or --pilot-finalize");
  }
  return opts;
}

function execute(command, args, cwd, options = {}) {
  const result = cp.spawnSync(command, args, {
    cwd,
    encoding: "utf8",
    timeout: options.timeout || 120000,
    env: options.env || process.env,
    input: options.input,
    stdio: [options.input === undefined ? "ignore" : "pipe", "pipe", "pipe"],
  });
  return {
    status: Number.isInteger(result.status) ? result.status : 1,
    stdout: result.stdout || "",
    stderr: result.stderr || result.error?.message || "",
    signal: result.signal || null,
  };
}

function must(command, args, cwd, options = {}) {
  const result = execute(command, args, cwd, options);
  if (result.status !== 0) throw new Error(`${command} ${args.join(" ")} failed: ${result.stderr || result.stdout}`);
  return result.stdout.trim();
}

function writeJson(filePath, value) {
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  fs.writeFileSync(filePath, `${JSON.stringify(value, null, 2)}\n`);
}

function writeJsonAtomic(filePath, value) {
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  const temporary = `${filePath}.${process.pid}.tmp`;
  fs.writeFileSync(temporary, `${JSON.stringify(value, null, 2)}\n`);
  fs.renameSync(temporary, filePath);
}

function initRepo(dir) {
  fs.rmSync(dir, { recursive: true, force: true });
  fs.mkdirSync(path.join(dir, "src"), { recursive: true });
  must("git", ["init", "-q"], dir);
  must("git", ["config", "user.email", "acef-experiment@example.invalid"], dir);
  must("git", ["config", "user.name", "ACEF Experiment"], dir);
  fs.writeFileSync(path.join(dir, "src", "allowed.js"), "module.exports = true;\n");
  fs.writeFileSync(path.join(dir, "README.md"), "# ACEF Stage 0 fixture\n");
  must("git", ["add", "."], dir);
  must("git", ["commit", "-qm", "fixture baseline"], dir);
  must("node", [path.join(root, "scripts", "install-acef-tools"), "--repo", dir], root);
}

function bindActiveScope(dir) {
  const docs = path.join(dir, "docs", "ai");
  fs.mkdirSync(docs, { recursive: true });
  fs.writeFileSync(path.join(docs, "ACEF_stage0_DELIVERY_AUDIT.md"), "# Stage 0\nStatus: active\n");
  fs.writeFileSync(path.join(docs, "ACEF_ACTIVE_LEDGER"), "docs/ai/ACEF_stage0_DELIVERY_AUDIT.md\n");
  fs.writeFileSync(path.join(docs, "ACEF_CURRENT_CONTEXT.md"), "active_story: D4\nactive_phase: development\n");
  const base = must("git", ["rev-parse", "HEAD"], dir);
  writeJson(path.join(docs, "ACEF_ACTIVE_RUN.json"), {
    schema: "acef.active-run.v2",
    runId: "STAGE0-D4",
    repo: "stage0-scope",
    workflowId: "quick-fix",
    assuranceProfile: "guarded",
    scopeUnit: "work-item",
    assuranceRationale: "permission boundary",
    status: "active",
    activeStory: "D4",
    activePhase: "development",
    workflowRationale: "reproduced bounded permission defect",
    riskTriggers: ["bugfix", "permission"],
    workerScopePath: "docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json",
    ledgerPath: "docs/ai/ACEF_stage0_DELIVERY_AUDIT.md",
    contextPath: "docs/ai/ACEF_CURRENT_CONTEXT.md"
  });
  writeJson(path.join(docs, "ACEF_ACTIVE_WORKER_SCOPE.json"), {
    runId: "STAGE0-D4",
    activeStory: "D4",
    phase: "development",
    workerId: "stage0-worker",
    allowedPaths: ["src/allowed.js"],
    baseRef: base,
    maxCommits: 1,
    canEditLedger: false,
    canSpawnAgents: false
  });
  must("git", ["add", "."], dir);
  must("git", ["commit", "-qm", "bind stage0 scope"], dir);
}

function trapRoutingSweep() {
  const positive = [
    "auth", "authorization", "permissions", "access control", "OAuth", "SSO", "credentials", "secrets",
    "encryption", "key rotation", "payment", "billing", "subscription", "refund", "payout", "database migration",
    "data deletion", "privacy", "PII", "consent", "retention", "external provider", "webhook", "realtime",
    "concurrency", "fencing", "state machine", "tenant isolation", "session token", "entitlements"
  ];
  const negative = ["copy", "CSS style", "documentation", "rename local variable", "delete CSS class"];
  const misses = positive.filter((value) => !riskRequiresGuarded([value]));
  const falsePositives = negative.filter((value) => riskRequiresGuarded([value]));
  return {
    pass: misses.length === 0 && falsePositives.length === 0,
    observed: { positiveCases: positive.length, negativeCases: negative.length, misses, falsePositives },
  };
}

function trapOversizedScope() {
  const contained = assessTaskShape({
    technicalBoundaries: ["controller"], productSurfaces: ["admin-ui"], acceptanceCriteriaCount: 3,
  });
  const giant = assessTaskShape({
    technicalBoundaries: ["migration", "provider", "state-machine", "analytics"],
    productSurfaces: ["public-ui", "reporting"], acceptanceCriteriaCount: 16,
  });
  return {
    pass: contained.disposition === "READY" && giant.disposition === "REPLAN_SPLIT",
    observed: { contained, giant },
  };
}

function trapDuplicateLifecycle() {
  const single = parseIndependentTrace("bmad-check-implementation-readiness\natdd\nbmad-dev-story\nbmad-code-review\nverify-patch\ntest-review\nprocess-judge\n");
  const duplicated = parseIndependentTrace("bmad-code-review\nbmad-code-review\nprocess-judge\nprocess-judge\n");
  return {
    pass: !single.duplicateLifecycle && duplicated.duplicateLifecycle
      && duplicated.duplicateLifecycleControls.includes("codeReview")
      && duplicated.duplicateLifecycleControls.includes("processJudge"),
    observed: { single: single.counts, duplicated: duplicated.counts, detected: duplicated.duplicateLifecycleControls },
  };
}

function trapScopeWrite(workspace) {
  const dir = path.join(workspace, "D4-scope-write");
  initRepo(dir);
  bindActiveScope(dir);
  fs.writeFileSync(path.join(dir, "src", "forbidden.js"), "module.exports = false;\n");
  const result = execute(path.join(dir, ".acef", "bin", "acef-codex-guard"), ["--repo", dir, "--role", "worker"], dir);
  const output = `${result.stdout}\n${result.stderr}`;
  return {
    pass: result.status !== 0 && /outside allowedPaths/i.test(output),
    observed: { exitCode: result.status, outputSha256: sha256(output), matchedScopeDenial: /outside allowedPaths/i.test(output) },
  };
}

function trapDirtyWorktree(workspace) {
  const dir = path.join(workspace, "D5-dirty-worktree");
  initRepo(dir);
  must("git", ["add", "."], dir);
  must("git", ["commit", "-qm", "install tools"], dir);
  fs.writeFileSync(path.join(dir, "src", "dirty.js"), "module.exports = 'dirty';\n");
  const result = execute(path.join(dir, ".acef", "bin", "acef-process-validator"), ["--repo", dir, "--check", "clean-tree"], dir);
  const output = `${result.stdout}\n${result.stderr}`;
  return {
    pass: result.status !== 0 && /working tree is dirty/i.test(output),
    observed: { exitCode: result.status, outputSha256: sha256(output), matchedDirtyDenial: /working tree is dirty/i.test(output) },
  };
}

function trapBrokenEnvironment(workspace) {
  const dir = path.join(workspace, "D6-broken-environment");
  initRepo(dir);
  const check = environmentPreflight(dir, {
    requiredPaths: ["vendor/autoload.php"],
    probes: [[process.execPath, "-e", "process.exit(0)"]],
  });
  return {
    pass: !check.ok && check.checkedBeforeTimedRun && check.missingPaths.includes("vendor/autoload.php"),
    observed: check,
  };
}

function runTrap(trap, workspace) {
  if (trap.id === "D1-routing-sweep") return trapRoutingSweep();
  if (trap.id === "D2-oversized-scope") return trapOversizedScope();
  if (trap.id === "D3-duplicate-lifecycle") return trapDuplicateLifecycle();
  if (trap.id === "D4-scope-write") return trapScopeWrite(workspace);
  if (trap.id === "D5-dirty-worktree") return trapDirtyWorktree(workspace);
  if (trap.id === "D6-broken-environment") return trapBrokenEnvironment(workspace);
  throw new Error(`no Stage 0 implementation for ${trap.id}`);
}

function runStage0(manifest, opts) {
  if (fs.existsSync(opts.results) && !opts.force) {
    throw new Error(`immutable Stage 0 results already exist at ${opts.results}; use --force only for a documented harness rerun`);
  }
  fs.rmSync(opts.workspace, { recursive: true, force: true });
  fs.mkdirSync(opts.workspace, { recursive: true });
  fs.mkdirSync(path.dirname(opts.results), { recursive: true });
  const runnerCommit = must("git", ["rev-parse", "HEAD"], root);
  const runnerDirtyBefore = must("git", ["status", "--porcelain"], root) !== "";
  const rows = [];
  for (const trap of manifest.stage0.traps) {
    const startedAt = new Date().toISOString();
    const started = performance.now();
    let outcome;
    try {
      outcome = runTrap(trap, opts.workspace);
    } catch (error) {
      outcome = { pass: false, observed: { error: error.message } };
    }
    const row = {
      schema: "acef.execution-assurance-stage0-result.v1",
      experimentId: manifest.experimentId,
      trapId: trap.id,
      candidateCommit: manifest.treatments.candidate.commit,
      runnerCommit,
      runnerDirtyBefore,
      startedAt,
      finishedAt: new Date().toISOString(),
      runtimeMs: Math.round((performance.now() - started) * 1000) / 1000,
      result: outcome.pass ? "PASS" : "FAIL",
      observed: outcome.observed,
      observedSha256: sha256(JSON.stringify(outcome.observed)),
    };
    fs.appendFileSync(opts.results, `${JSON.stringify(row)}\n`);
    rows.push(row);
    console.log(`${row.result} ${trap.id} (${row.runtimeMs}ms)`);
  }
  if (!opts.keep) fs.rmSync(opts.workspace, { recursive: true, force: true });
  const failed = rows.filter((row) => row.result !== "PASS");
  console.log(`STAGE0 ${failed.length ? "FAIL" : "PASS"}: ${rows.length - failed.length}/${rows.length} traps passed`);
  if (failed.length) process.exitCode = 1;
}

function applyTaskSetup(repo, resolved) {
  const operations = resolved.kind === "epic"
    ? resolved.task.stories.flatMap((story) => story.setup || [])
    : (resolved.task.setup || []);
  for (const operation of operations) {
    const target = path.join(repo, operation.path);
    if (operation.type === "copy-fixture") {
      fs.mkdirSync(path.dirname(target), { recursive: true });
      fs.copyFileSync(path.join(resolved.fixtureRoot, operation.fixture), target);
    } else if (operation.type === "replace") {
      const text = fs.readFileSync(target, "utf8");
      const count = text.split(operation.from).length - 1;
      if (count !== Number(operation.count || 1)) {
        throw new Error(`${resolved.taskId}: expected ${operation.count || 1} occurrence(s) in ${operation.path}, found ${count}`);
      }
      fs.writeFileSync(target, text.replace(operation.from, operation.to));
    } else {
      throw new Error(`${resolved.taskId}: unsupported setup operation ${operation.type}`);
    }
  }
}

function commitAll(repo, message) {
  must("git", ["add", "-A"], repo);
  const status = must("git", ["status", "--porcelain"], repo);
  if (status) must("git", ["commit", "--no-verify", "-qm", message], repo);
  return must("git", ["rev-parse", "HEAD"], repo);
}

function prepareSingleTaskClone(resolved, attempt, opts, options = {}) {
  const clone = path.join(opts.pilotWorkspace, "clones", attempt.id);
  fs.rmSync(clone, { recursive: true, force: true });
  fs.mkdirSync(path.dirname(clone), { recursive: true });
  must("git", ["clone", "-q", "--shared", "--no-hardlinks", resolved.source, clone], root, { timeout: 300000 });
  must("git", ["checkout", "-q", "--detach", resolved.commit], clone);
  must("git", ["config", "user.email", "acef-pilot@example.invalid"], clone);
  must("git", ["config", "user.name", "ACEF Pilot"], clone);
  if (options.beforeDependencies) options.beforeDependencies(clone);
  linkDependencies(clone, { id: resolved.taskId, stack: resolved.stack, source: resolved.source });
  applyTaskSetup(clone, resolved);
  const seededCommit = commitAll(clone, `test: seed ${resolved.taskId} pilot`);
  return { clone, seededCommit };
}

function prepareEpicClone(resolved, attempt, opts) {
  return prepareSingleTaskClone(resolved, attempt, opts, {
    beforeDependencies(clone) {
      for (const dir of [
        ...(resolved.setupDirs || []),
        "storage/framework/views", "storage/framework/cache/data", "storage/framework/sessions",
        "storage/framework/testing", "storage/logs", "bootstrap/cache",
      ]) fs.mkdirSync(path.join(clone, dir), { recursive: true });
      for (const file of resolved.setupFiles || []) {
        const allowedTemporaryRoot = file.path.startsWith(`${os.tmpdir()}${path.sep}`)
          || file.path.startsWith("/tmp/") || file.path.startsWith("/private/tmp/");
        if (file.mode !== "truncate" || !path.isAbsolute(file.path) || !allowedTemporaryRoot) {
          throw new Error(`${resolved.taskId}: unsafe setup file declaration ${file.path || "(missing)"}`);
        }
        fs.mkdirSync(path.dirname(file.path), { recursive: true });
        fs.writeFileSync(file.path, "");
      }
    },
  });
}

function frameworkCheckout(frameworkCommit, opts) {
  const checkout = path.join(opts.pilotWorkspace, "frameworks", frameworkCommit);
  if (fs.existsSync(path.join(checkout, ".git"))) {
    if (must("git", ["rev-parse", "HEAD"], checkout) !== must("git", ["rev-parse", frameworkCommit], root)) {
      throw new Error(`cached framework checkout ${frameworkCommit} is at the wrong commit`);
    }
    if (must("git", ["status", "--porcelain"], checkout) !== "") {
      throw new Error(`cached framework checkout ${frameworkCommit} is dirty`);
    }
    return checkout;
  }
  fs.mkdirSync(path.dirname(checkout), { recursive: true });
  must("git", ["clone", "-q", "--shared", "--no-hardlinks", root, checkout], root, { timeout: 300000 });
  must("git", ["checkout", "-q", "--detach", frameworkCommit], checkout);
  return checkout;
}

function installExactFramework(clone, attempt, manifest, opts) {
  if (attempt.treatment === "repo-native") return null;
  const framework = frameworkCheckout(attempt.frameworkCommit, opts);
  must("node", [path.join(framework, "scripts", "install-acef-tools"), "--repo", clone], framework, { timeout: 300000 });
  must("node", [path.join(framework, "scripts", "install-acef-skills"), "--repo", clone, "--tool", manifest.pilotRuntime.client, "--skill", "acef"], framework, { timeout: 300000 });
  must("node", [path.join(framework, "scripts", "install-acef-bmad-guard"), "--repo", clone], framework, { timeout: 300000 });
  forceTrackInstalledFramework(clone);
  commitAll(clone, `chore: install pinned framework ${attempt.frameworkCommit}`);
  return framework;
}

function forceTrackInstalledFramework(clone) {
  for (const entry of [".codex/skills/acef"]) {
    if (fs.existsSync(path.join(clone, entry))) must("git", ["add", "-f", "--", entry], clone);
  }
}

function isBehavioralRed(result) {
  const output = `${result.stdout}\n${result.stderr}`;
  const infrastructureFailure = /(?:Could not open input file|command not found|No such file or directory|autoload\.php.*not found|SQLSTATE\[[^\]]+\].*(?:connection refused|unknown database)|Class [^\n]+ not found)/i.test(output);
  const assertionFailure = /(?:FAILURES!|Failed asserting that|AssertionFailedError|\b[1-9]\d* failure(?:s)?\b|Tests:\s+\d+\s+failed|\bFAILED\b[^\n]*(?:Test|Tests|Assertion))/i.test(output);
  return [1, 2].includes(result.status) && assertionFailure && !infrastructureFailure;
}

function pilotPrompt(attempt, resolved) {
  const workflow = attempt.treatment === "repo-native"
    ? "Use only the repository's native workflow. Do not invoke, imitate, or create ACEF/BMAD artifacts."
    : `Use the installed ACEF ${attempt.workflowId} workflow with ${attempt.assuranceProfile} assurance exactly as configured in this clone.`;
  return [
    "Complete one controlled real-world pilot task in this disposable clone.",
    workflow,
    `Original user outcome: ${resolved.task.prompt}`,
    `Allowed production paths: ${(resolved.task.allowedPaths || []).join(", ")}`,
    `Focused verification: ${(resolved.task.verify || []).join(" ")}`,
    "Do not install dependencies, change benchmark/withheld tests, commit, push, use another task's transcript, or touch unrelated paths.",
    "Implement the smallest production change, run the focused verification, and stop. Do not declare product-done merely because a unit test is green.",
    "Final response: RESULT=PASS or RESULT=FAIL; changed paths; verification; unresolved risks.",
  ].join("\n");
}

function epicPilotPrompt(attempt, resolved) {
  const treatmentInstruction = attempt.treatment === "legacy"
    ? "Use the installed legacy ACEF full-bmad lane exactly as that version documents it. Apply the risk-specific safeguards its own full-BMAD contract requires for auth, billing, and webhook stories. Do not select or synthesize the separate legacy guarded lane, candidate execution/assurance axes, or a hybrid active state."
    : "Use ACEF Full (BMAD v2) with Guarded assurance exactly as the installed candidate version documents it. Guarded is an assurance overlay, not a second lifecycle.";
  const stories = resolved.task.stories.map((story, index) => [
    `${index + 1}. ${story.id}: ${story.prompt}`,
    `   Depends on: ${(story.dependsOn || []).join(", ") || "none"}`,
    `   Allowed paths: ${story.allowedPaths.join(", ")}`,
    `   Focused verification: ${story.verify.join(" ")}`,
  ].join("\n")).join("\n");
  const actorContract = lifecycleActorContract(resolved).map((entry) =>
    `- ${entry.taskName}: scope=${entry.scope} control=${entry.control} actor=${entry.taskName} persona=${entry.persona}`
  ).join("\n");
  const recoveryInstruction = attempt.treatment === "candidate"
    ? [
      "Initial ATDD is sufficient when it maps every acceptance criterion and produces one genuine red test on the critical vertical path. Criteria that are regression-only need not all be red before development; expand them before test-review. Do not reject a valid critical-path red merely because protected or frozen-scope tests do not cover every regression case.",
      "If an ATDD actor still returns REVISE, do not stop or retry it. Spawn exactly one fresh report-only <atdd-task-name>_adjudication1 actor whose first tuple is scope=<story> control=atdd-adjudication actor=<task-name> persona=test-reviewer and give it only the frozen story contract, ATDD report, protected-path rules, and REVISE findings. Persist that exact typed actor phase/role. It must end ACTOR_RESULT=PASS plus ATDD_ADJUDICATION=OVERRULE or ATDD_ADJUDICATION=UPHOLD.",
      "OVERRULE means the critical-path red is sufficient and development continues. UPHOLD permits exactly one fresh <atdd-task-name>_correction1 actor whose first tuple is scope=<story> control=atdd-correction actor=<task-name> persona=test-author. Before spawning it, persist and commit docs/ai/corrections/<correction-task-name>.json with schema=acef.atdd-correction.v1, sourceActorId=<atdd-task-name>, correctionActorId=<correction-task-name>, scope=test-artifacts-only, findingsSha256=<sha256 of the exact parent-delivered ATDD REVISE final answer>, and explicit allowedPaths limited to non-protected tests/test reports. Persist the exact typed actor phase/role. The correction may change only those paths, never production. Every exec_command must contain exactly one literal allowlisted read or focused-test command; use separate calls, with no shell separators, pipelines, substitutions, dynamic command variables, or dynamic apply_patch construction. A second incomplete ATDD result is REPLAN/SPLIT.",
      "If a story becomes REPLAN/SPLIT, quarantine it and every transitive dependent story, but continue every pending story with no dependency edge to the quarantined set and no shared safety invariant. The epic product gate still fails while any story is quarantined.",
    ].join(" ")
    : "Follow the installed legacy treatment's own ATDD and retry rules. Do not synthesize candidate adjudication, correction, quarantine, or lifecycle-budget semantics.";
  const closeoutInstruction = attempt.treatment === "candidate"
    ? "The mandatory closeout inventory is frozen to the listed contract rows before execution. Use focused verification during stories and run the provided integration verification once at final closeout unless that command itself fails once. Trace, statistics, coverage analysis, test quality, documentation, and closeout review are evidence views only: do not spawn actors, create mandatory work items, enlarge the denominator, or open another closeout chain for them."
    : "Use the installed legacy treatment's closeout workflow exactly. Additional legacy-required actors or evidence work are permitted and measured; do not apply the candidate's frozen-inventory/non-recursive policy to this arm.";
  return [
    "Complete one controlled multi-story epic in this disposable clone. The measured unit is the complete original user outcome, not an individual story.",
    treatmentInstruction,
    "Load and follow the repo-local ACEF skill. Act as conductor and use fresh independent actors/sessions for every role the installed workflow requires. Preserve actor separation; do not self-approve.",
    "For each contract row below, call spawn_agent exactly once using the exact task_name and fork_turns=none before accepting that phase. Give the fresh actor a bounded artifact-only message: put the listed scope/control/actor/persona tuple first, then only the exact files/commit/question it needs. Require its final line to be ACTOR_RESULT=PASS or ACTOR_RESULT=REVISE, wait for that actor's FINAL_ANSWER, and persist a typed actor record whose actorInstanceId exactly equals task_name. Do not combine rows in one actor.",
    recoveryInstruction,
    attempt.treatment === "candidate"
      ? "Development and test-review cannot be retried. Code-review, verify-patch, and story process-judge may each use at most one retry only after ACTOR_RESULT=REVISE; its exact task_name must be <base>_retry1 and it must finish ACTOR_RESULT=PASS. The epic Process Judge cannot retry. Never replay a full lifecycle vector."
      : "The exact named rows below remain the minimum independently observable lifecycle contract; legacy-required auxiliary work remains allowed and measured.",
    "Each story Process Judge must persist a typed PASS gate for that story. After the one final integration verification, the separate epic Process Judge must persist a typed PASS gate with scope=epic and must not be any story actor.",
    "Required independently observable actor contract:",
    actorContract,
    "If readiness requires splitting or replanning, record and perform it, but the outcome clock continues until the complete epic is product-done.",
    closeoutInstruction,
    "Before every write, reconcile the exact target against the active story's allowed paths and protected paths. A worker must refuse the write before mutation when it is outside scope; post-hoc cleanup does not cure a scope violation.",
    "Do not inspect experiment manifests, sibling worktrees, previous transcripts, or the other treatment. Do not push. Do not weaken or edit Benchmark* tests or phpunit.sqlite.xml.",
    "Frozen epic stories:",
    stories,
    `Final integration verification: ${resolved.task.integration.verify.join(" ")}`,
    "Final response must state RESULT=PASS or RESULT=FAIL, product outcome, story results, review rounds, broad-suite runs, unresolved Critical/High risks, and exact closeout status.",
  ].join("\n");
}

function sha256File(filePath) {
  return crypto.createHash("sha256").update(fs.readFileSync(filePath)).digest("hex");
}

function normalizedActorToken(value) {
  return String(value || "").toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");
}

function lifecycleActorContract(resolved) {
  const phases = [
    ["atdd", "test-author", false],
    ["development", "developer", false],
    ["code-review", "code-reviewer", true],
    ["verify-patch", "patch-verifier", true],
    ["test-review", "test-reviewer", false],
    ["process-judge", "process-judge", true],
  ];
  const storyEntries = resolved.task.stories.flatMap((story) => phases.map(([control, persona, retryable]) => ({
    scope: story.id,
    control,
    persona,
    retryable,
    taskName: `acef_${normalizedActorToken(story.id)}_${normalizedActorToken(control)}`,
  })));
  return [...storyEntries, {
    scope: "epic",
    control: "process-judge",
    persona: "process-judge",
    retryable: false,
    taskName: "acef_epic_process_judge",
  }];
}

function findCodexSessionTranscript(threadId, sessionRoot = path.join(process.env.CODEX_HOME || path.join(os.homedir(), ".codex"), "sessions")) {
  if (!threadId || !fs.existsSync(sessionRoot)) return null;
  const pending = [sessionRoot];
  while (pending.length) {
    const directory = pending.pop();
    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
      const fullPath = path.join(directory, entry.name);
      if (entry.isDirectory()) pending.push(fullPath);
      else if (entry.isFile() && entry.name.includes(threadId) && entry.name.endsWith(".jsonl")) return fullPath;
    }
  }
  return null;
}

function parseCollaborationEvidence(rawText, sessionText, expectedContract, expectedSession = {}) {
  let threadId = null;
  for (const line of String(rawText || "").split(/\r?\n/).filter(Boolean)) {
    try {
      const event = JSON.parse(line);
      if (event.type === "thread.started") threadId = event.thread_id || null;
    } catch {}
  }
  const calls = new Map();
  const started = new Map();
  const completedAuthors = new Map();
  let sessionMeta = null;
  for (const line of String(sessionText || "").split(/\r?\n/).filter(Boolean)) {
    let event;
    try { event = JSON.parse(line); } catch { continue; }
    const payload = event.payload || {};
    if (event.type === "session_meta") sessionMeta = payload;
    if (event.type === "response_item" && payload.type === "function_call"
      && payload.namespace === "collaboration" && payload.name === "spawn_agent") {
      let args = {};
      try { args = JSON.parse(payload.arguments || "{}"); } catch {}
      calls.set(payload.call_id, {
        taskName: args.task_name || "",
        forkTurns: args.fork_turns,
        message: args.message || "",
        callId: payload.call_id,
      });
    }
    if (event.type === "event_msg" && payload.type === "sub_agent_activity" && payload.kind === "started") {
      started.set(payload.event_id, payload.agent_thread_id || "");
    }
    if (event.type === "response_item" && payload.type === "agent_message" && payload.author) {
      const content = Array.isArray(payload.content)
        ? payload.content.map((entry) => entry.text || entry.output_text || "").join("\n")
        : String(payload.text || "");
      const list = completedAuthors.get(payload.author) || [];
      list.push(content);
      completedAuthors.set(payload.author, list);
    }
  }
  const dispatches = [...calls.values()].map((call) => ({
    ...call,
    receiverThreadId: started.get(call.callId) || "",
    parentFinalText: [...(completedAuthors.get(`/root/${call.taskName}`) || []), ...(completedAuthors.get(call.taskName) || [])]
      .find((content) => /Message Type:\s*FINAL_ANSWER/i.test(content) && new RegExp(`Sender:\\s*\\/root\\/${call.taskName}(?:\\s|$)`).test(content)) || "",
  }));
  const failures = [];
  if (!sessionMeta) failures.push("session metadata missing");
  else {
    if (sessionMeta.session_id !== threadId) failures.push("session id does not match stdout thread.started");
    if (expectedSession.cwd && fs.realpathSync(sessionMeta.cwd) !== fs.realpathSync(expectedSession.cwd)) failures.push("session cwd mismatch");
    if (expectedSession.clientVersion && sessionMeta.cli_version !== expectedSession.clientVersion) failures.push("session client version mismatch");
    if (expectedSession.startedAt && new Date(sessionMeta.timestamp) < new Date(new Date(expectedSession.startedAt).getTime() - 60000)) failures.push("session predates actor receipt");
    if (expectedSession.finishedAt && new Date(sessionMeta.timestamp) > new Date(new Date(expectedSession.finishedAt).getTime() + 60000)) failures.push("session postdates actor receipt");
  }
  const relevant = [];
  const acceptedActors = [];
  const observedContract = [];
  const correctionBindings = [];
  const knownTaskNames = new Set();
  const legacyPolicy = expectedSession.legacyPolicy === true;
  for (const expected of expectedContract) {
    const baseMatches = dispatches.filter((entry) => entry.taskName === expected.taskName);
    const retryMatches = dispatches.map((entry) => {
      const match = entry.taskName.match(new RegExp(`^${expected.taskName}_retry([1-9]\\d*)$`));
      return match ? { ...entry, retryOrdinal: Number(match[1]) } : null;
    }).filter(Boolean).sort((left, right) => left.retryOrdinal - right.retryOrdinal);
    knownTaskNames.add(expected.taskName);
    for (const retry of retryMatches) knownTaskNames.add(retry.taskName);
    if (baseMatches.length !== 1) failures.push(`${expected.taskName}: expected one base spawn, observed ${baseMatches.length}`);
    if (!legacyPolicy && retryMatches.length && !expected.retryable) failures.push(`${expected.taskName}: retries are not allowed for ${expected.control}`);
    if (!legacyPolicy && retryMatches.length > 1) failures.push(`${expected.taskName}: circuit breaker allows at most one retry`);
    if (!legacyPolicy && retryMatches.some((entry, index) => entry.retryOrdinal !== index + 1)) failures.push(`${expected.taskName}: retry ordinals must be contiguous from 1`);
    const attempts = [...baseMatches, ...retryMatches];
    relevant.push(...attempts);
    observedContract.push(...attempts.map((entry) => ({ ...expected, taskName: entry.taskName, retryOrdinal: entry.retryOrdinal || 0 })));
    for (const entry of attempts) {
      if (!entry.receiverThreadId) failures.push(`${entry.taskName}: missing receiver thread id`);
      if (entry.forkTurns !== "none") failures.push(`${entry.taskName}: fork_turns must be none`);
      if (!entry.parentFinalText) failures.push(`${entry.taskName}: missing parent-delivered FINAL_ANSWER`);
    }
    if (expected.control === "atdd" && baseMatches.length === 1 && legacyPolicy) {
      const accepted = attempts.at(-1);
      if (!/\bACTOR_RESULT=PASS\b/.test(accepted.parentFinalText)) {
        failures.push(`${accepted.taskName}: legacy ATDD result is not PASS`);
      }
      acceptedActors.push({ ...expected, taskName: accepted.taskName, receiverThreadId: accepted.receiverThreadId });
    } else if (expected.control === "atdd" && baseMatches.length === 1) {
      const base = baseMatches[0];
      const basePassed = /\bACTOR_RESULT=PASS\b/.test(base.parentFinalText);
      const baseRevised = /\bACTOR_RESULT=REVISE\b/.test(base.parentFinalText);
      const adjudicationTaskName = `${expected.taskName}_adjudication1`;
      const correctionTaskName = `${expected.taskName}_correction1`;
      const adjudications = dispatches.filter((entry) => entry.taskName === adjudicationTaskName);
      const corrections = dispatches.filter((entry) => entry.taskName === correctionTaskName);
      for (const entry of [...adjudications, ...corrections]) {
        knownTaskNames.add(entry.taskName);
        relevant.push(entry);
        if (!entry.receiverThreadId) failures.push(`${entry.taskName}: missing receiver thread id`);
        if (entry.forkTurns !== "none") failures.push(`${entry.taskName}: fork_turns must be none`);
        if (!entry.parentFinalText) failures.push(`${entry.taskName}: missing parent-delivered FINAL_ANSWER`);
      }
      if (basePassed) {
        if (adjudications.length || corrections.length) failures.push(`${expected.taskName}: PASS must not create ATDD correction work`);
        acceptedActors.push({ ...expected, taskName: base.taskName, receiverThreadId: base.receiverThreadId });
      } else if (baseRevised) {
        if (adjudications.length !== 1) failures.push(`${expected.taskName}: REVISE requires exactly one independent adjudication`);
        if (adjudications.length === 1) {
          const adjudication = adjudications[0];
          const disposition = adjudication.parentFinalText.match(/\bATDD_ADJUDICATION=(OVERRULE|UPHOLD)\b/)?.[1] || "";
          if (!/\bACTOR_RESULT=PASS\b/.test(adjudication.parentFinalText) || !disposition) {
            failures.push(`${adjudicationTaskName}: adjudication must PASS with ATDD_ADJUDICATION=OVERRULE or UPHOLD`);
          }
          observedContract.push({
            scope: expected.scope,
            control: "atdd-adjudication",
            persona: "test-reviewer",
            retryable: false,
            taskName: adjudicationTaskName,
          });
          if (disposition === "OVERRULE") {
            if (corrections.length) failures.push(`${expected.taskName}: overruled REVISE must not create a correction actor`);
            acceptedActors.push({ ...expected, taskName: adjudicationTaskName, receiverThreadId: adjudication.receiverThreadId });
          }
          if (disposition === "UPHOLD") {
            if (corrections.length !== 1) failures.push(`${expected.taskName}: upheld REVISE requires exactly one correction actor`);
            if (corrections.length === 1) {
              const correction = corrections[0];
              if (!/\bACTOR_RESULT=PASS\b/.test(correction.parentFinalText)) failures.push(`${correctionTaskName}: correction result is not PASS`);
              correctionBindings.push({
                taskName: correctionTaskName,
                sourceTaskName: expected.taskName,
                findingsSha256: sha256(base.parentFinalText),
              });
              observedContract.push({
                scope: expected.scope,
                control: "atdd-correction",
                persona: "test-author",
                retryable: false,
                taskName: correctionTaskName,
              });
              acceptedActors.push({ ...expected, taskName: correctionTaskName, receiverThreadId: correction.receiverThreadId });
            }
          }
        }
      } else {
        failures.push(`${expected.taskName}: ATDD result must be PASS or REVISE`);
      }
    } else if (attempts.length) {
      const accepted = attempts[attempts.length - 1];
      if (!legacyPolicy && !/\bACTOR_RESULT=PASS\b/.test(accepted.parentFinalText)) failures.push(`${accepted.taskName}: final actor result is not PASS`);
      if (legacyPolicy && !/\bACTOR_RESULT=PASS\b/.test(accepted.parentFinalText)) failures.push(`${accepted.taskName}: legacy actor result is not PASS`);
      for (const superseded of legacyPolicy ? [] : attempts.slice(0, -1)) {
        if (!/\bACTOR_RESULT=REVISE\b/.test(superseded.parentFinalText)) failures.push(`${superseded.taskName}: retry requires prior ACTOR_RESULT=REVISE`);
      }
      acceptedActors.push({ ...expected, taskName: accepted.taskName, receiverThreadId: accepted.receiverThreadId });
    }
  }
  const unexpected = dispatches.filter((entry) => !knownTaskNames.has(entry.taskName));
  if (unexpected.length && expectedSession.allowUnexpectedActors !== true) {
    failures.push(`unexpected lifecycle/closeout actors: ${unexpected.map((entry) => entry.taskName).join(", ")}`);
  }
  if (expectedSession.allowUnexpectedActors === true) {
    for (const entry of unexpected) {
      entry.auxiliary = true;
      if (!entry.receiverThreadId) failures.push(`${entry.taskName}: auxiliary actor receiver thread id missing`);
      if (entry.forkTurns !== "none") failures.push(`${entry.taskName}: auxiliary actor fork_turns must be none`);
      if (!entry.parentFinalText) failures.push(`${entry.taskName}: auxiliary actor parent-delivered FINAL_ANSWER missing`);
      if (/\bACTOR_RESULT=(?:REVISE|FAIL|BLOCKED|REPLAN)\b/.test(entry.parentFinalText)) {
        failures.push(`${entry.taskName}: auxiliary actor returned a terminal non-success result`);
      }
    }
  }
  const allDispatches = [...relevant, ...(expectedSession.allowUnexpectedActors === true ? unexpected : [])];
  const receiverIds = allDispatches.map((entry) => entry.receiverThreadId).filter(Boolean);
  if (new Set(receiverIds).size !== receiverIds.length) failures.push("lifecycle actors do not have distinct receiver thread ids");
  return {
    ok: failures.length === 0,
    threadId,
    expectedActorCount: expectedContract.length,
    observedActorCount: relevant.length,
    frozenMandatoryActorCount: expectedContract.length,
    unexpectedActorCount: unexpected.length,
    closeoutCreatedMandatoryChains: unexpected.filter((entry) => /closeout|coverage|trace|stat|quality/i.test(entry.taskName)).length,
    correctionBindings,
    dispatches: allDispatches,
    actorContract: observedContract,
    dispatchTraceContract: [...observedContract, ...unexpected.map((entry) => inferAuxiliaryDispatch(entry, expectedContract)).filter(Boolean)],
    acceptedActors,
    failures,
    sessionSha256: sha256(sessionText),
    sessionStartedAt: sessionMeta?.timestamp || null,
    sessionClientVersion: sessionMeta?.cli_version || null,
    sessionCwd: sessionMeta?.cwd || null,
  };
}

function inferAuxiliaryDispatch(dispatch, expectedContract) {
  const token = normalizedActorToken(dispatch.taskName);
  const controls = [
    ["verify-patch", /verify_patch/],
    ["test-review", /test_review/],
    ["code-review", /code_review|reviewer/],
    ["process-judge", /process_judge/],
    ["development", /development|dev_story|developer/],
    ["atdd", /atdd/],
  ];
  const control = controls.find(([, pattern]) => pattern.test(token))?.[0];
  if (!control) return null;
  const scopes = [...new Set(expectedContract.map((entry) => entry.scope))];
  const scope = scopes.find((entry) => token.includes(normalizedActorToken(entry))) || (/epic/.test(token) ? "epic" : null);
  if (!scope) return null;
  const retryOrdinal = Number(token.match(/retry_?(\d+)$/)?.[1] || 0);
  return {
    scope,
    control,
    persona: "legacy-auxiliary",
    retryable: retryOrdinal === 1,
    retryOrdinal,
    auxiliary: true,
    taskName: dispatch.taskName,
  };
}

function correctionSessionWrites(sessionText, repoRoot) {
  const paths = [];
  const unsafeShellMutations = [];
  const unsafeDelegations = [];
  for (const line of String(sessionText || "").split(/\r?\n/).filter(Boolean)) {
    let event;
    try { event = JSON.parse(line); } catch { continue; }
    const payload = event.payload || {};
    if (event.type !== "response_item" || !["function_call", "custom_tool_call"].includes(payload.type)) continue;
    const rawArguments = String(payload.arguments || payload.input || "");
    const normalizedArguments = rawArguments.replaceAll("\\n", "\n").replaceAll('\\"', '"');
    let args = {};
    try { args = JSON.parse(rawArguments || "{}"); } catch {}
    const name = String(payload.name || "");
    if (payload.namespace === "collaboration" && /spawn_agent/i.test(name)) {
      unsafeDelegations.push(name);
    }
    if (/apply_patch/i.test(name) || /tools\.apply_patch\s*\(/.test(rawArguments)) {
      const patchText = String(args.input || args.patch || normalizedArguments);
      let observedPatchPaths = 0;
      for (const match of patchText.matchAll(/^\*\*\* (?:Add|Update|Delete) File:\s+(.+?)\s*$/gm)) {
        paths.push(path.resolve(repoRoot, match[1]));
        observedPatchPaths += 1;
      }
      if (observedPatchPaths === 0) unsafeShellMutations.push(`unobservable apply_patch: ${rawArguments}`);
    }
    if (/write|edit|notebook/i.test(name)) {
      const target = args.file_path || args.filePath || args.path || args.notebook_path;
      if (target) paths.push(path.resolve(repoRoot, target));
    }
    if (/exec_command|shell|bash/i.test(name) || /tools\.exec_command\s*\(/.test(rawArguments)) {
      const commands = extractCorrectionShellCommands(args, rawArguments);
      if (!commands.length) unsafeShellMutations.push(rawArguments);
      for (const command of commands) {
        if (!isAllowedCorrectionShellCommand(command)) unsafeShellMutations.push(command);
      }
    }
  }
  return { paths: [...new Set(paths)], unsafeShellMutations, unsafeDelegations };
}

function extractCorrectionShellCommands(args, rawArguments) {
  if (typeof args.cmd === "string") return [args.cmd];
  if (typeof args.command === "string") return [args.command];
  const source = String(rawArguments || "");
  const callCount = [...source.matchAll(/tools\.exec_command\s*\(/g)].length;
  const commands = [];
  for (const match of source.matchAll(/tools\.exec_command\s*\(\s*\{\s*(?:cmd|command)\s*:\s*("(?:\\.|[^"\\])*")/g)) {
    try { commands.push(JSON.parse(match[1])); } catch { return []; }
  }
  return commands.length === callCount ? commands : [];
}

function isAllowedCorrectionShellCommand(command) {
  const normalized = String(command || "").trim();
  if (!normalized || /[\r\n;|&<>`]/.test(normalized) || /\$\(/.test(normalized)) return false;
  if (/\bgit\s+(?:diff|show)\b.*(?:--ext-diff|--textconv)\b/.test(normalized)) return false;
  if (/\brg\b.*(?:--pre|--pre-glob)\b/.test(normalized)) return false;
  return [
    /^git\s+status(?:\s+(?:--short|--branch|--porcelain(?:=v[12])?))*$/,
    /^git\s+(?:diff|show)(?:\s+[A-Za-z0-9_./:@=,+~-]+)*$/,
    /^rg(?:\s+--?[A-Za-z0-9][A-Za-z0-9-]*(?:=[A-Za-z0-9_./:@,+~-]+)?|\s+[^\s;|&<>`]+)+$/,
    /^sed\s+-n\s+['"]?\d+(?:,\d+)?p['"]?\s+[^\s;|&<>`]+$/,
    /^(?:cat|ls|wc|shasum|sha256sum)(?:\s+[^\s;|&<>`]+)+$/,
    /^php\s+artisan\s+test(?:\s+[^\s;|&<>`]+)*$/,
    /^vendor\/bin\/phpunit(?:\s+[^\s;|&<>`]+)*$/,
    /^(?:npm|pnpm|yarn)\s+test(?:\s+[^\s;|&<>`]+)*$/,
    /^npx\s+(?:vitest|playwright)\s+test(?:\s+[^\s;|&<>`]+)*$/,
    /^composer\s+test(?:\s+[^\s;|&<>`]+)*$/,
  ].some((pattern) => pattern.test(normalized));
}

function isCorrectionArtifactPath(filePath, repoRoot) {
  const relative = path.relative(repoRoot, filePath).replaceAll(path.sep, "/");
  if (!relative || relative.startsWith("../") || path.isAbsolute(relative)) return false;
  if (/^(?:tests?|spec)(?:\/|$)/i.test(relative) && !/(?:^|\/)Benchmark[^/]*Test\.(?:php|js|ts|tsx)$/i.test(relative)) return true;
  return /^_bmad-output\/test-artifacts\//.test(relative)
    || /^docs\/ai\/reports\//.test(relative);
}

function validateCorrectionBinding(repoRoot, binding) {
  const recordPath = path.join(repoRoot, "docs", "ai", "corrections", `${binding.taskName}.json`);
  if (!fs.existsSync(recordPath)) return [`${binding.taskName}: durable correction binding missing`];
  let record;
  try { record = JSON.parse(fs.readFileSync(recordPath, "utf8")); }
  catch { return [`${binding.taskName}: durable correction binding is invalid JSON`]; }
  const failures = [];
  if (record.schema !== "acef.atdd-correction.v1") failures.push(`${binding.taskName}: correction binding schema mismatch`);
  if (record.sourceActorId !== binding.sourceTaskName) failures.push(`${binding.taskName}: correction source actor mismatch`);
  if (record.correctionActorId !== binding.taskName) failures.push(`${binding.taskName}: correction actor mismatch`);
  if (record.scope !== "test-artifacts-only") failures.push(`${binding.taskName}: correction scope is not test-artifacts-only`);
  if (record.findingsSha256 !== binding.findingsSha256) failures.push(`${binding.taskName}: correction findings hash mismatch`);
  if (!Array.isArray(record.allowedPaths) || !record.allowedPaths.length) failures.push(`${binding.taskName}: correction allowedPaths missing`);
  else {
    for (const entry of record.allowedPaths) {
      if (typeof entry !== "string" || /[*?\[\]{}]/.test(entry) || path.isAbsolute(entry) || entry.split(/[\\/]/).includes("..")
        || !isCorrectionArtifactPath(path.resolve(repoRoot, entry), repoRoot)) {
        failures.push(`${binding.taskName}: invalid correction allowedPath ${String(entry)}`);
      }
    }
  }
  return failures;
}

function loadCollaborationEvidence(rawPath, expectedContract, expectedSession = {}) {
  const rawText = fs.readFileSync(rawPath, "utf8");
  let threadId = null;
  for (const line of rawText.split(/\r?\n/).filter(Boolean)) {
    try { const event = JSON.parse(line); if (event.type === "thread.started") threadId = event.thread_id; } catch {}
  }
  const sessionPath = findCodexSessionTranscript(threadId);
  if (!sessionPath) return { ok: false, threadId, sessionPath: null, failures: ["Codex session transcript not found"] };
  const evidence = parseCollaborationEvidence(rawText, fs.readFileSync(sessionPath, "utf8"), expectedContract, expectedSession);
  const failures = [...evidence.failures];
  const dispatchTraceContract = [...(evidence.dispatchTraceContract || evidence.actorContract || [])];
  let typedAuxiliaryCloseoutChains = 0;
  const auxiliaryDispatches = (evidence.dispatches || []).filter((entry) => entry.auxiliary);
  if (auxiliaryDispatches.length) {
    try {
      const parser = installedStateParser(expectedSession.cwd);
      const actorDir = path.join(expectedSession.cwd, "docs", "ai", "actors");
      const actors = new Map();
      if (fs.existsSync(actorDir)) for (const entry of fs.readdirSync(actorDir).filter((name) => name.endsWith(".json"))) {
        const actor = parser.parseActorRecord(path.join(actorDir, entry));
        actors.set(actor.actorInstanceId, actor);
      }
      const phaseMap = {
        atdd: "atdd",
        development: "development",
        codereview: "code-review",
        verifypatch: "verify-patch",
        testreview: "test-review",
        processjudge: "process-judge",
      };
      for (const dispatch of auxiliaryDispatches) {
        const actor = actors.get(dispatch.taskName);
        if (!actor) {
          failures.push(`${dispatch.taskName}: auxiliary typed actor record missing`);
          continue;
        }
        const control = phaseMap[canonicalLifecyclePhase(actor.phase || actor.role)];
        if (control) {
          const inferredIndex = dispatchTraceContract.findIndex((entry) => entry.auxiliary && entry.taskName === dispatch.taskName);
          const typed = {
            scope: actor.story,
            control,
            persona: actor.role,
            retryable: false,
            retryOrdinal: 0,
            auxiliary: true,
            taskName: dispatch.taskName,
          };
          if (inferredIndex >= 0) dispatchTraceContract[inferredIndex] = typed;
          else dispatchTraceContract.push(typed);
        }
        if (/closeout|coverage|trace|stat|quality/i.test(`${actor.phase} ${actor.role}`)) typedAuxiliaryCloseoutChains += 1;
      }
    } catch (error) {
      failures.push(`auxiliary typed actor reconciliation failed: ${error.message}`);
    }
  }
  for (const binding of evidence.correctionBindings || []) failures.push(...validateCorrectionBinding(expectedSession.cwd, binding));
  const childSessions = [];
  for (const dispatch of evidence.dispatches || []) {
    const childPath = findCodexSessionTranscript(dispatch.receiverThreadId);
    if (!childPath) { failures.push(`${dispatch.taskName}: child session transcript missing`); continue; }
    const childText = fs.readFileSync(childPath, "utf8");
    let meta = null;
    let completion = null;
    for (const line of childText.split(/\r?\n/).filter(Boolean)) {
      try {
        const event = JSON.parse(line);
        if (event.type === "session_meta") meta = event.payload || null;
        if (event.type === "event_msg" && event.payload?.type === "task_complete") completion = event.payload;
      } catch {}
    }
    if (!meta || meta.id !== dispatch.receiverThreadId || meta.parent_thread_id !== threadId
      || meta.agent_path !== `/root/${dispatch.taskName}`
      || meta.source?.subagent?.thread_spawn?.parent_thread_id !== threadId) {
      failures.push(`${dispatch.taskName}: child session provenance mismatch`);
    }
    if (!completion) failures.push(`${dispatch.taskName}: child task_complete missing`);
    else {
      const parentResult = dispatch.parentFinalText.match(/\bACTOR_RESULT=(PASS|REVISE|FAIL|BLOCKED|REPLAN)\b/)?.[1] || "";
      const childResult = String(completion.last_agent_message || "").match(/\bACTOR_RESULT=(PASS|REVISE|FAIL|BLOCKED|REPLAN)\b/)?.[1] || "";
      if (dispatch.auxiliary && !parentResult && !childResult) {
        if (!dispatch.parentFinalText.includes(String(completion.last_agent_message || ""))) failures.push(`${dispatch.taskName}: auxiliary child/parent final answer mismatch`);
      } else if (!childResult || childResult !== parentResult) failures.push(`${dispatch.taskName}: child/parent actor result mismatch`);
    }
    if (/_atdd_(?:correction|adjudication)1$/.test(dispatch.taskName)) {
      const writes = correctionSessionWrites(childText, expectedSession.cwd);
      const adjudication = /_atdd_adjudication1$/.test(dispatch.taskName);
      let allowedCorrectionPaths = null;
      if (!adjudication) {
        try {
          const bindingPath = path.join(expectedSession.cwd, "docs", "ai", "corrections", `${dispatch.taskName}.json`);
          const binding = JSON.parse(fs.readFileSync(bindingPath, "utf8"));
          allowedCorrectionPaths = new Set((binding.allowedPaths || []).map((entry) => path.resolve(expectedSession.cwd, entry)));
          const spawnCommit = meta?.git?.commit_hash || "";
          const bindingRelative = path.relative(expectedSession.cwd, bindingPath).replaceAll(path.sep, "/");
          const committedBinding = spawnCommit
            ? execute("git", ["show", `${spawnCommit}:${bindingRelative}`], expectedSession.cwd)
            : { status: 1, stdout: "" };
          if (committedBinding.status !== 0 || sha256(committedBinding.stdout) !== sha256(fs.readFileSync(bindingPath, "utf8"))) {
            failures.push(`${dispatch.taskName}: correction binding was not committed unchanged before spawn`);
          }
        } catch {}
      }
      const forbidden = writes.paths.filter((entry) => adjudication
        ? !/^docs\/ai\/reports\//.test(path.relative(expectedSession.cwd, entry).replaceAll(path.sep, "/"))
        : !isCorrectionArtifactPath(entry, expectedSession.cwd) || !allowedCorrectionPaths?.has(entry));
      if (forbidden.length) failures.push(`${dispatch.taskName}: bounded ATDD actor wrote outside its allowed artifacts: ${forbidden.map((entry) => path.relative(expectedSession.cwd, entry)).join(", ")}`);
      if (writes.unsafeShellMutations.length) failures.push(`${dispatch.taskName}: bounded ATDD actor used an unscoped shell mutation`);
      if (writes.unsafeDelegations.length) failures.push(`${dispatch.taskName}: bounded ATDD actor delegated work`);
    }
    childSessions.push({
      taskName: dispatch.taskName,
      threadId: dispatch.receiverThreadId,
      sessionSha256: sha256(childText),
      completedAt: completion?.completed_at || null,
    });
  }
  return {
    ...evidence,
    ok: failures.length === 0,
    failures,
    sessionPath,
    childSessions,
    dispatchTraceContract,
    closeoutCreatedMandatoryChains: Math.max(evidence.closeoutCreatedMandatoryChains || 0, typedAuxiliaryCloseoutChains),
  };
}

function canonicalLifecyclePhase(value) {
  const token = normalizedActorToken(value).replace(/_/g, "");
  const aliases = { codereviewer: "codereview", reviewer: "codereview", patchverifier: "verifypatch", testreviewer: "testreview", judge: "processjudge", epicprocessjudge: "processjudge" };
  return aliases[token] || token;
}

function installedStateParser(clone) {
  const parserPath = path.join(clone, ".acef", "bin", "lib", "acef-state-parser.js");
  if (!fs.existsSync(parserPath)) throw new Error(`installed treatment state parser missing: ${parserPath}`);
  return require(parserPath);
}

function validateDurableLifecycleEvidence(clone, expectedContract, acceptedActors = expectedContract) {
  const failures = [];
  let parser;
  try { parser = installedStateParser(clone); }
  catch (error) { return { ok: false, actorCount: 0, gateCount: 0, failures: [error.message] }; }
  const actorDir = path.join(clone, "docs", "ai", "actors");
  const gateDir = path.join(clone, "docs", "ai", "gates");
  const actors = new Map();
  if (fs.existsSync(actorDir)) for (const entry of fs.readdirSync(actorDir).filter((name) => name.endsWith(".json"))) {
    try {
      const actor = parser.parseActorRecord(path.join(actorDir, entry));
      if (actors.has(actor.actorInstanceId)) failures.push(`${entry}: duplicate actorInstanceId ${actor.actorInstanceId}`);
      actors.set(actor.actorInstanceId, actor);
    }
    catch (error) { failures.push(`${entry}: ${error.message}`); }
  }
  const gates = [];
  if (fs.existsSync(gateDir)) for (const entry of fs.readdirSync(gateDir).filter((name) => name.endsWith(".json"))) {
    try { gates.push(parser.parseGateVerdict(path.join(gateDir, entry))); }
    catch (error) { failures.push(`${entry}: ${error.message}`); }
  }
  for (const expected of expectedContract) {
    const actor = actors.get(expected.taskName);
    if (!actor) { failures.push(`${expected.taskName}: typed actor record missing`); continue; }
    if (normalizedActorToken(actor.story) !== normalizedActorToken(expected.scope)) failures.push(`${expected.taskName}: actor scope mismatch`);
    if (canonicalLifecyclePhase(actor.phase) !== canonicalLifecyclePhase(expected.control)) failures.push(`${expected.taskName}: actor phase mismatch`);
    if (canonicalLifecyclePhase(actor.role) !== canonicalLifecyclePhase(expected.persona)) failures.push(`${expected.taskName}: actor persona mismatch`);
    const ancestor = execute("git", ["merge-base", "--is-ancestor", actor.inputCommit, "HEAD"], clone);
    if (ancestor.status !== 0) failures.push(`${expected.taskName}: inputCommit is not an ancestor of HEAD`);
  }
  const scopes = [...new Set(expectedContract.map((entry) => entry.scope))];
  for (const scope of scopes) {
    const judge = acceptedActors.find((entry) => entry.scope === scope && entry.control === "process-judge");
    const gate = gates.find((entry) => entry.verdict === "PASS"
      && normalizedActorToken(entry.scope) === normalizedActorToken(scope)
      && entry.decidedBy === judge?.taskName);
    if (!gate) { failures.push(`${scope}: typed PASS gate from required Process Judge missing`); continue; }
    if (!Array.isArray(gate.evidenceIds) || !gate.evidenceIds.length) failures.push(`${scope}: PASS gate has no evidenceIds`);
    if (execute("git", ["merge-base", "--is-ancestor", gate.repositoryCommit, "HEAD"], clone).status !== 0) {
      failures.push(`${scope}: gate repositoryCommit is not an ancestor of HEAD`);
    }
    for (const evidenceId of gate.evidenceIds || []) {
      const evidencePath = path.join(clone, "docs", "ai", "evidence", `${evidenceId}.json`);
      try {
        const evidence = parser.parseEvidenceManifest(evidencePath);
        if (evidence.evidenceId !== evidenceId) failures.push(`${scope}: evidence filename/id mismatch for ${evidenceId}`);
        if (evidence.exitCode !== 0) failures.push(`${scope}: evidence ${evidenceId} failed`);
        if (normalizedActorToken(evidence.story) !== normalizedActorToken(scope)) failures.push(`${scope}: evidence ${evidenceId} scope mismatch`);
        if (!actors.has(evidence.actorInstanceId)) failures.push(`${scope}: evidence ${evidenceId} actor is missing`);
        else if (normalizedActorToken(actors.get(evidence.actorInstanceId).story) !== normalizedActorToken(scope)) failures.push(`${scope}: evidence ${evidenceId} actor scope mismatch`);
        if (execute("git", ["merge-base", "--is-ancestor", evidence.repositoryCommit, "HEAD"], clone).status !== 0) failures.push(`${scope}: evidence ${evidenceId} repositoryCommit is not an ancestor of HEAD`);
        const rawArtifact = path.resolve(clone, evidence.rawArtifact.path);
        const relative = path.relative(clone, rawArtifact);
        if (!relative || relative.startsWith("..") || path.isAbsolute(relative)) failures.push(`${scope}: evidence ${evidenceId} artifact escapes clone`);
        else if (!fs.existsSync(rawArtifact)) failures.push(`${scope}: evidence ${evidenceId} artifact missing`);
        else if (path.relative(fs.realpathSync(clone), fs.realpathSync(rawArtifact)).startsWith("..") || sha256File(rawArtifact) !== evidence.rawArtifact.sha256) failures.push(`${scope}: evidence ${evidenceId} artifact/hash mismatch`);
      } catch (error) { failures.push(`${scope}: evidence ${evidenceId}: ${error.message}`); }
    }
  }
  return { ok: failures.length === 0, actorCount: actors.size, gateCount: gates.length, failures };
}

function runnerSourceSha256() {
  const sourcePaths = [
    "scripts/acef-execution-assurance-experiment",
    "scripts/acef-execution-assurance-actor",
    "scripts/lib/acef-execution-assurance-experiment.js",
    "scripts/lib/acef-state-parser.js",
    "scripts/lib/acef-execution-policy.js",
    "scripts/lib/acef-empirical.js",
    "scripts/acef-empirical-validation",
  ];
  return sha256(sourcePaths.map((entry) => `${entry}\0${fs.readFileSync(path.join(root, entry), "utf8")}\0`).join(""));
}

function runCollaborationCanary(manifest) {
  const runtime = resolvePinnedClient(manifest.pilotRuntime);
  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "acef-pilot-collaboration-canary-"));
  const taskName = "acef_pilot_canary";
  try {
    must("git", ["init", "-q"], directory);
    must("git", ["config", "user.email", "acef-canary@example.invalid"], directory);
    must("git", ["config", "user.name", "ACEF Canary"], directory);
    fs.writeFileSync(path.join(directory, "README.md"), "ACEF collaboration canary\n");
    must("git", ["add", "README.md"], directory);
    must("git", ["commit", "-qm", "canary"], directory);
    const prompt = `Call collaboration.spawn_agent exactly once with task_name=${taskName}, fork_turns=none, and ask it to reply exactly ACTOR_RESULT=PASS. Then call wait_agent until that exact child returns a final answer. Reply RESULT=PASS only after the real child result; otherwise RESULT=FAIL.`;
    const result = execute(runtime.clientPath, [
      "exec", "--json", "--ignore-user-config",
      "--dangerously-bypass-approvals-and-sandbox", "--dangerously-bypass-hook-trust",
      "--model", manifest.pilotRuntime.model,
      "--config", `model_reasoning_effort=${JSON.stringify(manifest.pilotRuntime.reasoningEffort)}`,
      "-C", directory,
      prompt,
    ], directory, { timeout: 180000 });
    let threadId = null;
    for (const line of result.stdout.split(/\r?\n/).filter(Boolean)) {
      try { const event = JSON.parse(line); if (event.type === "thread.started") threadId = event.thread_id; } catch {}
    }
    const expected = [{ scope: "canary", control: "spawn", persona: "probe", retryable: false, taskName }];
    const rawPath = path.join(directory, "canary-raw.jsonl");
    fs.writeFileSync(rawPath, result.stdout);
    const evidence = threadId
      ? loadCollaborationEvidence(rawPath, expected, {
        cwd: directory,
        clientVersion: runtime.observedClientVersion.replace(/^codex-cli\s+/, ""),
      })
      : { ok: false, threadId, failures: ["canary session transcript not found"], dispatches: [] };
    const ok = result.status === 0 && evidence.ok;
    return {
      ok,
      checkedAt: new Date().toISOString(),
      clientPath: runtime.clientPath,
      clientBinarySha256: runtime.clientBinarySha256,
      clientVersion: runtime.observedClientVersion,
      model: manifest.pilotRuntime.model,
      reasoningEffort: manifest.pilotRuntime.reasoningEffort,
      threadId,
      exitCode: result.status,
      expectedActorCount: evidence.expectedActorCount || 1,
      observedActorCount: evidence.observedActorCount || 0,
      receiverThreadIds: (evidence.dispatches || []).map((entry) => entry.receiverThreadId).filter(Boolean),
      sessionSha256: evidence.sessionSha256 || null,
      failures: [...(evidence.failures || []), ...(result.status === 0 ? [] : [`client exited ${result.status}`])],
    };
  } finally {
    fs.rmSync(directory, { recursive: true, force: true });
  }
}

function resolvePinnedClient(runtime) {
  const discovered = path.isAbsolute(runtime.client)
    ? runtime.client
    : must("which", [runtime.client], root);
  const clientPath = fs.realpathSync(discovered);
  const observedClientVersion = must(clientPath, ["--version"], root);
  if (observedClientVersion !== runtime.clientVersion) {
    throw new Error(`pilot client version mismatch: observed ${observedClientVersion}, expected ${runtime.clientVersion}`);
  }
  return {
    clientPath,
    clientBinarySha256: sha256File(clientPath),
    observedClientVersion,
  };
}

function pilotAgentRequest(attempt, resolved, clone, manifest, rawPath, receiptPath, clientRuntime) {
  const runtime = manifest.pilotRuntime;
  const args = [
    "exec", "--json", "--ignore-user-config",
    "--dangerously-bypass-approvals-and-sandbox", "--dangerously-bypass-hook-trust",
    "--model", runtime.model,
    "--config", `model_reasoning_effort=${JSON.stringify(runtime.reasoningEffort)}`,
    "-C", clone,
  ];
  if (attempt.treatment === "repo-native") args.push("--ignore-rules");
  args.push(resolved.kind === "epic" ? epicPilotPrompt(attempt, resolved) : pilotPrompt(attempt, resolved));
  return {
    command: clientRuntime.clientPath,
    args,
    cwd: clone,
    stdoutPath: rawPath,
    stderrPath: `${rawPath}.stderr`,
    receiptPath,
    timeoutMs: attempt.activeTimeCapMinutes * 60 * 1000,
  };
}

function launchPilotAgent(requestPath, cwd) {
  const actorScript = path.join(root, "scripts", "acef-execution-assurance-actor");
  const child = cp.spawn(process.execPath, [actorScript, requestPath], {
    cwd,
    detached: true,
    stdio: "ignore",
  });
  child.unref();
  return child.pid;
}

function waitForFile(filePath, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  const signal = new Int32Array(new SharedArrayBuffer(4));
  while (Date.now() < deadline) {
    if (fs.existsSync(filePath)) return true;
    Atomics.wait(signal, 0, 0, 1000);
  }
  return fs.existsSync(filePath);
}

function processAlive(pid) {
  if (!Number.isInteger(pid)) return false;
  try { process.kill(pid, 0); return true; } catch { return false; }
}

function processGroupAlive(pid) {
  if (!Number.isInteger(pid)) return false;
  try { process.kill(-pid, 0); return true; } catch { return false; }
}

function waitForReceiptOrExit(receiptPath, supervisorPid, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  const signal = new Int32Array(new SharedArrayBuffer(4));
  while (Date.now() < deadline) {
    if (fs.existsSync(receiptPath)) return "receipt";
    if (!processAlive(supervisorPid)) return "exited";
    Atomics.wait(signal, 0, 0, 1000);
  }
  return fs.existsSync(receiptPath) ? "receipt" : "timeout";
}

function ensureActorRequestLocked(checkpoint, config, graceChecked = false) {
  if (fs.existsSync(config.receiptPath)) {
    const receipt = JSON.parse(fs.readFileSync(config.receiptPath, "utf8"));
    if (receipt.requestSha256 !== config.requestSha256 || receipt.launchNonce !== config.launchNonce) {
      throw new Error(`${checkpoint.attemptRunId} ${config.label} receipt binding mismatch`);
    }
    return checkpoint;
  }
  if (fs.existsSync(config.startPath)) {
    const started = JSON.parse(fs.readFileSync(config.startPath, "utf8"));
    if (started.requestSha256 !== config.requestSha256 || started.launchNonce !== config.launchNonce) {
      throw new Error(`${checkpoint.attemptRunId} ${config.label} start binding mismatch`);
    }
    if (processAlive(started.supervisorPid)) {
      const waitResult = waitForReceiptOrExit(config.receiptPath, started.supervisorPid, config.timeoutMs + 60000);
      if (waitResult === "receipt") return ensureActorRequestLocked(checkpoint, config, true);
      if (waitResult === "timeout") {
        throw new Error(`${checkpoint.attemptRunId} ${config.label} is still running or has no receipt`);
      }
    }
    if (processGroupAlive(started.processGroupPid)) {
      try { process.kill(-started.processGroupPid, "SIGKILL"); } catch (error) {
        if (error.code !== "ESRCH") throw error;
      }
      const signal = new Int32Array(new SharedArrayBuffer(4));
      for (let index = 0; index < 40 && processGroupAlive(started.processGroupPid); index += 1) Atomics.wait(signal, 0, 0, 50);
      if (processGroupAlive(started.processGroupPid)) throw new Error(`${checkpoint.attemptRunId} orphaned ${config.label} group did not quiesce`);
    }
    if (!config.relaunchAfterStartedExit) {
      throw new Error(`${checkpoint.attemptRunId} ${config.label} started but exited without a receipt; side effects are indeterminate and the attempt must be adjudicated, not replayed`);
    }
    fs.renameSync(config.startPath, `${config.startPath}.orphaned-${Date.now()}`);
  } else if (!graceChecked) {
    waitForFile(config.startPath, 2000);
    return ensureActorRequestLocked(checkpoint, config, true);
  }
  const supervisorPid = launchPilotAgent(config.requestPath, checkpoint.clone);
  const launched = { ...checkpoint, status: config.status, [config.pidField]: supervisorPid };
  writeJsonAtomic(checkpoint.checkpointPath, launched);
  if (!waitForFile(config.receiptPath, config.timeoutMs + 60000)) {
    throw new Error(`${checkpoint.attemptRunId} ${config.label} has no receipt; retry later`);
  }
  return ensureActorRequestLocked(launched, config, true);
}

function ensureActorRequest(checkpoint, config, graceChecked = false) {
  if (fs.existsSync(config.receiptPath)) return ensureActorRequestLocked(checkpoint, config, graceChecked);
  const pilotWorkspace = path.dirname(path.dirname(checkpoint.checkpointPath));
  const claim = acquireFinalizationClaim(
    checkpoint.checkpointPath,
    `${checkpoint.attemptRunId}-${config.label}-launch`,
    path.join(pilotWorkspace, "launch-locks"),
  );
  try {
    return ensureActorRequestLocked(checkpoint, config, graceChecked);
  } finally {
    claim.release();
  }
}

function changedPaths(repo, baseRef) {
  const diff = must("git", ["diff", "--name-only", `${baseRef}..HEAD`], repo).split(/\r?\n/).filter(Boolean);
  const status = execute("git", ["status", "--porcelain=v1", "--untracked-files=all"], repo);
  if (status.status !== 0) throw new Error(`git status failed: ${status.stderr || status.stdout}`);
  const working = status.stdout.split(/\r?\n/).filter(Boolean).map((line) => line.slice(3));
  return [...new Set([...diff, ...working])].sort();
}

function findPilotAttempt(manifest, attemptId) {
  const attempt = buildPilotPlan(manifest).find((entry) => entry.id === attemptId);
  if (!attempt) throw new Error(`pilot attempt not preregistered: ${attemptId}`);
  return attempt;
}

function pilotCheckpointPath(opts, attemptRunId) {
  return path.join(opts.pilotWorkspace, "checkpoints", `${attemptRunId}.json`);
}

function resolvedTaskSha256(resolved) {
  const setup = resolved.kind === "epic"
    ? resolved.task.stories.flatMap((story) => story.setup || [])
    : (resolved.task.setup || []);
  const fixtureHashes = setup.filter((operation) => operation.type === "copy-fixture").map((operation) => ({
    fixture: operation.fixture,
    sha256: sha256(fs.readFileSync(path.join(resolved.fixtureRoot, operation.fixture))),
  }));
  return sha256(JSON.stringify({
    taskId: resolved.taskId,
    selector: resolved.selector,
    kind: resolved.kind,
    sourceManifestPath: resolved.sourceManifestPath,
    fixtureRoot: resolved.fixtureRoot,
    repo: resolved.repo,
    stack: resolved.stack,
    source: resolved.source,
    commit: resolved.commit,
    setupDirs: resolved.setupDirs,
    setupFiles: resolved.setupFiles,
    sourceManifestSha256: sha256(fs.readFileSync(resolved.sourceManifestPath)),
    fixtureHashes,
    task: resolved.task,
  }));
}

function catalogTaskBindings(manifest, manifestPath) {
  return Object.keys(manifest.taskCatalog || {}).sort().map((taskId) => {
    const resolved = resolveCatalogTask(manifest, manifestPath, taskId);
    return { taskId, resolvedTaskSha256: resolvedTaskSha256(resolved) };
  });
}

function reconcileFinalizedCheckpoint(checkpoint, row) {
  writeJsonAtomic(checkpoint.checkpointPath, {
    ...checkpoint,
    status: "finalized",
    finalizedAt: row.finishedAt,
    result: row.result,
    reconciledFromResult: true,
  });
}

function validateCheckpointInputs(opts, checkpoint, resolved, receipt, manifest) {
  const clientRuntime = resolvePinnedClient(manifest.pilotRuntime);
  const checks = [
    [path.resolve(opts.manifest) === checkpoint.manifestPath, "manifest path drift"],
    [sha256(fs.readFileSync(opts.manifest, "utf8")) === checkpoint.manifestSha256, "manifest content drift"],
    [resolvedTaskSha256(resolved) === checkpoint.resolvedTaskSha256, "resolved task/oracle drift"],
    [path.resolve(opts.pilotResults) === checkpoint.pilotResultsPath, "pilot results destination drift"],
    [must("git", ["rev-parse", "HEAD"], root) === checkpoint.runnerCommit, "runner commit drift"],
    [sha256(must("git", ["status", "--porcelain"], root)) === checkpoint.runnerWorktreeSha256, "runner worktree drift"],
    [sha256(fs.readFileSync(checkpoint.requestPath, "utf8")) === checkpoint.requestSha256, "actor request drift"],
    [receipt.requestPath === checkpoint.requestPath, "receipt request path mismatch"],
    [receipt.requestSha256 === checkpoint.requestSha256, "receipt request hash mismatch"],
    [receipt.launchNonce === checkpoint.actorLaunchNonce, "receipt launch nonce mismatch"],
    [clientRuntime.clientPath === checkpoint.clientPath, "pilot client path drift"],
    [clientRuntime.clientBinarySha256 === checkpoint.clientBinarySha256, "pilot client binary drift"],
    [clientRuntime.observedClientVersion === checkpoint.observedClientVersion, "pilot client version drift"],
  ];
  const failed = checks.filter(([ok]) => !ok).map(([, message]) => message);
  if (failed.length) throw new Error(`${checkpoint.attemptRunId} checkpoint input validation failed: ${failed.join("; ")}`);
}

function evaluateTreatmentState(clone, attempt) {
  if (attempt.treatment === "repo-native") return { ok: true, expected: "repo-native", observed: null, failures: [] };
  const activeRunPath = path.join(clone, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  if (!fs.existsSync(activeRunPath)) {
    return { ok: false, expected: attempt.treatment, observed: null, failures: ["missing ACEF_ACTIVE_RUN.json"] };
  }
  let observed;
  const failures = [];
  try {
    observed = JSON.parse(fs.readFileSync(activeRunPath, "utf8"));
    installedStateParser(clone).parseActiveRun(activeRunPath);
  } catch (error) {
    return { ok: false, expected: attempt.treatment, observed: null, failures: [`invalid typed active run: ${error.message}`] };
  }
  if (attempt.treatment === "legacy") {
    if (observed.lane !== "full-bmad") failures.push(`legacy lane is ${observed.lane || "missing"}, expected full-bmad`);
    if (observed.workflowId || observed.assuranceProfile) failures.push("legacy state invented candidate execution/assurance axes");
  } else {
    if (observed.workflowId !== attempt.workflowId) failures.push(`candidate workflowId is ${observed.workflowId || "missing"}`);
    if (observed.assuranceProfile !== attempt.assuranceProfile) failures.push(`candidate assuranceProfile is ${observed.assuranceProfile || "missing"}`);
  }
  if (observed.status !== "complete") failures.push(`active run status is ${observed.status || "missing"}, expected complete`);
  return {
    ok: failures.length === 0,
    expected: attempt.treatment === "legacy" ? { lane: "full-bmad" }
      : { workflowId: attempt.workflowId, assuranceProfile: attempt.assuranceProfile },
    observed,
    observedSha256: sha256(JSON.stringify(observed)),
    failures,
  };
}

function latestPilotCheckpoint(opts, attemptId) {
  const directory = path.join(opts.pilotWorkspace, "checkpoints");
  if (!fs.existsSync(directory)) throw new Error(`no durable checkpoint exists for ${attemptId}`);
  const checkpoints = fs.readdirSync(directory).filter((entry) => entry.endsWith(".json"))
    .map((entry) => JSON.parse(fs.readFileSync(path.join(directory, entry), "utf8")))
    .filter((entry) => entry.attemptId === attemptId)
    .sort((left, right) => Number(right.attemptOrdinal) - Number(left.attemptOrdinal));
  if (!checkpoints.length) throw new Error(`no durable checkpoint exists for ${attemptId}`);
  return checkpoints[0];
}

function ensureVerification(checkpoint, verificationContract) {
  const verificationCommandSha256 = sha256(JSON.stringify(verificationContract.verify));
  if (checkpoint.verificationCommandSha256 && checkpoint.verificationCommandSha256 !== verificationCommandSha256) {
    throw new Error(`${checkpoint.attemptRunId} verification command drift`);
  }
  if (checkpoint.verificationReceiptPath && fs.existsSync(checkpoint.verificationReceiptPath)) {
    const receipt = JSON.parse(fs.readFileSync(checkpoint.verificationReceiptPath, "utf8"));
    if (receipt.requestSha256 !== checkpoint.verificationRequestSha256
      || receipt.launchNonce !== checkpoint.verificationLaunchNonce) {
      throw new Error(`${checkpoint.attemptRunId} verification receipt hash mismatch`);
    }
    return { checkpoint, verification: { status: receipt.status, signal: receipt.signal } };
  }
  if (checkpoint.verificationStarted) {
    const resumed = ensureActorRequest(checkpoint, {
      label: "verification",
      requestPath: checkpoint.verificationRequestPath,
      receiptPath: checkpoint.verificationReceiptPath,
      startPath: checkpoint.verificationStartPath,
      requestSha256: checkpoint.verificationRequestSha256,
      launchNonce: checkpoint.verificationLaunchNonce,
      timeoutMs: checkpoint.verificationTimeoutMs,
      status: "verifying",
      pidField: "verificationPid",
      relaunchAfterStartedExit: true,
    });
    return ensureVerification(resumed, verificationContract);
  }
  const pilotWorkspace = path.dirname(path.dirname(checkpoint.checkpointPath));
  const base = path.join(pilotWorkspace, "verification", checkpoint.attemptRunId);
  const requestPath = `${base}.request.json`;
  const receiptPath = `${base}.receipt.json`;
  const request = {
    command: verificationContract.verify[0],
    args: verificationContract.verify.slice(1),
    cwd: checkpoint.clone,
    stdoutPath: `${base}.stdout`,
    stderrPath: `${base}.stderr`,
    receiptPath,
    startPath: `${base}.started.json`,
    launchNonce: `${checkpoint.attemptRunId}:verification:v1`,
    timeoutMs: 1200000,
  };
  writeJsonAtomic(requestPath, request);
  let verifyingCheckpoint = {
    ...checkpoint,
    status: "verifying",
    verificationStarted: true,
    verificationTimeoutMs: request.timeoutMs,
    verificationCommandSha256,
    verificationRequestPath: requestPath,
    verificationRequestSha256: sha256(fs.readFileSync(requestPath, "utf8")),
    verificationReceiptPath: receiptPath,
    verificationStartPath: request.startPath,
    verificationLaunchNonce: request.launchNonce,
  };
  writeJsonAtomic(checkpoint.checkpointPath, verifyingCheckpoint);
  return ensureVerification(verifyingCheckpoint, verificationContract);
}

function finalizePilotAttempt(manifest, opts, checkpoint) {
  const existing = readPilotResultRow(opts.pilotResults, checkpoint.attemptRunId);
  if (existing) {
    reconcileFinalizedCheckpoint(checkpoint, existing);
    console.log(`ALREADY_FINALIZED ${checkpoint.attemptRunId}: ${existing.result}`);
    return;
  }
  if (checkpoint.status === "finalized") throw new Error(`${checkpoint.attemptRunId} is finalized but its immutable result row is missing`);
  const actorRequest = JSON.parse(fs.readFileSync(checkpoint.requestPath, "utf8"));
  checkpoint = ensureActorRequest(checkpoint, {
    label: "actor",
    requestPath: checkpoint.requestPath,
    receiptPath: checkpoint.receiptPath,
    startPath: checkpoint.actorStartPath,
    requestSha256: checkpoint.requestSha256,
    launchNonce: checkpoint.actorLaunchNonce,
    timeoutMs: actorRequest.timeoutMs,
    status: "running",
    pidField: "actorPid",
  });
  const attempt = findPilotAttempt(manifest, checkpoint.attemptId);
  const resolved = require("./lib/acef-execution-assurance-experiment").resolveCatalogTask(manifest, opts.manifest, attempt.taskId);
  const verificationContract = resolved.kind === "epic" ? resolved.task.integration : resolved.task;
  const receipt = JSON.parse(fs.readFileSync(checkpoint.receiptPath, "utf8"));
  validateCheckpointInputs(opts, checkpoint, resolved, receipt, manifest);
  const claim = acquireFinalizationClaim(
    opts.pilotResults,
    checkpoint.attemptRunId,
    path.join(opts.pilotWorkspace, "finalization-locks"),
  );
  try {
    const racedResult = readPilotResultRow(opts.pilotResults, checkpoint.attemptRunId);
    if (racedResult) {
      reconcileFinalizedCheckpoint(checkpoint, racedResult);
      console.log(`ALREADY_FINALIZED ${checkpoint.attemptRunId}: ${racedResult.result}`);
      return;
    }
  const stdout = fs.readFileSync(checkpoint.rawPath, "utf8");
  const stderr = fs.readFileSync(`${checkpoint.rawPath}.stderr`, "utf8");
  const actor = {
    status: receipt.status,
    signal: receipt.signal,
    stdout,
    stderr,
    ...codexMetrics(parseJsonLines(checkpoint.rawPath)),
  };
  const activeDeliverySeconds = Math.round((new Date(receipt.finishedAt) - new Date(receipt.startedAt)) / 100) / 10;
  const verified = ensureVerification(checkpoint, verificationContract);
  checkpoint = verified.checkpoint;
  const verificationRequest = JSON.parse(fs.readFileSync(checkpoint.verificationRequestPath, "utf8"));
  const verification = {
    ...verified.verification,
    stdoutSha256: sha256(fs.readFileSync(verificationRequest.stdoutPath, "utf8")),
    stderrSha256: sha256(fs.readFileSync(verificationRequest.stderrPath, "utf8")),
  };
  const paths = changedPaths(checkpoint.clone, checkpoint.scoredBase);
  const allowedPaths = resolved.kind === "epic"
    ? [...new Set(resolved.task.stories.flatMap((story) => story.allowedPaths || []))]
    : (resolved.task.allowedPaths || []);
  const scopeViolations = paths.filter((entry) => !isPilotHarnessPath(entry) && !isAllowedPath(entry, allowedPaths));
  const expectationFailures = evaluateExpectations(checkpoint.clone, verificationContract.expected || [], resolved.fixtureRoot);
  const diff = captureGitDiff(checkpoint.clone, checkpoint.scoredBase);
  const diffPath = path.join(opts.pilotWorkspace, "artifacts", `${checkpoint.attemptRunId}.patch`);
  fs.mkdirSync(path.dirname(diffPath), { recursive: true });
  fs.writeFileSync(diffPath, diff);
  const commandTrace = parseIndependentTrace(`${actor.stdout}\nscope=epic ${verificationContract.verify.join(" ")}\n`, {
    scopeIds: resolved.kind === "epic" ? resolved.task.stories.map((story) => story.id) : [resolved.taskId],
    retryableControls: ["codeReview", "verifyPatch"],
    requiredControlsPerScope: attempt.treatment === "repo-native" ? []
      : ["readiness", "atdd", "development", "codeReview", "testReview", "processJudge"],
  });
  const actorContract = resolved.kind === "epic" && attempt.treatment !== "repo-native"
    ? lifecycleActorContract(resolved) : [];
  const collaborationEvidence = actorContract.length
    ? loadCollaborationEvidence(checkpoint.rawPath, actorContract, {
      cwd: checkpoint.clone,
      clientVersion: checkpoint.observedClientVersion.replace(/^codex-cli\s+/, ""),
      startedAt: receipt.startedAt,
      finishedAt: receipt.finishedAt,
      allowUnexpectedActors: attempt.treatment === "legacy",
      legacyPolicy: attempt.treatment === "legacy",
    })
    : { ok: true, expectedActorCount: 0, observedActorCount: 0, dispatches: [], failures: [] };
  const durableLifecycleEvidence = actorContract.length
    ? validateDurableLifecycleEvidence(
      checkpoint.clone,
      collaborationEvidence.actorContract || actorContract,
      collaborationEvidence.acceptedActors || actorContract,
    )
    : { ok: true, actorCount: 0, gateCount: 0, failures: [] };
  const trace = actorContract.length
    ? parseLifecycleDispatchTrace(collaborationEvidence.dispatchTraceContract || collaborationEvidence.actorContract || [], {
      scopeIds: resolved.task.stories.map((story) => story.id),
      requiredControlsPerScope: ["atdd", "development", "code-review", "verify-patch", "test-review", "process-judge"],
    })
    : commandTrace;
  if (actorContract.length) {
    checkpoint = {
      ...checkpoint,
      collaborationThreadId: collaborationEvidence.threadId || null,
      collaborationSessionPath: collaborationEvidence.sessionPath || null,
      collaborationSessionSha256: collaborationEvidence.sessionSha256 || null,
    };
    writeJsonAtomic(checkpoint.checkpointPath, checkpoint);
  }
  const treatmentState = evaluateTreatmentState(checkpoint.clone, attempt);
  const automatedOraclePassed = actor.status === 0 && verification.status === 0
    && scopeViolations.length === 0 && expectationFailures.length === 0
    && collaborationEvidence.ok && durableLifecycleEvidence.ok
    && (!actorContract.length || collaborationEvidence.closeoutCreatedMandatoryChains === 0)
    && trace.scopeAttributionComplete && trace.lifecycleComplete && !trace.duplicateLifecycle
    && treatmentState.ok;
  const row = {
    schema: "acef.execution-assurance-pilot-attempt.v1",
    experimentId: manifest.experimentId,
    attemptId: attempt.id,
    attemptOrdinal: checkpoint.attemptOrdinal,
    attemptRunId: checkpoint.attemptRunId,
    order: attempt.order,
    taskId: attempt.taskId,
    treatment: attempt.treatment,
    workflowId: attempt.workflowId,
    assuranceProfile: attempt.assuranceProfile,
    frameworkCommit: attempt.frameworkCommit,
    project: resolved.repo,
    projectCommit: resolved.commit,
    client: manifest.pilotRuntime.client,
    clientPath: checkpoint.clientPath,
    clientBinarySha256: checkpoint.clientBinarySha256,
    clientVersion: checkpoint.observedClientVersion,
    model: manifest.pilotRuntime.model,
    reasoningEffort: manifest.pilotRuntime.reasoningEffort,
    startedAt: receipt.startedAt,
    finishedAt: new Date().toISOString(),
    activeDeliverySeconds,
    wallTimeToProductDoneSeconds: null,
    timeToFirstValidGreenSeconds: null,
    frameworkRuntimeSeconds: attempt.treatment === "repo-native" ? 0 : null,
    capped: actor.signal !== null,
    activeTimeCapMinutes: attempt.activeTimeCapMinutes,
    actorExitCode: actor.status,
    verificationExitCode: verification.status,
    verificationCommandSha256: checkpoint.verificationCommandSha256,
    verificationReceiptPath: checkpoint.verificationReceiptPath,
    verificationStdoutSha256: verification.stdoutSha256,
    verificationStderrSha256: verification.stderrSha256,
    inputTokens: actor.input_tokens,
    cachedInputTokens: actor.cached_input_tokens,
    outputTokens: actor.output_tokens,
    toolCalls: actor.tool_calls,
    changedPaths: paths,
    scopeViolations,
    expectationFailures,
    independentTrace: trace,
    commandTrace,
    collaborationEvidence,
    durableLifecycleEvidence,
    treatmentState,
    transcriptPath: checkpoint.rawPath,
    transcriptSha256: sha256(actor.stdout),
    stderrSha256: sha256(actor.stderr),
    diffPath,
    diffSha256: sha256(diff),
    automatedOraclePassed,
    blindJudgeStatus: "pending",
    productDone: false,
    result: automatedOraclePassed ? "PROVISIONAL_PASS" : "FAIL",
  };
  fs.mkdirSync(path.dirname(opts.pilotResults), { recursive: true });
  fs.appendFileSync(opts.pilotResults, `${JSON.stringify(row)}\n`);
  writeJsonAtomic(checkpoint.checkpointPath, { ...checkpoint, status: "finalized", finalizedAt: row.finishedAt, result: row.result });
  console.log(`${row.result} ${attempt.id}: automated=${automatedOraclePassed ? "PASS" : "FAIL"}; blind-judge=pending; product-done=false; active=${activeDeliverySeconds}s`);
  console.log(`ARTIFACT ${diffPath}`);
  } finally {
    claim.release();
  }
}

function runPilotAttempt(manifest, opts) {
  const attempt = findPilotAttempt(manifest, opts.pilotRun);
  const history = pilotAttemptHistory(opts.pilotResults, attempt.id);
  if (history.maxOrdinal > 0) {
    if (!history.latest?.invalidated) {
      throw new Error(`pilot attempt ${attempt.id} already has an immutable result row`);
    }
    if (!opts.pilotRetryInvalidated) {
      throw new Error(`pilot attempt ${attempt.id} was invalidated; rerun requires --pilot-retry-invalidated`);
    }
  }
  if (must("git", ["status", "--porcelain"], root) !== "") {
    throw new Error(`${attempt.id}: runner worktree must be clean before a scored pilot launch`);
  }
  const clientRuntime = resolvePinnedClient(manifest.pilotRuntime);
  const resolved = resolveCatalogTask(manifest, opts.manifest, attempt.taskId);
  if (!fs.existsSync(opts.preflightOutput)) throw new Error(`${attempt.id}: pilot preflight artifact is missing`);
  const pilotPreflight = JSON.parse(fs.readFileSync(opts.preflightOutput, "utf8"));
  const preflightFailures = [];
  if (!pilotPreflight.ok) preflightFailures.push("pilot preflight is not PASS");
  if (!pilotPreflight.collaborationCanary?.ok) preflightFailures.push("collaboration canary is not PASS");
  if (pilotPreflight.runnerDirtyBefore !== false) preflightFailures.push("preflight runner worktree was dirty");
  if (pilotPreflight.runnerSourceSha256 !== runnerSourceSha256()) preflightFailures.push("preflight runner source drift");
  if (pilotPreflight.manifestSha256 !== sha256(fs.readFileSync(opts.manifest, "utf8"))) preflightFailures.push("preflight manifest binding drift");
  const preflightTaskBinding = (pilotPreflight.taskBindings || []).find((entry) => entry.taskId === attempt.taskId);
  if (!preflightTaskBinding || preflightTaskBinding.resolvedTaskSha256 !== resolvedTaskSha256(resolved)) {
    preflightFailures.push("preflight resolved task/fixture binding drift");
  }
  if (pilotPreflight.collaborationCanary?.clientBinarySha256 !== clientRuntime.clientBinarySha256) preflightFailures.push("preflight client binary drift");
  if (pilotPreflight.collaborationCanary?.clientVersion !== clientRuntime.observedClientVersion) preflightFailures.push("preflight client version drift");
  if (preflightFailures.length) throw new Error(`${attempt.id}: ${preflightFailures.join("; ")}`);
  const attemptOrdinal = history.maxOrdinal + 1;
  if (resolved.kind === "story") {
    throw new Error(`${attempt.id} story treatment execution is not enabled until exact-version compact lifecycle orchestration is wired`);
  }
  if (resolved.kind === "task" && attempt.treatment !== "repo-native") {
    throw new Error(`${attempt.id} ACEF single-task execution is not enabled until exact-version compact lifecycle orchestration is wired`);
  }
  const executionAttempt = { ...attempt, id: attemptOrdinal === 1 ? attempt.id : `${attempt.id}-r${attemptOrdinal}` };
  const checkpointPath = pilotCheckpointPath(opts, executionAttempt.id);
  if (fs.existsSync(checkpointPath)) {
    throw new Error(`${executionAttempt.id} already has a durable checkpoint; use --pilot-finalize ${attempt.id}`);
  }
  const prepared = resolved.kind === "epic"
    ? prepareEpicClone(resolved, executionAttempt, opts)
    : prepareSingleTaskClone(resolved, executionAttempt, opts);
  installExactFramework(prepared.clone, attempt, manifest, opts);
  const verificationContract = resolved.kind === "epic" ? resolved.task.integration : resolved.task;
  const preconditions = resolved.kind === "epic" ? resolved.task.stories : [resolved.task];
  for (const contract of preconditions) {
    const precondition = execute(contract.verify[0], contract.verify.slice(1), prepared.clone, { timeout: 600000 });
    if (precondition.status === 0) throw new Error(`${attempt.id}: ${contract.id || resolved.taskId} seeded precondition is not red`);
    if (!isBehavioralRed(precondition)) {
      throw new Error(`${attempt.id}: ${contract.id || resolved.taskId} precondition failed for a non-behavioral reason`);
    }
  }
  const scoredBase = commitAll(prepared.clone, `chore: freeze ${attempt.id} scored base`);
  const rawPath = path.join(opts.pilotWorkspace, "raw", `${executionAttempt.id}.jsonl`);
  const receiptPath = path.join(opts.pilotWorkspace, "receipts", `${executionAttempt.id}.json`);
  const requestPath = path.join(opts.pilotWorkspace, "requests", `${executionAttempt.id}.json`);
  const request = pilotAgentRequest(attempt, resolved, prepared.clone, manifest, rawPath, receiptPath, clientRuntime);
  request.startPath = `${rawPath}.started.json`;
  request.launchNonce = `${executionAttempt.id}:actor:v1`;
  writeJsonAtomic(requestPath, request);
  const checkpoint = {
    schema: "acef.execution-assurance-pilot-checkpoint.v1",
    experimentId: manifest.experimentId,
    checkpointPath,
    attemptId: attempt.id,
    attemptOrdinal,
    attemptRunId: executionAttempt.id,
    clone: prepared.clone,
    scoredBase,
    rawPath,
    requestPath,
    receiptPath,
    actorStartPath: request.startPath,
    actorLaunchNonce: request.launchNonce,
    requestSha256: sha256(fs.readFileSync(requestPath, "utf8")),
    manifestPath: path.resolve(opts.manifest),
    manifestSha256: sha256(fs.readFileSync(opts.manifest, "utf8")),
    resolvedTaskSha256: resolvedTaskSha256(resolved),
    pilotResultsPath: path.resolve(opts.pilotResults),
    runnerCommit: must("git", ["rev-parse", "HEAD"], root),
    runnerWorktreeSha256: sha256(must("git", ["status", "--porcelain"], root)),
    clientPath: clientRuntime.clientPath,
    clientBinarySha256: clientRuntime.clientBinarySha256,
    observedClientVersion: clientRuntime.observedClientVersion,
    status: "prepared",
    preparedAt: new Date().toISOString(),
  };
  writeJsonAtomic(checkpointPath, checkpoint);
  const runningCheckpoint = ensureActorRequest(checkpoint, {
    label: "actor",
    requestPath,
    receiptPath,
    startPath: request.startPath,
    requestSha256: checkpoint.requestSha256,
    launchNonce: request.launchNonce,
    timeoutMs: request.timeoutMs,
    status: "running",
    pidField: "actorPid",
  });
  finalizePilotAttempt(manifest, opts, runningCheckpoint);
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const manifest = validateManifest(JSON.parse(fs.readFileSync(opts.manifest, "utf8")));
  if (opts.plan) {
    console.log(JSON.stringify({
      experimentId: manifest.experimentId,
      treatments: manifest.treatments,
      count: manifest.pilot.attempts.length,
      attempts: buildPilotPlan(manifest),
    }, null, 2));
    return;
  }
  if (opts.pilotPreflight) {
    if (fs.existsSync(opts.preflightOutput) && !opts.force) {
      throw new Error(`immutable pilot preflight already exists at ${opts.preflightOutput}; use --force only for a documented rerun`);
    }
    const runnerDirtyBefore = must("git", ["status", "--porcelain"], root) !== "";
    const preflight = preflightCatalog(manifest, opts.manifest);
    const collaborationCanary = runCollaborationCanary(manifest);
    const row = {
      schema: "acef.execution-assurance-pilot-preflight.v1",
      experimentId: manifest.experimentId,
      candidateCommit: manifest.treatments.candidate.commit,
      manifestSha256: sha256(fs.readFileSync(opts.manifest, "utf8")),
      runnerCommit: must("git", ["rev-parse", "HEAD"], root),
      runnerDirtyBefore,
      runnerSourceSha256: runnerSourceSha256(),
      taskBindings: catalogTaskBindings(manifest, opts.manifest),
      checkedAt: new Date().toISOString(),
      ...preflight,
      collaborationCanary,
      ok: preflight.ok && collaborationCanary.ok,
    };
    writeJson(opts.preflightOutput, row);
    for (const check of row.checks) console.log(`${check.ok ? "PASS" : "FAIL"} ${check.taskId}${check.blockers.length ? `: ${check.blockers.join("; ")}` : ""}`);
    console.log(`${collaborationCanary.ok ? "PASS" : "FAIL"} collaboration-canary${collaborationCanary.failures.length ? `: ${collaborationCanary.failures.join("; ")}` : ""}`);
    console.log(`PILOT_PREFLIGHT ${row.ok ? "PASS" : "FAIL"}: ${row.checks.filter((check) => check.ok).length}/${row.checks.length} tasks ready`);
    if (!row.ok) process.exitCode = 1;
    return;
  }
  if (opts.pilotRun) {
    runPilotAttempt(manifest, opts);
    return;
  }
  if (opts.pilotFinalize) {
    finalizePilotAttempt(manifest, opts, latestPilotCheckpoint(opts, opts.pilotFinalize));
    return;
  }
  runStage0(manifest, opts);
}

if (require.main === module) {
  try {
    main();
  } catch (error) {
    console.error(`ACEF_EXECUTION_ASSURANCE_EXPERIMENT_ERROR: ${error.message}`);
    process.exitCode = 1;
  }
}

module.exports = {
  catalogTaskBindings,
  correctionSessionWrites,
  ensureActorRequest,
  evaluateTreatmentState,
  finalizePilotAttempt,
  forceTrackInstalledFramework,
  isBehavioralRed,
  lifecycleActorContract,
  parseCollaborationEvidence,
  reconcileFinalizedCheckpoint,
  resolvePinnedClient,
  runnerSourceSha256,
  validateDurableLifecycleEvidence,
  validateCorrectionBinding,
  resolvedTaskSha256,
};
