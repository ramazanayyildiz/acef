      `   Allowed production paths: ${story.allowedPaths.join(", ")}`,
      `   Frozen test paths: ${(story.testPaths || []).join(", ") || "none"}`,
      `   Focused verification: ${story.verify.join(" ")}`,
      ...(story.discovery ? [
        `   Frozen discovery command JSON: ${JSON.stringify(story.discovery.argv)}`,
        `   Expected discovered tests: ${(story.discovery.expectedTests || []).join(" | ")}`,
