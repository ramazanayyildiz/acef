  const shellLiteral = (value) => /^[A-Za-z0-9_./:=+,-]+$/.test(String(value))
    ? String(value)
    : `'${String(value).replaceAll("'", `'"'"'`)}'`;
  const stories = resolved.task.stories.map((story, index) => {
