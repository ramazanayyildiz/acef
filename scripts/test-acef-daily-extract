def cut_repro():
    s = "public\n" + "x" * 70000 + "\npassword: |\n"
    s += "\n".join("  api_key: example" if i % 30 == 0 else "  " + "z" * 990 for i in range(350))
    return s + "\n  Velvet meadow 731\n  " + "y" * 250


def cut_family(seed=11, n=120):
    """Fields with a long secret block that crosses the bounding cut at different offsets: head fillers of several
    sizes, headers at several indents, nested keyword lines, blank lines, body lines of several lengths. Every body
    line carries a unique tag."""
    import random
    rng = random.Random(seed)
    for trial in range(n):
        lines = ["head %d" % i for i in range(rng.randint(0, 40))]
        lines.append("f" * rng.choice([1000, 60000, 65000, 66000, 70000, 130000]))
        hdr = " " * rng.choice([0, 2, 4])
        lines.append(hdr + rng.choice(["password: |", "password:", "secret: >-", "token: x", "api_key: |2-"]))
        for i in range(rng.randint(5, 400)):
            r, ind = rng.random(), hdr + " " * rng.choice([2, 2, 4])
            if r < 0.05:
                lines.append(ind + rng.choice(["api_key: example", "token: |", "secret:"]))
            elif r < 0.08:
                lines.append("")
            else:
                lines.append(ind + "T%04d_%d " % (trial, i) + "z" * rng.choice([10, 500, 990, 3000]))
        lines += [hdr + "  T%04d_end" % trial, "tail " + "y" * rng.choice([10, 250, 70000])]
        yield "\n".join(lines)


def block_family():
    """Block bodies with a keyword line at every position (first, middle, last, deeper, deeper with its own block)
    and secrets ({}) before and after it, under three header styles. Every line from the header to the line before
    "next: 1" must be redacted (the outermost block)."""
    kws = ["api_key: example", "token: x", "secret:"]
    shapes = [
        ["  {KW}", "  {}", "  {}"],                     # first line of the block
        ["  {}", "  {KW}", "  {}"],                     # middle, same indent
        ["  {}", "  {}", "  {KW}"],                     # last
        ["  {}", "    {KW}", "  {}"],                   # deeper
        ["  {}", "    {KW} |", "      {}", "  {}"],     # deeper, with its own block
        ["  {KW}", "  {}", "    {}", "  {}"],           # same indent, value lines at mixed depth
    ]
    out = []
    for head in ("password: |", "password:", "password: >-"):
        for kw in kws:
            for shape in shapes:
                out.append("\n".join([head] + [ln.replace("{KW}", kw) for ln in shape] + ["next: 1"]))
    return out


def property_fixture(root):
    """Secrets in many forms, each placed in every input field the extractor reads. Returns the secret values that
    must never appear (no 6+ char substring) in any written file or file name."""
    import random
    rng = random.Random(7)
    up, low, dig = "GHJKLMNPQRSTUVWXYZ", "ghjkmnpqrstuvwxyz", "23456789"

    def chunk(n):    # every 6-window has upper case letters outside hex, so hashes and words never collide
        return "".join(rng.choice((up, low, dig)[i % 3]) for i in range(n))
    secrets = []

    def v3():
        a, b, c = chunk(6), chunk(6), chunk(6)
        secrets.append(f"{a} {b} {c}")
        return a, b, c

    def w():
        x = chunk(24)
        secrets.append(x)
        return x
    forms = []
    for q in ('"', "'"):
        a, b, c = v3()
        forms.append(f"password={q}{a} {b} {c}{q} rest")
    forms.append(f"password={w()} rest")
    a, b, c = v3()
    forms.append(f'password="{a} {b} {c}')                                   # unterminated quote
    a, b, c = v3()
    forms.append(json.dumps({"password": f"{a} {b} {c}"}))
    a, b, c = chunk(6), chunk(6), chunk(6)
    secrets += [a, b, c]
    forms.append(json.dumps({"password": f'{a} "{b}" {c}'}))                 # nested escaped quotes
    a, b, c = v3()
    forms.append(json.dumps(json.dumps({"api_key": f"{a} {b} {c}"})))         # JSON in JSON
    a, b, c = v3()
    forms.append(f"secret: {a} {b} {c}")
    forms.append(f"client_secret={w()}")
    forms.append(f"DATABASE_URL=postgres://app:{w()}@db.local/app")
    a, b, c = v3()
    forms.append(f'mysql -u root -p"{a} {b} {c}" app')                        # CLI flags
    forms.append(f"mysql -p{w()} app")
    forms.append(f"psql --password={w()} app")
    a, b, c = v3()
    forms.append(f"mysqldump -p'{a} {b} {c}' db")
    forms.append(f"git clone https://deploy:{w()}@example.net/repo.git")       # URL credentials, no keyword
    forms.append(f"Authorization: Bearer {w()}")
    forms.append(f"token: {w()}")
    forms.append(f"X-Api-Key: {w()}")
    a, b, c = v3()
    forms.append(f"password:\n  {a} {b} {c}\nnext")                             # YAML value on the next line
    a, b = chunk(8), chunk(8)
    secrets += [a, b]
    forms.append(f"password: # production\n  {a}\n  {b}\nnext: 1")              # comment, value below
    for ind in ("|", ">", "|-", ">-", "|+", "|2-", ">1+", "|-2", "!!str |", "&pw |", "!secret >-",
                "*alias"):                                                       # YAML block scalars, tags, anchors
        a, b = chunk(8), chunk(8)
        secrets += [a, b]
        forms.append(f"db:\n  password: {ind}\n    {a}\n    {b}\n  host: x")
    a, b = chunk(8), chunk(8)
    secrets += [a, b]
    forms.append(f"API_KEY=\\\n{a}\\\n{b}\nNEXT=1")                                # dotenv backslash continuation
    a, b = chunk(8), chunk(8)
    secrets += [a, b]
    forms.append(f'password="{a}\n{b}" rest\nok')                                # quoted value over two lines
    a, b = chunk(8), chunk(8)
    secrets += [a, b]
    forms.append(f"{{password:\n {a}}}\n{{token:\n{b}}}\nok")                     # flow mappings, indented or not
    a = chunk(8)
    secrets.append(a)
    forms.append(f"password: |2-\n{a}\nok")                                    # value line not indented
    a = chunk(8)
    secrets.append(a)
    forms.append(f"db:\n  password:\napi_key: |2-\n  {a}\nok: 1")              # header as first continuation, dedent
    a, b, c = chunk(8), chunk(8), chunk(8)
    secrets += [a, b, c]
    forms.append(f"x:\n  token: |\n    {a}\n  secret: >-\n      {b}\npassword: |\n {c}\nok")   # consecutive, mixed indent
    a, b = chunk(8), chunk(8)
    secrets += [a, b]
    forms.append(f"password: |\ntoken: |\n  {a}\n    client_secret: >\n      {b}\nok")    # nested headers in a block
    a, b = chunk(8), chunk(8)
    secrets += [a, b]
    forms.append(f"  a:\n    password: |\n      {a}\n  api_key: >\n    {b}\nnext: 1")     # a header that dedents
    for body in block_family():                   # a keyword line at every position inside a block (r7)
        vals = [chunk(8) for _ in range(body.count("{}"))]
        secrets.extend(vals)
        forms.append(body.format(*vals))
    forms.append(f"use sk-proj-{w()} now")                                     # tokens anywhere
    forms.append(f"ghp_{w()}")
    forms.append(f"xoxb-{w()}")
    ak = "".join(rng.choice(up + dig) for _ in range(16))
    secrets.append(ak)
    forms.append(f"key AKIA{ak} here")
    forms.append(f"AIza{w()}{w()}")
    forms.append(f"jwt eyJ{w()}.{w()}.{w()}")
    pem_body = [w() for _ in range(3)]
    forms.append("-----BEGIN PRIVATE KEY-----\n" + "\n".join(pem_body) + "\n-----END PRIVATE KEY-----")
    forms.append("-----BEGIN RSA PRIVATE KEY-----\n" + "\n".join(w() for _ in range(3)))   # unterminated PEM
    forms.append(f"cat /tmp/password-{w()}.txt")                               # file names
    forms.append(f"mail {w()}@example.org")
    one = [f.replace("\n", " ") for f in forms]
    tokname = w()
    # Claude main session: owner messages, title, branch, cwd, tool inputs and outputs, tests, commits, cd paths
    pc = root / "claude" / "-nonexistent-prop"
    sid = "33333333-4444-5555-6666-777777777777"
    rows = [dict(user(ts(9, 0), forms[0]), cwd="/nonexistent-acef-fixture/prop/.worktrees/w", gitBranch=one[1])]
    rows.append({"type": "ai-title", "aiTitle": one[2], "sessionId": "s"})
    rows.append({"type": "pr-link", "sessionId": "s", "prNumber": 1, "prRepository": one[3], "timestamp": ts(9, 1)})
    for i, (f, o) in enumerate(zip(forms, one)):
        hh, mm = 10 + i // 30, (i * 2) % 60
        rows += [say(ts(hh, mm), "Running it.", f"pa{i}"), user(ts(hh, mm), f"{f}"),
                 bash(ts(hh, mm), f"pb{i}", f"echo go; {f}", f"pb{i}"),
                 result(ts(hh, mm), f"pb{i}", f"Exit code 2\nfailed: {f}", err=True),
                 bash(ts(hh, mm), f"pt{i}", "vendor/bin/phpunit --filter X", f"pt{i}"),
                 result(ts(hh, mm), f"pt{i}", f"FAILURES!\nTests: 1, Failures: 1. {o}", err=True),
                 bash(ts(hh, mm), f"pc{i}", f"cd /tmp/{o.split()[0]} && git commit -m '{o}'", f"pc{i}"),
                 result(ts(hh, mm), f"pc{i}", "[main abc1234] x")]
        tool = base(ts(hh, mm), "assistant")
        tool.update(requestId=f"pw{i}", message={"model": "m", "id": f"pw{i}", "role": "assistant", "content": [
            {"type": "tool_use", "id": f"pw{i}", "name": "Write", "input": {"file_path": "/tmp/x", "content": f}},
            {"type": "tool_use", "id": f"pg{i}", "name": "Agent", "input": {"description": o, "prompt": f}}]})
        rows += [tool, result(ts(hh, mm), f"pw{i}", f"error: {f}", err=True)]
