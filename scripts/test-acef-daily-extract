    # Codex: exec with a review prompt, failing commands with secrets in command and output tail, MCP errors;
    # an older-format owner pane; a session file and a project dir named after a token
    ev_ = lambda t, pl, typ="event_msg": {"timestamp": t, "type": typ, "payload": pl}  # noqa: E731
    cxs = [{"timestamp": ts(13, 0), "type": "session_meta", "payload": {
        "id": "p-1", "cwd": "/nonexistent-acef-fixture/prop/.worktrees/w", "originator": "codex_exec"}},
        ev_(ts(13, 0), {"type": "item_completed", "item": {"type": "UserMessage", "content": [
            {"type": "text", "text": "Review. VERDICT: ACCEPT or REVISE. " + forms[4]}]}})]
    tui = [{"timestamp": ts(14, 0), "type": "session_meta", "payload": {
        "id": "p-2", "cwd": "/nonexistent-acef-fixture/prop/.worktrees/w", "originator": "codex_cli_rs"}}]
    for i, (f, o) in enumerate(zip(forms, one)):
