    def walk(o, path="$"):
        if isinstance(o, dict):
            for k, v in o.items():
                yield path + ".key", k
                yield from walk(v, path + "." + str(k)[:20])
        elif isinstance(o, list):
            for i, v in enumerate(o):
                yield from walk(v, f"{path}[{i}]")
        elif isinstance(o, str):
            yield path, o
    dirty = [(p_, v) for p_, v in walk(pidx) for sec in secrets for i in range(len(sec) - 5) if sec[i:i + 6] in v]
    check("C write gate: every key and value of extract.json is clean", pidx and not dirty, dirty[:5])
