    return secrets, mem


def tree_hash(root):
    h = hashlib.sha256()
    for f in sorted(root.rglob("*")):
        h.update(str(f).encode())
        if f.is_file():
            h.update(f.read_bytes())
    return h.hexdigest()


def run(*extra):
