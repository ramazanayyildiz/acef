    survivors = []
    for body in block_family():
        text = body.replace("{}", "Zq9Yw2Xr")
        red = mod.redact(text).split("\n")
        # an empty-valued keyword as the last body line claims the next line by rule (b): over-redaction, allowed
        tail_ok = red[-1] == "next: 1" or (text.split("\n")[-2].strip() == "secret:" and red[-1] == "<redacted>")
        if not tail_ok or any(x.strip() and x.strip() != "<redacted>" for x in red[:-1]):
            survivors.append((text, red))
    r6 = mod.redact("db:\n  password:\napi_key: |2-\n  Cedar47Maple\nok: 1")
    r7 = mod.redact("password: |\n  api_key: example\n  CanaryMint79!\nnext: 1")
    check(f"P1 monotone blocks: a keyword line at every position inside a block ({len(block_family())} shapes) "
          "never shortens it; r6 and r7", not survivors and "Cedar47Maple" not in r6 and "CanaryMint79" not in r7
          and r6.endswith("ok: 1") and r7.endswith("next: 1"), (survivors[:2], r6, r7))
    # P1 r8: the bounding cut never shortens a block. For every field, no line the full-text line pass redacts
    # survives redact_field (exact head, carried state into the tail); the repro does not reach extract.json.
    viol, total = [], 0
    for x in cut_family():
        full = mod._redact_lines(mod._redact_pem(x)).split("\n")
        orig = x.split("\n")
        tags = [orig[i].split()[0] for i in range(len(orig)) if full[i] != orig[i] and orig[i].strip().startswith("T")]
        kept = set(re.findall(r"T\d{4}_\w+", mod.redact_field(x)))
        total += len(tags)
        viol += [t for t in tags if t in kept]
    check(f"P1 bounding cut: no line the full-text pass redacts survives redact_field ({total} redacted lines in "
          "120 fields crossing the cut); the r8 repro does not reach any written file",
          not viol and total > 5000 and "Velvet meadow" not in mod.redact_field(cut_repro()) and
          "Velvet meadow" not in mod.tail_clip(cut_repro(), 400) and r2s and
          not any("Velvet meadow" in v for v in written.values()), viol[:10])
    # P2: every redaction pattern family is linear: an adversarial 256 KB input finishes under 0.2 s
    import time as time_mod
    K = 256 * 1024
    adv = {
        "pem BEGIN repeated": "-----BEGIN PRIVATE KEY-----\n", "pem END repeated": "-----END PRIVATE KEY-----\n",
        "pem non-key markers": "-----BEGIN X-----", "pem dashes": "-", "sk": "sk-", "gh": "ghp_", "xox": "xoxb-",
        "AKIA": "AKIA", "AIza": "AIza", "jwt dash": "eyJ-", "jwt dot": "eyJ.", "email at": "a@", "email dot": "a.",
        "email local": "x", "url": "a://", "url creds": "a://b:", "ctx keyword": "password ", "ctx pass": "pass ",
        "ctx block": "password: |\n", "db cli": "mysql ", "db dash": "mysql -", "long token": "Ab1",
        "spaces": " ", "newlines": "\n", "quotes": '"', "backslash lines": "\\\n",
        "url at no colon": "a://b@", "url colon no at": "x://y:", "keyword lines": "password\n",
    }
    slow = {}
    for name, unit in adv.items():
        text = (unit * (K // len(unit) + 1))[:K]
        took = 9.0
        for _ in range(3):              # best of 3: the algorithmic cost, not machine-load noise
            t0 = time_mod.perf_counter()
            mod.redact(text)
            took = min(took, time_mod.perf_counter() - t0)
        if took >= 0.2:
            slow[name] = round(took, 3)
    t0 = time_mod.perf_counter()
    mod.clip("token " + "Ab1-" * (1024 * 1024 // 4), 300)
    took_clip = time_mod.perf_counter() - t0
    import random as random_mod
    rng = random_mod.Random(1)
    mixed = []
    while sum(map(len, mixed)) < 10 * 1024 * 1024:
        k_ = rng.random()
        mixed.append("password: |" if k_ < 0.01 else "  token: x" if k_ < 0.02 else "  " + "a" * rng.randint(10, 200))
    tenmb = {"mixed": "\n".join(mixed), "keyword every line": ("password\n" * 1200000)[:10 * 1024 * 1024],
             "indented keyword every line": ("  token: x\n" * 1000000)[:10 * 1024 * 1024],
             "one line": "x" * (10 * 1024 * 1024)}
    slow10 = {}
    for name, text in tenmb.items():
        took = 9.0
        for _ in range(2):
            t0 = time_mod.perf_counter()
            mod.redact_field(text)
            took = min(took, time_mod.perf_counter() - t0)
        if took >= 1.0:
            slow10[name] = round(took, 3)
    check("P2 a 10 MB field is redacted under 1 s (mixed, keyword on every line, one line)", not slow10, slow10)
    check(f"P2 linear redaction: {len(adv)} adversarial 256 KB inputs each under 0.2 s; clip() on 1 MB "
          f"{took_clip:.2f} s", not slow and took_clip < 0.5, slow or took_clip)
    big_field = "\n".join(f"line {i} " + "x" * 60 for i in range(6000)) + "\npassword: |\n  Zq9Yw2Xr8Vt4\nend"
    bf = mod.redact_field(big_field)
    check("P2 field cap: a field over 2 x 64 KB keeps whole head and tail lines, drops the middle with a marker, "
          "and still redacts a block in the tail", "<dropped " in bf and "Zq9Yw2Xr8Vt4" not in bf and
          all(ln_.startswith(("line ", "<dropped", "<redacted>", "end")) or not ln_ for ln_ in bf.split("\n")),
          bf[-300:])
    # default window: yesterday 09:00 to today 09:00 local (TZ=UTC here)
    p2 = subprocess.run([sys.executable, "-I", str(TOOL), "--claude-dir", str(TMP / "none"), "--codex-dir",
                         str(TMP / "none"), "--store", str(TMP / "store2"), "--mem-guard-log", str(MEM), "--no-gh"],
                        env=ENV, capture_output=True, text=True)
    import datetime as dt
    today = dt.datetime.now(dt.timezone.utc).date()
    exp_until = dt.datetime(today.year, today.month, today.day, 9, tzinfo=dt.timezone.utc).timestamp()
    idx2 = json.loads(next((TMP / "store2" / "daily").glob("*/extract.json")).read_text()) if p2.returncode == 0 else {}
    check("default window is the rolling 09:00 to 09:00", idx2.get("window", {}).get("until") == exp_until and
          idx2["window"]["since"] == exp_until - 86400, (p2.stdout + p2.stderr, idx2.get("window")))
    # budget trimming: many distinct failures, tiny budget
    sid = "11111111-2222-3333-4444-555555555555"
    f = CLAUDE / "-nonexistent-acef-fixture-demo" / f"{sid}.jsonl"
    with open(f, "a", encoding="utf-8") as fh:
        for i in range(20):
            fh.write(json.dumps(bash(ts(15, i), f"x{i}", f"tool{chr(97 + i)} --flag", f"rx{i}")) + "\n")
            fh.write(json.dumps(result(ts(15, i), f"x{i}", f"Exit code 3\nerror {chr(97 + i)}", err=True)) + "\n")
    os.utime(f, (1_900_000_000, 1_900_000_000))
    p = run("--budget-tokens", "900")
    md2 = (out / "demo.md").read_text()
    check("trimmed to budget, says what was cut", p.returncode == 0 and "Trimmed to budget:" in md2 and
          "trimmed: kept" in md2 and "x3 Bash" in md2, md2[:3000])
finally:
    shutil.rmtree(TMP, ignore_errors=True)

print(f"test-acef-daily-extract: {ok} passed, {bad} failed")
sys.exit(1 if bad else 0)
