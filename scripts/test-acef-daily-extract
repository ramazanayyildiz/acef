            "type": "CommandExecution", "command": ["bash", "-lc", f"run {f}"], "cwd": "file:///tmp",
            "exit_code": 1, "aggregated_output": "x" * 500 + "\n" + f + "\n" + "y " * 100}}))
        cxs.append(ev_(t, {"type": "item_completed", "item": {
            "type": "McpToolCall", "server": "s", "tool": "t", "status": "failed", "error": {"message": f}}}))
        tui.append(ev_(ts(14, 1 + i % 58), {"type": "user_message", "message": f}))
        tui.append(ev_(ts(14, 1 + i % 58), {"type": "function_call", "name": "shell", "call_id": f"q{i}",
                                            "arguments": json.dumps({"command": ["bash", "-lc", f]})},
                       typ="response_item"))
        tui.append(ev_(ts(14, 1 + i % 58), {"type": "function_call_output", "call_id": f"q{i}", "output": json.dumps(
            {"output": f, "exit_code": 3})}, typ="response_item"))
