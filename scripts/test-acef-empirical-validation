#!/usr/bin/env node
"use strict";

const assert = require("assert");
const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawnSync } = require("child_process");

const root = path.resolve(__dirname, "..");
const { codexMetrics, opencodeMetrics, isAllowedPath } = require("./lib/acef-empirical");
const {
  buildRuns,
  changedPaths,
  evaluateExpectations,
  knownFindingRecall,
  promptFor,
  evaluateDirectOutcome,
} = require("./acef-empirical-validation");
const { summarizeMeasurement } = require("./acef-direct-measurement-report");

function run(command, args, opts = {}) {
  const result = spawnSync(command, args, { encoding: "utf8", ...opts });
  if (result.status !== 0) {
    throw new Error(`${command} ${args.join(" ")} failed\n${result.stdout}\n${result.stderr}`);
  }
  return result.stdout;
}

function testManifestExpansion() {
  const manifest = JSON.parse(fs.readFileSync(path.join(root, "docs/experiments/empirical-validation/manifest.json"), "utf8"));
  const runs = buildRuns(manifest);
  const unique = (key) => [...new Set(runs.map((run) => run[key] ?? run.task[key]))].sort();
  assert.strictEqual(runs.length, 30);
  assert.deepStrictEqual(unique("repo"), ["browser-rts", "detaysoft2026", "mvt-nextjs"]);
  assert.deepStrictEqual(unique("stack"), ["php-laravel", "typescript-nextjs", "typescript-vite"]);
  assert.deepStrictEqual(unique("lane"), ["baseline", "guarded", "lightweight"]);
  assert.deepStrictEqual(unique("client"), ["codex", "opencode"]);
  assert.deepStrictEqual(unique("taskType"), ["bug-fix", "guarded-security-fix", "small-feature"]);
}

function testMetricsParsers() {
  const codex = codexMetrics([
    { type: "item.started", item: { type: "command_execution", command: "rg foo" } },
    { type: "item.completed", item: { type: "command_execution", exit_code: 1 } },
    { type: "item.completed", item: { type: "agent_message", text: "done" } },
    { type: "turn.completed", usage: { input_tokens: 11, cached_input_tokens: 2, output_tokens: 3 } },
  ]);
  assert.strictEqual(codex.input_tokens, 11);
  assert.strictEqual(codex.cached_input_tokens, 2);
  assert.strictEqual(codex.output_tokens, 3);
  assert.strictEqual(codex.extra_file_reads, 1);
  assert.strictEqual(codex.retry_count, 1);
  assert.match(codex.final_text, /done/);

  const opencode = opencodeMetrics([
    { type: "event", part: { type: "tool", state: { input: { command: "sed -n 1,2p file" }, status: "error" } } },
    { type: "text", part: { text: "finished" } },
    { type: "step_finish", part: { tokens: { input: 19, output: 4, cache: { read: 5 } }, cost: 0.001 } },
  ]);
  assert.strictEqual(opencode.input_tokens, 19);
  assert.strictEqual(opencode.cached_input_tokens, 5);
  assert.strictEqual(opencode.output_tokens, 4);
  assert.strictEqual(opencode.tool_calls, 1);
  assert.strictEqual(opencode.extra_file_reads, 1);
  assert.strictEqual(opencode.retry_count, 1);
  assert.match(opencode.final_text, /finished/);
}

function testScopeMatching() {
  assert.strictEqual(isAllowedPath("app/api/app/[...path]/route.ts", ["app/api/app/[...path]/route.ts"]), true);
  assert.strictEqual(isAllowedPath("app/api/app/foo/route.ts", ["app/api/app/[...path]/route.ts"]), false);
  assert.strictEqual(isAllowedPath("app/Twill/Capsules/Blogs/Models/Blog.php", ["app/Twill/Capsules/Blogs/**"]), true);
}

function testChangedPathsPreservesPorcelainFilenames() {
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "acef-empirical-test-"));
  try {
    run("git", ["init", "-q"], { cwd: tmp });
    run("git", ["config", "user.email", "acef-test@example.invalid"], { cwd: tmp });
    run("git", ["config", "user.name", "ACEF Test"], { cwd: tmp });
    fs.writeFileSync(path.join(tmp, "alpha.txt"), "base\n");
    run("git", ["add", "alpha.txt"], { cwd: tmp });
    run("git", ["commit", "-q", "-m", "base"], { cwd: tmp });
    const base = run("git", ["rev-parse", "HEAD"], { cwd: tmp }).trim();
    fs.writeFileSync(path.join(tmp, "alpha.txt"), "changed\n");
    fs.writeFileSync(path.join(tmp, "zulu.txt"), "new\n");
    assert.deepStrictEqual(changedPaths(tmp, base), ["alpha.txt", "zulu.txt"]);
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
}

function testPlanCli() {
  const stdout = run("node", ["scripts/acef-empirical-validation", "--plan"], { cwd: root });
  const plan = JSON.parse(stdout);
  assert.strictEqual(plan.count, 30);
  assert.strictEqual(plan.runs.length, 30);
}

function testPilotManifestExpansion() {
  const manifestPath = path.join(root, "docs/experiments/empirical-validation/manifest-v2-pilot.json");
  const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
  const runs = buildRuns(manifest);
  assert.strictEqual(runs.length, manifest.expectedRuns);
  assert.strictEqual(runs.length, 12);
  const stdout = run("node", ["scripts/acef-empirical-validation", "--plan", "--manifest", manifestPath], { cwd: root });
  const plan = JSON.parse(stdout);
  assert.strictEqual(plan.experimentId, "acef-empirical-v2-pilot");
  assert.strictEqual(plan.count, 12);
}

function testDirectManifestExpansion() {
  const manifestPath = path.join(root, "docs/experiments/direct-lane-measurement/manifest.json");
  const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
  const runs = buildRuns(manifest);
  assert.strictEqual(runs.length, 30);
  assert.deepStrictEqual([...new Set(runs.map((run) => run.lane))].sort(), ["baseline", "direct", "lightweight"]);
  assert.strictEqual(manifest.tasks.filter((task) => task.directExpected === "complete").length, 4);
  assert.strictEqual(manifest.tasks.filter((task) => task.directExpected === "promote").length, 1);
  const stdout = run("node", ["scripts/acef-empirical-validation", "--plan", "--manifest", manifestPath], { cwd: root });
  const plan = JSON.parse(stdout);
  assert.strictEqual(plan.experimentId, "acef-direct-lane-v1");
  assert.strictEqual(plan.count, 30);
}

function testDirectPromptAndPromotionOutcome() {
  const prompt = promptFor({
    lane: "direct",
    task: {
      prompt: "Fix one localized bug.",
      allowedPaths: ["src/local.js"],
      verify: ["node", "--check", "src/local.js"],
    },
  });
  assert.match(prompt, /ACEF direct workflow/);
  assert.match(prompt, /ACEF_DIRECT_RUN\.json/);
  assert.match(prompt, /RESULT=PROMOTED/);

  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "acef-direct-outcome-"));
  try {
    const stateDir = path.join(tmp, "docs", "ai");
    fs.mkdirSync(stateDir, { recursive: true });
    fs.writeFileSync(path.join(stateDir, "ACEF_DIRECT_RUN.json"), `${JSON.stringify({
      schema: "acef.direct-run.v1",
      version: "1.0.0",
      runId: "promotion-test",
      lane: "direct",
      status: "promoted",
      scope: "provider integration",
      acceptance: ["Provider work promotes"],
      technicalBoundary: "localized-bugfix",
      reversible: true,
      riskTriggers: ["external-provider"],
      changedPaths: [],
      verification: [],
      promotion: {
        decision: "promote-guarded",
        reasons: ["DeepL provider integration"],
      },
      updatedAt: new Date().toISOString(),
    }, null, 2)}\n`);
    const outcome = evaluateDirectOutcome(
      tmp,
      { task: { directExpected: "promote" } },
      1,
      ["docs/ai/ACEF_DIRECT_RUN.json"],
    );
    assert.strictEqual(outcome.contractPassed, true);
    assert.strictEqual(outcome.promotionCorrect, true);
    assert.strictEqual(outcome.implementationAttempted, false);
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
}

function testDirectMeasurementSummary() {
  const rows = [];
  const clients = ["codex", "opencode"];
  for (let taskIndex = 0; taskIndex < 5; taskIndex += 1) {
    const expected = taskIndex === 4 ? "promote" : "complete";
    for (const lane of ["baseline", "direct", "lightweight"]) {
      for (const client of clients) {
        const direct = lane === "direct";
        rows.push({
          experiment_id: "test-direct",
          task_id: `task-${taskIndex}`,
          task_direct_expected: expected,
          lane,
          client,
          result: "pass",
          escaped_defects: 0,
          scope_violations: [],
          context_miss: false,
          input_tokens: lane === "baseline" ? 100 : lane === "direct" ? 60 : 80,
          cached_input_tokens: 10,
          output_tokens: 5,
          runtime_seconds: lane === "baseline" ? 10 : lane === "direct" ? 11 : 20,
          tool_calls: lane === "baseline" ? 5 : lane === "direct" ? 6 : 9,
          extra_file_reads: 0,
          retry_count: 0,
          direct_contract_passed: direct && expected === "complete" ? true : null,
          direct_closeout_exit_code: direct && expected === "complete" ? 0 : null,
          promotion_correct: direct && expected === "promote" ? true : null,
          implementation_attempted: direct && expected === "promote" ? false : null,
        });
      }
    }
  }
  const summary = summarizeMeasurement(rows);
  assert.strictEqual(summary.total_runs, 30);
  assert.strictEqual(summary.direct.contract_passes, 8);
  assert.strictEqual(summary.direct.correct_promotions, 2);
  assert.strictEqual(summary.direct.input_reduction_vs_baseline_pct, 40);
  assert.strictEqual(summary.proven, true);
}

function testFixtureUnchangedExpectation() {
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "acef-empirical-fixture-"));
  try {
    const fixtureName = "run-benchmark-gather-modifier.mjs";
    const fixturePath = path.join(root, "docs/experiments/empirical-validation/fixtures", fixtureName);
    fs.mkdirSync(path.join(tmp, "scripts"), { recursive: true });
    fs.copyFileSync(fixturePath, path.join(tmp, "scripts", fixtureName));
    const expectations = [{ path: `scripts/${fixtureName}`, fixtureUnchanged: fixtureName }];
    assert.deepStrictEqual(evaluateExpectations(tmp, expectations), []);
    fs.appendFileSync(path.join(tmp, "scripts", fixtureName), "// weakened assertion\n");
    const failures = evaluateExpectations(tmp, expectations);
    assert.strictEqual(failures.length, 1);
    assert.match(failures[0], /modified from fixture/);
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
}

function testKnownFindingRecall() {
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "acef-empirical-recall-"));
  try {
    fs.writeFileSync(path.join(tmp, "detail.ts"), "WHERE id = $1 AND deleted_at IS NULL\n");
    fs.writeFileSync(path.join(tmp, "list.ts"), "// ACEF benchmark regression: leak\n");
    const task = {
      knownFindings: [
        { id: "detail", expected: [{ path: "detail.ts", notContains: "ACEF benchmark regression" }] },
        { id: "list", expected: [{ path: "list.ts", notContains: "ACEF benchmark regression" }, { path: "list.ts", contains: "deleted_at IS NULL" }] },
      ],
    };
    assert.deepStrictEqual(knownFindingRecall(tmp, task, 0, []), { recalled: 1, total: 2 });
    fs.writeFileSync(path.join(tmp, "list.ts"), "where.push(\"deleted_at IS NULL\");\n");
    assert.deepStrictEqual(knownFindingRecall(tmp, task, 0, []), { recalled: 2, total: 2 });
    assert.deepStrictEqual(knownFindingRecall(tmp, task, 1, []), { recalled: 0, total: 2 });
    const legacy = { expected: [] };
    assert.deepStrictEqual(knownFindingRecall(tmp, legacy, 0, []), { recalled: 1, total: 1 });
    assert.deepStrictEqual(knownFindingRecall(tmp, legacy, 0, ["failure"]), { recalled: 0, total: 1 });
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
}

testManifestExpansion();
testMetricsParsers();
testScopeMatching();
testChangedPathsPreservesPorcelainFilenames();
testPlanCli();
testPilotManifestExpansion();
testDirectManifestExpansion();
testDirectPromptAndPromotionOutcome();
testDirectMeasurementSummary();
testFixtureUnchangedExpectation();
testKnownFindingRecall();

console.log("acef-empirical-validation tests passed");
