#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { performance } = require("node:perf_hooks");
const { inspectRunAuthorization } = require("./lib/acef-run-authorization");

const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "acef-run-authorization-"));
const docsAi = path.join(tmp, "docs", "ai");
const activeRunPath = path.join(docsAi, "ACEF_ACTIVE_RUN.json");
const workerScopePath = path.join(docsAi, "ACEF_ACTIVE_WORKER_SCOPE.json");

function writeJson(filePath, value) {
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  fs.writeFileSync(filePath, `${JSON.stringify(value, null, 2)}\n`);
}

function percentile(values, quantile) {
  const sorted = [...values].sort((left, right) => left - right);
  return sorted[Math.min(sorted.length - 1, Math.ceil(sorted.length * quantile) - 1)];
}

try {
  fs.mkdirSync(docsAi, { recursive: true });
  fs.writeFileSync(path.join(docsAi, "ACEF_demo_DELIVERY_AUDIT.md"), "# Demo\n");
  fs.writeFileSync(path.join(docsAi, "ACEF_ACTIVE_LEDGER"), "docs/ai/ACEF_demo_DELIVERY_AUDIT.md\n");
  fs.writeFileSync(path.join(docsAi, "ACEF_CURRENT_CONTEXT.md"), "active_story: Story 1.1\n");

  const activeRun = {
    schema: "acef.active-run.v2",
    runId: "RUN-auth",
    repo: "authorization-fixture",
    workflowId: "lightweight",
    assuranceProfile: "guarded",
    scopeUnit: "story",
    assuranceRationale: "Authorization fixture exercises guarded assurance.",
    status: "active",
    activeStory: "Story 1.1",
    activePhase: "development",
    workerScopePath: "docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json",
    ledgerPath: "docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
    contextPath: "docs/ai/ACEF_CURRENT_CONTEXT.md",
  };
  const workerScope = {
    runId: "RUN-auth",
    activeStory: "Story 1.1",
    phase: "development",
    workerId: "dev-1",
    allowedPaths: ["src/**"],
    baseRef: "HEAD",
    maxCommits: 1,
    canEditLedger: false,
    canSpawnAgents: false,
  };
  writeJson(activeRunPath, activeRun);
  writeJson(workerScopePath, workerScope);

  const valid = inspectRunAuthorization(tmp, {
    requireWorkerScope: true,
    requireScopeRunId: true,
  });
  if (!valid.ok || valid.mode !== "typed") {
    throw new Error(`valid typed run was rejected: ${valid.blockers.join("; ")}`);
  }

  const { schema, workflowId, assuranceProfile, scopeUnit, assuranceRationale, ...legacyGuarded } = activeRun;
  writeJson(activeRunPath, { ...legacyGuarded, lane: "guarded" });
  const migrationRequired = inspectRunAuthorization(tmp, { requireScopeRunId: true });
  if (migrationRequired.ok || !migrationRequired.blockers.some((item) => item.includes("explicit workflow migration"))) {
    throw new Error("legacy guarded run did not fail closed for explicit workflow migration");
  }
  writeJson(activeRunPath, activeRun);

  writeJson(activeRunPath, { ...activeRun, status: "blocked" });
  const blocked = inspectRunAuthorization(tmp, { requireScopeRunId: true });
  if (blocked.ok || !blocked.blockers.some((item) => item.includes("status blocked"))) {
    throw new Error("blocked active run was not rejected");
  }
  writeJson(activeRunPath, activeRun);

  writeJson(workerScopePath, { ...workerScope, runId: "RUN-stale" });
  const stale = inspectRunAuthorization(tmp, { requireScopeRunId: true });
  if (stale.ok || !stale.blockers.some((item) => item.includes("does not match active run"))) {
    throw new Error("stale worker scope runId was not rejected");
  }
  writeJson(workerScopePath, workerScope);

  const epicCloseRun = {
    ...activeRun,
    workflowId: "full-bmad",
    fullFlowContract: "four-actor-v3",
    assuranceProfile: "baseline",
    scopeUnit: "epic",
    expectedStories: ["Story 1.1"],
    activeStory: "Epic closeout",
    activePhase: "epic-process-judge",
  };
  const finalStoryScope = { ...workerScope, activeStory: "Story 1.1", phase: "patch-assurance" };
  writeJson(activeRunPath, epicCloseRun);
  writeJson(workerScopePath, finalStoryScope);
  const strictEpicClose = inspectRunAuthorization(tmp, { requireScopeRunId: true });
  if (strictEpicClose.ok || !strictEpicClose.blockers.some((item) => item.includes("does not match active run"))) {
    throw new Error("final-story scope exception activated without an explicit epic-close opt-in");
  }
  const authorizedEpicClose = inspectRunAuthorization(tmp, {
    requireScopeRunId: true,
    allowFinalStoryScopeAtV3EpicClose: true,
  });
  if (!authorizedEpicClose.ok) {
    throw new Error(`valid final-story scope at v3 epic close was rejected: ${authorizedEpicClose.blockers.join("; ")}`);
  }
  writeJson(workerScopePath, { ...finalStoryScope, activeStory: "Story 9.9" });
  const foreignEpicScope = inspectRunAuthorization(tmp, {
    requireScopeRunId: true,
    allowFinalStoryScopeAtV3EpicClose: true,
  });
  if (foreignEpicScope.ok || !foreignEpicScope.blockers.some((item) => item.includes("does not match active run"))) {
    throw new Error("epic close accepted a worker scope outside the frozen story inventory");
  }
  writeJson(activeRunPath, activeRun);
  writeJson(workerScopePath, workerScope);

  const capsuleAtddRun = {
    ...activeRun,
    workflowId: "full-bmad",
    fullFlowContract: "four-actor-v3",
    runtimeContract: "capsule-supervisor-v1",
    expectedStories: ["Story 1.1"],
    activePhase: "atdd",
    workerRole: "test-author",
    activeActorId: null,
    nextAllowedStep: "write_failing_tests",
  };
  const capsuleAtddScope = {
    ...workerScope,
    phase: "atdd",
    workerId: "acef_story_1_1_atdd",
    allowedCommands: ["node --test tests/StoryTest.js"],
  };
  for (const controlPath of [
    ".acef/bin/acef-state",
    ".agents/skills/acef/SKILL.md",
    ".claude/skills/acef/SKILL.md",
    ".codex/skills/acef/SKILL.md",
    ".opencode/plugins/acef.js",
    "_bmad/core/workflow.xml",
    "_bmad-output/planning-artifacts/story.md",
    "docs/ai/ACEF_CURRENT_CONTEXT.md",
  ]) {
    writeJson(activeRunPath, capsuleAtddRun);
    writeJson(workerScopePath, {
      ...capsuleAtddScope,
      allowedPaths: ["tests/StoryTest.js", controlPath],
    });
    const controlOnlyImplementation = inspectRunAuthorization(tmp, {
      requireWorkerScope: true,
      requireScopeRunId: true,
    });
    if (controlOnlyImplementation.ok
      || !controlOnlyImplementation.blockers.some((item) => item.includes("non-control implementation path"))) {
      throw new Error(`capsule ATDD accepted control path as implementation scope: ${controlPath}`);
    }
  }
  writeJson(activeRunPath, capsuleAtddRun);
  writeJson(workerScopePath, {
    ...capsuleAtddScope,
    allowedPaths: ["tests/StoryTest.js", "src/story.js"],
  });
  const boundedImplementation = inspectRunAuthorization(tmp, {
    requireWorkerScope: true,
    requireScopeRunId: true,
  });
  if (!boundedImplementation.ok) {
    throw new Error(`capsule ATDD rejected a real implementation path: ${boundedImplementation.blockers.join("; ")}`);
  }

  const capsuleDevelopmentRun = {
    ...capsuleAtddRun,
    activePhase: "development",
    workerRole: "developer",
    activeActorId: null,
    nextAllowedStep: "implement_to_green",
    fullLedgerAccess: "denied",
    maxLines: 120,
  };
  const capsuleDevelopmentScope = {
    ...capsuleAtddScope,
    phase: "development",
    workerId: "acef_story_1_1_development",
    allowedPaths: ["tests/StoryTest.js", "src/story.js"],
  };
  writeJson(activeRunPath, capsuleDevelopmentRun);
  writeJson(workerScopePath, capsuleDevelopmentScope);
  const developmentPreActor = inspectRunAuthorization(tmp, {
    requireWorkerScope: true,
    requireScopeRunId: true,
  });
  if (!developmentPreActor.ok) {
    throw new Error(`capsule Development rejected its valid pre-actor state: ${developmentPreActor.blockers.join("; ")}`);
  }

  const staleAtddControlPlane = {
    ...capsuleDevelopmentRun,
    workerRole: "atdd",
    activeActorId: "acef_story_1_1_atdd",
    nextAllowedStep: "write_failing_tests",
  };
  writeJson(activeRunPath, staleAtddControlPlane);
  writeJson(workerScopePath, { ...capsuleDevelopmentScope, workerId: "acef_story_1_1_atdd" });
  const incoherentDevelopment = inspectRunAuthorization(tmp, {
    requireWorkerScope: true,
    requireScopeRunId: true,
  });
  for (const expected of [
    "requires workerRole developer",
    "requires nextAllowedStep implement_to_green",
    "worker scope workerId acef_story_1_1_atdd does not match canonical development actor",
    "activeActorId acef_story_1_1_atdd does not match canonical development actor",
  ]) {
    if (incoherentDevelopment.ok || !incoherentDevelopment.blockers.some((item) => item.includes(expected))) {
      throw new Error(`capsule Development did not reject stale ATDD binding: ${expected}`);
    }
  }

  const developerActorId = "acef_story_1_1_development";
  writeJson(path.join(docsAi, "actors", `${developerActorId}.json`), {
    actorInstanceId: developerActorId,
    runId: capsuleDevelopmentRun.runId,
    fullFlowContract: "four-actor-v3",
    storyInventory: capsuleDevelopmentRun.expectedStories,
    story: capsuleDevelopmentRun.activeStory,
    phase: "development",
    role: "developer",
    client: "codex",
    inputCommit: "fixture",
    allowedContextProfile: "development",
  });
  writeJson(activeRunPath, { ...capsuleDevelopmentRun, activeActorId: developerActorId });
  writeJson(workerScopePath, capsuleDevelopmentScope);
  const developmentActor = inspectRunAuthorization(tmp, {
    requireWorkerScope: true,
    requireScopeRunId: true,
  });
  if (!developmentActor.ok) {
    throw new Error(`capsule Development rejected its canonical actor: ${developmentActor.blockers.join("; ")}`);
  }

  writeJson(path.join(docsAi, "actors", `${developerActorId}.json`), {
    actorInstanceId: developerActorId,
    runId: capsuleDevelopmentRun.runId,
    fullFlowContract: "four-actor-v3",
    storyInventory: capsuleDevelopmentRun.expectedStories,
    story: capsuleDevelopmentRun.activeStory,
    phase: "atdd",
    role: "test-author",
    client: "codex",
    inputCommit: "fixture",
    allowedContextProfile: "atdd",
  });
  const wrongDeveloperActorRole = inspectRunAuthorization(tmp, {
    requireWorkerScope: true,
    requireScopeRunId: true,
  });
  if (wrongDeveloperActorRole.ok
    || !wrongDeveloperActorRole.blockers.some((item) => item.includes("actor record does not match"))) {
    throw new Error("capsule Development accepted a canonical actor id with stale ATDD role identity");
  }
  writeJson(activeRunPath, activeRun);
  writeJson(workerScopePath, workerScope);

  const durations = [];
  for (let index = 0; index < 500; index += 1) {
    const started = performance.now();
    const result = inspectRunAuthorization(tmp, {
      requireWorkerScope: true,
      requireScopeRunId: true,
    });
    durations.push(performance.now() - started);
    if (!result.ok) throw new Error(`authorization benchmark iteration failed: ${result.blockers.join("; ")}`);
  }
  const p95 = percentile(durations, 0.95);
  if (p95 > 50) throw new Error(`authorization p95 ${p95.toFixed(3)}ms exceeds 50ms budget`);

  fs.rmSync(activeRunPath);
  fs.rmSync(workerScopePath);
  fs.rmSync(path.join(docsAi, "ACEF_ACTIVE_LEDGER"));
  writeJson(path.join(docsAi, "ACEF_DIRECT_RUN.json"), {
    schema: "acef.direct-run.v1",
    version: "1.0.0",
    runId: "DIRECT-auth",
    lane: "direct",
    status: "active",
    scope: "Contained UI copy",
    acceptance: ["Requested copy is visible."],
    technicalBoundary: "localized-ui",
    reversible: true,
    riskTriggers: [],
    baseCommit: null,
    changedPaths: ["src/ui/copy.js"],
    verification: [],
    promotion: { decision: "stay-direct", reasons: [] },
  });
  const direct = inspectRunAuthorization(tmp, { allowDirect: true });
  if (!direct.ok || direct.mode !== "direct" || direct.contextPath !== "docs/ai/ACEF_DIRECT_RUN.json") {
    throw new Error(`valid direct run was rejected: ${direct.blockers.join("; ")}`);
  }

  console.log(`acef run authorization tests passed (p95=${p95.toFixed(3)}ms, n=500)`);
} finally {
  fs.rmSync(tmp, { recursive: true, force: true });
}
