#!/usr/bin/env node
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const cp = require("node:child_process");
const crypto = require("node:crypto");

const root = path.resolve(__dirname, "..");
const state = path.join(root, "scripts", "acef-state");
const supervisor = path.join(root, "scripts", "acef-supervisor");
const validator = path.join(root, "scripts", "acef-process-validator");
const status = path.join(root, "scripts", "acef-status");
const next = path.join(root, "scripts", "acef-next");
const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "acef-capsule-supervisor-"));
const unauthorizedDiscoveryMarker = path.join(os.tmpdir(), `acef-unauthorized-discovery-${process.pid}.txt`);

function quoteArg(value) {
  return /^[A-Za-z0-9_./:@%+=,-]+$/.test(value) ? value : `'${value.replaceAll("'", `'\\''`)}'`;
}

const demoDiscoveryCommand = [process.execPath, "-e", "console.log('demo contract')"].map(quoteArg).join(" ");
const otherDiscoveryCommand = [process.execPath, "-e", "console.log('other test')"].map(quoteArg).join(" ");

function run(command, args, options = {}) {
  return cp.execFileSync(command, args, { cwd: tmp, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], ...options });
}

function stateRun(args, options = {}) {
  return run(process.execPath, [state, ...args], options);
}

function git(args) {
  return run("git", args).trim();
}

function readJson(relativePath) {
  return JSON.parse(fs.readFileSync(path.join(tmp, relativePath), "utf8"));
}

const objectiveRelativePath = "docs/ai/objectives/OBJ-capsule.json";

function armObjectiveHeartbeat() {
  const objective = readJson(objectiveRelativePath);
  const before = objective.progress.activeControlSeconds;
  objective.progress.lastObservedAt = new Date(Date.now() - 10000).toISOString();
  fs.writeFileSync(path.join(tmp, objectiveRelativePath), `${JSON.stringify(objective, null, 2)}\n`);
  return before;
}

function assertObjectiveHeartbeat(before, label) {
  const after = readJson(objectiveRelativePath).progress.activeControlSeconds;
  if (after < before + 9 || after > before + 13) {
    throw new Error(`${label} objective heartbeat was missing or double-counted: before=${before} after=${after}`);
  }
}

try {
  git(["init", "-q"]);
  git(["config", "user.email", "acef@example.invalid"]);
  git(["config", "user.name", "ACEF Test"]);
  fs.mkdirSync(path.join(tmp, "app"), { recursive: true });
  fs.mkdirSync(path.join(tmp, "tests"), { recursive: true });
  fs.mkdirSync(path.join(tmp, "docs", "ai"), { recursive: true });
  fs.writeFileSync(path.join(tmp, "AGENTS.md"), "# Agent entry\n");
  fs.writeFileSync(path.join(tmp, "app", "demo.js"), "module.exports = false;\n");
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_CURRENT_CONTEXT.md"), "# Current Context\n- AC: demo becomes true\n- focused: node --test tests/demo.test.js\n");
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_capsule_DELIVERY_AUDIT.md"), "# Capsule audit\n");
  git(["add", "."]); git(["commit", "-qm", "fixture"]);
  const baseCommit = git(["rev-parse", "HEAD"]);

  stateRun(["active-run", "--repo", tmp, "--run-id", "RUN-capsule", "--workflow-id", "full-bmad",
    "--objective-id", "OBJ-capsule", "--objective-scope", "Deliver the bounded capsule lifecycle",
    "--full-flow-contract", "four-actor-v3", "--runtime-contract", "capsule-supervisor-v1",
    "--assurance", "guarded", "--assurance-rationale", "auth state transition", "--scope-unit", "story",
    "--expected-story", "Story Capsule", "--status", "active", "--story", "Story Capsule", "--phase", "atdd",
    "--ledger", "docs/ai/ACEF_capsule_DELIVERY_AUDIT.md", "--context", "docs/ai/ACEF_CURRENT_CONTEXT.md",
    "--worker-scope", "docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json"]);
  stateRun(["worker-scope", "--repo", tmp, "--story", "Story Capsule", "--phase", "atdd",
    "--worker-id", "acef_story_capsule_atdd", "--allow", "app/**", "--allow", "tests/**",
    "--allow-command", `${process.execPath} --test tests/demo.test.js`,
    "--allow-command", demoDiscoveryCommand,
    "--allow-command", otherDiscoveryCommand,
    "--surface", "integration", "--surface", "internal", "--surface", "notification",
    "--pattern-use", "new-reusable-pattern", "--requires-round-trip", "true",
    "--binding", "internal>internal:demo:true"]);

  const actorDir = path.join(tmp, "docs", "ai", "actors");
  fs.mkdirSync(actorDir, { recursive: true });
  fs.writeFileSync(path.join(actorDir, "legacy-other-story.json"), `${JSON.stringify({
    story: "Retired Story",
    phase: "atdd",
  }, null, 2)}\n`);
  fs.writeFileSync(path.join(actorDir, "other-run-current-story.json"), `${JSON.stringify({
    runId: "RUN-retired",
    story: "Story Capsule",
    phase: "atdd",
  }, null, 2)}\n`);
  const unrelatedActors = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  const actorDiagnostic = unrelatedActors.diagnostics.find((entry) => entry.code === "ignored-unrelated-actor-records");
  if (actorDiagnostic?.count !== 2
    || !actorDiagnostic.samplePaths.includes("docs/ai/actors/legacy-other-story.json")
    || !actorDiagnostic.samplePaths.includes("docs/ai/actors/other-run-current-story.json")) {
    throw new Error("supervisor did not prefilter and diagnose unrelated legacy actor records");
  }

  const evidenceDir = path.join(tmp, "docs", "ai", "evidence");
  fs.mkdirSync(evidenceDir, { recursive: true });
  fs.writeFileSync(path.join(evidenceDir, "legacy-other-story.json"), `${JSON.stringify({
    evidenceId: "legacy-other-story", story: "Retired Story", actorInstanceId: "legacy",
  }, null, 2)}\n`);
  const unrelatedEvidence = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  const evidenceDiagnostic = unrelatedEvidence.diagnostics.find((entry) => entry.code === "ignored-unrelated-evidence-records");
  if (evidenceDiagnostic?.count !== 1
    || !evidenceDiagnostic.samplePaths.includes("docs/ai/evidence/legacy-other-story.json")) {
    throw new Error("supervisor did not prefilter and diagnose unrelated legacy evidence records");
  }

  const currentRunMalformedActor = path.join(actorDir, "current-run-malformed.json");
  fs.writeFileSync(currentRunMalformedActor, `${JSON.stringify({
    runId: "RUN-capsule",
    story: "Different Story",
    phase: "atdd",
  }, null, 2)}\n`);
  const currentRunMalformedCheck = cp.spawnSync(process.execPath, [supervisor, "--repo", tmp], { cwd: tmp, encoding: "utf8" });
  if (currentRunMalformedCheck.status === 0
    || !`${currentRunMalformedCheck.stdout}${currentRunMalformedCheck.stderr}`.includes("current-run-malformed.json")) {
    throw new Error("supervisor did not fail closed for a malformed current-run actor candidate");
  }
  fs.rmSync(currentRunMalformedActor);

  const invalidRunIdentityActor = path.join(actorDir, "invalid-run-identity.json");
  fs.writeFileSync(invalidRunIdentityActor, `${JSON.stringify({
    runId: "",
    story: "Different Story",
    phase: "atdd",
  }, null, 2)}\n`);
  const invalidRunIdentityCheck = cp.spawnSync(process.execPath, [supervisor, "--repo", tmp], { cwd: tmp, encoding: "utf8" });
  if (invalidRunIdentityCheck.status === 0
    || !`${invalidRunIdentityCheck.stdout}${invalidRunIdentityCheck.stderr}`.includes("invalid-run-identity.json")) {
    throw new Error("supervisor treated a malformed run identity as an unrelated legacy actor");
  }
  fs.rmSync(invalidRunIdentityActor);

  const unidentifiedMalformedActor = path.join(actorDir, "unidentified-malformed.json");
  fs.writeFileSync(unidentifiedMalformedActor, "{not-json\n");
  const unidentifiedMalformedCheck = cp.spawnSync(process.execPath, [supervisor, "--repo", tmp], { cwd: tmp, encoding: "utf8" });
  if (unidentifiedMalformedCheck.status === 0
    || !`${unidentifiedMalformedCheck.stdout}${unidentifiedMalformedCheck.stderr}`.includes("unidentified-malformed.json")) {
    throw new Error("supervisor did not fail closed when malformed JSON could not identify an unrelated actor");
  }
  fs.rmSync(unidentifiedMalformedActor);

  const initialContext = fs.readFileSync(path.join(tmp, "docs", "ai", "ACEF_CURRENT_CONTEXT.md"), "utf8");
  if (!initialContext.includes("- Active story: `Story Capsule`")
    || !initialContext.includes("- Active phase: `atdd`")
    || !initialContext.includes("- `app/**`")
    || !initialContext.includes(`- \`${process.execPath} --test tests/demo.test.js\``)) {
    throw new Error("typed bootstrap did not synchronize the bounded Current Context");
  }

  const atddRun = readJson("docs/ai/ACEF_ACTIVE_RUN.json");
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), JSON.stringify({ ...atddRun, activePhase: "readiness" }, null, 2));
  const readiness = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  if (readiness.action.command !== ".acef/bin/acef-state phase-transition --repo . --phase atdd") {
    throw new Error("supervisor did not recover the deterministic readiness bootstrap phase");
  }
  stateRun(["phase-transition", "--repo", tmp, "--phase", "atdd"]);
  const atddDispatch = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  if (atddDispatch.action.type !== "dispatch" || atddDispatch.action.role !== "atdd"
    || atddDispatch.action.precheckCommand !== ".acef/bin/acef-state atdd-precheck --repo . --test-path 'tests/**'") {
    throw new Error("supervisor did not compile the bounded ATDD harness precheck");
  }

  fs.writeFileSync(path.join(tmp, "tests", "demo.test.js"), "const test = require('node:test'); const assert = require('node:assert'); test('demo contract', () => assert.strictEqual(require('../app/demo.js'), true));\n");
  stateRun(["atdd-precheck", "--repo", tmp, "--test-path", "tests/demo.test.js"]);
  const nestedArrowFixture = path.join(tmp, "tests", "NestedArrowTest.php");
  fs.writeFileSync(nestedArrowFixture, "<?php $count = 0; $run = fn() => call(function () use (&$count) { $count++; });\n");
  const nestedArrowCheck = cp.spawnSync(process.execPath, [state, "atdd-precheck", "--repo", tmp,
    "--test-path", "tests/NestedArrowTest.php"], { cwd: tmp, encoding: "utf8" });
  if (nestedArrowCheck.status === 0 || !`${nestedArrowCheck.stdout}${nestedArrowCheck.stderr}`.includes("outer arrow captures by value")) {
    throw new Error("ATDD precheck did not reject a nested arrow/by-reference observation trap");
  }
  fs.rmSync(nestedArrowFixture);
  git(["add", "tests/demo.test.js"]); git(["commit", "-qm", "red test"]);
  const unauthorizedDiscovery = cp.spawnSync(process.execPath, [state, "evidence-run", "--repo", tmp,
    "--id", "capsule-unauthorized-discovery", "--kind", "runtime-test",
    "--actor", "acef_story_capsule_atdd", "--story", "Story Capsule",
    "--satisfies", "story-capsule-ac1",
    "--discovery-command-json", JSON.stringify([process.execPath, "-e",
      `require('node:fs').writeFileSync(${JSON.stringify(unauthorizedDiscoveryMarker)}, 'executed')`]),
    "--expected-test", "demo contract",
    "--", process.execPath, "--test", "tests/demo.test.js"], { cwd: tmp, encoding: "utf8" });
  if (unauthorizedDiscovery.status === 0
    || !`${unauthorizedDiscovery.stdout}${unauthorizedDiscovery.stderr}`.includes("discovery command is not authorized")
    || fs.existsSync(unauthorizedDiscoveryMarker)
    || fs.existsSync(path.join(tmp, "docs", "ai", "evidence", "capsule-unauthorized-discovery.json"))) {
    throw new Error("unauthorized discovery command executed or left evidence state");
  }
  const red = cp.spawnSync(process.execPath, [state, "evidence-run", "--repo", tmp, "--id", "capsule-red",
    "--kind", "runtime-test", "--actor", "acef_story_capsule_atdd", "--story", "Story Capsule",
    "--model", "gpt-5.6-sol", "--effort", "high", "--satisfies", "story-capsule-ac1",
    "--discovery-command-json", JSON.stringify([process.execPath, "-e", "console.log('demo contract')"]),
    "--expected-test", "demo contract",
    "--", process.execPath, "--test", "tests/demo.test.js"], { cwd: tmp, encoding: "utf8" });
  if (red.status === 0 || !fs.existsSync(path.join(tmp, "docs", "ai", "evidence", "capsule-red.json"))) {
    throw new Error("red evidence was not captured");
  }
  const atddDone = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  if (atddDone.action.type !== "dispatch" || atddDone.action.role !== "development") {
    throw new Error("red evidence did not atomically advance the supervisor to Development dispatch");
  }
  const developmentScope = readJson("docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json");
  if (developmentScope.phase !== "development" || developmentScope.workerId !== "acef_story_capsule_development") {
    throw new Error("ATDD transition did not atomically rebind the typed worker scope to Development");
  }
  if (!fs.readFileSync(path.join(tmp, "docs", "ai", "ACEF_CURRENT_CONTEXT.md"), "utf8")
    .includes("- Active phase: `development`")) {
    throw new Error("phase transition left Current Context stale");
  }
  const developmentRun = readJson("docs/ai/ACEF_ACTIVE_RUN.json");
  if (developmentRun.workerRole !== "developer" || developmentRun.activeActorId !== null
    || developmentRun.nextAllowedStep !== "implement_to_green") {
    throw new Error("atomic RED handoff did not publish the Development role/action binding");
  }
  const developmentNext = JSON.parse(run(process.execPath, [next, "--repo", tmp]));
  if (developmentNext.status !== "ready" || developmentNext.active_state.next_allowed_action !== "implement_to_green"
    || developmentNext.allowed.can_write !== true
    || developmentNext.allowed.commands[0] !== `${process.execPath} --test tests/demo.test.js`) {
    throw new Error("acef-next did not expose the exact bounded Development action after RED");
  }
  const developmentDispatch = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  if (developmentDispatch.action.type !== "dispatch"
    || developmentDispatch.action.actorInstanceId !== "acef_story_capsule_development"
    || !developmentDispatch.action.registrationCommand.includes("--session-id /root/acef_story_capsule_development")
    || !developmentDispatch.action.registrationCommand.includes("--model gpt-5.6-sol --effort high")) {
    throw new Error("supervisor did not compile the canonical Development registration before dispatch");
  }
  const beforeDeveloperActor = armObjectiveHeartbeat();
  stateRun(["actor", "--repo", tmp, "--id", "acef_story_capsule_development", "--story", "Story Capsule",
    "--phase", "development", "--role", "developer", "--client", "codex", "--session-id", "/root/acef_story_capsule_development",
    "--context-profile", "development", "--model", "gpt-5.6-sol", "--effort", "high"]);
  assertObjectiveHeartbeat(beforeDeveloperActor, "Developer actor registration");

  const correctionHash = "a".repeat(64);
  const beforeCorrection = armObjectiveHeartbeat();
  stateRun(["atdd-correction-start", "--repo", tmp, "--findings-sha256", correctionHash]);
  assertObjectiveHeartbeat(beforeCorrection, "ATDD correction transition");
  const correction = readJson("docs/ai/corrections/acef_story_capsule_atdd_correction1.json");
  const correctionScope = readJson("docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json");
  if (correction.schema !== "acef.atdd-correction.v2"
    || correction.requestingActorId !== "acef_story_capsule_development"
    || correction.originalRedEvidenceId !== "capsule-red"
    || correction.baseCommit !== git(["rev-parse", "HEAD"])
    || correctionScope.phase !== "atdd-correction"
    || correctionScope.workerId !== "acef_story_capsule_atdd_correction1"
    || correctionScope.allowedPaths.some((entry) => !entry.startsWith("tests"))) {
    throw new Error("post-red ATDD correction did not freeze the requesting Developer, original red, and test-only scope");
  }
  const correctionCommit = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  if (correctionCommit.action.type !== "commit-control"
    || !correctionCommit.action.committedPaths.includes("docs/ai/corrections/acef_story_capsule_atdd_correction1.json")) {
    throw new Error("supervisor did not require the correction binding before dispatch");
  }
  run("/bin/sh", ["-c", correctionCommit.action.command]);
  const correctionDispatch = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  if (correctionDispatch.action.type !== "dispatch" || correctionDispatch.action.role !== "atdd-correction"
    || correctionDispatch.action.actorInstanceId !== "acef_story_capsule_atdd_correction1"
    || correctionDispatch.action.redEvidenceId !== "story_capsule-red-correction1"
    || correctionDispatch.action.stageCommand !== "git add -- 'tests/demo.test.js'"
    || !correctionDispatch.action.commitCommand.startsWith("git commit -m ")
    || !correctionDispatch.action.redEvidenceCommand.includes("--discovery-command-json")
    || !correctionDispatch.action.redEvidenceCommand.includes("demo contract")) {
    throw new Error("supervisor did not compile the bounded replayable ATDD correction dispatch");
  }
  fs.appendFileSync(path.join(tmp, "tests", "demo.test.js"), "// corrected semantic fixture\n");
  stateRun(["atdd-precheck", "--repo", tmp, "--test-path", "tests/demo.test.js"]);
  git(["add", "tests/demo.test.js"]); git(["commit", "-qm", "correct red test semantics"]);
  const wrongCorrectionId = cp.spawnSync(process.execPath, [state, "evidence-run", "--repo", tmp,
    "--id", "forged-correction-red", "--kind", "runtime-test",
    "--actor", "acef_story_capsule_atdd_correction1", "--story", "Story Capsule",
    "--model", "gpt-5.6-sol", "--effort", "high", "--satisfies", "story-capsule-ac1",
    "--discovery-command-json", JSON.stringify([process.execPath, "-e", "console.log('demo contract')"]),
    "--expected-test", "demo contract", "--", process.execPath, "--test", "tests/demo.test.js"],
  { cwd: tmp, encoding: "utf8" });
  if (wrongCorrectionId.status === 0
    || fs.existsSync(path.join(tmp, "docs", "ai", "actors", "acef_story_capsule_atdd_correction1.json"))
    || fs.existsSync(path.join(tmp, "docs", "ai", "evidence", "forged-correction-red.json"))) {
    throw new Error("post-red correction accepted a forged evidence identity or partially persisted actor/evidence state");
  }
  const correctedRed = cp.spawnSync(process.execPath, [state, "evidence-run", "--repo", tmp,
    "--id", "story_capsule-red-correction1", "--kind", "runtime-test",
    "--actor", "acef_story_capsule_atdd_correction1", "--story", "Story Capsule",
    "--model", "gpt-5.6-sol", "--effort", "high", "--satisfies", "story-capsule-ac1",
    "--discovery-command-json", JSON.stringify([process.execPath, "-e", "console.log('demo contract')"]),
    "--expected-test", "demo contract", "--", process.execPath, "--test", "tests/demo.test.js"],
  { cwd: tmp, encoding: "utf8" });
  if (correctedRed.status === 0
    || !fs.existsSync(path.join(tmp, "docs", "ai", "evidence", "story_capsule-red-correction1.json"))) {
    throw new Error("replacement red evidence was not captured by the fresh correction actor");
  }
  const correctionDone = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  if (correctionDone.action.type !== "resume" || correctionDone.action.role !== "development"
    || correctionDone.action.actorInstanceId !== "acef_story_capsule_development"
    || correctionDone.action.requiredFinalMarker !== "POST_RED_ATDD_CORRECTION=acef_story_capsule_atdd_correction1") {
    throw new Error("supervisor did not reactivate the original Developer with the correction marker");
  }
  fs.writeFileSync(path.join(tmp, "app", "demo.js"), "module.exports = 'almost';\n");
  git(["add", "app/demo.js"]); git(["commit", "-qm", "failed implementation"]);
  const failed = cp.spawnSync(process.execPath, [state, "evidence-run", "--repo", tmp, "--id", "capsule-failed",
    "--kind", "runtime-test", "--actor", "acef_story_capsule_development", "--story", "Story Capsule",
    "--satisfies", "story-capsule-ac1", "--", process.execPath, "--test", "tests/demo.test.js"], { cwd: tmp, encoding: "utf8" });
  if (failed.status === 0) throw new Error("failed implementation evidence unexpectedly passed");

  const missingDiscovery = cp.spawnSync(process.execPath, [state, "evidence-run", "--repo", tmp, "--id", "capsule-missing-discovery",
    "--kind", "runtime-test", "--actor", "acef_story_capsule_development", "--story", "Story Capsule",
    "--satisfies", "story-capsule-ac1", "--discovery-command-json", JSON.stringify([process.execPath, "-e", "console.log('other test')"]),
    "--expected-test", "demo contract", "--", process.execPath, "--test", "tests/demo.test.js"], { cwd: tmp, encoding: "utf8" });
  if (missingDiscovery.status === 0 || fs.existsSync(path.join(tmp, "docs", "ai", "evidence", "capsule-missing-discovery.json"))) {
    throw new Error("missing discovery test did not fail atomically");
  }

  fs.writeFileSync(path.join(tmp, "app", "demo.js"), "module.exports = true; // initial\n");
  git(["add", "app/demo.js"]); git(["commit", "-qm", "green implementation"]);
  stateRun(["evidence-run", "--repo", tmp, "--id", "capsule-green", "--kind", "runtime-test",
    "--actor", "acef_story_capsule_development", "--story", "Story Capsule", "--satisfies", "story-capsule-ac1",
    "--discovery-command-json", JSON.stringify([process.execPath, "-e", "console.log('demo contract')"]),
    "--expected-test", "demo contract", "--", process.execPath, "--test", "tests/demo.test.js"]);
  const developmentDone = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  if (developmentDone.action.type !== "transition" || developmentDone.action.nextPhase !== "code-review") {
    throw new Error("supervisor did not transition after the one Developer turn produced discovered green");
  }
  stateRun(["phase-transition", "--repo", tmp, "--phase", "code-review"]);
  const scopePreparation = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  if (scopePreparation.action.type !== "prepare-review-capsules" || scopePreparation.action.runtime !== null
    || scopePreparation.action.scopeCommand !== ".acef/bin/acef-state review-scope --repo ."
    || scopePreparation.action.capsuleCommands.length !== 2
    || !scopePreparation.action.capsuleCommands.every((command) => command.includes("--review-cycle 0"))) {
    throw new Error("supervisor did not select deterministic review-scope preparation");
  }
  stateRun(["review-scope", "--repo", tmp]);
  const reviewScope = readJson("docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json");
  if (reviewScope.phase !== "code-review"
    || JSON.stringify(reviewScope.surfaces) !== JSON.stringify(["integration", "internal", "notification"])) {
    throw new Error("review-scope did not preserve declared non-inferable surfaces alongside inferred surfaces");
  }
  git(["add", "docs/ai"]); git(["commit", "-qm", "review transition"]);
  const reviewBase = baseCommit;
  for (const role of ["code-review", "patch-assurance"]) {
    const id = `story-capsule-${role}`;
    const actor = `acef_story_capsule_${role.replaceAll("-", "_")}`;
    stateRun(["review-capsule", "--repo", tmp, "--id", id, "--role", role, "--actor", actor,
      "--base-commit", reviewBase, "--red-evidence", "story_capsule-red-correction1", "--green-evidence", "capsule-green"]);
    const first = fs.readFileSync(path.join(tmp, "docs", "ai", "capsules", `${id}.json`), "utf8");
    const referenceCapsule = JSON.parse(first);
    if (!referenceCapsule.sourceRefs?.length || referenceCapsule.sourceBlobs !== undefined) {
      throw new Error("review capsule duplicated source bodies instead of using commit-bound source references");
    }
    stateRun(["review-capsule", "--repo", tmp, "--id", id, "--role", role, "--actor", actor,
      "--base-commit", reviewBase, "--red-evidence", "story_capsule-red-correction1", "--green-evidence", "capsule-green"]);
    if (fs.readFileSync(path.join(tmp, "docs", "ai", "capsules", `${id}.json`), "utf8") !== first) {
      throw new Error("capsule generation is not byte-identical for the same tree");
    }
    stateRun(["capsule-show", "--repo", tmp, "--id", id]);
  }
  const reviewDispatch = JSON.parse(run(process.execPath, [supervisor, "--repo", tmp]));
  if (reviewDispatch.action.type !== "dispatch-parallel" || reviewDispatch.action.actors.length !== 2
    || reviewDispatch.action.concurrency?.minimum !== 1
    || reviewDispatch.action.concurrency?.fallback !== "sequential-same-input-tree"
    || reviewDispatch.action.actors.some((actor) => actor.runtime.model !== "gpt-5.6-sol"
      || actor.runtime.reasoningEffort !== (actor.role === "code-review" ? "medium" : "high")
      || !actor.capsule?.path.startsWith("docs/ai/capsules/") || !/^[a-f0-9]{64}$/.test(actor.capsule?.sha256 || "")
      || actor.capsule.showCommand !== `.acef/bin/acef-state capsule-show --repo . --id ${actor.capsule.id}`)) {
    throw new Error("supervisor did not emit the pinned parallel reviewer action");
  }
  if (reviewDispatch.modelPolicy.provider !== "openai" || reviewDispatch.modelPolicy.roles["code-review"].reasoningTier !== "medium"
    || !/^[a-f0-9]{64}$/.test(reviewDispatch.modelPolicy.policySha256 || "")) {
