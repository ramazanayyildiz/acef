  if (retryPreparation.action.type !== "prepare-review-capsules" || retryPreparation.action.reviewCycle !== 1
    || JSON.stringify(retryPreparation.action.roles) !== JSON.stringify(["patch-assurance"])
    || retryPreparation.action.capsuleCommands.length !== 1
    || !retryPreparation.action.capsuleCommands.every((command) => command.includes("--repair-receipt docs/ai/repairs/story_capsule-repair1.json"))) {
    throw new Error("supervisor did not retain Code Review PASS for a test-only repair");
  }

  const capsulePath = path.join(tmp, "docs", "ai", "capsules", "story-capsule-code-review.json");
  const tampered = JSON.parse(fs.readFileSync(capsulePath, "utf8"));
  tampered.reviewPolicy.push("tamper");
  fs.writeFileSync(capsulePath, `${JSON.stringify(tampered, null, 2)}\n`);
  const tamperCheck = cp.spawnSync(process.execPath, [state, "capsule-show", "--repo", tmp, "--id", "story-capsule-code-review"], { cwd: tmp, encoding: "utf8" });
  if (tamperCheck.status === 0 || !`${tamperCheck.stdout}${tamperCheck.stderr}`.includes("payload hash mismatch")) {
    throw new Error("tampered capsule did not fail closed");
  }
  const certificationCheck = cp.spawnSync(process.execPath, [validator, "--repo", tmp, "--check", "gate-verdict"], { cwd: tmp, encoding: "utf8" });
  if (certificationCheck.status === 0 || !`${certificationCheck.stdout}${certificationCheck.stderr}`.includes("capsule")) {
    throw new Error("process certification did not fail closed on a corrupted bound capsule");
  }
  const malformedStateCheck = cp.spawnSync(process.execPath, [supervisor, "--repo", tmp], { cwd: tmp, encoding: "utf8" });
  if (malformedStateCheck.status === 0 || !`${malformedStateCheck.stdout}${malformedStateCheck.stderr}`.includes("story-capsule-code-review.json")) {
    throw new Error("supervisor silently ignored malformed typed state");
  }

  console.log("acef capsule supervisor tests passed");
} finally {
  fs.rmSync(tmp, { recursive: true, force: true });
  fs.rmSync(unauthorizedDiscoveryMarker, { force: true });
}
