#!/usr/bin/env python3
"""acef-session-rotation: Claude Code SessionStart hook (matcher resume|compact).

Long-running sessions lose detail at every compaction and re-read a growing context on every turn
(method/MODEL_CHOICE.md, Waiting). When a session has had ROTATE_COMPACTIONS compactions, or has been open
ROTATE_HOURS hours, this prints a note into the session's context: write the handoff note and continue in a new
session. It also sends the owner one macOS notification per new compaction count (state in
~/.local/state/acef-rotation). Silent otherwise. Never fails the session: always exit 0.

Test: echo '{"session_id":"x","transcript_path":"<file>","source":"compact"}' | acef-session-rotation
"""
import json
import os
import subprocess
import sys
import time
from datetime import datetime

ROTATE_COMPACTIONS = 3
ROTATE_HOURS = 24
NOTIFIER = os.environ.get("ACEF_ROTATION_NOTIFIER", "/opt/homebrew/bin/terminal-notifier")
STATE = os.path.expanduser(os.environ.get("ACEF_ROTATION_STATE", "~/.local/state/acef-rotation"))


def scan(path):
    """Whole-transcript compaction count and first timestamp (epoch s or None)."""
    count, first = 0, None
    with open(path, "rb") as f:
        for raw in f:
            if first is None and b'"timestamp"' in raw:
                try:
                    first = datetime.fromisoformat(json.loads(raw)["timestamp"].replace("Z", "+00:00")).timestamp()
                except Exception:
                    pass
            if b"compact_boundary" in raw:
                try:
                    d = json.loads(raw)
                except Exception:
                    continue
                if d.get("type") == "system" and d.get("subtype") == "compact_boundary":
                    count += 1
    return count, first


def main():
    try:
        inp = json.loads(sys.stdin.read() or "{}")
    except Exception:
        return
    path, sid = inp.get("transcript_path") or "", inp.get("session_id") or ""
    if not path or not os.path.isfile(path):
        return
    count, first = scan(path)
    hours = (time.time() - first) / 3600 if first else 0
    if count < ROTATE_COMPACTIONS and hours < ROTATE_HOURS:
        return
    why = f"{count} compactions" + (f", open {hours:.0f} h" if hours >= 1 else "")
    print(f"ACEF session rotation due ({why}; rule: {ROTATE_COMPACTIONS} compactions or {ROTATE_HOURS} h, "
          "method/MODEL_CHOICE.md, Waiting). If this is a long-running coordinator or main session: finish the "
          "current step, write the project's handoff note (HANDOFF.md or the file the project names) with the live "
          "state, open items and any decision that so far exists only in this chat, then tell the owner in one line "
          "to continue in a new session that starts from that note. A worker on a single item finishes its item first.")
    key = "".join(c for c in sid if c.isalnum() or c in "-_")[:80]
    if not key or not os.path.exists(NOTIFIER):
        return
    os.makedirs(STATE, exist_ok=True)
    mark = os.path.join(STATE, key)
    try:
        seen = int(open(mark).read().strip() or -1)
    except Exception:
        seen = -1
    if count <= seen:
        return
    with open(mark, "w") as f:
        f.write(str(count))
    title = os.path.basename(inp.get("cwd") or os.getcwd()) or "session"
    subprocess.run([NOTIFIER, "-title", "Yeni oturuma geç", "-message",
                    f"{title}: {why}. Handoff yazılsın, yeni oturum açılsın."],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
