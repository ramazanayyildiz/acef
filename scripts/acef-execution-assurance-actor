#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const cp = require("node:child_process");
const { sha256 } = require("./lib/acef-execution-assurance-experiment");

function writeJsonAtomic(filePath, value) {
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  const temporary = `${filePath}.${process.pid}.tmp`;
  fs.writeFileSync(temporary, `${JSON.stringify(value, null, 2)}\n`);
  fs.renameSync(temporary, filePath);
}

function groupAlive(pid) {
  try { process.kill(-pid, 0); return true; } catch { return false; }
}

function stopGroup(pid, signal) {
  try { process.kill(-pid, signal); } catch (error) {
    if (error.code !== "ESRCH") throw error;
  }
}

function wait(milliseconds) {
  return new Promise((resolve) => setTimeout(resolve, milliseconds));
}

function findSessionTranscript(root, threadId) {
  if (!root || !threadId || !fs.existsSync(root)) return null;
  const pending = [root];
  while (pending.length) {
    const directory = pending.pop();
    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
      const fullPath = path.join(directory, entry.name);
      if (entry.isDirectory()) pending.push(fullPath);
      else if (entry.isFile() && entry.name.includes(threadId) && entry.name.endsWith(".jsonl")) return fullPath;
    }
  }
  return null;
}

function livePolicyMonitor(request) {
  const policy = request.livePolicy;
  if (!policy) return () => null;
  if (policy.schema !== "acef.execution-assurance-live-policy.v1"
    || !Array.isArray(policy.allowedFollowupTargets) || !policy.allowedFollowupTargets.length
    || policy.allowedFollowupTargets.some((entry) => typeof entry !== "string" || !entry)) {
    throw new Error("invalid live policy contract");
  }
  const allowedTargets = new Set(policy.allowedFollowupTargets);
  const sessionRoot = policy.sessionRoot
    || path.join(process.env.CODEX_HOME || path.join(require("node:os").homedir(), ".codex"), "sessions");
  let threadId = "";
  let transcriptPath = "";
  let offset = 0;
  let remainder = "";
  return () => {
    if (!threadId && fs.existsSync(request.stdoutPath)) {
      for (const line of fs.readFileSync(request.stdoutPath, "utf8").split(/\r?\n/).filter(Boolean)) {
        try {
          const event = JSON.parse(line);
          if (event.type === "thread.started" && event.thread_id) { threadId = event.thread_id; break; }
        } catch {}
      }
    }
    if (threadId && !transcriptPath) transcriptPath = findSessionTranscript(sessionRoot, threadId) || "";
    if (!transcriptPath || !fs.existsSync(transcriptPath)) return null;
    const size = fs.statSync(transcriptPath).size;
    if (size < offset) { offset = 0; remainder = ""; }
    if (size === offset) return null;
    const length = size - offset;
    const buffer = Buffer.alloc(length);
    const descriptor = fs.openSync(transcriptPath, "r");
    try { fs.readSync(descriptor, buffer, 0, length, offset); } finally { fs.closeSync(descriptor); }
    offset = size;
    const rows = `${remainder}${buffer.toString("utf8")}`.split(/\r?\n/);
    remainder = rows.pop() || "";
    for (const line of rows) {
      let event;
      try { event = JSON.parse(line); } catch { continue; }
      const payload = event.payload || {};
      if (event.type !== "response_item" || payload.type !== "function_call"
        || payload.namespace !== "collaboration" || payload.name !== "followup_task") continue;
      let args = {};
      try { args = JSON.parse(payload.arguments || "{}"); } catch {}
      const target = String(args.target || "");
      if (!allowedTargets.has(target)) {
        return {
          code: "FORBIDDEN_FOLLOWUP_TARGET",
          callId: payload.call_id || null,
          target,
          threadId,
          observedAt: event.timestamp || new Date().toISOString(),
        };
      }
    }
    return null;
  };
}

async function runCaptured(request, onSpawn) {
  fs.mkdirSync(path.dirname(request.stdoutPath), { recursive: true });
  fs.mkdirSync(path.dirname(request.stderrPath), { recursive: true });
  const stdoutFd = fs.openSync(request.stdoutPath, "w");
  const stderrFd = fs.openSync(request.stderrPath, "w");
  const child = cp.spawn(request.command, request.args, {
    cwd: request.cwd,
    env: process.env,
    detached: true,
    stdio: ["ignore", stdoutFd, stderrFd],
  });
  onSpawn(child.pid);
  let timedOut = false;
  let policyViolation = null;
  let forceKillTimer = null;
  const checkLivePolicy = livePolicyMonitor(request);
  const policyTimer = setInterval(() => {
    if (policyViolation) return;
    try { policyViolation = checkLivePolicy(); } catch (error) {
      policyViolation = { code: "LIVE_POLICY_MONITOR_ERROR", reason: error.message, observedAt: new Date().toISOString() };
    }
    if (policyViolation) {
      stopGroup(child.pid, "SIGTERM");
      if (!forceKillTimer) forceKillTimer = setTimeout(() => stopGroup(child.pid, "SIGKILL"), 1000);
    }
  }, 250);
  const timer = setTimeout(() => {
    timedOut = true;
    stopGroup(child.pid, "SIGTERM");
    forceKillTimer = setTimeout(() => stopGroup(child.pid, "SIGKILL"), 1000);
  }, Number(request.timeoutMs || 120000));
  const outcome = await new Promise((resolve, reject) => {
    child.once("error", reject);
    child.once("exit", (code, signal) => resolve({ code, signal }));
  }).finally(() => {
    clearTimeout(timer);
    clearInterval(policyTimer);
    if (forceKillTimer) clearTimeout(forceKillTimer);
  });
  if (groupAlive(child.pid)) {
    stopGroup(child.pid, "SIGTERM");
    await wait(250);
  }
  if (groupAlive(child.pid)) {
    stopGroup(child.pid, "SIGKILL");
    for (let index = 0; index < 20 && groupAlive(child.pid); index += 1) await wait(50);
  }
  fs.closeSync(stdoutFd);
  fs.closeSync(stderrFd);
  if (groupAlive(child.pid)) throw new Error(`actor process group ${child.pid} did not quiesce`);
  return {
    status: Number.isInteger(outcome.code) ? outcome.code : 1,
    signal: outcome.signal || (timedOut ? "SIGTERM" : null),
    timedOut,
    policyViolation,
  };
}

async function main() {
  const requestPath = process.argv[2];
  if (!requestPath) throw new Error("actor request path is required");
  const requestBytes = fs.readFileSync(requestPath, "utf8");
  const request = JSON.parse(requestBytes);
  const startedAt = new Date().toISOString();
  const recordStart = (processGroupPid = null) => request.startPath && writeJsonAtomic(request.startPath, {
    schema: "acef.execution-assurance-actor-start.v1",
    requestPath,
    requestSha256: sha256(requestBytes),
    launchNonce: request.launchNonce || null,
    supervisorPid: process.pid,
    processGroupPid,
    startedAt,
  });
  recordStart();
  const result = await runCaptured(request, (processGroupPid) => recordStart(processGroupPid));
  writeJsonAtomic(request.receiptPath, {
    schema: "acef.execution-assurance-actor-receipt.v1",
    requestPath,
    requestSha256: sha256(requestBytes),
    launchNonce: request.launchNonce || null,
    startedAt,
    finishedAt: new Date().toISOString(),
    status: result.status,
    signal: result.signal,
    timedOut: result.timedOut,
    policyViolation: result.policyViolation,
  });
}

main().catch((error) => {
  console.error(error.stack || error.message);
  process.exitCode = 1;
});
