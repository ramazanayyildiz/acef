#!/usr/bin/env node
"use strict";

const assert = require("node:assert/strict");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const cp = require("node:child_process");
const {
  NATIVE_ACTIVE_SECONDS,
  NATIVE_CLOSEOUT_TIMEOUT_SECONDS,
  NATIVE_FOCUSED_COMMAND_LIMIT,
  NATIVE_FOCUSED_TIMEOUT_SECONDS,
  NATIVE_REPEAT_LIMIT,
  classifyNativeVerification,
  freshNativeBudget,
  nativeBudgetFailure,
  unwrapWorktreeTest,
} = require("./lib/acef-native-speed");

const wrapper = path.resolve(__dirname, "acef-native-test");
const worktreeRunnerSource = path.resolve(__dirname, "acef-worktree-test");

assert.equal(NATIVE_FOCUSED_COMMAND_LIMIT, 3);
assert.equal(NATIVE_REPEAT_LIMIT, 2);
assert.equal(NATIVE_ACTIVE_SECONDS, 600);
assert.equal(NATIVE_FOCUSED_TIMEOUT_SECONDS, 180);
assert.equal(NATIVE_CLOSEOUT_TIMEOUT_SECONDS, 1800);
assert.equal(classifyNativeVerification(["php", "artisan", "test", "--testsuite=Feature"]).kind, "broad");
assert.equal(classifyNativeVerification(["php", "artisan", "test", "tests/Feature/OneTest.php"]).kind, "focused");
assert.equal(classifyNativeVerification(["vendor/bin/phpstan", "analyse", "--configuration=phpstan.neon"]).kind, "broad");
assert.equal(classifyNativeVerification(["vendor/bin/phpstan", "analyse", "app/Services/One.php"]).kind, "focused");
const wrappedFocused = [".acef/bin/acef-worktree-test", "--work-unit", "child-a", "--",
  "php", "artisan", "test", "--filter=WrappedCase", "--", "--preserve"];
assert.equal(classifyNativeVerification(wrappedFocused).kind, "focused");
assert.equal(classifyNativeVerification(wrappedFocused).identity,
  "php artisan test --filter=WrappedCase -- --preserve");
assert.match(unwrapWorktreeTest(["acef-worktree-test", "--work-unit", "child-a"]).error, /requires -- before/);
assert.match(unwrapWorktreeTest(["acef-worktree-test", "--bad", "--", "php"]).error, /unsupported option/);
assert.match(unwrapWorktreeTest(["acef-worktree-test", "--work-unit", "--", "php"]).error, /missing --work-unit value/);
assert.match(unwrapWorktreeTest(["acef-worktree-test", "--work-unit", "child-a", "--"]).error, /requires a test command/);
const idleBudget = freshNativeBudget("/repo", "a".repeat(40), "main", "idle", Date.now() - 60 * 60 * 1000);
assert.equal(nativeBudgetFailure(idleBudget, { kind: "focused", identity: "focused" }), "",
  "wall-clock idle time must not consume the active command budget");
idleBudget.activeMilliseconds = NATIVE_ACTIVE_SECONDS * 1000;
assert.match(nativeBudgetFailure(idleBudget, { kind: "focused", identity: "focused" }), /active test budget exceeded/);

function repoFixture() {
  const repo = fs.mkdtempSync(path.join(os.tmpdir(), "acef-native-speed-"));
  cp.execFileSync("git", ["init", "-q"], { cwd: repo });
  cp.execFileSync("git", ["config", "user.email", "acef@example.invalid"], { cwd: repo });
  cp.execFileSync("git", ["config", "user.name", "ACEF Test"], { cwd: repo });
  fs.writeFileSync(path.join(repo, "README.md"), "fixture\n");
  const bin = path.join(repo, "fake-bin");
  fs.mkdirSync(bin);
  const php = path.join(bin, "php");
  fs.writeFileSync(php, "#!/usr/bin/env node\nconst fs=require('node:fs');fs.mkdirSync('.acef',{recursive:true});fs.writeFileSync('.acef/php-argv.json', JSON.stringify(process.argv.slice(2)));\nprocess.exit(0);\n");
  fs.chmodSync(php, 0o755);
  const worktreeBin = path.join(repo, ".acef", "bin");
  fs.mkdirSync(worktreeBin, { recursive: true });
  const worktreeRunner = path.join(worktreeBin, "acef-worktree-test");
  fs.copyFileSync(worktreeRunnerSource, worktreeRunner);
  fs.chmodSync(worktreeRunner, 0o755);
  cp.execFileSync("git", ["add", "README.md", "fake-bin/php", ".acef/bin/acef-worktree-test"], { cwd: repo });
  cp.execFileSync("git", ["commit", "-qm", "fixture"], { cwd: repo });
  return { repo, env: { ...process.env, PATH: `${bin}${path.delimiter}${process.env.PATH}` } };
}

function run(fixture, args) {
  return cp.spawnSync(process.execPath, [wrapper, ...args], {
    cwd: fixture.repo,
    env: fixture.env,
    encoding: "utf8",
  });
}

const repeated = repoFixture();
try {
  const command = ["--", "php", "artisan", "test", "--filter=FocusedCase"];
  assert.equal(run(repeated, command).status, 0);
  assert.equal(run(repeated, command).status, 0);
  const third = run(repeated, command);
  assert.equal(third.status, 2);
  assert.match(third.stderr, /repeat budget exceeded/);
} finally {
  fs.rmSync(repeated.repo, { recursive: true, force: true });
}

const distinct = repoFixture();
try {
  for (const name of ["One", "Two", "Three"]) {
    assert.equal(run(distinct, ["--", "php", "artisan", "test", `--filter=${name}`]).status, 0);
  }
  const fourth = run(distinct, ["--", "php", "artisan", "test", "--filter=Four"]);
  assert.equal(fourth.status, 2);
  assert.match(fourth.stderr, /focused-command budget exceeded/);
} finally {
  fs.rmSync(distinct.repo, { recursive: true, force: true });
}

const splitChildren = repoFixture();
try {
  const focused = ["--", "php", "artisan", "test", "--filter=FocusedCase"];
  assert.equal(run(splitChildren, ["--work-unit", "child-a", ...focused]).status, 0);
  assert.equal(run(splitChildren, ["--work-unit", "child-a", ...focused]).status, 0);
  assert.equal(run(splitChildren, ["--work-unit", "child-a", ...focused]).status, 2);
  assert.equal(run(splitChildren, ["--work-unit", "child-b", ...focused]).status, 0,
    "an independently admitted split child must receive its own native verification budget");
} finally {
  fs.rmSync(splitChildren.repo, { recursive: true, force: true });
}

const wrapped = repoFixture();
try {
  const inner = ["php", "artisan", "test", "--filter=WrappedCase", "--", "--preserve"];
  const command = ["--work-unit", "child-a", "--", ".acef/bin/acef-worktree-test", "--work-unit", "child-a", "--", ...inner];
  assert.equal(run(wrapped, command).status, 0, "a documented worktree wrapper composition must execute");
  const runtimeRoot = path.resolve(wrapped.repo, cp.execFileSync("git", ["rev-parse", "--git-path", "acef-runtime"], { cwd: wrapped.repo, encoding: "utf8" }).trim());
  const receiptDir = fs.readdirSync(runtimeRoot).at(0);
  const receipt = JSON.parse(fs.readFileSync(path.join(runtimeRoot, receiptDir, "last-run.json"), "utf8"));
  assert.equal(receipt.workUnit, "child-a");
  assert.deepEqual(receipt.command, inner);
  assert.deepEqual(JSON.parse(fs.readFileSync(path.join(wrapped.repo, ".acef", "php-argv.json"), "utf8")), inner.slice(1));
  const stateRoot = path.resolve(wrapped.repo, cp.execFileSync("git", ["rev-parse", "--git-path", "acef-native-speed"], { cwd: wrapped.repo, encoding: "utf8" }).trim());
  const stateFile = path.join(stateRoot, fs.readdirSync(stateRoot).find((name) => name.startsWith("state-") && name.endsWith(".json")));
  const state = JSON.parse(fs.readFileSync(stateFile, "utf8"));
  assert.equal(state.workUnitId, "child-a");
  assert.equal(state.commands["php artisan test --filter=WrappedCase -- --preserve"], 1);
  const broadNested = run(wrapped, ["--work-unit", "child-b", "--", ".acef/bin/acef-worktree-test", "--work-unit", "child-b", "--",
    "php", "artisan", "test", "--testsuite=Feature"]);
  assert.equal(broadNested.status, 2);
  assert.match(broadNested.stderr, /broad verification is forbidden/);
  const malformed = run(wrapped, ["--", ".acef/bin/acef-worktree-test", "--bogus", "--", ...inner]);
  assert.equal(malformed.status, 2);
  assert.match(malformed.stderr, /recognized test or static-analysis commands/);
  const missingWorkUnit = run(wrapped, ["--", ".acef/bin/acef-worktree-test", "--work-unit", "--", ...inner]);
  assert.equal(missingWorkUnit.status, 2);
  const missing = run(wrapped, ["--", ".acef/bin/acef-worktree-test", "--work-unit", "child-a", "--"]);
  assert.equal(missing.status, 2);
} finally {
  fs.rmSync(wrapped.repo, { recursive: true, force: true });
}

const equivalent = repoFixture();
try {
  const raw = ["--", "php", "artisan", "test", "--filter=SameCase"];
  const nested = ["--", ".acef/bin/acef-worktree-test", "--work-unit", "focused", "--", ...raw.slice(1)];
  assert.equal(run(equivalent, raw).status, 0);
  assert.equal(run(equivalent, nested).status, 0);
  const third = run(equivalent, raw);
  assert.equal(third.status, 2);
  assert.match(third.stderr, /repeat budget exceeded/);
} finally {
  fs.rmSync(equivalent.repo, { recursive: true, force: true });
}

const broad = repoFixture();
try {
  const args = ["--", "php", "artisan", "test", "--testsuite=Feature"];
  const early = run(broad, args);
  assert.equal(early.status, 2);
  assert.match(early.stderr, /broad verification is forbidden/);
  fs.mkdirSync(path.join(broad.repo, ".acef"), { recursive: true });
  fs.writeFileSync(path.join(broad.repo, ".acef", "installed-runtime.txt"), "control-only\n");
  assert.equal(run(broad, ["--closeout", ...args]).status, 0);
  const repeatedBroad = run(broad, ["--closeout", ...args]);
  assert.equal(repeatedBroad.status, 2);
  assert.match(repeatedBroad.stderr, /already ran once/);
} finally {
  fs.rmSync(broad.repo, { recursive: true, force: true });
}

const dirtyProduct = repoFixture();
try {
  fs.writeFileSync(path.join(dirtyProduct.repo, "product.php"), "<?php\n");
  const denied = run(dirtyProduct, ["--closeout", "--", "php", "artisan", "test", "--testsuite=Feature"]);
  assert.equal(denied.status, 2);
  assert.match(denied.stderr, /clean application\/test tree/);
} finally {
  fs.rmSync(dirtyProduct.repo, { recursive: true, force: true });
}

console.log("acef native speed contract tests passed");
