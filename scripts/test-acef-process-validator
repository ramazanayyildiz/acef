    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "needs-scope.ts"),
      content: "export const blocked = true;\n",
    },
  }, "deny", workerEnv);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), JSON.stringify({
    runId: "RUN-hook",
    repo: "fixture",
    lane: "full-bmad",
    status: "active",
    activeStory: "1.1",
    activePhase: "development",
    workerScopePath: "docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json",
    ledgerPath: "docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
    contextPath: "docs/ai/ACEF_CURRENT_CONTEXT.md",
  }, null, 2));
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json"), JSON.stringify({
    runId: "RUN-hook",
    activeStory: "1.1",
    phase: "dev",
    workerId: "other-worker",
    allowedPaths: ["src/**", "tests/**"],
    baseRef: "HEAD",
    maxCommits: 1,
    canEditLedger: false,
    canSpawnAgents: false,
  }, null, 2));
  expectHookDecision("worker identity mismatch explains active scope", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "wrong-worker.ts"),
      content: "export const blocked = true;\n",
    },
  }, "deny", workerEnv, [
    "active worker scope is assigned to a different worker identity",
    "Active worker scope: activeStory=1.1; phase=dev; workerId=other-worker; allowedPaths=src/**, tests/**.",
    "If this is not an active ACEF run, close the stale lane marker",
  ]);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json"), JSON.stringify({
    runId: "RUN-hook",
    activeStory: "1.1",
    phase: "dev",
    workerId: "ACEF_BMAD_WORKER",
    allowedPaths: ["src/**", "tests/**"],
    baseRef: "HEAD",
    maxCommits: 1,
    canEditLedger: false,
    canSpawnAgents: false,
  }, null, 2));
  expectHookDecision("worker outside active story scope denied", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "app", "Models", "OutOfScope.php"),
      content: "<?php\n",
    },
  }, "deny", workerEnv, [
    "outside allowedPaths for Story 1.1",
    "Requested implementation path(s): app/Models/OutOfScope.php.",
    "If this is not an active ACEF run, close the stale lane marker",
  ]);
  expectHookDecision("worker apply_patch outside active story scope denied", {
    tool_name: "apply_patch",
    cwd: tmp,
    tool_input: {
      patch: [
        "*** Begin Patch",
        "*** Add File: app/Models/OutOfScope.php",
        "+<?php",
        "*** End Patch",
      ].join("\n"),
    },
  }, "deny", workerEnv);
  expectHookDecision("worker commit must cite active story", {
    tool_name: "Bash",
    cwd: tmp,
    tool_input: {
      command: "git commit -m 'feat: Story 1.2 wrong story'",
      cwd: tmp,
    },
  }, "deny", workerEnv);
  expectHookDecision("P1 conformance allows source write", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "new-service.ts"),
      content: "export const ok = true;\n",
    },
  }, "allow", workerEnv);
  const hookRunPath = path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  const hookRun = JSON.parse(fs.readFileSync(hookRunPath, "utf8"));
  fs.writeFileSync(hookRunPath, JSON.stringify({ ...hookRun, status: "blocked" }, null, 2));
  expectHookDecision("blocked active run denies implementation write", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "blocked-run.ts"),
      content: "export const blocked = true;\n",
    },
  }, "deny", workerEnv, ["active run status blocked is not authorized"]);
  fs.writeFileSync(hookRunPath, JSON.stringify(hookRun, null, 2));
  const hookScopePath = path.join(tmp, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json");
  const hookScope = JSON.parse(fs.readFileSync(hookScopePath, "utf8"));
  fs.writeFileSync(hookScopePath, JSON.stringify({ ...hookScope, runId: "RUN-stale" }, null, 2));
  expectHookDecision("stale worker runId denies implementation write", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "stale-run.ts"),
      content: "export const blocked = true;\n",
    },
  }, "deny", workerEnv, ["worker scope runId RUN-stale does not match active run RUN-hook"]);
  fs.writeFileSync(hookScopePath, JSON.stringify(hookScope, null, 2));

  // --- Identity-absent graceful degradation -------------------------------------------
  // The harness (e.g. Claude Code subagents) does not propagate worker identity into hook
  // env. With no identity, the hard wall must degrade from per-actor to scope-level gating
  // rather than fail-closed on every guarded write. The P1-conformance fixtures established
  // above remain in place, so these cases exercise only the identity/scope decision.
  const noIdentityEnv = {
    ACEF_BMAD_WORKER: "",
    ACEF_ROLE: "",
    ACEF_WORKER_ID: "",
    CLAUDE_AGENT_NAME: "",
    CLAUDE_SUBAGENT_NAME: "",
    OPENCODE_AGENT_NAME: "",
    AGENT_NAME: "",
  };
  function writeWorkerScope(overrides) {
    fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json"), JSON.stringify({
      runId: "RUN-hook",
      activeStory: "1.1",
      phase: "development",
      workerId: "ACEF_BMAD_WORKER",
      allowedPaths: ["src/**", "tests/**"],
      baseRef: "HEAD",
      maxCommits: 1,
      canEditLedger: false,
      canSpawnAgents: false,
      ...overrides,
    }, null, 2));
  }

  // (a) no identity + dev-phase scope + path in allowedPaths -> ALLOW
  writeWorkerScope({ phase: "development", allowedPaths: ["src/**", "tests/**"] });
  expectHookDecision("identity fallback allows dev-phase write inside allowedPaths", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "fallback-ok.ts"),
      content: "export const ok = true;\n",
    },
  }, "allow", noIdentityEnv, ["worker identity not propagated by harness"]);

  // (b) no identity + non-implementation phase (process-judge) -> DENY
  writeWorkerScope({ phase: "process-judge" });
  expectHookDecision("identity fallback denies non-dev phase write", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "fallback-phase.ts"),
      content: "export const blocked = true;\n",
    },
  }, "deny", noIdentityEnv, [
    "does not permit implementation writes",
    "set a developer scope via 'acef-state worker-scope'",
  ]);

  // (c) no identity + dev phase but path outside allowedPaths -> DENY
  writeWorkerScope({ phase: "development", allowedPaths: ["lib/**"] });
  expectHookDecision("identity fallback denies write outside allowedPaths", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "fallback-outside.ts"),
      content: "export const blocked = true;\n",
    },
  }, "deny", noIdentityEnv, ["outside allowedPaths for Story 1.1"]);

  // (d) identity present (ACEF_WORKER_ID) matching scope.workerId -> ALLOW
  writeWorkerScope({ phase: "development", workerId: "dev-worker-7", allowedPaths: ["src/**"] });
  expectHookDecision("identity present matching scope allows write", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "matched.ts"),
      content: "export const ok = true;\n",
    },
  }, "allow", { ...noIdentityEnv, ACEF_WORKER_ID: "dev-worker-7" });

  // (e) identity present but mismatched scope.workerId -> DENY
  writeWorkerScope({ phase: "development", workerId: "dev-worker-7", allowedPaths: ["src/**"] });
  expectHookDecision("identity present mismatched scope denies write", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "mismatch.ts"),
      content: "export const blocked = true;\n",
    },
  }, "deny", { ...noIdentityEnv, ACEF_WORKER_ID: "intruder-9" }, [
    "active worker scope is assigned to a different worker identity",
  ]);

  // Restore the worker scope expected by the review-patch tests that follow.
  writeWorkerScope({ phase: "dev", workerId: "ACEF_BMAD_WORKER", allowedPaths: ["src/**", "tests/**"] });
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_REVIEW_PATCH_REQUIRED.json"), JSON.stringify({
    activeStory: "1.1",
    reviewVerdict: "MERGE WITH REQUIRED PATCH",
    status: "REQUIRED",
  }, null, 2));
  expectHookDecision("review patch gate blocks conductor implementation patch", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "review-fix.ts"),
      content: "export const conductorPatch = true;\n",
    },
  }, "deny");
  expectHookDecision("review patch gate blocks non-verify worker phase", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "review-fix.ts"),
      content: "export const devPatch = true;\n",
    },
  }, "deny", workerEnv);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json"), JSON.stringify({
    runId: "RUN-hook",
    activeStory: "1.1",
    phase: "verify-patch",
    workerId: "ACEF_BMAD_WORKER",
    allowedPaths: ["src/**", "tests/**"],
    baseRef: "HEAD",
    maxCommits: 1,
    canEditLedger: false,
    canSpawnAgents: false,
  }, null, 2));
  expectHookDecision("review patch gate allows scoped verify-patch worker", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "review-fix.ts"),
      content: "export const verifyPatch = true;\n",
    },
  }, "allow", workerEnv);
  const v3HookRun = JSON.parse(fs.readFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), "utf8"));
  const { lane: _v3LegacyLane, ...v3HookBase } = v3HookRun;
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), JSON.stringify({
    ...v3HookBase,
    schema: "acef.active-run.v2",
    workflowId: "full-bmad",
    assuranceProfile: "baseline",
    scopeUnit: "story",
    fullFlowContract: "four-actor-v3",
    expectedStories: ["1.1"],
  }, null, 2));
  writeWorkerScope({ phase: "development", workerId: "ACEF_BMAD_WORKER", allowedPaths: ["src/**", "tests/**"] });
  expectHookDecision("v3 review patch gate reactivates scoped developer", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "review-fix-v3.ts"),
      content: "export const developerRepair = true;\n",
    },
  }, "allow", workerEnv);
  writeWorkerScope({ phase: "verify-patch", workerId: "ACEF_BMAD_WORKER", allowedPaths: ["src/**", "tests/**"] });
  expectHookDecision("v3 review patch gate rejects retired verify-patch editor", {
    tool_name: "Write",
    cwd: tmp,
    tool_input: {
      file_path: path.join(tmp, "src", "review-fix-v3.ts"),
      content: "export const retiredVerifyPatch = true;\n",
    },
  }, "deny", workerEnv, ["unknown phase alias"]);
  fs.rmSync(path.join(tmp, "docs", "ai", "ACEF_REVIEW_PATCH_REQUIRED.json"));
  writeWorkerScope({ phase: "code-review", workerId: "ACEF_BMAD_WORKER", allowedPaths: ["src/**", "tests/**", "docs/ai/reports/**"] });
  expectHookDecision("v3 code review is report-only despite broad allowedPaths", {
    tool_name: "Write", cwd: tmp,
    tool_input: { file_path: path.join(tmp, "src", "reviewer-edit.ts"), content: "export const forbidden = true;\n" },
  }, "deny", workerEnv, ["report-only"]);
  expectHookDecision("v3 code review may write its report artifact", {
    tool_name: "Write", cwd: tmp,
    tool_input: { file_path: path.join(tmp, "docs", "ai", "reports", "review-v3.json"), content: "{}\n" },
  }, "allow", workerEnv);
  writeWorkerScope({ phase: "code-reviewer", workerId: "ACEF_BMAD_WORKER", allowedPaths: ["src/**", "docs/ai/reports/**"] });
  expectHookDecision("v3 code-reviewer alias remains report-only", {
    tool_name: "Write", cwd: tmp,
    tool_input: { file_path: path.join(tmp, "src", "alias-reviewer-edit.ts"), content: "export const forbidden = true;\n" },
  }, "deny", workerEnv, ["report-only"]);
  expectHookDecision("v3 code-reviewer alias may write scoped report", {
    tool_name: "Write", cwd: tmp,
    tool_input: { file_path: path.join(tmp, "docs", "ai", "reports", "alias-review-v3.json"), content: "{}\n" },
  }, "allow", workerEnv);
  writeWorkerScope({ phase: "patch-assurance", workerId: "ACEF_BMAD_WORKER", allowedPaths: ["src/**", "tests/**", "docs/ai/reports/**"] });
  expectHookDecision("v3 patch assurance is report-only despite broad allowedPaths", {
    tool_name: "Write", cwd: tmp,
    tool_input: { file_path: path.join(tmp, "tests", "assurance-edit.test.ts"), content: "test('forbidden', () => {});\n" },
  }, "deny", workerEnv, ["report-only"]);
  writeWorkerScope({ phase: "patch-assurance-reviewer", workerId: "ACEF_BMAD_WORKER", allowedPaths: ["src/**", "docs/ai/reports/**"] });
  expectHookDecision("v3 patch-assurance-reviewer alias remains report-only", {
    tool_name: "Write", cwd: tmp,
    tool_input: { file_path: path.join(tmp, "src", "alias-assurance-edit.ts"), content: "export const forbidden = true;\n" },
  }, "deny", workerEnv, ["report-only"]);
  writeWorkerScope({ phase: "review-finalizer", workerId: "ACEF_BMAD_WORKER", allowedPaths: ["src/**"] });
  expectHookDecision("v3 unknown phase alias fails closed", {
    tool_name: "Write", cwd: tmp,
    tool_input: { file_path: path.join(tmp, "src", "unknown-phase-edit.ts"), content: "export const forbidden = true;\n" },
  }, "deny", workerEnv, ["unknown phase alias"]);
  writeWorkerScope({ phase: "atdd", workerId: "ACEF_BMAD_WORKER", allowedPaths: ["src/**", "tests/**"] });
  expectHookDecision("v3 ATDD may write scoped test envelope", {
    tool_name: "Write", cwd: tmp,
    tool_input: { file_path: path.join(tmp, "tests", "atdd-envelope.test.ts"), content: "test('red', () => expect(service()).toBe(true));\n" },
  }, "allow", workerEnv);
  expectHookDecision("v3 ATDD cannot write application paths", {
    tool_name: "Write", cwd: tmp,
    tool_input: { file_path: path.join(tmp, "src", "atdd-app-edit.ts"), content: "export const forbidden = true;\n" },
  }, "deny", workerEnv, ["test envelope"]);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), JSON.stringify(v3HookRun, null, 2));

  const fakeHome = fs.mkdtempSync(path.join(os.tmpdir(), "acef-home-"));
  const nonAcefRepo = path.join(fakeHome, "work", "browser-rts");
  fs.mkdirSync(path.join(fakeHome, ".bmad"), { recursive: true });
  fs.mkdirSync(nonAcefRepo, { recursive: true });
  fs.mkdirSync(path.join(nonAcefRepo, ".bmad"), { recursive: true });
  fs.mkdirSync(path.join(nonAcefRepo, "_bmad"), { recursive: true });
  fs.mkdirSync(path.join(nonAcefRepo, "_bmad-output"), { recursive: true });
  expectHookDecision("home-level bmad marker does not activate unrelated repo", {
    tool_name: "Bash",
    cwd: nonAcefRepo,
    tool_input: {
      command: "npm install fast-check",
      cwd: nonAcefRepo,
    },
  }, "allow", { HOME: fakeHome });
  expectHookDecision("stock BMAD markers do not activate ACEF", {
    tool_name: "Write",
    cwd: nonAcefRepo,
    tool_input: {
      file_path: path.join(nonAcefRepo, "src", "native-bmad.ts"),
      content: "export const nativeBmad = true;\n",
    },
  }, "allow", { HOME: fakeHome });

  const lightweight = fs.mkdtempSync(path.join(os.tmpdir(), "acef-lightweight-"));
  fs.mkdirSync(path.join(lightweight, "docs", "ai"), { recursive: true });
  fs.writeFileSync(path.join(lightweight, ".acef-lightweight-lane"), "active\n");
  fs.writeFileSync(path.join(lightweight, "docs", "ai", "pattern-registry.json"), fs.readFileSync(path.join(tmp, "docs", "ai", "pattern-registry.json"), "utf8"));
  expectHookDecision("lightweight lane missing P1 conformance", {
    tool_name: "Write",
    cwd: lightweight,
    tool_input: {
      file_path: path.join(lightweight, "src", "light.ts"),
      content: "export const light = true;\n",
    },
  }, "deny", workerEnv);
  fs.rmSync(lightweight, { recursive: true, force: true });

  const directHook = fs.mkdtempSync(path.join(os.tmpdir(), "acef-direct-hook-"));
  fs.mkdirSync(path.join(directHook, "docs", "ai"), { recursive: true });
  fs.writeFileSync(path.join(directHook, ".acef-lane"), "direct\n");
  fs.writeFileSync(path.join(directHook, "docs", "ai", "ACEF_DIRECT_RUN.json"), JSON.stringify({
    schema: "acef.direct-run.v1",
    version: "1.0.0",
    runId: "DIRECT-hook",
    lane: "direct",
    status: "active",
    scope: "Contained source copy",
    acceptance: ["Copy is updated."],
    technicalBoundary: "localized-ui",
    reversible: true,
    riskTriggers: [],
    baseCommit: null,
    changedPaths: ["src/direct.ts"],
    verification: [],
    promotion: { decision: "stay-direct", reasons: [] },
  }, null, 2));
  expectHookDecision("direct run allows current-session implementation write", {
    tool_name: "Write",
    cwd: directHook,
    tool_input: {
      file_path: path.join(directHook, "src", "direct.ts"),
      content: "export const direct = true;\n",
    },
  }, "allow");
  expectHookDecision("direct run forbids worker spawn", {
    tool_name: "Agent",
    cwd: directHook,
    tool_input: {
      prompt: "Implement the contained direct task",
    },
  }, "deny", {}, ["direct lane forbids worker or subagent spawning"]);
  fs.rmSync(directHook, { recursive: true, force: true });

  fs.rmSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), { force: true });

  expectPass("preflight", ["--repo", tmp, "--check", "preflight"]);
  expectPass("adapter-freshness", ["--repo", tmp, "--check", "adapter-freshness", "--adapter", "docs/codebase-map.md"]);
  expectPass("pattern-registry", ["--repo", tmp, "--check", "pattern-registry"]);
  const registryPath = path.join(tmp, "docs", "ai", "pattern-registry.json");
  const validRegistry = JSON.parse(fs.readFileSync(registryPath, "utf8"));
  const missingCompletionEvidence = JSON.parse(JSON.stringify(validRegistry));
  delete missingCompletionEvidence.patterns[0].completionEvidence;
  fs.writeFileSync(registryPath, JSON.stringify(missingCompletionEvidence));
  expectFail("pattern-registry", ["--repo", tmp, "--check", "pattern-registry"]);
  const emptyCompletionEvidence = JSON.parse(JSON.stringify(validRegistry));
  emptyCompletionEvidence.patterns[0].completionEvidence = {};
  fs.writeFileSync(registryPath, JSON.stringify(emptyCompletionEvidence));
  expectFail("pattern-registry", ["--repo", tmp, "--check", "pattern-registry"]);
  const staleSchemaRegistry = JSON.parse(JSON.stringify(validRegistry));
  staleSchemaRegistry.schemaVersion = 1;
  fs.writeFileSync(registryPath, JSON.stringify(staleSchemaRegistry));
  expectFail("pattern-registry", ["--repo", tmp, "--check", "pattern-registry"]);
  fs.writeFileSync(registryPath, JSON.stringify(validRegistry));
  expectPass("reuse-before-create", ["--repo", tmp, "--check", "reuse-before-create", "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md"]);
  expectPass("do-not-copy", ["--repo", tmp, "--check", "do-not-copy", "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md"]);
  expectPass("partial-workshape", ["--repo", tmp, "--check", "partial-workshape", "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md"]);
  expectPass("finding-promotion", ["--repo", tmp, "--check", "finding-promotion", "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md"]);
  expectPass("graduation-reconciliation", ["--repo", tmp, "--check", "graduation-reconciliation", "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md"]);
  expectPass("vertical-slice", ["--repo", tmp, "--check", "vertical-slice", "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md"]);
  expectPass("test-authenticity", ["--repo", tmp, "--check", "test-authenticity"]);
  const fakeGreenTestPath = path.join(tmp, "tests", "Feature", "FakeGreenSmokeTest.php");
  fs.writeFileSync(fakeGreenTestPath, [
    "<?php",
    "",
    "final class FakeGreenSmokeTest extends TestCase",
    "{",
    "    public function test_runtime_smoke_silently_skips_failures(): void",
    "    {",
    "        try {",
    "            $this->get('/admin/menus')->assertOk();",
    "        } catch (Throwable $error) {",
    "            $this->addWarning('admin route unavailable');",
    "            continue;",
    "        }",
    "    }",
    "",
    "    public function test_self_referential_gate(): void",
    "    {",
    "        $count = 42;",
    "        $this->assertSame($count, $count);",
    "    }",
    "}",
    "",
  ].join("\n"));
  expectFail("test-authenticity", ["--repo", tmp, "--check", "test-authenticity"]);
  fs.writeFileSync(fakeGreenTestPath, [
    "<?php",
    "",
    "final class RealSmokeTest extends TestCase",
    "{",
    "    public function test_runtime_smoke_proves_content_and_negative_guard(): void",
    "    {",
    "        $this->get('/account')",
    "            ->assertOk()",
    "            ->assertSee('Account')",
    "            ->assertDontSee('Exception');",
    "    }",
    "}",
    "",
  ].join("\n"));
  expectPass("test-authenticity", ["--repo", tmp, "--check", "test-authenticity"]);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_backend_only_DELIVERY_AUDIT.md"), [
    "# Backend-only false completion",
    "",
    "## Vertical Slice Trace",
    "",
    "| Capability | Actor | Surface | Entrypoint | Entrypoint Evidence | Application Path | Runtime Evidence | Status |",
    "|---|---|---|---|---|---|---|---|",
    "| Edit page | Editor | service | PageController | `routes/web.php#/missing-admin` | controller -> service | `tests/Feature/ServiceCapabilityTest.php#/missing-admin` | PASS |",
  ].join("\n"));
  expectFail("vertical-slice", ["--repo", tmp, "--check", "vertical-slice", "--ledger", "docs/ai/ACEF_backend_only_DELIVERY_AUDIT.md"]);
  expectPass("guarded-test-floor", ["--repo", tmp, "--check", "guarded-test-floor", "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md"]);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_guarded_floor_DELIVERY_AUDIT.md"), [
    "# Guarded floor",
    "track: guarded",
    "",
    "## Guarded Test Floor",
    "boundary: authorization",
    "boundary_symbol: PaymentBoundary::authorize",
    "test_evidence: tests/Feature/PaymentBoundaryTest.php#PaymentBoundary::authorize",
    "test_author_actor: test-author-1",
    "status: PASS",
  ].join("\n"));
  expectPass("guarded-test-floor", ["--repo", tmp, "--check", "guarded-test-floor", "--ledger", "docs/ai/ACEF_guarded_floor_DELIVERY_AUDIT.md"]);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_fake_guarded_floor_DELIVERY_AUDIT.md"), [
    "# Fake guarded floor",
    "track: guarded",
    "",
    "## Guarded Test Floor",
    "boundary: authorization",
    "boundary_symbol: MissingBoundary::authorize",
    "test_evidence: tests/Feature/PaymentBoundaryTest.php#MissingBoundary::authorize",
    "test_author_actor: conductor",
    "status: PASS",
