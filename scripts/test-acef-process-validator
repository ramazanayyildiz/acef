        {
          matcher: "Write",
          hooks: [{ type: "command", command: "node ~/.codex/hooks/acef-bmad-hard-wall.mjs" }],
        },
      ],
    },
  }, null, 2));
  fs.mkdirSync(path.join(installerHome, ".config", "opencode", "plugins"), { recursive: true });
  fs.writeFileSync(path.join(installerHome, ".config", "opencode", "plugins", "acef-bmad-hard-wall.mjs"), "old global full hook\n");
  const installerRepo = fs.mkdtempSync(path.join(os.tmpdir(), "acef-installer-repo-"));
  run("node", [path.join(repoRoot, "scripts", "install-acef-bmad-guard"), "--repo", installerRepo, "--global-dispatcher"], {
    env: { ...process.env, HOME: installerHome },
  });
  if (!fs.existsSync(path.join(installerRepo, ".acef", "hooks", "acef-bmad-hard-wall.mjs"))) {
    throw new Error("Expected installer to add local ACEF guard engine");
  }
  if (!fs.existsSync(path.join(installerRepo, ".opencode", "plugins", "acef-bmad-hard-wall.js"))) {
    throw new Error("Expected installer to add local OpenCode plugin");
  }
  const installedCodexHooks = JSON.parse(fs.readFileSync(path.join(installerHome, ".codex", "hooks.json"), "utf8"));
  const codexPreTool = installedCodexHooks.hooks.PreToolUse || [];
  if (!codexPreTool.some((entry) => (entry.hooks || []).some((hook) => String(hook.command || "").includes("context-mode hook codex pretooluse")))) {
    throw new Error("Expected installer to preserve existing Codex PreToolUse hook");
  }
  const codexDispatcherEntry = codexPreTool.find((entry) => (entry.hooks || []).some((hook) => String(hook.command || "").includes("acef-bmad-dispatcher.mjs")));
  if (!codexDispatcherEntry) {
    throw new Error("Expected installer to add ACEF dispatcher to Codex PreToolUse hooks");
  }
  if (!String(codexDispatcherEntry.matcher || "").includes("spawn_agent")) {
    throw new Error("Expected Codex dispatcher matcher to include worker spawn tools");
  }
  if (codexPreTool.some((entry) => (entry.hooks || []).some((hook) => String(hook.command || "").includes("acef-bmad-hard-wall.mjs")))) {
    throw new Error("Expected installer to remove old full ACEF guard from Codex PreToolUse hooks");
  }
  const installedClaudeSettings = JSON.parse(fs.readFileSync(path.join(installerHome, ".claude", "settings.json"), "utf8"));
  if (!String(JSON.stringify(installedClaudeSettings)).includes("acef-bmad-dispatcher.mjs")) {
    throw new Error("Expected installer to add ACEF dispatcher to Claude PreToolUse hooks");
  }
  const claudeDispatcherEntry = (installedClaudeSettings.hooks?.PreToolUse || [])
    .find((entry) => (entry.hooks || []).some((hook) => String(hook.command || "").includes("acef-bmad-dispatcher.mjs")));
  if (!String(claudeDispatcherEntry?.matcher || "").includes("Agent")) {
    throw new Error("Expected Claude dispatcher matcher to include worker spawn tools");
  }
  if (fs.existsSync(path.join(installerHome, ".config", "opencode", "plugins", "acef-bmad-hard-wall.mjs"))) {
    throw new Error("Expected installer to remove old full ACEF guard sibling from global OpenCode plugin dir");
  }
  fs.rmSync(installerHome, { recursive: true, force: true });
  fs.rmSync(installerRepo, { recursive: true, force: true });

  const routingRepo = fs.mkdtempSync(path.join(os.tmpdir(), "acef-two-axis-routing-"));
  fs.mkdirSync(path.join(routingRepo, "docs", "ai"), { recursive: true });
  run("git", ["init", "-q"], { cwd: routingRepo });
  run("git", ["config", "user.email", "acef-routing@example.invalid"], { cwd: routingRepo });
  run("git", ["config", "user.name", "ACEF Routing Test"], { cwd: routingRepo });
  fs.writeFileSync(path.join(routingRepo, "README.md"), "routing fixture\n");
  run("git", ["add", "README.md"], { cwd: routingRepo });
  run("git", ["commit", "-qm", "fixture"], { cwd: routingRepo });
  const routingPath = path.join(routingRepo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  const billingDefectRun = {
    schema: "acef.active-run.v2",
    runId: "RUN-billing-defect",
    repo: "routing-fixture",
    workflowId: "quick-fix",
    assuranceProfile: "guarded",
    scopeUnit: "story",
    status: "active",
    activeStory: "Repair subscription registration regression",
    activePhase: "intake",
    workflowRationale: "Proven root cause, bounded patch, no new contract.",
    assuranceRationale: "Subscription and public authorization boundary.",
    intakeDecision: {
      routingPolicyVersion: "two-axis-v1",
      route: "C",
      confidence: "high",
      inferredAnswers: ["Root cause is reproduced and the patch envelope is bounded."],
      unresolvedQuestions: [],
    },
    riskTriggers: ["bugfix", "root-cause-proven", "bounded-patch", "billing", "subscription", "public-auth"],
    ledgerPath: "docs/ai/ACEF_DELIVERY_LEDGER.md",
  };
  fs.writeFileSync(routingPath, JSON.stringify(billingDefectRun, null, 2));
  expectPass("lane-selection", ["--repo", routingRepo, "--check", "lane-selection"]);
  fs.writeFileSync(routingPath, JSON.stringify({ ...billingDefectRun, workflowId: "full-bmad" }, null, 2));
  expectFailMessage("lane-selection", ["--repo", routingRepo, "--check", "lane-selection"],
    /risk boundaries select Guarded assurance, not Full/);
  fs.writeFileSync(routingPath, JSON.stringify({
    ...billingDefectRun,
    workflowId: "full-bmad",
    riskTriggers: [...billingDefectRun.riskTriggers, "new-contract"],
  }, null, 2));
  expectPass("lane-selection", ["--repo", routingRepo, "--check", "lane-selection"]);
  fs.rmSync(routingRepo, { recursive: true, force: true });

  console.log("acef-process-validator tests passed");
} finally {
  fs.rmSync(tmp, { recursive: true, force: true });
}
