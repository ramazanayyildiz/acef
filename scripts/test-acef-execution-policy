#!/usr/bin/env node
"use strict";

const assert = require("node:assert/strict");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { parseControlDosing, parseLightweightRun } = require("./lib/acef-state-parser");
const {
  ASSURANCE_PROFILES,
  WORKFLOW_IDS,
  displayName,
  isFull,
  isGuarded,
  isHeavy,
  normalizeExecutionState,
  planningRequiresFull,
  resolveControlBundle,
  resolveControlDose,
  riskRequiresGuarded,
  workflowSelectionFailures,
} = require("./lib/acef-execution-policy");

const manifest = parseControlDosing(path.resolve(__dirname, "..", "method", "control-dosing.json"));
const requirementRank = { "not-required": 0, optional: 1, "required-if-triggered": 2, required: 3 };
const doseRank = { none: 0, light: 1, compact: 2, full: 3 };

assert.deepEqual(WORKFLOW_IDS, ["quick-fix", "lightweight", "full-bmad"]);
assert.deepEqual(ASSURANCE_PROFILES, ["baseline", "guarded"]);

for (const workflowId of WORKFLOW_IDS) {
  const baseline = { workflowId, assuranceProfile: "baseline", scopeUnit: "story" };
  const guarded = { workflowId, assuranceProfile: "guarded", scopeUnit: "story" };
  assert.equal(isFull(baseline), workflowId === "full-bmad");
  assert.equal(isGuarded(baseline), false);
  assert.equal(isGuarded(guarded), true);
  assert.equal(isHeavy(baseline), workflowId === "full-bmad");
  assert.equal(isHeavy(guarded), true);
  assert.match(displayName(guarded), /Guarded$/);

  const baselineBundle = resolveControlBundle(manifest, workflowId, "baseline");
  const guardedBundle = resolveControlBundle(manifest, workflowId, "guarded");
  assert.equal(new Set(guardedBundle).size, guardedBundle.length, `${workflowId} guarded bundle contains duplicates`);
  for (const controlId of baselineBundle) {
    assert.ok(guardedBundle.includes(controlId), `${workflowId} guarded bundle removed ${controlId}`);
  }
  for (const control of manifest.controls) {
    const base = resolveControlDose(manifest, control.id, workflowId, "baseline");
    const overlay = resolveControlDose(manifest, control.id, workflowId, "guarded");
    assert.ok(requirementRank[overlay.requirement] >= requirementRank[base.requirement], `${control.id} guarded requirement weakened`);
    assert.ok(doseRank[overlay.dose] >= doseRank[base.dose], `${control.id} guarded dose weakened`);
  }
}

assert.equal(riskRequiresGuarded(["copy"]), false);
assert.equal(riskRequiresGuarded(["database migration"]), true);
assert.equal(riskRequiresGuarded(["external-provider"]), true);
for (const trigger of [
  "OAuth", "SSO", "access control", "credentials", "secrets", "encryption", "key rotation",
  "subscription", "refund", "data deletion", "consent", "retention", "entitlements",
]) {
  assert.equal(riskRequiresGuarded([trigger]), true, `${trigger} must require Guarded assurance`);
}
assert.equal(riskRequiresGuarded(["delete CSS class"]), false);
assert.equal(riskRequiresGuarded(["remove documentation comment"]), false);

const provenBillingDefect = {
  workflowId: "quick-fix",
  assuranceProfile: "guarded",
  scopeUnit: "story",
  riskTriggers: ["bugfix", "root-cause-proven", "bounded-patch", "billing", "subscription", "public-auth"],
};
assert.equal(planningRequiresFull(provenBillingDefect), false, "risk alone must not select Full execution");
assert.deepEqual(workflowSelectionFailures(provenBillingDefect), []);
assert.match(workflowSelectionFailures({ ...provenBillingDefect, workflowId: "full-bmad" }).join("\n"),
  /risk boundaries select Guarded assurance, not Full/);
assert.deepEqual(workflowSelectionFailures({
  ...provenBillingDefect,
  workflowId: "full-bmad",
  riskTriggers: [...provenBillingDefect.riskTriggers, "new-contract"],
}), []);
assert.match(workflowSelectionFailures({
  ...provenBillingDefect,
  riskTriggers: ["bugfix", "billing"],
}).join("\n"), /root-cause-proven/);
const bundledAuditRepairs = {
  workflowId: "full-bmad",
  assuranceProfile: "guarded",
  scopeUnit: "story",
  riskTriggers: ["bugfix", "broad-cross-surface", "shared-test-failures", "ci-gates"],
};
assert.match(workflowSelectionFailures(bundledAuditRepairs).join("\n"), /REPLAN\/SPLIT.*repair batch/);
assert.doesNotMatch(workflowSelectionFailures({
  ...bundledAuditRepairs,
  workflowId: "quick-fix",
  riskTriggers: [...bundledAuditRepairs.riskTriggers, "root-cause-proven", "bounded-patch"],
}).join("\n"), /REPLAN\/SPLIT/);

const legacyGuarded = normalizeExecutionState({ lane: "guarded", activeEpic: null });
assert.equal(legacyGuarded.executionMigrationRequired, true);
assert.equal(legacyGuarded.workflowId, null);
assert.equal(legacyGuarded.assuranceProfile, "guarded");

const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "acef-execution-policy-"));
try {
  const lightweightPath = path.join(tmp, "ACEF_LIGHTWEIGHT_RUN.json");
  const steps = [
    "preflight-current-context",
    "reuse-before-create",
    "implementation",
    "independent-review",
    "focused-verification",
    "closeout-evidence",
  ].map((name) => ({ name, status: "PASS", evidencePaths: [`evidence/${name}.md`] }));
  const v2Fix = {
    schema: "acef.lightweight-run.v2",
    runId: "FIX-v2",
    workflowId: "quick-fix",
    assuranceProfile: "guarded",
    status: "complete",
    implementationActorId: "dev-1",
    reviewActorId: "judge-1",
    steps,
    promotion: { decision: "stay-lightweight", triggers: [] },
  };
  fs.writeFileSync(lightweightPath, JSON.stringify(v2Fix));
  assert.throws(() => parseLightweightRun(lightweightPath), /complete quick-fix run requires quickFix evidence/);
  v2Fix.quickFix = {
    intent: "Repair bounded defect",
    scope: "one surface",
    reproEvidencePath: "evidence/repro.md",
    beforePatchEvidencePath: "evidence/before.md",
    afterPatchEvidencePath: "evidence/after.md",
  };
  fs.writeFileSync(lightweightPath, JSON.stringify(v2Fix));
  const parsedFix = parseLightweightRun(lightweightPath);
  assert.equal(parsedFix.workflowId, "quick-fix");
  assert.equal(parsedFix.assuranceProfile, "guarded");
  assert.equal(parsedFix.lane, "quick-fix");

  v2Fix.quickFixContract = "single-review-v1";
  Object.assign(v2Fix.quickFix, {
    baseCommit: "a".repeat(40),
    applicationCommit: "b".repeat(40),
    redEvidenceId: "red-1",
    greenEvidenceId: "green-1",
    revertProofEvidenceId: "revert-1",
    productVerification: "NOT_APPLICABLE",
    startedAt: "2026-08-06T10:00:00.000Z",
    completedAt: "2026-08-06T10:12:00.000Z",
    reviewCycle: 1,
    frameworkFailures: 0,
  });
  v2Fix.reviewActorId = "reviewer-1";
  fs.writeFileSync(lightweightPath, JSON.stringify(v2Fix));
  assert.equal(parseLightweightRun(lightweightPath).quickFixContract, "single-review-v1");
  v2Fix.quickFix.reviewCycle = 2;
  fs.writeFileSync(lightweightPath, JSON.stringify(v2Fix));
  assert.throws(() => parseLightweightRun(lightweightPath), /reviewCycle must be 0 or 1/);
} finally {
  fs.rmSync(tmp, { recursive: true, force: true });
}

console.log("acef execution policy tests passed (3 workflows x 2 assurance profiles)");
