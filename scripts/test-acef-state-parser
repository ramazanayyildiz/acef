#!/usr/bin/env node
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const {
  parseActiveRun,
  parseActorRecord,
  parseEvidenceManifest,
  parseGateVerdict,
  parseReviewReport,
  parseDeveloperRepair,
  parseProcessJudgeDecision,
  parseApproval,
  parseWorkerScope,
  parseAtddCorrection,
  parseWorkflow,
  parseFreshness,
  atddRedExecutionFailure,
  atddTestSourceAuthenticityFailure,
  atddGreenTestContinuityFailure,
  safeRelative,
} = require("./lib/acef-state-parser");

const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "acef-state-parser-"));

function write(rel, value) {
  const filePath = path.join(tmp, rel);
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  fs.writeFileSync(filePath, typeof value === "string" ? value : JSON.stringify(value, null, 2));
  return filePath;
}

function assertThrows(fn, pattern, label) {
  try {
    fn();
  } catch (error) {
    if (pattern.test(error.message)) return;
    throw new Error(`${label} threw wrong error: ${error.message}`);
  }
  throw new Error(`${label} did not throw`);
}

try {
  const activeRun = write("docs/ai/ACEF_ACTIVE_RUN.json", {
    runId: "RUN-1",
    repo: "demo",
    lane: "full-bmad",
    status: "active",
    activeStory: "Story 5.2",
    activePhase: "developer",
    ledgerPath: "docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
  });
  if (parseActiveRun(activeRun).activeStory !== "Story 5.2") throw new Error("active run parse failed");
  const v3ActiveRun = write("docs/ai/ACEF_ACTIVE_RUN_V3.json", {
    schema: "acef.active-run.v2",
    runId: "RUN-v3",
    repo: "demo",
    workflowId: "full-bmad",
    fullFlowContract: "four-actor-v3",
    assuranceProfile: "guarded",
    assuranceRationale: "security boundary",
    scopeUnit: "story",
    expectedStories: ["Story 5.3"],
    status: "active",
    activeStory: "Story 5.3",
    activePhase: "atdd",
    ledgerPath: "docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
  });
  if (parseActiveRun(v3ActiveRun).fullFlowContract !== "four-actor-v3") throw new Error("v3 active run parse failed");
  const missingV3Inventory = JSON.parse(fs.readFileSync(v3ActiveRun, "utf8"));
  delete missingV3Inventory.expectedStories;
  write("missing-v3-inventory.json", missingV3Inventory);
  assertThrows(() => parseActiveRun(path.join(tmp, "missing-v3-inventory.json")), /requires frozen expectedStories inventory/, "v3 initial inventory");

  const actor = write("docs/ai/actors/dev-1.json", {
    actorInstanceId: "dev-1",
    story: "Story 5.2",
    phase: "development",
    role: "developer",
    client: "codex",
    inputCommit: "abc123",
    allowedContextProfile: "developer",
  });
  if (parseActorRecord(actor).role !== "developer") throw new Error("actor parse failed");

  const evidence = write("docs/ai/evidence/EV-1.json", {
    evidenceId: "EV-1",
    kind: "runtime-test",
    command: "php artisan test",
    exitCode: 0,
    repositoryCommit: "abc123",
    dirtyDigest: null,
    actorInstanceId: "dev-1",
    story: "Story 5.2",
    rawArtifact: { path: "docs/ai/evidence/raw/EV-1.log", sha256: "sha256-demo" },
    runnerProof: {
      schema: "acef-evidence-runner-proof-v1",
      runner: "acef-state evidence-run",
      sha256: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    },
    satisfies: ["AC-5.2.1"],
  });
  if (parseEvidenceManifest(evidence).exitCode !== 0) throw new Error("evidence parse failed");

  const gate = write("docs/ai/gates/story-5-2.json", {
    gateId: "story-5-2-process-judge",
    scope: "Story 5.2",
    verdict: "PASS",
    decidedBy: "judge-1",
    repositoryCommit: "abc123",
    evidenceIds: ["EV-1"],
  });
  if (parseGateVerdict(gate).verdict !== "PASS") throw new Error("gate parse failed");
  const v3Gate = write("docs/ai/gates/story-5-3.json", {
    gateId: "story-5-3-close",
    runId: "RUN-v3",
    fullFlowContract: "four-actor-v3",
    storyInventory: ["Story 5.3"],
    gateType: "deterministic-story-close-v3",
    decisionMode: "deterministic",
    scope: "Story 5.3",
    verdict: "PASS",
    decidedBy: "acef-story-close-v3",
    repositoryCommit: "abc123",
    repositoryTree: "tree123",
    applicationCommit: "abc123",
    applicationTree: "tree123",
    scopePaths: ["src/story-5-3.js"],
    validatorVersion: "acef-story-close-v3.0.0",
    actors: { atdd: "a", development: "b", codeReview: "c", patchAssurance: "d" },
    redEvidenceId: "EV-red",
    greenEvidenceId: "EV-green",
    executedChecks: { actorSeparation: true, atddTestOnlyRed: true, redGreenChronology: true, finalTreeReview: true, patchAssurance: true, findingsResolved: true, runnerProof: true, scopeBinding: true, hashBinding: true },
    reviewCycle: 0,
    unresolvedFindings: [],
    findingDispositions: [],
    reportHashes: { codeReview: "a".repeat(64), patchAssurance: "b".repeat(64) },
    reportPaths: { codeReview: "docs/ai/reports/code.json", patchAssurance: "docs/ai/reports/assurance.json" },
    evidenceIds: ["EV-green"],
  });
  if (parseGateVerdict(v3Gate).decisionMode !== "deterministic") throw new Error("v3 gate parse failed");
  const badV3Gate = JSON.parse(fs.readFileSync(v3Gate, "utf8"));
  badV3Gate.executedChecks.hashBinding = false;
  write("bad-v3-gate.json", badV3Gate);
  assertThrows(() => parseGateVerdict(path.join(tmp, "bad-v3-gate.json")), /every mechanical check/, "bad v3 PASS gate");
  const reviewReport = write("docs/ai/reports/review-v3.json", {
    schema: "acef.review-report.v3",
    runId: "RUN-v3",
    fullFlowContract: "four-actor-v3",
    actorInstanceId: "review-v3",
    story: "Story 5.3",
    phase: "code-review",
    inputCommit: "abc123",
    inputTree: "tree123",
    verdict: "PASS",
    findings: [{ id: "LOW-1", severity: "LOW", status: "DISMISSED", reason: "Not reproducible at the boundary" }],
  });
  if (parseReviewReport(reviewReport).findings[0].status !== "DISMISSED") throw new Error("review report v3 parse failed");
  const invalidHighDismissal = JSON.parse(fs.readFileSync(reviewReport, "utf8"));
  invalidHighDismissal.findings = [{ id: "HIGH-1", severity: "HIGH", status: "DISMISSED", reason: "ignore" }];
  write("invalid-high-dismissal.json", invalidHighDismissal);
  assertThrows(() => parseReviewReport(path.join(tmp, "invalid-high-dismissal.json")), /cannot dismissed high|cannot dismiss high/i, "high dismissal policy");
  const invalidDeferral = { ...invalidHighDismissal, findings: [{ id: "LOW-2", severity: "LOW", status: "DEFERRED" }] };
  write("invalid-deferral.json", invalidDeferral);
  assertThrows(() => parseReviewReport(path.join(tmp, "invalid-deferral.json")), /requires a typed approvalId/, "deferred approval binding");
  const emptyRevise = { ...JSON.parse(fs.readFileSync(reviewReport, "utf8")), verdict: "REVISE", findings: [] };
  write("empty-revise.json", emptyRevise);
  assertThrows(() => parseReviewReport(path.join(tmp, "empty-revise.json")), /requires at least one OPEN finding/, "empty repair findings");
  const invalidReviewPhase = { ...JSON.parse(fs.readFileSync(reviewReport, "utf8")), phase: "test-review" };
  write("invalid-review-phase.json", invalidReviewPhase);
  assertThrows(() => parseReviewReport(path.join(tmp, "invalid-review-phase.json")), /phase must be one of/, "review phase schema parity");
  const repairReceipt = write("docs/ai/repairs/repair-v3.json", {
    schema: "acef.developer-repair.v3", runId: "RUN-v3", fullFlowContract: "four-actor-v3",
    story: "Story 5.3", cycle: 1, priorGateId: "story-5-3-close", findingsSha256: "c".repeat(64),
    developerActorId: "dev-v3", developerSessionId: "session-v3", preCommit: "abc123", preTree: "tree123",
    postCommit: "def456", postTree: "tree456", createdAt: "2026-08-02T00:00:00Z",
  });
  if (parseDeveloperRepair(repairReceipt).cycle !== 1) throw new Error("Developer repair receipt parse failed");
  const judgeDecision = write("docs/ai/judges/judge-v3.json", {
    schema: "acef.process-judge-decision.v3", runId: "RUN-v3", fullFlowContract: "four-actor-v3",
    story: "Story 5.3", trigger: "ambiguity", actorId: "judge-v3", gateId: "story-5-3-close",
    evidenceIds: ["EV-red", "EV-green"], verdict: "ACKNOWLEDGE", createdAt: "2026-08-02T00:00:00Z",
  });
  if (parseProcessJudgeDecision(judgeDecision).verdict !== "ACKNOWLEDGE") throw new Error("Process Judge decision parse failed");
  const changedRedTests = ["tests/story-5-3-red.test.js"];
  if (atddRedExecutionFailure({ command: "node --test tests/story-5-3-red.test.js" }, "--- stdout ---\nnot ok 1 - tests/story-5-3-red.test.js\nAssertionError", changedRedTests)) {
    throw new Error("real test-runner red evidence was rejected");
  }
  if (!atddRedExecutionFailure({ command: "node -e process.exit(1)" }, "--- stdout ---\nFAIL tests/story-5-3-red.test.js", changedRedTests)) {
    throw new Error("arbitrary self-failure was accepted as ATDD red evidence");
  }
  if (!atddRedExecutionFailure({ command: "node --test tests/story-5-3-red.test.js" }, "--- stdout ---\nprocess exited 1", changedRedTests)) {
    throw new Error("test runner without observed failure identity was accepted as ATDD red evidence");
  }
  const meaningfulRedSource = "const actual = require('../app/service'); test('red', () => assert.strictEqual(actual(), 'green'));";
  if (atddTestSourceAuthenticityFailure([{ filePath: changedRedTests[0], source: meaningfulRedSource }])) {
    throw new Error("real test declaration/assertion was rejected");
  }
  if (!atddTestSourceAuthenticityFailure([{ filePath: changedRedTests[0], source: "test('red', () => assert.strictEqual('red', 'green'));" }])) {
    throw new Error("literal-vs-literal assertion was accepted as production behavior proof");
  }
  if (!atddTestSourceAuthenticityFailure([{ filePath: changedRedTests[0], source: "const actual = require('../app/service'); test('red', () => expect(actual).toBe(actual));" }])) {
    throw new Error("expect self-comparison was accepted as production behavior proof");
  }
  if (!atddTestSourceAuthenticityFailure([{ filePath: changedRedTests[0], source: "process.exit(1);" }])) {
    throw new Error("pure self-exit test source was accepted as authentic ATDD");
  }
  if (atddGreenTestContinuityFailure(
    [{ filePath: changedRedTests[0], source: meaningfulRedSource }],
    [{ filePath: changedRedTests[0], source: `${meaningfulRedSource}\ntest('extra', () => assert.ok(actual()));` }],
  )) throw new Error("additive green coverage incorrectly weakened the red test fingerprint");
  if (!atddGreenTestContinuityFailure(
    [{ filePath: changedRedTests[0], source: meaningfulRedSource }],
    [{ filePath: changedRedTests[0], source: "const actual = require('../app/service'); test('red', () => assert.strictEqual(actual(), actual()));" }],
  )) throw new Error("green self-comparison weakening preserved the ATDD fingerprint");

  const approval = write("docs/ai/approvals/APP-1.json", {
    approvalId: "APP-1",
    decision: "APPROVE",
    scope: "epic-transition:5->6",
    actorType: "human",
    userQuote: "Start Epic 6",
    statementHash: "sha256-demo",
    repositoryCommit: "abc123",
  });
  if (parseApproval(approval).scope !== "epic-transition:5->6") throw new Error("approval parse failed");

  const workerScope = write("docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json", {
    activeStory: "Story 5.2",
    phase: "development",
    workerId: "dev-1",
    allowedPaths: ["app/**", "tests/**"],
    baseRef: "abc123",
    maxCommits: 1,
    canEditLedger: false,
    canSpawnAgents: false,
  });
  if (parseWorkerScope(workerScope).workerId !== "dev-1") throw new Error("worker scope parse failed");
  const atddCorrection = path.join(tmp, "atdd-correction.json");
  fs.writeFileSync(atddCorrection, `${JSON.stringify({
    schema: "acef.atdd-correction.v1",
    sourceActorId: "story-atdd",
    correctionActorId: "story-atdd-correction1",
    scope: "test-artifacts-only",
    findingsSha256: "a".repeat(64),
    allowedPaths: ["tests/Feature/FocusedTest.php"],
  })}\n`);
  if (parseAtddCorrection(atddCorrection).correctionActorId !== "story-atdd-correction1") throw new Error("ATDD correction parse failed");
  fs.writeFileSync(atddCorrection, `${JSON.stringify({
    schema: "acef.atdd-correction.v1",
    sourceActorId: "story-atdd",
    correctionActorId: "story-atdd-correction1",
    scope: "test-artifacts-only",
    findingsSha256: "a".repeat(64),
    allowedPaths: ["tests/**"],
  })}\n`);
  assertThrows(() => parseAtddCorrection(atddCorrection), /without globs/, "unsafe ATDD correction scope");
  const workflow = write("workflows/lightweight-review.yaml", [
    "workflow: lightweight-review",
    "version: 1",
    "nodes:",
    "  - id: implement",
    "    type: agent",
    "    role: developer",
    "    inputs:",
    "      - docs/ai/ACEF_CURRENT_CONTEXT.md",
    "    outputs:",
    "      - docs/ai/reports/dev.md",
    "  - id: test",
    "    type: command",
    "    command: npm test",
    "    requires:",
    "      - implement",
    "    inputs:",
    "      - docs/ai/reports/dev.md",
    "    outputs:",
    "      - docs/ai/evidence/test.json",
  ].join("\n"));
  if (parseWorkflow(workflow).nodes.length !== 2) throw new Error("workflow parse failed");
  const unsafeScope = { ...JSON.parse(fs.readFileSync(workerScope, "utf8")), allowedPaths: ["../outside/**"] };
  write("unsafe-scope.json", unsafeScope);
  assertThrows(() => parseWorkerScope(path.join(tmp, "unsafe-scope.json")), /repo-relative/, "unsafe worker scope");
  if (parseFreshness({ commit: "abc123", verifiedAt: "2026-06-23T00:00:00Z", scope: "app/**" }).commit !== "abc123") {
    throw new Error("freshness parse failed");
  }

  write("bad-active.json", { runId: "RUN-2" });
  assertThrows(() => parseActiveRun(path.join(tmp, "bad-active.json")), /missing required field/, "bad active run");
  write("bad-evidence.json", {
    evidenceId: "EV-2",
    kind: "runtime-test",
    command: "npm test",
    exitCode: "0",
    repositoryCommit: "abc123",
    dirtyDigest: null,
    actorInstanceId: "dev-1",
    story: "Story 5.2",
    rawArtifact: { path: "raw.log", sha256: "demo" },
    runnerProof: {
      schema: "acef-evidence-runner-proof-v1",
      runner: "acef-state evidence-run",
      sha256: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    },
    satisfies: ["AC-1"],
  });
  assertThrows(() => parseEvidenceManifest(path.join(tmp, "bad-evidence.json")), /integer exitCode/, "bad evidence");
  assertThrows(() => safeRelative(path.join(tmp, "..", "escape.json"), tmp), /escapes root/, "safeRelative");

  console.log("acef-state-parser tests passed");
} finally {
  fs.rmSync(tmp, { recursive: true, force: true });
}
