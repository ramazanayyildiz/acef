#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");
const { inspectRunAuthorization } = require("./lib/acef-run-authorization");
const { displayName } = require("./lib/acef-execution-policy");

function usage() {
  console.log(`Usage: acef-status --repo <path> [--format text|json]

Prints the small repo-truth startup packet a fresh agent should read before acting.
It is read-only: it does not advance state, edit ledgers, approve gates, or choose work.`);
}

function parseArgs(argv) {
  const opts = { repo: process.cwd(), format: "text" };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--repo") {
      opts.repo = argv[++index] || "";
    } else if (arg === "--format") {
      opts.format = argv[++index] || "";
    } else if (arg === "--help" || arg === "-h") {
      opts.help = true;
    } else {
      throw new Error(`Unknown argument: ${arg}`);
    }
  }
  if (!["text", "json"].includes(opts.format)) throw new Error("--format must be text or json");
  opts.repo = path.resolve(opts.repo);
  return opts;
}

function readTextIfExists(filePath) {
  return fs.existsSync(filePath) ? fs.readFileSync(filePath, "utf8").trim() : null;
}

function currentGit(repo) {
  const head = readTextIfExists(path.join(repo, ".git", "HEAD"));
  if (!head) return { branch: null, head: null };
  if (!head.startsWith("ref: ")) return { branch: null, head: head.slice(0, 12) };
  const ref = head.slice(5).trim();
  const branch = ref.replace(/^refs\/heads\//, "");
  const commit = readTextIfExists(path.join(repo, ".git", ref));
  return { branch, head: commit ? commit.slice(0, 12) : null };
}

function loadInstallation(repo) {
  const filePath = path.join(repo, "docs", "ai", "ACEF_INSTALLATION.json");
  if (!fs.existsSync(filePath)) return { path: "docs/ai/ACEF_INSTALLATION.json", exists: false, record: null, error: null };
  try {
    const record = JSON.parse(fs.readFileSync(filePath, "utf8"));
    const missing = [];
    if (record.schema !== "acef.installation.v1") missing.push("schema");
    if (!record.acefVersion?.sourceCommit) missing.push("acefVersion.sourceCommit");
    if (!record.acefVersion?.sourcePath) missing.push("acefVersion.sourcePath");
    if (!record.updateCommand) missing.push("updateCommand");
    if (!record.components || !Object.keys(record.components).length) missing.push("components");
    if (missing.length) throw new Error(`missing required field(s): ${missing.join(", ")}`);
    return { path: "docs/ai/ACEF_INSTALLATION.json", exists: true, record, error: null };
  } catch (error) {
    return { path: "docs/ai/ACEF_INSTALLATION.json", exists: true, record: null, error: error.message };
  }
}

function buildStatus(repo) {
  const authorization = inspectRunAuthorization(repo, {
    allowDirect: true,
    requireScopeRunId: true,
  });
  const activeRun = { record: authorization.activeRun };
  const workerScope = { record: authorization.workerScope };
  const installation = loadInstallation(repo);
  const contextPath = authorization.contextPath;
  const ledgerPath = authorization.ledgerPath;
  const git = currentGit(repo);
  const blockers = [...authorization.blockers];

  if (!fs.existsSync(path.join(repo, "AGENTS.md"))) blockers.push("missing AGENTS.md");
  if (!installation.exists) blockers.push("missing docs/ai/ACEF_INSTALLATION.json");
  if (installation.error) blockers.push(`invalid ACEF installation manifest: ${installation.error}`);

  const nextAllowedStep = activeRun.record?.nextAllowedStep || null;
  return {
    schema: "acef.status.v1",
    repo,
    git,
    status: blockers.length ? "needs-attention" : "ready",
    blockers,
    readOrder: [
      "AGENTS.md",
      ".acef/bin/acef-status --repo .",
      contextPath,
      ledgerPath || "docs/ai/ACEF_ACTIVE_LEDGER",
    ],
    activeRun: activeRun.record ? {
      runId: activeRun.record.runId,
      lane: activeRun.record.lane,
      workflowId: activeRun.record.workflowId,
      fullFlowContract: activeRun.record.workflowId === "full-bmad"
        ? (activeRun.record.fullFlowContract || "six-actor-v2")
        : null,
      assuranceProfile: activeRun.record.assuranceProfile,
      scopeUnit: activeRun.record.scopeUnit,
      executionPath: displayName(activeRun.record),
      status: activeRun.record.status,
      activeEpic: activeRun.record.activeEpic ?? null,
      activeStory: activeRun.record.activeStory,
      activePhase: activeRun.record.activePhase,
      workerRole: activeRun.record.workerRole ?? null,
      activeActorId: activeRun.record.activeActorId ?? null,
      lastPassedGate: activeRun.record.lastPassedGate ?? null,
      nextAllowedStep,
      ledgerPath,
      contextPath,
    } : null,
    directRun: authorization.directRun ? {
      runId: authorization.directRun.runId,
      status: authorization.directRun.status,
      scope: authorization.directRun.scope,
      technicalBoundary: authorization.directRun.technicalBoundary,
      promotionDecision: authorization.directRun.promotion.decision,
      changedPaths: authorization.directRun.changedPaths,
    } : null,
    installation: installation.record ? {
      path: installation.path,
      sourceCommit: installation.record.acefVersion?.sourceCommit ?? null,
      sourceShortCommit: installation.record.acefVersion?.sourceShortCommit ?? null,
      sourceBranch: installation.record.acefVersion?.sourceBranch ?? null,
      sourceTreeState: installation.record.acefVersion?.sourceTreeState ?? null,
      sourcePath: installation.record.acefVersion?.sourcePath ?? null,
      lastUpdatedAt: installation.record.lastUpdatedAt ?? installation.record.installedAt ?? null,
      components: Object.keys(installation.record.components || {}).sort(),
      updateCommand: installation.record.updateCommand ?? null,
    } : null,
    workerScope: workerScope.record ? {
      activeStory: workerScope.record.activeStory,
      phase: workerScope.record.phase,
      workerId: workerScope.record.workerId,
      allowedPaths: workerScope.record.allowedPaths,
      maxCommits: workerScope.record.maxCommits,
      canEditLedger: workerScope.record.canEditLedger,
      canSpawnAgents: workerScope.record.canSpawnAgents,
    } : null,
    reminders: [
      "Do not infer approval from go on/devam/tamamla.",
      "Do not start the next epic/story unless active state and approval allow it.",
      "Workers read current context and scoped artifacts, not the full ledger by default.",
      "Agent output is not evidence until backed by files, hashes, commands, or typed gates.",
    ],
  };
}

function printText(status) {
  console.log(`ACEF status: ${status.status}`);
  console.log(`repo: ${status.repo}`);
  if (status.git.branch || status.git.head) console.log(`git: ${status.git.branch || "detached"} ${status.git.head || ""}`.trim());
  if (status.blockers.length) {
    console.log("blockers:");
    for (const blocker of status.blockers) console.log(`- ${blocker}`);
  }
  console.log("read order:");
  for (const entry of status.readOrder) console.log(`- ${entry}`);
  if (status.activeRun) {
    console.log("active run:");
    console.log(`- execution path: ${status.activeRun.executionPath}`);
    console.log(`- workflow: ${status.activeRun.workflowId}`);
    if (status.activeRun.fullFlowContract) console.log(`- full flow contract: ${status.activeRun.fullFlowContract}`);
    console.log(`- assurance: ${status.activeRun.assuranceProfile}`);
    console.log(`- status: ${status.activeRun.status}`);
    if (status.activeRun.activeEpic) console.log(`- epic: ${status.activeRun.activeEpic}`);
    console.log(`- story: ${status.activeRun.activeStory}`);
    console.log(`- phase: ${status.activeRun.activePhase}`);
    if (status.activeRun.lastPassedGate) console.log(`- last passed gate: ${status.activeRun.lastPassedGate}`);
    if (status.activeRun.nextAllowedStep) console.log(`- next allowed step: ${status.activeRun.nextAllowedStep}`);
    console.log(`- ledger: ${status.activeRun.ledgerPath}`);
    console.log(`- context: ${status.activeRun.contextPath}`);
  }
  if (status.directRun) {
    console.log("direct run:");
    console.log(`- status: ${status.directRun.status}`);
    console.log(`- scope: ${status.directRun.scope}`);
    console.log(`- technical boundary: ${status.directRun.technicalBoundary}`);
    console.log(`- promotion: ${status.directRun.promotionDecision}`);
  }
  if (status.installation) {
    console.log("ACEF installation:");
    console.log(`- source: ${status.installation.sourceShortCommit || status.installation.sourceCommit || "unknown"} (${status.installation.sourceBranch || "unknown"}, ${status.installation.sourceTreeState || "unknown"})`);
    console.log(`- updated: ${status.installation.lastUpdatedAt || "unknown"}`);
    console.log(`- components: ${status.installation.components.join(", ") || "none"}`);
    if (status.installation.updateCommand) console.log(`- update: ${status.installation.updateCommand}`);
  }
  if (status.workerScope) {
    console.log("worker scope:");
    console.log(`- worker: ${status.workerScope.workerId}`);
    console.log(`- phase: ${status.workerScope.phase}`);
    console.log(`- allowed paths: ${status.workerScope.allowedPaths.join(", ")}`);
    console.log(`- max commits: ${status.workerScope.maxCommits}`);
  }
  console.log("reminders:");
  for (const reminder of status.reminders) console.log(`- ${reminder}`);
}

try {
  const opts = parseArgs(process.argv.slice(2));
  if (opts.help) {
    usage();
    process.exit(0);
  }
  const status = buildStatus(opts.repo);
  if (opts.format === "json") {
    console.log(JSON.stringify(status, null, 2));
  } else {
    printText(status);
  }
  if (status.blockers.length) process.exitCode = 2;
} catch (error) {
  console.error(`acef-status: ${error.message}`);
  process.exitCode = 1;
}
