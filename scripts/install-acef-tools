#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");
const {
  createOwnedFileWriter,
  installedRuntimeDigest,
  installedSourceBaseline,
  mergeHostJson,
  sourceRuntimeDigest,
  writeInstallationManifest,
} = require("./lib/acef-installation");
const { validateModelRoutingPolicy } = require("./lib/acef-model-routing");
const { assertRoutingPreflight } = require("./lib/acef-routing-preflight");

const repoRoot = path.resolve(__dirname, "..");
const tools = [
  "acef-state",
  "acef-status",
  "acef-next",
  "acef-supervisor",
  "acef-workflow-validate",
  "acef-process-validator",
  "acef-closeout-verify",
  "acef-codex-guard",
  "acef-native-test",
  "acef-worktree-test",
  "acef-lightweight-surface-evidence",
  "acef-scoped-format",
  "acef-query",
  "acef-context-experiment",
  "acef-context-experiment-report",
  "acef-context-experiment-manifest",
  "acef-context-next-run",
  "acef-context-actor-prompt",
  "acef-context-actor-prompt-batch",
  "acef-context-record-actor-report",
  "acef-pr-review",
  "acef-worker-result",
  "acef-note",
  "acef-version-check",
  "acef-detect",
  "acef-retro",
  "update-acef-installation",
];

function usage() {
  console.log(`Usage: scripts/install-acef-tools --repo <path>

Installs ACEF local helper CLIs into:
  <repo>/.acef/bin/

This keeps validators and guards repo-local instead of relying on the ACEF checkout path.`);
}

function parseArgs(argv) {
  const opts = { repo: "" };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--repo" || arg === "--target") {
      opts.repo = argv[++index] || "";
    } else if (arg === "-h" || arg === "--help") {
      usage();
      process.exit(0);
    } else {
      throw new Error(`Unknown argument: ${arg}`);
    }
  }
  if (!opts.repo) throw new Error("--repo is required");
  opts.repo = path.resolve(opts.repo);
  return opts;
}

// Every write goes through the owned-file writer: a host-modified copy is kept and reported, never overwritten.
function rel(...parts) {
  return path.join(...parts).split(path.sep).join("/");
}

function copyTool(name, writer) {
  const source = path.join(repoRoot, "scripts", name);
  const target = rel(".acef", "bin", name);
  if (!fs.existsSync(source)) throw new Error(`Tool source not found: ${source}`);
  const content = fs.readFileSync(source);
  if (content.toString("utf8").startsWith("#!/usr/bin/env python3")) {
    // Python tools (acef-note, acef-version-check) are copied as they are; there is no Node wrapper.
    // Older installs wrapped every tool in node; that .cjs is removed only when it is still ACEF's copy.
    writer.removeOwned(`${target}.cjs`, { sourceRel: rel("scripts", name) });
    writer.write(target, content, { mode: 0o755, sourceRel: rel("scripts", name) });
    return target;
  }
  writer.write(`${target}.cjs`, content, { mode: 0o755, sourceRel: rel("scripts", name) });
  writer.write(target, `#!/usr/bin/env sh\nexec node "$(dirname "$0")/${name}.cjs" "$@"\n`, { mode: 0o755, generated: true });
  return target;
}

function copyDirectoryFiles(sourceDir, targetDir, writer) {
  const absolute = path.join(repoRoot, sourceDir);
  if (!fs.existsSync(absolute)) return [];
  const copied = [];
  for (const entry of fs.readdirSync(absolute).sort((a, b) => a.localeCompare(b))) {
    const source = path.join(absolute, entry);
    if (!fs.statSync(source).isFile()) continue;
    const target = rel(targetDir, entry);
    writer.write(target, fs.readFileSync(source), { sourceRel: rel(sourceDir, entry) });
    copied.push(target);
  }
  return copied;
}

function writeRuntimePackage(writer) {
  const target = rel(".acef", "bin", "package.json");
  writer.write(target, `${JSON.stringify({ private: true, type: "commonjs" }, null, 2)}\n`, { generated: true });
  return target;
}

function copySingle(sourceRel, targetRel, writer) {
  const source = path.join(repoRoot, sourceRel);
  if (!fs.existsSync(source)) return "";
  writer.write(targetRel, fs.readFileSync(source), { sourceRel });
  return targetRel;
}

// Host-local model choices survive an update: values the host changed stay, values still equal to the ACEF copy they
// were installed from follow the new ACEF copy, and new keys are added.
function mergeModelRoutingPolicy(targetRepo) {
  const source = path.join(repoRoot, "method", "model-routing-policy-v1.json");
  if (!fs.existsSync(source)) return "";
  const target = rel(".acef", "model-routing-policy.json");
  const baseline = installedSourceBaseline(targetRepo, repoRoot, "tools", rel("method", "model-routing-policy-v1.json"));
  mergeHostJson(targetRepo, target, fs.readFileSync(source), validateModelRoutingPolicy, baseline);
  return target;
}

const opts = parseArgs(process.argv.slice(2));
// Review floors are checked before anything is written: a rejected install leaves the host byte-identical.
assertRoutingPreflight(repoRoot, opts.repo);
const writer = createOwnedFileWriter(opts.repo, repoRoot, "tools");
console.log(`Installed ACEF runtime package boundary: ${writeRuntimePackage(writer)}`);
for (const tool of tools) {
  console.log(`Installed ${tool}: ${copyTool(tool, writer)}`);
}
// acef-detect finds its core detectors next to itself (.acef/bin/detectors); host detectors stay in .acef/detectors.
for (const detector of copyDirectoryFiles(rel("scripts", "detectors"), rel(".acef", "bin", "detectors"), writer)) {
  console.log(`Installed detector: ${detector}`);
}
for (const library of copyDirectoryFiles(rel("scripts", "lib"), rel(".acef", "bin", "lib"), writer)) {
  console.log(`Installed support library: ${library}`);
}
for (const schema of copyDirectoryFiles("schemas", rel(".acef", "schemas"), writer)) {
  console.log(`Installed schema: ${schema}`);
}
const controlDosing = copySingle(rel("method", "control-dosing.json"), rel(".acef", "control-dosing.json"), writer);
if (controlDosing) {
  console.log(`Installed control dosing manifest: ${controlDosing}`);
}
const reviewFloorsSource = path.join(repoRoot, "method", "model-review-floors-v1.json");
if (fs.existsSync(reviewFloorsSource)) {
  writer.write(rel(".acef", "model-review-floors.json"), fs.readFileSync(reviewFloorsSource), { sourceRel: rel("method", "model-review-floors-v1.json"), acefOwned: true });
  console.log(`Installed ACEF-owned review floors: ${rel(".acef", "model-review-floors.json")}`);
}
const modelRoutingPolicy = mergeModelRoutingPolicy(opts.repo);
if (modelRoutingPolicy) {
  console.log(`Installed model routing policy: ${modelRoutingPolicy}`);
}
for (const fixture of copyDirectoryFiles(rel("docs", "experiments", "context-retrieval", "tasks"), rel(".acef", "context-retrieval", "tasks"), writer)) {
  console.log(`Installed context experiment fixture: ${fixture}`);
}
for (const workflow of copyDirectoryFiles("workflows", rel(".acef", "workflows"), writer)) {
  console.log(`Installed workflow: ${workflow}`);
}
const { files: ownedFiles } = writer.finish("install-acef-tools");
console.log(`Updated ACEF installation manifest: ${writeInstallationManifest(opts.repo, repoRoot, "tools", {
  tools,
  schemas: fs.existsSync(path.join(repoRoot, "schemas")),
  controlDosing: fs.existsSync(path.join(repoRoot, "method", "control-dosing.json")),
  modelRoutingPolicy: fs.existsSync(path.join(repoRoot, "method", "model-routing-policy-v1.json")),
  defaultModelRoutingContract: "admitted-role-routing-v1",
  defaultLightweightStateContract: "lightweight-state-v1",
  workflows: fs.existsSync(path.join(repoRoot, "workflows")),
  defaultRuntimeContract: "capsule-supervisor-v2",
  dispatchReadinessContract: "full-v3-dispatch-readiness-v1",
  objectiveSupervisor: "objective-supervisor-v1",
  boundedRedOwnershipContract: "integrated-developer-v1",
  fullRedOwnershipContract: "independent-test-author-v1",
  worktreeIsolationContract: "worktree-test-v1",
  freshnessContract: "worktree-handshake-v1",
  sourceRuntimeDigest: sourceRuntimeDigest(repoRoot),
  installedRuntimeDigest: installedRuntimeDigest(opts.repo),
  files: ownedFiles,
})}`);
