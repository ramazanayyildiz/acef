function upheldCorrectionSession(correctionMessage) {
  return [
    syntheticSession.replace("ACTOR_RESULT=PASS", "ACTOR_RESULT=REVISE"),
    JSON.stringify({ type: "response_item", payload: { type: "function_call", namespace: "collaboration", name: "spawn_agent", call_id: "adjudicate-uphold", arguments: JSON.stringify({ task_name: adjudicationName, fork_turns: "none", message: "frozen findings only" }) } }),
    JSON.stringify({ type: "event_msg", payload: { type: "sub_agent_activity", event_id: "adjudicate-uphold", agent_thread_id: "receiver-adjudication-uphold", kind: "started" } }),
    JSON.stringify({ type: "response_item", payload: { type: "agent_message", author: `/root/${adjudicationName}`, content: [{ type: "input_text", text: `Message Type: FINAL_ANSWER\nSender: /root/${adjudicationName}\nPayload:\nATDD_ADJUDICATION=UPHOLD\nACTOR_RESULT=PASS` }] } }),
    JSON.stringify({ type: "response_item", payload: { type: "function_call", namespace: "collaboration", name: "spawn_agent", call_id: "correct-1", arguments: JSON.stringify({ task_name: correctionName, fork_turns: "none", message: correctionMessage }) } }),
    JSON.stringify({ type: "event_msg", payload: { type: "sub_agent_activity", event_id: "correct-1", agent_thread_id: "receiver-correction", kind: "started" } }),
    JSON.stringify({ type: "response_item", payload: { type: "agent_message", author: `/root/${correctionName}`, content: [{ type: "input_text", text: `Message Type: FINAL_ANSWER\nSender: /root/${correctionName}\nPayload:\nACTOR_RESULT=PASS` }] } }),
  ].join("\n");
}
const upheldCorrectionEvidence = parseCollaborationEvidence(syntheticRaw, upheldCorrectionSession("encrypted-at-rest"), epicActorContract);
assert.equal(upheldCorrectionEvidence.ok, true, "one upheld correction is accepted at the transcript layer");
assert.deepEqual(upheldCorrectionEvidence.correctionBindings, [{
  taskName: correctionName,
  sourceTaskName: firstAtdd.taskName,
  findingsSha256: sha256(revisedAtddFinalText),
}], "the durable correction contract must bind the exact parent-delivered findings independently of encrypted spawn text");
