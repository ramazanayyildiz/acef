assert.equal(pilotPlan.length, 16);
assert.equal(pilotPlan.find((attempt) => attempt.id === "R1-legacy-1").frameworkCommit, manifest.treatments.legacy.commit);
assert.equal(pilotPlan.find((attempt) => attempt.id === "R1-candidate-1").frameworkCommit, manifest.treatments.candidate.commit);
