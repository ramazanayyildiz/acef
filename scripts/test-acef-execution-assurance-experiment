  fs.writeFileSync(path.join(treatmentRepo, "docs/ai/ACEF_ACTIVE_RUN.json"), `${JSON.stringify({
    schema: "acef.active-run.v2", runId: "candidate-v3-test", repo: "fixture",
    workflowId: "full-bmad", assuranceProfile: "guarded", assuranceRationale: "fixture risk",
