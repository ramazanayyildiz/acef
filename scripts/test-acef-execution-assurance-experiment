  syntheticSession.replace("ACTOR_RESULT=PASS", "ACTOR_RESULT=REVISE"),
  JSON.stringify({ type: "response_item", payload: { type: "function_call", namespace: "collaboration", name: "spawn_agent", call_id: "adjudicate-1", arguments: JSON.stringify({ task_name: adjudicationName, fork_turns: "none", message: "frozen findings only" }) } }),
  JSON.stringify({ type: "event_msg", payload: { type: "sub_agent_activity", event_id: "adjudicate-1", agent_thread_id: "receiver-adjudication", kind: "started" } }),
  JSON.stringify({ type: "response_item", payload: {
    type: "agent_message", author: `/root/${adjudicationName}`,
