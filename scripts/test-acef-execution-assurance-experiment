function eventTimestamp(second) {
  return new Date(Date.parse("2026-08-01T00:00:00.000Z") + second * 1000).toISOString();
}
function lifecycleSession(contract, resultByTask = {}, extras = []) {
  return [JSON.stringify({ timestamp: eventTimestamp(0), type: "session_meta", payload: {
    session_id: "parent-thread", timestamp: "2026-08-01T00:00:00.000Z", cwd: root, cli_version: "0.146.0",
  } }), ...contract.flatMap((entry, index) => {
    const callId = `v3-call-${index}`;
    const receiver = `v3-receiver-${index}`;
    const storyIndex = Math.floor(index / 4);
    const phaseIndex = index % 4;
    const startedAt = entry.scope === "epic" ? 55
      : (storyIndex * 12) + [1, 3, 5, 6][phaseIndex];
    const finishedAt = entry.scope === "epic" ? 56
      : (storyIndex * 12) + [2, 4, 8, 9][phaseIndex];
    return [
      JSON.stringify({ timestamp: eventTimestamp(startedAt), type: "response_item", payload: { type: "function_call", namespace: "collaboration", name: "spawn_agent", call_id: callId, arguments: JSON.stringify({ task_name: entry.taskName, fork_turns: "none" }) } }),
      JSON.stringify({ timestamp: eventTimestamp(startedAt + 0.5), type: "event_msg", payload: { type: "sub_agent_activity", event_id: callId, agent_thread_id: receiver, kind: "started" } }),
      JSON.stringify({ timestamp: eventTimestamp(finishedAt), type: "response_item", payload: {
        type: "agent_message", author: `/root/${entry.taskName}`,
        content: [{ type: "input_text", text: `Message Type: FINAL_ANSWER\nSender: /root/${entry.taskName}\nPayload:\nACTOR_RESULT=${resultByTask[entry.taskName] || "PASS"}` }],
      } }),
    ];
  }), ...extras].join("\n");
}
