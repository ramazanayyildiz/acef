const frozenIntegrationArgv = ["sh", "-c", "php artisan test --filter=Frozen && vendor/bin/phpunit --filter=Frozen"];
const integrationCall = JSON.stringify({ timestamp: eventTimestamp(11), type: "response_item", payload: {
  type: "function_call", name: "exec_command", call_id: "integration-1",
  arguments: JSON.stringify({ cmd: frozenIntegrationArgv[2] }),
} });
const integrationOutput = JSON.stringify({ timestamp: eventTimestamp(12), type: "response_item", payload: {
  type: "function_call_output", call_id: "integration-1", output: JSON.stringify({ exit_code: 0, output: "PASS" }),
} });
assert.equal(parseLifecycleIntegrationEvidence(`${integrationCall}\n${integrationOutput}`, frozenIntegrationArgv,
  eventTimestamp(10), eventTimestamp(20)).ok, true);
assert.equal(parseLifecycleIntegrationEvidence("", frozenIntegrationArgv,
  eventTimestamp(10), eventTimestamp(20)).ok, false, "missing frozen lifecycle integration command fails closed");
assert.equal(parseLifecycleIntegrationEvidence(`${integrationCall}\n${integrationOutput}\n${integrationCall}\n${integrationOutput}`,
  frozenIntegrationArgv, eventTimestamp(10), eventTimestamp(20)).ok, false,
"duplicate exact lifecycle integration commands fail closed");
assert.equal(parseLifecycleIntegrationEvidence(`${integrationCall}\n${integrationOutput}`, frozenIntegrationArgv,
  eventTimestamp(11.5), eventTimestamp(20)).ok, false,
"integration command must start only after all story PASS evidence is complete");
const falseGreenWrapperOutput = JSON.stringify({ timestamp: eventTimestamp(12), type: "response_item", payload: {
  type: "function_call_output", call_id: "integration-1", output: "Script completed\nexit_code: 1\nFAIL",
} });
assert.equal(parseLifecycleIntegrationEvidence(`${integrationCall}\n${falseGreenWrapperOutput}`,
  frozenIntegrationArgv, eventTimestamp(10), eventTimestamp(20)).ok, false,
"wrapper completion cannot conceal an explicit nonzero inner integration exit code");
