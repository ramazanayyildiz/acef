  const livePolicyChild = `const fs=require('fs'); console.log(JSON.stringify({type:'thread.started',thread_id:${JSON.stringify(livePolicyThread)}})); setTimeout(()=>fs.writeFileSync(${JSON.stringify(livePolicyTranscript)},${JSON.stringify(`${forbiddenFollowup}\n`)}),100); setInterval(()=>{},30000);`;
  fs.writeFileSync(livePolicyRequest, `${JSON.stringify({
