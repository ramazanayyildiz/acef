  const finalizeRaw = path.join(finalizeWorkspace, "raw", "FINALIZE-fixture.jsonl");
  const finalizeRequest = path.join(finalizeWorkspace, "requests", "FINALIZE-fixture.json");
  const finalizeReceipt = path.join(finalizeWorkspace, "receipts", "FINALIZE-fixture.json");
