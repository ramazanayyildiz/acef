function judgeSessionBytes(sessionId, verdict, productOutcomeComplete, timestamp, findings = []) {
  const finalAnswer = [
    "Message Type: FINAL_ANSWER",
    `JUDGE_PACKET_SHA256=${judgePacketSha256}`,
    `JUDGE_INPUT_BUNDLE_SHA256=${judgmentInputBundleSha256}`,
    `PRODUCT_CONTRACT_SHA256=${judgmentProductContractSha256}`,
    `JUDGE_VERDICT=${verdict}`,
    `PRODUCT_OUTCOME_COMPLETE=${productOutcomeComplete}`,
    "SCOPE_VIOLATION=false",
    "TEST_WEAKENING=false",
    `FINDINGS_SHA256=${sha256(JSON.stringify(findings))}`,
  ].join("\n");
  return [
    JSON.stringify({ type: "session_meta", payload: {
      id: sessionId, parent_thread_id: null, cwd: judgmentUnitDir,
      cli_version: v3Manifest.pilotRuntime.clientVersion.replace(/^codex-cli\s+/, ""),
    } }),
    JSON.stringify({ timestamp, type: "event_msg", payload: {
      type: "agent_message", phase: "final_answer", message: finalAnswer,
    } }),
  ].join("\n") + "\n";
}
function createJudgeBinding(prefix, sessionId, verdict, productOutcomeComplete, finalAt, startedAt, finishedAt, findings = []) {
  const sessionTranscriptPath = path.join(judgmentUnitDir, `${prefix}-session.jsonl`);
  fs.writeFileSync(sessionTranscriptPath,
    judgeSessionBytes(sessionId, verdict, productOutcomeComplete, finalAt, findings));
  const receiptPath = path.join(judgmentUnitDir, `${prefix}-receipt.json`);
  const prompt = `blind judge fixture ${prefix}`;
  const requestPath = path.join(judgmentUnitDir, `${prefix}-request.json`);
  const launchNonce = `fixture:${prefix}:v1`;
  fs.writeFileSync(requestPath, `${JSON.stringify({
    command: process.execPath,
    args: ["exec", "--model", v3Manifest.pilotRuntime.model,
      `model_reasoning_effort=${JSON.stringify(v3Manifest.pilotRuntime.reasoningEffort)}`, prompt],
    cwd: judgmentUnitDir, launchNonce,
  })}\n`);
  const requestSha256 = sha256(fs.readFileSync(requestPath, "utf8"));
  const actorReceiptPath = path.join(judgmentUnitDir, `${prefix}-actor-receipt.json`);
  fs.writeFileSync(actorReceiptPath, `${JSON.stringify({
    status: 0, requestSha256, launchNonce, startedAt, finishedAt,
  })}\n`);
  fs.writeFileSync(receiptPath, `${JSON.stringify({
    schema: "acef.execution-assurance-judge-receipt.v1", experimentId: v3Manifest.experimentId,
    attemptRunId: "P0-candidate-v3", judgePacketSha256, inputBundleSha256: judgmentInputBundleSha256,
    productContractSha256: judgmentProductContractSha256, judgeSessionId: sessionId,
    judgeModel: v3Manifest.pilotRuntime.model, reasoningEffort: v3Manifest.pilotRuntime.reasoningEffort,
    clientPath: process.execPath, clientBinarySha256: sha256(fs.readFileSync(process.execPath)),
    clientVersion: v3Manifest.pilotRuntime.clientVersion, requestPath, requestSha256,
    actorReceiptPath, actorReceiptSha256: sha256(fs.readFileSync(actorReceiptPath, "utf8")), promptSha256: sha256(prompt),
    sessionTranscriptPath, sessionTranscriptSha256: sha256(fs.readFileSync(sessionTranscriptPath, "utf8")),
    freshSession: true, artifactOnly: true, treatmentBlinded: true, transcriptWithheld: true,
    crossRunMemory: false, parentSessionId: null, startedAt, finishedAt,
  })}\n`);
  return { sessionTranscriptPath, receiptPath, receiptSha256: sha256(fs.readFileSync(receiptPath, "utf8")) };
}
