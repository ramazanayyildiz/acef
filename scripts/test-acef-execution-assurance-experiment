    reviewerCompletions: v3ReviewerCompletions, developerReactivations: [] };
  const untrackedV3Durable = validateDurableLifecycleEvidence(lifecycleRepo, v3DurableExpected, v3DurableExpected, {
    ...v3DurableOptions,
  });
  assert.equal(untrackedV3Durable.ok, false, "untracked v3 close package must not count as durable");
  assert.ok(untrackedV3Durable.failures.some((entry) => /not tracked/.test(entry)), untrackedV3Durable.failures.join("; "));
  cp.spawnSync("git", ["add", "docs/ai"], { cwd: lifecycleRepo });
  const packageCommit = cp.spawnSync("git", ["commit", "-qm", "chore: commit v3 story-close package"], {
