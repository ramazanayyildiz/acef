    gateId: "v3-story-close", gateType: "deterministic-story-close-v3", decisionMode: "deterministic",
    runId: v3RunId, fullFlowContract: "four-actor-v3", storyInventory: v3StoryInventory,
    scope: v3Story, verdict: "PASS", decidedBy: "acef-story-close-v3", repositoryCommit: lifecycleRedCommit,
    repositoryTree: lifecycleTree, applicationCommit: lifecycleRedCommit, applicationTree: lifecycleTree,
