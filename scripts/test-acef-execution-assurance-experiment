  assert.ok(!scopedTestRepairDurable.failures.some((entry) => /Code Review predates/.test(entry)),
    "scoped test-only repair may retain prior Code Review but requires Patch Assurance");
  fs.appendFileSync(path.join(lifecycleRepo, "README.md"), "scoped production repair\n");
