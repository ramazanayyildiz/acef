      sessionRoot: livePolicyRoot,
    },
  })}\n`);
  const livePolicyActor = cp.spawn(process.execPath, [actorCli, livePolicyRequest], {
    cwd: tmp, detached: true, stdio: "ignore",
  });
  livePolicyActor.unref();
  assert.equal(waitUntil(() => fs.existsSync(livePolicyReceipt)), true,
    "live supervisor must publish a receipt after a forbidden ATDD follow-up");
  const livePolicyResult = JSON.parse(fs.readFileSync(livePolicyReceipt, "utf8"));
  assert.equal(livePolicyResult.policyViolation?.code, "FORBIDDEN_FOLLOWUP_TARGET");
  assert.equal(livePolicyResult.policyViolation?.target, "/root/acef_s1_resolver_fail_closed_atdd");
  assert.notEqual(livePolicyResult.status, 0,
    "forbidden ATDD reactivation must terminate the parent before Development can continue");

  const sameOrdinalResults = path.join(tmp, "same-ordinal", "pilot.jsonl");
