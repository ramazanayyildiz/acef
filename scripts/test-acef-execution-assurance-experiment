  return [
    JSON.stringify({ type: "response_item", payload: { type: "function_call", namespace: "collaboration", name: "spawn_agent", call_id: callId, arguments: JSON.stringify({ task_name: taskName, fork_turns: "none" }) } }),
    JSON.stringify({ type: "event_msg", payload: { type: "sub_agent_activity", event_id: callId, agent_thread_id: `retry-receiver-${index}`, kind: "started" } }),
