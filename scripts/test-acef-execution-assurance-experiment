  fs.mkdirSync(livePolicyDirectory, { recursive: true });
  const forbiddenFollowup = JSON.stringify({ timestamp: "2026-08-03T00:00:01.000Z", type: "response_item", payload: {
    type: "function_call", namespace: "collaboration", name: "followup_task", call_id: "forbidden-atdd-followup",
    arguments: JSON.stringify({ target: "/root/acef_s1_resolver_fail_closed_atdd", message: "retry" }),
