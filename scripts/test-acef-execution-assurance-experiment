  } }),
].join("\n");
assert.equal(parseCollaborationEvidence(syntheticRaw, revisedWithAdjudication, epicActorContract).ok, true,
  "one fresh adjudicator may overrule an over-broad ATDD REVISE without replaying ATDD");
