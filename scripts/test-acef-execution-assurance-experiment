  JSON.stringify({ type: "response_item", payload: { type: "function_call", namespace: "collaboration", name: "spawn_agent", call_id: "one", arguments: JSON.stringify({ task_name: epicActorContract[0].taskName, fork_turns: "none" }) } }),
  JSON.stringify({ type: "event_msg", payload: { type: "sub_agent_activity", event_id: "one", agent_thread_id: "receiver-one", kind: "started" } }),
