  const finalizeRequestSha = require("./lib/acef-execution-assurance-experiment").sha256(fs.readFileSync(finalizeRequest, "utf8"));
  fs.writeFileSync(finalizeReceipt, `${JSON.stringify({
    schema: "acef.execution-assurance-actor-receipt.v1",
    requestPath: finalizeRequest,
    requestSha256: finalizeRequestSha,
    launchNonce: finalizeActorRequest.launchNonce,
