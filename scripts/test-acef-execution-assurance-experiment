  cp.spawnSync("git", ["commit", "-qm", "fix: scoped application repair after review"], { cwd: lifecycleRepo });
  const appRepairDurable = validateDurableLifecycleEvidence(lifecycleRepo, v3DurableExpected, v3DurableExpected, {
    ...v3DurableOptions,
  });
  assert.ok(appRepairDurable.failures.some((entry) => /Code Review predates/.test(entry)));
  assert.ok(appRepairDurable.failures.some((entry) => /Patch Assurance does not bind/.test(entry)));
  const originalV3Gate = JSON.parse(fs.readFileSync(path.join(lifecycleRepo, "docs", "ai", "gates", "v3-story-close.json"), "utf8"));
  fs.writeFileSync(path.join(lifecycleRepo, "docs", "ai", "gates", "v3-story-close-duplicate.json"), `${JSON.stringify({
    ...originalV3Gate, gateId: "v3-story-close-duplicate",
