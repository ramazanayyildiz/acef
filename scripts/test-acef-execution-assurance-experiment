  cp.spawnSync("git", ["commit", "-qm", "test: introduce package member separately"], { cwd: lifecycleRepo });
  const committedGate = JSON.parse(fs.readFileSync(path.join(lifecycleRepo, "docs", "ai", "gates", "v3-story-close.json"), "utf8"));
  Object.defineProperty(committedGate, "_recordPath", { value: path.join(lifecycleRepo, "docs", "ai", "gates", "v3-story-close.json") });
  const splitPackageFailures = validateFormalStoryClosePackage(v3Story, committedGate, lifecycleRepo,
    [...v3DurableExpected.map((entry) => path.join(lifecycleRepo, "docs", "ai", "actors", `${entry.taskName}.json`)), latePackagePath],
    Object.values(reportBindings).map((entry) => path.join(lifecycleRepo, entry.path)),
    require(path.join(lifecycleRepo, ".acef", "bin", "lib", "acef-state-parser.js")));
  assert.ok(splitPackageFailures.some((entry) => /not introduced in one commit/.test(entry)),
    "story-close package members introduced across commits fail closed");
  const v3GreenEvidencePath = path.join(lifecycleRepo, "docs", "ai", "evidence", "v3-green.json");
