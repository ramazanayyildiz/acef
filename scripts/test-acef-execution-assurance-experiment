  frozenIntegrationArgv, eventTimestamp(10), eventTimestamp(20)).ok, false,
"wrapper completion without a structured inner exit code is not success evidence");
const contradictoryExitOutput = JSON.stringify({ timestamp: eventTimestamp(12), type: "response_item", payload: {
  type: "function_call_output", call_id: "integration-1", output: '{"exit_code":0}\nProcess exited with code 1',
} });
