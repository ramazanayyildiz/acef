      actorInstanceId: actor.taskName, runId: v3RunId, fullFlowContract: "four-actor-v3",
      storyInventory: v3StoryInventory,
      story: v3Story, phase: actor.control, role: actor.persona,
      client: "codex", inputCommit, inputTree: lifecycleTree, allowedContextProfile: "artifact-only",
      ...(actor.control === "code-review" ? {
        producedArtifactHash: reviewHash, producedArtifactPath: reportBindings["code-review"].path,
      } : {}),
      ...(actor.control === "patch-assurance" ? {
        producedArtifactHash: assuranceHash, producedArtifactPath: reportBindings["patch-assurance"].path,
      } : {}),
    })}\n`);
