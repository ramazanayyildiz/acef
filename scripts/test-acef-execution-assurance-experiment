  assert.ok(replacedReviewerBlob.failures.some((entry) => /reviewer child-completion blob/.test(entry)),
    "a conductor replacement cannot substitute a different report blob after reviewer completion");
  const committedGatePath = path.join(lifecycleRepo, "docs", "ai", "gates", "v3-story-close.json");
