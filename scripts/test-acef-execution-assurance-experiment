  finalizePilotAttempt(finalizeManifest, finalizeOpts, finalizeCheckpoint);
  finalizePilotAttempt(finalizeManifest, finalizeOpts, finalizeCheckpoint);
  const finalizedRows = fs.readFileSync(finalizeResults, "utf8").trim().split(/\n/).map(JSON.parse);
  assert.equal(finalizedRows.length, 1, "repeated finalization must append exactly one immutable row");
  assert.equal(finalizedRows[0].result, "PROVISIONAL_PASS");
  assert.equal(fs.existsSync(finalizedRows[0].judgePacketPath), true,
    "finalization must create the immutable artifact-only judge packet");
  assert.equal(sha(fs.readFileSync(finalizedRows[0].judgePacketPath, "utf8")), finalizedRows[0].judgePacketSha256);
  const finalizedJudgePacket = JSON.parse(fs.readFileSync(finalizedRows[0].judgePacketPath, "utf8"));
  assert.equal(finalizedJudgePacket.productContract.schema, "acef.execution-assurance-product-contract.v1");
  assert.equal(finalizedJudgePacket.productContractSha256, finalizedRows[0].productContractSha256);
  assert.equal(finalizedJudgePacket.inputBundleSha256, finalizedRows[0].judgeInputBundleSha256);
  assert.equal(finalizedJudgePacket.changedPaths.some((entry) => /^docs\/ai\//.test(entry)), false);
  assert.equal(fs.existsSync(finalizedRows[0].fullDiffPath), true,
    "process audit retains the separate full diff while the blind packet receives only product paths");
  assert.equal(sha(fs.readFileSync(finalizedRows[0].fullDiffPath, "utf8")), finalizedRows[0].fullDiffSha256);
  assert.equal(finalizedRows[0].productDoneReceiptPath, finalizedRows[0].verificationReceiptPath);
  assert.equal(sha(fs.readFileSync(finalizedRows[0].productDoneReceiptPath, "utf8")),
    finalizedRows[0].productDoneReceiptSha256);
  assert.equal(finalizedRows[0].harnessProductDoneAt,
    JSON.parse(fs.readFileSync(finalizedRows[0].productDoneReceiptPath, "utf8")).finishedAt);
  assert.ok(Date.parse(finalizedRows[0].harnessProductDoneAt) <= Date.parse(finalizedRows[0].finishedAt));
  assert.equal(JSON.parse(fs.readFileSync(finalizeCheckpointPath, "utf8")).status, "finalized");

  const invalidatedHistory = path.join(tmp, "invalidated-history");
  const invalidatedResults = path.join(invalidatedHistory, "pilot.jsonl");
  fs.mkdirSync(invalidatedHistory, { recursive: true });
  fs.writeFileSync(path.join(invalidatedHistory, "pilot-adjudications.jsonl"),
