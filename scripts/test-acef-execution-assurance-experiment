function retryEvents(entry, ordinal, result) {
  const taskName = `${entry.taskName}_retry${ordinal}`;
  const callId = `v3-${entry.control.replace(/-/g, "-")}-retry-${ordinal}`;
  const startedAt = 65 + ((ordinal - 1) * 10);
  return [
    JSON.stringify({ timestamp: eventTimestamp(startedAt), type: "response_item", payload: { type: "function_call", namespace: "collaboration", name: "spawn_agent", call_id: callId, arguments: JSON.stringify({ task_name: taskName, fork_turns: "none" }) } }),
    JSON.stringify({ timestamp: eventTimestamp(startedAt + 0.5), type: "event_msg", payload: { type: "sub_agent_activity", event_id: callId, agent_thread_id: `${callId}-receiver`, kind: "started" } }),
    JSON.stringify({ timestamp: eventTimestamp(startedAt + 1), type: "response_item", payload: { type: "agent_message", author: `/root/${taskName}`, content: [{ type: "input_text", text: `Message Type: FINAL_ANSWER\nSender: /root/${taskName}\nPayload:\nREPAIR_CYCLE=${ordinal}\nACTOR_RESULT=${result}` }] } }),
  ];
}
const v3Developer = v3ActorContract.find((entry) => entry.scope === v3CodeReview.scope && entry.control === "development");
function developerRepairEvents(ordinal) {
  const calledAt = 60 + ((ordinal - 1) * 10);
  const repairReceiptPath = `docs/ai/repairs/${v3Developer.taskName}-cycle-${ordinal}.json`;
  const repairReceiptSha256 = "c".repeat(64);
  return [
    JSON.stringify({ timestamp: eventTimestamp(calledAt), type: "response_item", payload: {
      type: "function_call", namespace: "collaboration", name: "followup_task", call_id: `developer-repair-${ordinal}`,
      arguments: JSON.stringify({ target: `/root/${v3Developer.taskName}`, message: `repair cycle ${ordinal}` }),
    } }),
    JSON.stringify({ timestamp: eventTimestamp(calledAt + 1), type: "response_item", payload: {
      type: "agent_message", author: `/root/${v3Developer.taskName}`,
      content: [{ type: "input_text", text: `Message Type: FINAL_ANSWER\nSender: /root/${v3Developer.taskName}\nPayload:\nREPAIR_CYCLE=${ordinal}  \nREPAIR_RECEIPT_PATH=${repairReceiptPath}  \nREPAIR_RECEIPT_SHA256=${repairReceiptSha256}  \nACTOR_RESULT=PASS` }],
    } }),
  ];
}
function extraneousFollowupEvent(ordinal) {
  return JSON.stringify({ timestamp: eventTimestamp(80 + ordinal), type: "response_item", payload: {
    type: "function_call", namespace: "collaboration", name: "followup_task", call_id: `extraneous-followup-${ordinal}`,
    arguments: JSON.stringify({ target: `/root/${v3Developer.taskName}`, message: "unbound extra work" }),
  } });
}
const extraneousFollowupEvidence = parseCollaborationEvidence(syntheticRaw,
  `${v3SyntheticSession}\n${extraneousFollowupEvent(1)}`, v3ActorContract, {
    actorContractVersion: "four-actor-v3", maximumActorInvocations: 21,
  });
assert.equal(extraneousFollowupEvidence.ok, false, "an unbound followup_task must fail closed");
assert.match(extraneousFollowupEvidence.failures.join("; "), /unexpected or unbound followup_task calls/);
assert.equal(extraneousFollowupEvidence.followupInvocationCount, 1,
  "even a rejected followup remains visible in the invocation accounting");
const overCapExtraneousFollowups = parseCollaborationEvidence(syntheticRaw,
  `${v3SyntheticSession}\n${[1, 2, 3, 4, 5].map(extraneousFollowupEvent).join("\n")}`, v3ActorContract, {
    actorContractVersion: "four-actor-v3", maximumActorInvocations: 21,
  });
assert.equal(overCapExtraneousFollowups.ok, false);
assert.equal(overCapExtraneousFollowups.totalActorInvocations, 22,
  "unbound followups cannot evade the global actor cap");
assert.match(overCapExtraneousFollowups.failures.join("; "), /actor invocation budget exceeded: 22\/21/);
