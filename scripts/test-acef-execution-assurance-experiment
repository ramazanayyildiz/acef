function waitUntil(predicate, timeoutMs = 3000) {
  const deadline = Date.now() + timeoutMs;
  const signal = new Int32Array(new SharedArrayBuffer(4));
  while (Date.now() < deadline) {
    if (predicate()) return true;
    Atomics.wait(signal, 0, 0, 20);
  }
  return false;
}

function installStateParserFixture(repo) {
  const target = path.join(repo, ".acef", "bin", "lib");
  fs.mkdirSync(target, { recursive: true });
  for (const entry of ["acef-state-parser.js", "acef-execution-policy.js"]) {
    fs.copyFileSync(path.join(root, "scripts", "lib", entry), path.join(target, entry));
  }
}

