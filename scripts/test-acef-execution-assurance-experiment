  session_id: "parent-thread", timestamp: "2026-08-01T00:00:00.000Z", cwd: root, cli_version: "0.146.0",
} }), ...epicActorContract.flatMap((entry, index) => {
  const callId = `call-${index}`;
  const receiver = `receiver-${index}`;
  return [
    JSON.stringify({ type: "response_item", payload: { type: "function_call", namespace: "collaboration", name: "spawn_agent", call_id: callId, arguments: JSON.stringify({ task_name: entry.taskName, fork_turns: "none" }) } }),
    JSON.stringify({ type: "event_msg", payload: { type: "sub_agent_activity", event_id: callId, agent_thread_id: receiver, kind: "started" } }),
    JSON.stringify({ type: "response_item", payload: {
      type: "agent_message", author: `/root/${entry.taskName}`,
      content: [{ type: "input_text", text: `Message Type: FINAL_ANSWER\nTask name: /root\nSender: /root/${entry.taskName}\nPayload:\nACTOR_RESULT=PASS` }],
    } }),
  ];
})].join("\n");
assert.equal(parseCollaborationEvidence(syntheticRaw, syntheticSession, epicActorContract).ok, true);
