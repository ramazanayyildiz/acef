  frozenIntegrationArgv, eventTimestamp(10), eventTimestamp(20)).ok, false,
"any explicit nonzero exit rejects even when another structured field says zero");
const judgmentUnitDir = fs.mkdtempSync(path.join(os.tmpdir(), "acef-judgment-unit-"));
process.on("exit", () => fs.rmSync(judgmentUnitDir, { recursive: true, force: true }));
const judgmentDiffPath = path.join(judgmentUnitDir, "candidate.patch");
fs.writeFileSync(judgmentDiffPath, [
  "diff --git a/value b/value\n--- a/value\n+++ b/value\n@@ -1 +1 @@\n-before\n+after\n",
  "diff --git a/value.test b/value.test\n--- a/value.test\n+++ b/value.test\n@@ -1 +1 @@\n-old test\n+new test\n",
].join(""));
