  const committedV3Durable = validateDurableLifecycleEvidence(lifecycleRepo, v3DurableExpected, v3DurableExpected, {
    ...v3DurableOptions,
  });
  assert.equal(committedV3Durable.ok, true, committedV3Durable.failures.join("; "));
  const layeredParser = require(path.join(lifecycleRepo, ".acef", "bin", "lib", "acef-state-parser.js"));
  const baseLayerGatePath = path.join(lifecycleRepo, "docs", "ai", "gates", "v3-story-close.json");
  const baseLayerGate = layeredParser.parseGateVerdict(baseLayerGatePath);
  Object.defineProperty(baseLayerGate, "_recordPath", { value: baseLayerGatePath });
  const repairLayerReceiptPath = path.join(lifecycleRepo, "docs", "ai", "repairs", "v3-cycle1.json");
