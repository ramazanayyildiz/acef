    executedChecks: { actorSeparation: true, atddTestOnlyRed: true, redGreenChronology: true, finalTreeReview: true, patchAssurance: true,
      findingsResolved: true, runnerProof: true, scopeBinding: true, hashBinding: true },
    reviewCycle: 0, unresolvedFindings: [], findingDispositions: [], reportHashes: { codeReview: reviewHash, patchAssurance: assuranceHash },
    reportPaths: { codeReview: reportBindings["code-review"].path, patchAssurance: reportBindings["patch-assurance"].path },
  })}\n`);
  const v3ReviewerCompletions = v3DurableExpected.filter((entry) => ["code-review", "patch-assurance"].includes(entry.control)).map((actor) => {
    const binding = reportBindings[actor.control];
    const reportBytes = fs.readFileSync(path.join(lifecycleRepo, binding.path), "utf8");
    return { taskName: actor.taskName, reportPath: binding.path, reportSha256: binding.hash,
      reportBase64: Buffer.from(reportBytes).toString("base64"), inputTree: lifecycleTree };
  });
  const v3DurableOptions = { actorContractVersion: "four-actor-v3", runId: v3RunId,
    storyInventory: v3StoryInventory,
