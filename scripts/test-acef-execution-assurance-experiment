    status: "complete", activeStory: "s2", activePhase: "closeout",
    ledgerPath: "docs/ai/ACEF_DELIVERY_LEDGER.md",
  })}\n`);
  const matchingExpectedStories = evaluateTreatmentState(treatmentRepo, {
