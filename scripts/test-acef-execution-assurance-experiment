  assert.equal(parsedV3Plan.attempts[0].actorContractVersion, "four-actor-v3");

  const judgmentFixture = path.join(tmp, "judgment-ingestion");
  const judgmentResults = path.join(judgmentFixture, "pilot.jsonl");
  const judgmentLog = path.join(judgmentFixture, "pilot-judgments.jsonl");
  const verdictDirectory = path.join(judgmentFixture, "pilot-verdicts");
  const judgmentWorkspace = path.join(judgmentFixture, "workspace");
  const pendingJudgmentPath = path.join(judgmentFixture, "pending.json");
  fs.mkdirSync(judgmentFixture, { recursive: true });
  fs.writeFileSync(judgmentResults, `${JSON.stringify(judgmentAttempt)}\n`);
  fs.writeFileSync(pendingJudgmentPath, `${JSON.stringify(pendingJudgment, null, 2)}\n`);
  const ingestArgs = [
    cli, "--manifest", v3ManifestPath, "--pilot-results", judgmentResults,
    "--pilot-judgments", judgmentLog, "--pilot-verdict-directory", verdictDirectory,
    "--pilot-workspace", judgmentWorkspace, "--pilot-ingest-judgment", pendingJudgmentPath,
  ];
  const pendingIngest = cp.spawnSync(process.execPath, ingestArgs, { cwd: root, encoding: "utf8" });
  assert.equal(pendingIngest.status, 0, `${pendingIngest.stdout}\n${pendingIngest.stderr}`);
  assert.match(pendingIngest.stdout, /INGESTED J-PENDING: PENDING/);
  assert.equal(readPilotResultRow(judgmentResults, judgmentAttempt.attemptRunId).result, "PROVISIONAL_PASS",
    "judgment ingestion must not mutate the immutable attempt JSONL");
  const pendingVerdictPath = path.join(verdictDirectory, "P0-candidate-v3--J-PENDING.json");
  assert.equal(JSON.parse(fs.readFileSync(pendingVerdictPath, "utf8")).result, "PENDING");
  const duplicatePendingIngest = cp.spawnSync(process.execPath, ingestArgs, { cwd: root, encoding: "utf8" });
  assert.equal(duplicatePendingIngest.status, 0, duplicatePendingIngest.stderr);
  assert.match(duplicatePendingIngest.stdout, /ALREADY_INGESTED/);
  assert.equal(fs.readFileSync(judgmentLog, "utf8").trim().split(/\n/).length, 1,
    "idempotent recovery cannot duplicate append-only judgment rows");
  const passIngestJudgment = passJudgment;
  const passJudgmentPath = path.join(judgmentFixture, "pass.json");
  fs.writeFileSync(passJudgmentPath, `${JSON.stringify(passIngestJudgment, null, 2)}\n`);
  const passIngestArgs = [...ingestArgs.slice(0, -1), passJudgmentPath];
  const passIngest = cp.spawnSync(process.execPath, passIngestArgs, { cwd: root, encoding: "utf8" });
  assert.equal(passIngest.status, 0, `${passIngest.stdout}\n${passIngest.stderr}`);
  assert.match(passIngest.stdout, /INGESTED J-PASS: PASS/);
  assert.equal(JSON.parse(fs.readFileSync(path.join(verdictDirectory, "P0-candidate-v3--J-PASS.json"), "utf8")).promotionEligible, true);
  assert.equal(fs.readFileSync(judgmentLog, "utf8").trim().split(/\n/).length, 2,
    "a new packet may supersede PENDING without mutating prior judgment or verdict artifacts");
  const terminalFailLog = path.join(judgmentFixture, "terminal-fail-judgments.jsonl");
  const terminalFailVerdicts = path.join(judgmentFixture, "terminal-fail-verdicts");
  const failJudgmentPath = path.join(judgmentFixture, "fail.json");
  const failJudgeBinding = createJudgeBinding("fail-unit", "judge-session-fail-unit", "FAIL", false,
    "2026-08-02T00:09:30.000Z", "2026-08-02T00:09:01.000Z", "2026-08-02T00:09:59.000Z");
  fs.writeFileSync(failJudgmentPath, `${JSON.stringify({
    ...pendingJudgment, judgePacketId: "J-FAIL", verdict: "FAIL", judgeSessionId: "judge-session-fail-unit",
    judgeReceiptPath: failJudgeBinding.receiptPath, judgeReceiptSha256: failJudgeBinding.receiptSha256,
    judgedAt: "2026-08-02T00:10:00.000Z",
  }, null, 2)}\n`);
  const terminalBaseArgs = [
    cli, "--manifest", v3ManifestPath, "--pilot-results", judgmentResults,
    "--pilot-judgments", terminalFailLog, "--pilot-verdict-directory", terminalFailVerdicts,
    "--pilot-workspace", judgmentWorkspace, "--pilot-ingest-judgment",
  ];
  const failIngest = cp.spawnSync(process.execPath, [...terminalBaseArgs, failJudgmentPath], { cwd: root, encoding: "utf8" });
  assert.equal(failIngest.status, 0, `${failIngest.stdout}\n${failIngest.stderr}`);
  const afterFail = cp.spawnSync(process.execPath, [...terminalBaseArgs, passJudgmentPath], { cwd: root, encoding: "utf8" });
  assert.notEqual(afterFail.status, 0, "a terminal FAIL cannot be cherry-picked into a later PASS");
  assert.match(`${afterFail.stdout}\n${afterFail.stderr}`, /terminal FAIL judgment; only PENDING is supersedable/);

  const results = path.join(tmp, "stage0.jsonl");
  const workspace = path.join(tmp, "workspace");
  const stage0 = cp.spawnSync(process.execPath, [cli, "--manifest", manifestPath, "--results", results, "--workspace", workspace, "--stage0"], {
    cwd: root,
    encoding: "utf8",
    timeout: 120000,
  });
  assert.equal(stage0.status, 0, `${stage0.stdout}\n${stage0.stderr}`);
  const rows = fs.readFileSync(results, "utf8").trim().split(/\n/).map(JSON.parse);
  assert.equal(rows.length, 6);
  assert.deepEqual(rows.map((row) => row.result), ["PASS", "PASS", "PASS", "PASS", "PASS", "PASS"]);

  const immutable = cp.spawnSync(process.execPath, [cli, "--manifest", manifestPath, "--results", results, "--workspace", workspace, "--stage0"], {
    cwd: root,
    encoding: "utf8",
  });
  assert.notEqual(immutable.status, 0);
  assert.match(`${immutable.stdout}\n${immutable.stderr}`, /immutable Stage 0 results already exist/);
} finally {
  fs.rmSync(tmp, { recursive: true, force: true });
}

console.log("acef execution-assurance experiment tests passed");
