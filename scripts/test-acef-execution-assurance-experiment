  fs.writeFileSync(v3GreenEvidencePath, `${JSON.stringify({
    ...cleanV3GreenEvidence, dirtyApplicationPathsBefore: ["tests/transient-dirty.test"],
  })}\n`);
  const dirtyBeforeV3Durable = validateDurableLifecycleEvidence(lifecycleRepo, v3DurableExpected, v3DurableExpected, {
    ...v3DurableOptions,
  });
  assert.equal(dirtyBeforeV3Durable.ok, false, "v3 closing green cannot rely on test-dirty-then-restore evidence");
  assert.ok(dirtyBeforeV3Durable.failures.some((entry) => /no dirty application paths/.test(entry)));
  fs.writeFileSync(v3GreenEvidencePath, `${JSON.stringify(cleanV3GreenEvidence)}\n`);
  const v3GreenLog = path.join(lifecycleRepo, "docs", "ai", "evidence", "v3-green.log");
  fs.appendFileSync(v3GreenLog, "tampered\n");
  const tamperedV3Durable = validateDurableLifecycleEvidence(lifecycleRepo, v3DurableExpected, v3DurableExpected, {
    ...v3DurableOptions,
  });
  assert.equal(tamperedV3Durable.ok, false, "post-commit raw-artifact tampering must fail v3 durability");
  fs.writeFileSync(v3GreenLog, "v3-green\n");
  const codeReviewReportPath = path.join(lifecycleRepo, reportBindings["code-review"].path);
  const cleanCodeReviewReport = fs.readFileSync(codeReviewReportPath, "utf8");
  fs.appendFileSync(codeReviewReportPath, " ");
  const tamperedReportDurable = validateDurableLifecycleEvidence(lifecycleRepo, v3DurableExpected, v3DurableExpected, {
    ...v3DurableOptions,
  });
  assert.equal(tamperedReportDurable.ok, false, "review report contents must be recomputed against actor and gate hashes");
  fs.writeFileSync(codeReviewReportPath, cleanCodeReviewReport);
  fs.writeFileSync(path.join(lifecycleRepo, "tests", "after-review-repair.test"), "test-only repair\n");
  cp.spawnSync("git", ["add", "tests/after-review-repair.test"], { cwd: lifecycleRepo });
  cp.spawnSync("git", ["commit", "-qm", "test: repair after review"], { cwd: lifecycleRepo });
  const testRepairDurable = validateDurableLifecycleEvidence(lifecycleRepo, v3DurableExpected, v3DurableExpected, {
    ...v3DurableOptions,
  });
  assert.ok(!testRepairDurable.failures.some((entry) => /Patch Assurance does not bind/.test(entry)),
    "a later story or unrelated test path must not invalidate the frozen story tree");
  assert.ok(!testRepairDurable.failures.some((entry) => /Code Review predates/.test(entry)),
    "unrelated later work must not invalidate Code Review");
  fs.appendFileSync(path.join(lifecycleRepo, "tests", "v3-red.test"), "scoped test repair\n");
  cp.spawnSync("git", ["add", "tests/v3-red.test"], { cwd: lifecycleRepo });
  cp.spawnSync("git", ["commit", "-qm", "test: scoped repair after review"], { cwd: lifecycleRepo });
  const scopedTestRepairDurable = validateDurableLifecycleEvidence(lifecycleRepo, v3DurableExpected, v3DurableExpected, {
