    fs.writeFileSync(path.join(lifecycleRepo, relativeReportPath), reportBytes);
    reportBindings[actor.control] = { path: relativeReportPath, hash: lifecycleSha(reportBytes) };
  }
  const reviewHash = reportBindings["code-review"].hash;
  const assuranceHash = reportBindings["patch-assurance"].hash;
  for (const actor of v3DurableExpected) {
    const inputCommit = actor.control === "atdd" ? lifecycleBase : lifecycleRedCommit;
