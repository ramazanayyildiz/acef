  JSON.stringify({ timestamp: "2026-08-01T00:00:00.000Z", type: "response_item", payload: { type: "function_call", namespace: "collaboration", name: "wait_agent", call_id: "wait-1" } }),
  JSON.stringify({ timestamp: "2026-08-01T00:00:05.000Z", type: "response_item", payload: { type: "function_call", namespace: "collaboration", name: "wait_agent", call_id: "wait-2" } }),
  JSON.stringify({ timestamp: "2026-08-01T00:00:10.000Z", type: "response_item", payload: { type: "function_call_output", call_id: "wait-1" } }),
  JSON.stringify({ timestamp: "2026-08-01T00:00:15.000Z", type: "response_item", payload: { type: "function_call_output", call_id: "wait-2" } }),
].join("\n"), 60, {
  dispatches: [{ taskName: "worker-1", spawnedAt: "2026-08-01T00:00:02.000Z" }],
  childSessions: [{ taskName: "worker-1", completedAt: Date.parse("2026-08-01T00:00:12.000Z") / 1000 }],
});
assert.equal(harnessWait.seconds, 15, "overlapping waits are measured as wall-time union, not double-counted");
assert.equal(harnessWait.share, 0.25);
