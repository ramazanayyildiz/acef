  assert.ok(missingDirectGreen.failures.some((entry) => /directly include redEvidenceId and greenEvidenceId/.test(entry)),
    "red and green identifiers must both be directly enumerated by the deterministic gate");
  fs.writeFileSync(committedGatePath, cleanCommittedGateBytes);
  const latePackagePath = path.join(lifecycleRepo, "docs", "ai", "actors", "late-package-member.json");
  fs.writeFileSync(latePackagePath, "{}\n");
