#!/usr/bin/env node
// Updates keep host-modified files (owner decision 2026-10-27): install-acef-tools, install-acef-bmad-guard and
// install-acef-skills replace a file only when the host copy equals what ACEF installed last time; the model routing
// policy is merged (host values kept, new keys added); legacy records without hashes use the recorded install commit.
const assert = require("node:assert/strict");
const cp = require("node:child_process");
const crypto = require("node:crypto");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const root = path.resolve(__dirname, "..");
const sha = (bytes) => crypto.createHash("sha256").update(bytes).digest("hex");
const run = (script, args) => cp.execFileSync(process.execPath, [path.join(root, "scripts", script), ...args], {
  cwd: root, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"],
});
const update = (repo) => run("update-acef-installation", ["--repo", repo]);
const read = (repo, rel) => fs.readFileSync(path.join(repo, rel), "utf8");
const write = (repo, rel, text) => fs.writeFileSync(path.join(repo, rel), text);
const recordPath = (repo) => path.join(repo, "docs", "ai", "ACEF_INSTALLATION.json");
const record = (repo) => JSON.parse(fs.readFileSync(recordPath(repo), "utf8"));
const saveRecord = (repo, value) => fs.writeFileSync(recordPath(repo), `${JSON.stringify(value, null, 2)}\n`);
const source = (rel) => fs.readFileSync(path.join(root, rel), "utf8");
const committedSource = (rel) => cp.execFileSync("git", ["show", `HEAD:${rel}`], { cwd: root, encoding: "utf8" });

const STATE = ".acef/bin/acef-state.cjs";
const LIB = ".acef/bin/lib/acef-installation.js";
const HOOK = ".acef/hooks/acef-bmad-hard-wall.mjs";
const SKILL = ".claude/skills/acef/SKILL.md";
const POLICY = ".acef/model-routing-policy.json";
const dirs = [];
function freshRepo() {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "acef-host-files-"));
  dirs.push(dir);
  cp.execFileSync("git", ["init", "-q", dir]);
  update(dir);
  return dir;
}

try {
  // 1. A fresh install records the hash of every owned file per component.
  const repo = freshRepo();
  const first = record(repo).components;
  for (const [component, rel] of [["tools", STATE], ["tools", LIB], ["bmadGuard", HOOK], ["skills", SKILL]]) {
    assert.equal(first[component].files[rel], sha(fs.readFileSync(path.join(repo, rel))), `${component} records ${rel}`);
  }
  assert.ok(!first.tools.files[POLICY], "the policy is merged, never hash-owned");

  // 2. Host edits survive an update and are reported; untouched files are refreshed.
  write(repo, STATE, `${read(repo, STATE)}\n// host gate\n`);
  write(repo, HOOK, `${read(repo, HOOK)}\n// host hook gate\n`);
  write(repo, SKILL, `${read(repo, SKILL)}\nHost note.\n`);
  const olderLib = "// what ACEF installed last time\n";
  write(repo, LIB, olderLib);
  const rec = record(repo);
  rec.components.tools.files[LIB] = sha(olderLib); // simulate an older ACEF copy that the host never touched
  saveRecord(repo, rec);
  const out = update(repo);
  for (const rel of [STATE, HOOK, SKILL]) assert.match(out, new RegExp(`kept host-modified ${rel.replace(/[.]/g, "\\.")}`), rel);
  assert.match(read(repo, STATE), /\/\/ host gate\n$/);
  assert.match(read(repo, HOOK), /\/\/ host hook gate\n$/);
  assert.match(read(repo, SKILL), /Host note\.\n$/);
  assert.equal(read(repo, LIB), source("scripts/lib/acef-installation.js"), "an unmodified older copy is replaced");
  const second = record(repo).components;
  assert.equal(second.tools.files[STATE], first.tools.files[STATE], "a kept file keeps the hash ACEF installed, not the host one");
  // and a second update still keeps it
  assert.match(update(repo), /kept host-modified \.acef\/bin\/acef-state\.cjs/);
  assert.match(read(repo, STATE), /\/\/ host gate\n$/);

  // 3. Model routing policy: host values survive, only new keys are added.
  const policy = JSON.parse(read(repo, POLICY));
  policy.providers.openai.models.orchestration = "host-chosen-model";
  policy.policyId = "host-policy";
  const removed = Object.keys(policy.providers).find((name) => name !== policy.activeProvider);
  if (removed) delete policy.providers[removed];
  write(repo, POLICY, `${JSON.stringify(policy, null, 2)}\n`);
  const merged = update(repo);
  const after = JSON.parse(read(repo, POLICY));
  assert.equal(after.providers.openai.models.orchestration, "host-chosen-model");
  assert.equal(after.policyId, "host-policy");
  assert.match(merged, /kept host overrides \.acef\/model-routing-policy\.json: policyId, providers\.openai\.models\.orchestration/);
  if (removed) {
    assert.ok(after.providers[removed], `new key providers.${removed} is added`);
    assert.match(merged, new RegExp(`added new keys \\.acef/model-routing-policy\\.json: providers\\.${removed}`));
  }
  // an unusable merge stops the update before any write (review of 7bc3bad): the new runtime would reject it
  write(repo, POLICY, "{\"schema\": \"acef.model-routing-policy.v1\", \"roles\": \"broken\"}\n");
  const stateBefore = read(repo, STATE);
  assert.throws(() => update(repo), (error) => /update stopped before any write[\s\S]*routing policy would not validate:\n- \.acef\/model-routing-policy\.json/.test(`${error.stderr}`));
  assert.equal(read(repo, POLICY), "{\"schema\": \"acef.model-routing-policy.v1\", \"roles\": \"broken\"}\n");
  assert.equal(read(repo, STATE), stateBefore, "no runtime file is replaced");
  write(repo, POLICY, `${JSON.stringify(after, null, 2)}\n`);

  // 4. Legacy record (no hashes): the baseline is the file at the recorded install commit.
  const legacy = freshRepo();
  const head = cp.execFileSync("git", ["rev-parse", "HEAD"], { cwd: root, encoding: "utf8" }).trim();
  const stripHashes = (repoDir, commit) => {
    const value = record(repoDir);
    for (const component of Object.values(value.components)) {
      delete component.files;
      component.sourceCommit = commit;
    }
    value.acefVersion.sourceCommit = commit;
    saveRecord(repoDir, value);
  };
  write(legacy, STATE, committedSource("scripts/acef-state"));          // exactly what ACEF shipped at that commit
  write(legacy, HOOK, `${committedSource("claude-plugins/acef-bmad-guard/hooks/acef-bmad-hard-wall.mjs")}\n// host\n`);
  stripHashes(legacy, head);
  const legacyOut = update(legacy);
  assert.equal(read(legacy, STATE), source("scripts/acef-state"), "unmodified legacy copy is replaced");
  assert.match(legacyOut, /kept host-modified \.acef\/hooks\/acef-bmad-hard-wall\.mjs/);
  assert.match(read(legacy, HOOK), /\/\/ host\n$/);
  assert.ok(!record(legacy).components.bmadGuard.files[HOOK] || record(legacy).components.bmadGuard.files[HOOK] !== sha(fs.readFileSync(path.join(legacy, HOOK))),
    "the host copy's hash is never recorded as ACEF-installed");

  // 5. Legacy record whose install commit is unknown: differing files are kept, never overwritten blind.
  const unknown = freshRepo();
  write(unknown, STATE, "// some host copy\n");
  stripHashes(unknown, "0".repeat(40));
  assert.match(update(unknown), /kept host copy \.acef\/bin\/acef-state\.cjs \(install commit 000000000000 not available/);
  assert.equal(read(unknown, STATE), "// some host copy\n");

  // 6. Legacy record made from another ACEF checkout (a fork): the baseline comes from that checkout, also for the
  //    guard and skills installers that run after install-acef-tools has rewritten the record's source path.
  const fork = fs.mkdtempSync(path.join(os.tmpdir(), "acef-host-files-fork-"));
  dirs.push(fork);
  cp.execFileSync("git", ["clone", "-q", "--shared", root, fork]);
  const forkGit = (...args) => cp.execFileSync("git", args, { cwd: fork, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
  const forkHook = "claude-plugins/acef-bmad-guard/hooks/acef-bmad-hard-wall.mjs";
  fs.appendFileSync(path.join(fork, forkHook), "\n// fork-only line\n");
  forkGit("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qam", "fork change");
  const forkCommit = forkGit("rev-parse", "HEAD");
  const forked = freshRepo();
  write(forked, HOOK, fs.readFileSync(path.join(fork, forkHook), "utf8"));
  stripHashes(forked, forkCommit);
  const forkedRecord = record(forked);
  forkedRecord.acefVersion.sourcePath = fork;
  saveRecord(forked, forkedRecord);
  fs.rmSync(path.join(forked, ".acef", "local"), { recursive: true, force: true });
  const forkOut = update(forked);
  assert.doesNotMatch(forkOut, /kept[^\n]*acef-bmad-hard-wall\.mjs/, "an unmodified fork copy is replaced");
  assert.equal(read(forked, HOOK), source(forkHook));

  // 7. Policy three-way merge across an ACEF upgrade: a value the host never touched follows ACEF, a host override
  //    stays, both are reported. An install made from a commit outside this ACEF history (a fork) has no baseline, so
  //    all of its values count as host choices.
  const acef = fs.mkdtempSync(path.join(os.tmpdir(), "acef-host-files-src-"));
  dirs.push(acef);
  cp.execFileSync("git", ["clone", "-q", "--shared", root, acef]);
  for (const dir of ["scripts", "schemas", "method", "workflows", "skills", "claude-plugins", "opencode-plugins", "docs/experiments/context-retrieval"]) {
    fs.rmSync(path.join(acef, dir), { recursive: true, force: true });
    fs.cpSync(path.join(root, dir), path.join(acef, dir), { recursive: true });
  }
  const acefGit = (...args) => cp.execFileSync("git", ["-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", ...args], { cwd: acef, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
  const policyRel = "method/model-routing-policy-v1.json";
  const setPolicy = (mutate) => {
    const value = JSON.parse(fs.readFileSync(path.join(acef, policyRel), "utf8"));
    mutate(value);
    fs.writeFileSync(path.join(acef, policyRel), `${JSON.stringify(value, null, 2)}\n`);
  };
  const updateFrom = (repoDir) => cp.execFileSync(process.execPath, [path.join(acef, "scripts", "update-acef-installation"), "--repo", repoDir], { cwd: acef, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
  const shippedRoleModels = JSON.parse(source(policyRel)).providers.anthropic.roleModels;
  const floorsRel = "method/model-review-floors-v1.json";
  const shippedFloors = JSON.parse(source(floorsRel));
  assert.ok(shippedRoleModels && shippedFloors.providers.anthropic, "ACEF ships roleModels and review floors");
  const FLOORS = ".acef/model-review-floors.json";
  // ACEF v1 here is the pre-roleModels ACEF: no per-role models and no review floors file.
  setPolicy((value) => {
    value.providers.openai.models.orchestration = "old-orchestration";
    value.providers.openai.models["semantic-critical"] = "old-critical";
    delete value.providers.anthropic.roleModels;
  });
  fs.rmSync(path.join(acef, floorsRel));
  acefGit("add", "-A"); acefGit("commit", "-qm", "ACEF v1 policy");
  const base = acefGit("rev-parse", "HEAD");
  const freshHost = () => {
    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "acef-host-files-"));
    dirs.push(dir);
    cp.execFileSync("git", ["init", "-q", dir]);
    updateFrom(dir);
    return dir;
  };
  const editPolicy = (dir, rel, mutate) => {
    const value = JSON.parse(read(dir, rel));
    mutate(value);
    fs.mkdirSync(path.dirname(path.join(dir, rel)), { recursive: true });
    write(dir, rel, `${JSON.stringify(value, null, 2)}\n`);
  };
  // Every file under the host, with its hash (the .git directory included).
  const snapshot = (dir) => {
    const out = {};
    const walk = (rel) => {
      for (const entry of fs.readdirSync(path.join(dir, rel), { withFileTypes: true })) {
        const child = path.join(rel, entry.name);
        if (entry.isDirectory()) walk(child);
        else out[child] = sha(fs.readFileSync(path.join(dir, child)));
      }
    };
    walk("");
    return out;
  };
  const upgraded = freshHost();
  // The host runs its own openai critical model; the ACEF floors do not rank it, so it exempts the three roles.
  editPolicy(upgraded, POLICY, (value) => {
    value.providers.openai.models["semantic-critical"] = "host-critical";
    value.providers.openai.roleModelExemptions = { "patch-assurance": "owner: host-critical", "process-judge": "owner: host-critical", "epic-process-judge": "owner: host-critical" };
  });
  // Hosts installed from the pre-roleModels ACEF.
  const plainHost = freshHost();
  const roleHost = freshHost();
  const exemptHost = freshHost();
  const docsHost = freshHost();
  assert.equal(JSON.parse(read(plainHost, POLICY)).providers.anthropic.roleModels, undefined);
  editPolicy(roleHost, POLICY, (value) => { value.providers.anthropic.roleModels = { "patch-assurance": "claude-sonnet-5-5", development: "claude-opus-5-5" }; });
  editPolicy(exemptHost, POLICY, (value) => {
    value.providers.anthropic.roleModels = { "patch-assurance": "claude-sonnet-5-5", "process-judge": null, development: "claude-opus-5-5" };
    value.providers.anthropic.roleModelExemptions = { "patch-assurance": "owner: Sonnet assurance accepted", "process-judge": "owner: class model accepted" };
  });
  // A whole-file docs override copied from the pre-roleModels policy (the B2Press/JakoMeet shape).
  write(docsHost, "docs/ai/ACEF_MODEL_ROUTING_POLICY.json", read(docsHost, POLICY));
  editPolicy(docsHost, "docs/ai/ACEF_MODEL_ROUTING_POLICY.json", (value) => { value.providers.openai.models["semantic-critical"] = "gpt-6.1-sol"; });
  // a fork install: same ACEF v1 plus a fork-only policy commit on a side branch; its own critical model is exempted
  acefGit("checkout", "-q", "-b", "fork");
  setPolicy((value) => {
    value.providers.openai.models.orchestration = "fork-orchestration";
    value.providers.openai.roleModelExemptions = { "patch-assurance": "fork: own critical model", "process-judge": "fork: own critical model", "epic-process-judge": "fork: own critical model" };
  });
  acefGit("commit", "-qam", "fork policy");
  const forkInstall = freshHost();
  acefGit("checkout", "-q", base);
  acefGit("checkout", "-q", "-b", "next");
  setPolicy((value) => {
    value.providers.openai.models.orchestration = "new-orchestration";
    value.providers.openai.models["semantic-critical"] = "new-critical";
    value.providers.anthropic.roleModels = shippedRoleModels;
  });
  const nextFloors = structuredClone(shippedFloors);
  nextFloors.providers.openai.modelRank.push("new-critical");
  fs.writeFileSync(path.join(acef, floorsRel), `${JSON.stringify(nextFloors, null, 2)}\n`);
  acefGit("add", "-A"); acefGit("commit", "-qm", "ACEF v2 policy");
  const upgradeOut = updateFrom(upgraded);
  const upgradedPolicy = JSON.parse(read(upgraded, POLICY)).providers.openai.models;
  assert.equal(upgradedPolicy.orchestration, "new-orchestration", "an untouched old ACEF value is upgraded");
  assert.equal(upgradedPolicy["semantic-critical"], "host-critical", "a host-changed value is kept");
  assert.match(upgradeOut, /kept host overrides \.acef\/model-routing-policy\.json: providers\.openai\.models\.semantic-critical/);
  assert.match(upgradeOut, /upgraded untouched ACEF values \.acef\/model-routing-policy\.json: providers\.openai\.models\.orchestration/);
  assert.equal(read(upgraded, FLOORS), `${JSON.stringify(nextFloors, null, 2)}\n`, "the ACEF floors are installed");
  // 7b. Per-role models across the same upgrade. An untouched host gains ACEF's roleModels (Patch Assurance and the
  //     Judges move to Opus on anthropic); review roles never drop below the floor without an exemption.
  const { loadModelRoutingPolicy, resolveRoleRuntime } = require(path.join(root, "scripts", "lib", "acef-model-routing"));
  // Resolve with the host's installed floors file passed explicitly (floors never ride on a policy record).
  const resolveIn = (dir, role, provider) => resolveRoleRuntime(loadModelRoutingPolicy(dir).record, role, provider, { reviewFloors: JSON.parse(read(dir, FLOORS)) });
  const plainOut = updateFrom(plainHost);
  assert.match(plainOut, /added new keys \.acef\/model-routing-policy\.json: [^\n]*providers\.anthropic\.roleModels/);
  assert.deepEqual(JSON.parse(read(plainHost, POLICY)).providers.anthropic.roleModels, shippedRoleModels);
  assert.equal(resolveIn(plainHost, "patch-assurance", "anthropic").model, "claude-opus-5-5");
  assert.equal(resolveIn(plainHost, "development", "anthropic").model, "claude-sonnet-5-5");
  // A rejected update (review of 9269a8c, P2): checked before any write, the host stays byte-identical, and the
  // message names each role, model, floor and the exemption line.
  const expectRefused = (dir, patterns) => {
    const before = snapshot(dir);
    let stderr = "";
    assert.throws(() => updateFrom(dir), (error) => { stderr = `${error.stderr}`; return true; });
    assert.match(stderr, /update stopped before any write/);
    for (const pattern of patterns) assert.match(stderr, pattern);
    assert.deepEqual(snapshot(dir), before, "a refused update leaves the host byte-identical");
  };
  expectRefused(roleHost, [/\.acef\/model-routing-policy\.json provider anthropic patch-assurance: claude-sonnet-5-5 is below the review floor claude-opus-5-5 \(floor claude-opus-5-5\); if Ram approves, add \.acef\/model-routing-policy\.json: "providers": \{ "anthropic": \{ "roleModelExemptions": \{ "patch-assurance": "<owner, date, reason>" \} \} \}/]);
  // The effective docs override is checked too: all three anthropic review roles are on Sonnet there.
  expectRefused(docsHost, ["patch-assurance", "process-judge", "epic-process-judge"].map((role) => new RegExp(`docs/ai/ACEF_MODEL_ROUTING_POLICY\\.json provider anthropic ${role}: claude-sonnet-5-5 is below the review floor claude-opus-5-5`)));
  // At resolve time the docs override (the file the loader prefers) is held to the installed floors as well.
  assert.throws(() => resolveRoleRuntime(loadModelRoutingPolicy(docsHost).record, "patch-assurance", "anthropic", { reviewFloors: shippedFloors }), /below the review floor claude-opus-5-5/);
  editPolicy(docsHost, "docs/ai/ACEF_MODEL_ROUTING_POLICY.json", (value) => {
    value.providers.anthropic.roleModelExemptions = { "patch-assurance": "owner: test", "process-judge": "owner: test", "epic-process-judge": "owner: test" };
  });
  updateFrom(docsHost);
  // With roleModelExemptions the host's per-role values, including a null, survive and stay in force.
  const exemptOut = updateFrom(exemptHost);
  const exemptAfter = JSON.parse(read(exemptHost, POLICY)).providers.anthropic;
  assert.equal(exemptAfter.roleModels["patch-assurance"], "claude-sonnet-5-5", "an exempted host per-role model survives the update");
  assert.equal(exemptAfter.roleModels["process-judge"], null, "an exempted host null survives the update");
  assert.equal(exemptAfter.roleModels.development, "claude-opus-5-5", "a host-only per-role key survives the update");
  assert.equal(exemptAfter.roleModels["epic-process-judge"], "claude-opus-5-5", "a per-role default the host did not name is added");
  assert.deepEqual(Object.keys(exemptAfter.roleModelExemptions), ["patch-assurance", "process-judge"], "host exemptions survive");
  assert.match(exemptOut, /kept host overrides \.acef\/model-routing-policy\.json: [^\n]*providers\.anthropic\.roleModels\.patch-assurance/);
  assert.equal(resolveIn(exemptHost, "patch-assurance", "anthropic").model, "claude-sonnet-5-5");
  assert.equal(resolveIn(exemptHost, "process-judge", "anthropic").model, "claude-sonnet-5-5");
  // The floors file is ACEF-owned: a host edit is reset on the next update and reported.
  const lowered = JSON.parse(read(exemptHost, FLOORS));
  lowered.providers.anthropic.reviewModelFloors["epic-process-judge"] = "claude-sonnet-5-5";
  write(exemptHost, FLOORS, `${JSON.stringify(lowered, null, 2)}\n`);
  const resetOut = updateFrom(exemptHost);
  assert.match(resetOut, /reset host-modified ACEF-owned \.acef\/model-review-floors\.json/);
  assert.equal(JSON.parse(read(exemptHost, FLOORS)).providers.anthropic.reviewModelFloors["epic-process-judge"], "claude-opus-5-5");
  // A 9269a8c-shaped install (unreleased round 2: modelRank/reviewModelFloors inside the routing policy) migrates:
  // the keys are removed from the host policy and reported, and the merged policy validates (review of 7bc3bad).
  const roundTwo = freshHost();
  editPolicy(roundTwo, POLICY, (value) => {
    value.providers.openai.modelRank = ["gpt-6.1-sol"];
    value.providers.openai.reviewModelFloors = { "code-review": "gpt-6.1-sol", "patch-assurance": "gpt-6.1-sol", "process-judge": "gpt-6.1-sol", "epic-process-judge": "gpt-6.1-sol" };
    value.providers.anthropic.modelRank = ["claude-sonnet-5-5", "claude-opus-5-5"];
    value.providers.anthropic.reviewModelFloors = { "code-review": "claude-sonnet-5-5", "patch-assurance": "claude-opus-5-5", "process-judge": "claude-opus-5-5", "epic-process-judge": "claude-opus-5-5" };
    value.providers.anthropic.roleModels = shippedRoleModels;
    value.providers.openai.models["semantic-critical"] = "gpt-6.1-sol";
  });
  const roundTwoOut = updateFrom(roundTwo);
  assert.match(roundTwoOut, /moved to \.acef\/model-review-floors\.json \(removed from \.acef\/model-routing-policy\.json\): providers\.openai\.modelRank, providers\.openai\.reviewModelFloors, providers\.anthropic\.modelRank, providers\.anthropic\.reviewModelFloors/);
  const roundTwoPolicy = JSON.parse(read(roundTwo, POLICY));
  for (const mapping of Object.values(roundTwoPolicy.providers)) {
    assert.equal(mapping.modelRank, undefined);
    assert.equal(mapping.reviewModelFloors, undefined);
  }
  const { validateModelRoutingPolicy } = require(path.join(root, "scripts", "lib", "acef-model-routing"));
  validateModelRoutingPolicy(roundTwoPolicy);
  assert.equal(resolveIn(roundTwo, "patch-assurance", "anthropic").model, "claude-opus-5-5");
  // A docs override that would not validate (floor keys in it) stops the update before any write.
  const badDocs = freshHost();
  write(badDocs, "docs/ai/ACEF_MODEL_ROUTING_POLICY.json", read(roundTwo, POLICY).replace('"providers": {', '"acefReviewFloors": { "providers": {} },\n  "providers": {'));
  const badBefore = snapshot(badDocs);
  let badErr = "";
  assert.throws(() => updateFrom(badDocs), (error) => { badErr = `${error.stderr}`; return true; });
  assert.match(badErr, /update stopped before any write[\s\S]*routing policy would not validate:\n- docs\/ai\/ACEF_MODEL_ROUTING_POLICY\.json: model routing policy acefReviewFloors is not allowed/);
  assert.deepEqual(snapshot(badDocs), badBefore, "an invalid docs override leaves the host byte-identical");
  const forkOut2 = updateFrom(forkInstall);
  assert.equal(JSON.parse(read(forkInstall, POLICY)).providers.openai.models.orchestration, "fork-orchestration", "fork values are host choices");
  assert.match(forkOut2, /no ACEF baseline/);

  // 8. A stale .cjs next to a Python tool is removed only when it is still ACEF's copy.
  const pyTool = fs.readdirSync(path.join(root, "scripts")).find((name) => !name.startsWith("test-")
    && fs.statSync(path.join(root, "scripts", name)).isFile() && fs.readFileSync(path.join(root, "scripts", name), "utf8").startsWith("#!/usr/bin/env python3")
    && fs.existsSync(path.join(repo, ".acef", "bin", name)));
  assert.ok(pyTool, "a Python tool is installed");
  const staleRel = `.acef/bin/${pyTool}.cjs`;
  const staleRecord = record(repo);
  write(repo, staleRel, source(`scripts/${pyTool}`));
  staleRecord.components.tools.files[staleRel] = sha(source(`scripts/${pyTool}`)); // an older install wrote it
  saveRecord(repo, staleRecord);
  update(repo);
  assert.ok(!fs.existsSync(path.join(repo, staleRel)), "an unmodified stale .cjs is removed");
  write(repo, staleRel, "// host wrapper\n");
  const hostStale = record(repo);
  hostStale.components.tools.files[staleRel] = sha(source(`scripts/${pyTool}`));
  saveRecord(repo, hostStale);
  assert.match(update(repo), new RegExp(`kept host-modified \\.acef/bin/${pyTool}\\.cjs \\(no longer shipped by ACEF\\)`));
  assert.equal(read(repo, staleRel), "// host wrapper\n", "a host-modified stale .cjs is kept");
  assert.match(update(repo), new RegExp(`kept host-modified \\.acef/bin/${pyTool}\\.cjs`), "and still kept on the next update");

  console.log("acef host file preservation tests passed");
} finally {
  for (const dir of dirs) fs.rmSync(dir, { recursive: true, force: true });
}
