#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");
const cp = require("node:child_process");
const crypto = require("node:crypto");
const os = require("node:os");
const {
  parseActiveRun,
  parseActorRecord,
  parseApproval,
  parseControlDosing,
  parseDirectRun,
  parseEvidenceManifest,
  parseGateVerdict,
  parseReviewReport,
  parseDeveloperRepair,
  parseAssuranceCapsule,
  parseProcessJudgeDecision,
  parseWorkerScope,
  atddRedExecutionFailure,
  atddTestSourceAuthenticityFailure,
  atddGreenTestContinuityFailure,
} = require("./lib/acef-state-parser");
const { riskRequiresGuarded } = require("./lib/acef-execution-policy");

function usage(command = "") {
  if (command === "direct-run") {
    console.log(`Usage: acef-state direct-run --repo <path> --run-id <existing-id> --status complete|promoted [options]

New direct-run admission is retired. Contained low-risk work uses the repository's native workflow outside ACEF with
focused verification. Keep this command only to close or promote an ACEF_DIRECT_RUN.json that already exists.

Close an existing record:
  acef-state direct-run --repo . --run-id <id> --status complete --changed-path <target> --verification-command <command> --verification-exit-code 0 --summary <handoff>

Promote an existing record before implementation continues:
  acef-state direct-run --repo . --run-id <id> --status promoted --promotion-decision <lane> --promotion-reason <reason>
  lane: promote-lightweight | promote-full-bmad | promote-guarded

The existing direct record is the compact compatibility context. Do not inspect ACEF schemas or CLI source to discover these options.`);
    return;
  }
  if (command === "worker-scope") {
    console.log("Usage: acef-state worker-scope --repo <path> --story <scope> --phase <phase> --worker-id <id> --allow <glob>... [options]\n\nThe active run must exist and be active; its runId is bound into the scope automatically.");
    return;
  }
  console.log(`ACEF typed-state writer

Usage:
  acef-state active-run --repo <path> --run-id <id> --workflow-id quick-fix|lightweight|full-bmad [--full-flow-contract six-actor-v2|four-actor-v3] [--runtime-contract capsule-supervisor-v1] --assurance baseline|guarded --scope-unit work-item|story|epic [--expected-story <story>...] --status <status> --story <scope> --phase <phase> --ledger <path> [--route <route> --route-confidence low|medium|high] [--goal-description <text> --goal-user-facing true|false --goal-completion-mode backend-capability|product-workspace|internal] [options]
  acef-state migrate-active-run --repo <path> --workflow-id quick-fix|lightweight|full-bmad [--assurance baseline|guarded] [--assurance-rationale <text>] [--assurance-approval <approval-id>]
  acef-state direct-run --repo <path> --run-id <id> --status active|complete|promoted --scope <scope> --acceptance <criterion>... --technical-boundary <kind> --reversible true [--changed-path <path>...] [--verification-command <command> --verification-exit-code <code>]... [options]
  acef-state actor --repo <path> --id <id> --story <scope> --phase <phase> --role <role> --client <client> --context-profile <profile> [options]
  acef-state worker-scope --repo <path> --story <scope> --phase <phase> --worker-id <id> --allow <glob>... [--surface <name>...] [--pattern-use <kind>] [--requires-round-trip true|false] [--binding <input>><output>:<field>[:defaultMaskingRisk]] [options]
  acef-state phase-transition --repo <path> --phase atdd|development|code-review
  acef-state story-transition --repo <path>
  acef-state review-scope --repo <path>
  acef-state approval --repo <path> --id <id> --decision APPROVE|REJECT|ACCEPT_RISK --scope <scope> --quote <exact human words> [options]
  acef-state evidence-run --repo <path> --id <id> --kind <kind> --actor <id> --story <scope> --satisfies <id>... [--discovery-command-json <json-argv> --expected-test <identity>...] -- <command> [args...]
  acef-state developer-repair --repo <path> --id <id> --prior-gate <gate-id> --developer-actor <actor-id>
  acef-state review-capsule --repo <path> --id <id> --role code-review|patch-assurance --actor <id> --base-commit <sha> --red-evidence <id> --green-evidence <id> [--review-cycle 0|1|2 --repair-receipt <path>]
  acef-state capsule-show --repo <path> --id <id>
  acef-state review-result --repo <path> --actor <exact-reviewer-id> --verdict PASS|REVISE|REPLAN [--finding-id <id> --finding-severity LOW|MEDIUM|HIGH|CRITICAL --finding-reason <plain-text>]...
  acef-state review-completion --repo <path> --artifact-path <docs/ai/reports/report.json> --actor <exact-reviewer-id>  # compatibility
  acef-state judge-decision --repo <path> --id <id> --gate-id <future-gate-id> --actor <judge-id> --trigger ambiguity|waiver|evidence-conflict|gate-anomaly --evidence <id>...
  acef-state gate --repo <path> --id <id> --scope <scope> --verdict <verdict> --decided-by <actor-id> [--evidence <id>...] [options]
  acef-state gate --repo <path> --id <id> --scope <scope> --atdd-actor <id> --development-actor <id> --code-review-actor <id> --patch-assurance-actor <id> --red-evidence <id> --green-evidence <id> --code-review-report-hash <sha256> --patch-assurance-report-hash <sha256> [--review-cycle 0|1|2] [--unresolved-finding SEVERITY:id] [--process-judge-actor <id> --judge-trigger ambiguity|waiver|evidence-conflict|gate-anomaly] [--verdict <computed-verdict>] [options]

Record files are written under docs/ai. Immutable records refuse overwrite; active-run and worker-scope are atomic singletons.`);
}

function parseArgs(argv) {
  const [command, ...rest] = argv;
  const opts = { command, repo: process.cwd(), allow: [], satisfies: [], evidence: [], surface: [], surfaceEvidence: [], binding: [], bindingEvidence: [], riskTrigger: [], clarifyingQuestion: [], inferredAnswer: [], unresolvedQuestion: [], requiredSurface: [], coveredSurface: [], goalEvidence: [], goalMissing: [], acceptance: [], changedPath: [], verificationCommand: [], verificationExitCode: [], unresolvedRisk: [], unresolvedFinding: [], finding: [], findingId: [], findingSeverity: [], findingReason: [], promotionReason: [], expectedStory: [], expectedTest: [], commandArgv: [] };
  for (let index = 0; index < rest.length; index += 1) {
    const arg = rest[index];
    if (arg === "--help" || arg === "-h") {
      opts.help = true;
      continue;
    }
    if (arg === "--") {
      opts.commandArgv = rest.slice(index + 1);
      break;
    }
    if (!arg.startsWith("--")) throw new Error(`Unexpected argument: ${arg}`);
    const key = arg.slice(2).replace(/-([a-z])/g, (_, letter) => letter.toUpperCase());
    if (["force"].includes(key)) {
      opts[key] = true;
      continue;
    }
    const value = rest[index + 1];
    if (value === undefined || value.startsWith("--")) throw new Error(`Missing value for ${arg}`);
    index += 1;
    if (["allow", "satisfies", "evidence", "surface", "surfaceEvidence", "binding", "bindingEvidence", "riskTrigger", "clarifyingQuestion", "inferredAnswer", "unresolvedQuestion", "requiredSurface", "coveredSurface", "goalEvidence", "goalMissing", "acceptance", "changedPath", "verificationCommand", "verificationExitCode", "unresolvedRisk", "unresolvedFinding", "finding", "findingId", "findingSeverity", "findingReason", "promotionReason", "expectedStory", "expectedTest"].includes(key)) opts[key].push(value);
    else opts[key] = value;
  }
  opts.repo = path.resolve(opts.repo);
  return opts;
}

function required(opts, fields) {
  const missing = fields.filter((field) => opts[field] === undefined || opts[field] === "");
  if (missing.length) throw new Error(`Missing option(s): ${missing.map((field) => `--${field.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)}`).join(", ")}`);
}

function safeId(value, label) {
  if (!/^[A-Za-z0-9._-]+$/.test(String(value || ""))) throw new Error(`${label} must use only letters, numbers, dot, underscore, or dash`);
  return String(value);
}

function parseBoolean(value, label) {
  if (value === true || value === "true") return true;
  if (value === false || value === "false") return false;
  throw new Error(`${label} must be true or false`);
}

function intakeDecision(opts) {
  if (!opts.route && !opts.routeConfidence && !opts.clarifyingQuestion.length && !opts.inferredAnswer.length && !opts.unresolvedQuestion.length) return null;
  const record = {
    route: opts.route || "",
    confidence: opts.routeConfidence || "medium",
    clarifyingQuestions: opts.clarifyingQuestion,
    inferredAnswers: opts.inferredAnswer,
    unresolvedQuestions: opts.unresolvedQuestion,
  };
  if (opts.approvalRequired !== undefined) record.approvalRequired = parseBoolean(opts.approvalRequired, "--approval-required");
  if (opts.executionApproved !== undefined) record.executionApproved = parseBoolean(opts.executionApproved, "--execution-approved");
  if (opts.briefApproved !== undefined) record.briefApproved = parseBoolean(opts.briefApproved, "--brief-approved");
  return record;
}

function activeGoal(opts) {
  if (!opts.goalDescription && opts.goalUserFacing === undefined && !opts.goalCompletionMode) return null;
  const record = {};
  if (opts.goalDescription) record.description = opts.goalDescription;
  if (opts.goalUserFacing !== undefined) record.userFacing = parseBoolean(opts.goalUserFacing, "--goal-user-facing");
  if (opts.goalCompletionMode) record.completionMode = opts.goalCompletionMode;
  return record;
}

function goalCoverage(opts) {
  if (!opts.goalStatus && !opts.storyType && !opts.requiredSurface.length && !opts.coveredSurface.length && !opts.goalEvidence.length && !opts.goalMissing.length) return null;
  const record = {};
  if (opts.goalStatus) record.status = opts.goalStatus;
  if (opts.storyType) record.storyType = opts.storyType;
  if (opts.requiredSurface.length) record.requiredSurfaces = opts.requiredSurface;
  if (opts.coveredSurface.length) record.coveredSurfaces = opts.coveredSurface;
  if (opts.goalEvidence.length) record.evidenceRefs = opts.goalEvidence;
  if (opts.goalMissing.length) record.missing = opts.goalMissing;
  if (opts.goalNotes) record.notes = opts.goalNotes;
  return record;
}

function parseSurfaceEvidence(entries) {
  if (!entries.length) return undefined;
  return entries.map((entry) => {
    const [surface, evidenceId, roundTrip, firstUsePattern] = String(entry).split(":");
    if (!surface || !evidenceId) {
      throw new Error("--surface-evidence must be surface:evidenceId[:roundTrip][:firstUse]");
    }
    const record = { surface, evidenceId };
    if (roundTrip !== undefined && roundTrip !== "") record.roundTrip = parseBoolean(roundTrip, "--surface-evidence roundTrip");
    if (firstUsePattern !== undefined && firstUsePattern !== "") record.firstUsePattern = parseBoolean(firstUsePattern, "--surface-evidence firstUse");
    return record;
  });
}

function parseBinding(entries) {
  if (!entries.length) return undefined;
  return entries.map((entry) => {
    const [surfacePair, field, defaultMaskingRisk] = String(entry).split(":");
    const [inputSurface, outputSurface] = String(surfacePair || "").split(">");
    if (!inputSurface || !outputSurface || !field) {
      throw new Error("--binding must be inputSurface>outputSurface:field[:defaultMaskingRisk]");
    }
    const record = { inputSurface, outputSurface, field };
    if (defaultMaskingRisk !== undefined && defaultMaskingRisk !== "") {
      record.defaultMaskingRisk = parseBoolean(defaultMaskingRisk, "--binding defaultMaskingRisk");
    }
    return record;
  });
}

function parseBindingEvidence(entries) {
  if (!entries.length) return undefined;
  return entries.map((entry) => {
    const [surfacePair, field, evidenceId, nonDefaultValue, defaultRejected] = String(entry).split(":");
    const [inputSurface, outputSurface] = String(surfacePair || "").split(">");
    if (!inputSurface || !outputSurface || !field || !evidenceId) {
      throw new Error("--binding-evidence must be inputSurface>outputSurface:field:evidenceId[:nonDefaultValue][:defaultRejected]");
    }
    const record = { inputSurface, outputSurface, field, evidenceId };
    if (nonDefaultValue !== undefined && nonDefaultValue !== "") {
      record.nonDefaultValue = parseBoolean(nonDefaultValue, "--binding-evidence nonDefaultValue");
    }
    if (defaultRejected !== undefined && defaultRejected !== "") {
      record.defaultRejected = parseBoolean(defaultRejected, "--binding-evidence defaultRejected");
    }
    return record;
  });
}

function runGit(repo, args) {
  return cp.execFileSync("git", args, { cwd: repo, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
}

function gitCommit(repo) {
  return runGit(repo, ["rev-parse", "HEAD"]);
}

function gitTree(repo) {
  return runGit(repo, ["rev-parse", "HEAD^{tree}"]);
}

function gitTreeAt(repo, commit) {
  return runGit(repo, ["rev-parse", `${commit}^{tree}`]);
}

function sha256(value) {
  return crypto.createHash("sha256").update(value).digest("hex");
}

function evidenceRunnerProof(record) {
  return sha256(JSON.stringify({
    schema: "acef-evidence-runner-proof-v1",
    runner: "acef-state evidence-run",
    evidenceId: record.evidenceId,
    kind: record.kind,
    command: record.command,
    exitCode: record.exitCode,
    startedAt: record.startedAt || null,
    finishedAt: record.finishedAt || null,
    repositoryCommit: record.repositoryCommit,
    repositoryTree: record.repositoryTree || null,
    dirtyDigest: record.dirtyDigest,
    dirtyApplicationPathsBefore: record.dirtyApplicationPathsBefore || [],
    dirtyApplicationPathsAfter: record.dirtyApplicationPathsAfter || [],
    environmentDigest: record.environmentDigest || null,
    actorInstanceId: record.actorInstanceId,
    story: record.story,
    rawArtifact: record.rawArtifact,
    ...(Object.prototype.hasOwnProperty.call(record, "discovery") ? { discovery: record.discovery } : {}),
    satisfies: record.satisfies,
  }));
}

function dirtyDigest(repo) {
  const status = cp.execFileSync("git", ["status", "--porcelain=v1", "-z"], {
    cwd: repo,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
  return status ? sha256(status) : "clean";
}

function isControlPath(filePath) {
  const normalized = filePath.replaceAll(path.sep, "/");
  return /^docs\/ai\/(?:ACEF_(?:ACTIVE_RUN\.json|ACTIVE_WORKER_SCOPE\.json|ACTIVE_LEDGER|DIRECT_RUN\.json|CURRENT_CONTEXT\.md|RUN_[^/]+\.md|DELIVERY_LEDGER(?:_[^/]+)?\.md|[^/]+_DELIVERY_AUDIT\.md)|actors\/|gates\/|evidence\/|reports\/|approvals\/|repairs\/|capsules\/|judges\/)/.test(normalized);
}

function dirtyApplicationPaths(repo) {
  const output = cp.execFileSync("git", ["status", "--porcelain=v1"], {
    cwd: repo,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
  return output.split(/\r?\n/).filter(Boolean).map((line) => line.slice(3)).filter((filePath) => !isControlPath(filePath));
}

function atomicJson(filePath, record, { overwrite = false, validate = null } = {}) {
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  if (!overwrite && fs.existsSync(filePath)) throw new Error(`Refusing to overwrite immutable record: ${filePath}`);
  const tmp = `${filePath}.${process.pid}.tmp`;
  try {
    fs.writeFileSync(tmp, `${JSON.stringify(record, null, 2)}\n`);
    if (validate) validate(tmp);
    fs.renameSync(tmp, filePath);
  } finally {
    fs.rmSync(tmp, { force: true });
  }
}

function relative(repo, filePath) {
  return path.relative(repo, filePath).replaceAll(path.sep, "/");
}

function actorPath(repo, actorId) {
  return path.join(repo, "docs", "ai", "actors", `${safeId(actorId, "actor id")}.json`);
}

function evidencePath(repo, evidenceId) {
  return path.join(repo, "docs", "ai", "evidence", `${safeId(evidenceId, "evidence id")}.json`);
}

function rawEvidencePath(repo, evidenceId) {
  return path.join(repo, "docs", "ai", "evidence", "raw", `${safeId(evidenceId, "evidence id")}.log`);
}

function quoteArg(value) {
  return /^[A-Za-z0-9_./:@%+=,-]+$/.test(value) ? value : `'${value.replaceAll("'", `'\\''`)}'`;
}

function lifecycleRecordsExist(repo) {
  const candidates = [
    path.join(repo, "docs", "ai", "actors"),
    path.join(repo, "docs", "ai", "gates"),
  ];
  for (const dirPath of candidates) {
    if (!fs.existsSync(dirPath)) continue;
    if (fs.readdirSync(dirPath).some((name) => name.endsWith(".json"))) return true;
  }
  return false;
}

function writeActiveRun(opts) {
  required(opts, ["runId", "status", "story", "phase", "ledger"]);
  if (opts.lane === "guarded") {
    throw new Error("lane guarded is legacy state; select --workflow-id quick-fix|lightweight|full-bmad and --assurance guarded");
  }
  const workflowId = opts.workflowId || opts.lane;
  if (!workflowId) throw new Error("Missing required option(s): workflow-id");
  const target = path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  const previous = fs.existsSync(target) ? parseActiveRun(target) : null;
  const sameRun = previous?.schema === "acef.active-run.v2" && previous.runId === opts.runId;
  const previousContract = sameRun ? previous.fullFlowContract : undefined;
  const previousRuntimeContract = sameRun ? previous.runtimeContract : undefined;
  const previousSemanticContract = sameRun ? (previousContract || "six-actor-v2") : undefined;
  if (sameRun && opts.fullFlowContract && previousSemanticContract !== opts.fullFlowContract
    && lifecycleRecordsExist(opts.repo)) {
    throw new Error(`fullFlowContract is immutable after actor/gate creation within run ${opts.runId}: ${previousSemanticContract} -> ${opts.fullFlowContract}`);
  }
  if (sameRun && opts.runtimeContract && previousRuntimeContract !== opts.runtimeContract
    && lifecycleRecordsExist(opts.repo)) {
    throw new Error(`runtimeContract is immutable after actor/gate creation within run ${opts.runId}`);
  }
  // Compatibility rule: an already-existing missing contract remains legacy v2.
  // A genuinely new Full run defaults to v3.
  const fullFlowContract = sameRun
    ? (opts.fullFlowContract || previousContract)
    : (workflowId === "full-bmad" ? (opts.fullFlowContract || "four-actor-v3") : opts.fullFlowContract);
  if (fullFlowContract && workflowId !== "full-bmad") {
    throw new Error("--full-flow-contract is only valid with --workflow-id full-bmad");
  }
  const runtimeContract = sameRun ? (opts.runtimeContract || previousRuntimeContract) : opts.runtimeContract;
  if (runtimeContract && (workflowId !== "full-bmad" || fullFlowContract !== "four-actor-v3")) {
    throw new Error("--runtime-contract requires --workflow-id full-bmad --full-flow-contract four-actor-v3");
  }
  const riskTriggers = opts.riskTrigger.length ? opts.riskTrigger : [];
  const assuranceProfile = opts.assurance || (riskRequiresGuarded(riskTriggers) ? "guarded" : "baseline");
  const scopeUnit = opts.scopeUnit || (opts.epic ? "epic" : "story");
  const expectedStories = opts.expectedStory.length ? [...new Set(opts.expectedStory)] : (sameRun ? previous.expectedStories : undefined);
  if (sameRun && previous.expectedStories && opts.expectedStory.length
    && JSON.stringify(previous.expectedStories) !== JSON.stringify(expectedStories)) {
    throw new Error("expectedStories inventory is frozen when a four-actor-v3 run is created");
  }
  if (fullFlowContract === "four-actor-v3" && !expectedStories?.length) {
    throw new Error("new four-actor-v3 run requires at least one --expected-story before lifecycle work begins");
  }
  if (fullFlowContract === "four-actor-v3" && scopeUnit !== "story"
    && expectedStories.some((story) => normalizedScope(story) === normalizedScope(opts.story))) {
    throw new Error(`four-actor-v3 active story ${opts.story} requires --scope-unit story`);
  }
  if (fullFlowContract === "four-actor-v3" && scopeUnit === "story"
    && !expectedStories.some((story) => normalizedScope(story) === normalizedScope(opts.story))) {
    throw new Error(`active story ${opts.story} is not in the frozen expectedStories inventory`);
  }
  const assuranceRationale = opts.assuranceRationale
    || (assuranceProfile === "guarded" ? `risk triggers: ${riskTriggers.join(", ") || "explicit guarded selection"}` : null);
  if (assuranceProfile === "guarded" && scopeUnit === "epic" && workflowId !== "full-bmad" && !opts.assuranceApproval) {
    throw new Error("non-Full guarded epic requires --assurance-approval <typed approval id>");
  }
  const record = {
    schema: "acef.active-run.v2",
    runId: opts.runId,
    repo: path.basename(opts.repo),
    workflowId,
    ...(fullFlowContract ? { fullFlowContract } : {}),
    ...(runtimeContract ? { runtimeContract } : {}),
    assuranceProfile,
    scopeUnit,
    ...(expectedStories ? { expectedStories } : {}),
    assuranceRationale,
    assuranceApprovalId: opts.assuranceApproval ? safeId(opts.assuranceApproval, "assurance approval id") : null,
    track: opts.track === "guarded" ? null : (opts.track || null),
    status: opts.status,
    activeEpic: opts.epic || (sameRun ? previous.activeEpic : null),
    activeStory: opts.story,
    activePhase: opts.phase,
    activeGoal: activeGoal(opts) || (sameRun ? previous.activeGoal : null),
    goalCoverage: goalCoverage(opts) || (sameRun ? previous.goalCoverage : null),
    workerRole: opts.workerRole || (sameRun ? previous.workerRole : null),
    activeActorId: opts.actor || (sameRun ? previous.activeActorId : null),
    workflowRationale: opts.workflowRationale || opts.laneRationale || (sameRun ? previous.workflowRationale : null),
    intakeDecision: intakeDecision(opts) || (sameRun ? previous.intakeDecision : null),
    riskTriggers: riskTriggers.length ? riskTriggers : (sameRun ? previous.riskTriggers : []),
    workerScopePath: opts.workerScope || (sameRun ? previous.workerScopePath : null),
    workflowPath: opts.workflow || (sameRun ? previous.workflowPath : null),
    workflowNodeId: opts.workflowNode || (sameRun ? previous.workflowNodeId : null),
    fullLedgerAccess: opts.fullLedgerAccess || (sameRun ? previous.fullLedgerAccess : null),
    maxLines: opts.maxLines ? Number(opts.maxLines) : (sameRun ? previous.maxLines : null),
    nextAllowedStep: opts.nextAllowedStep || (sameRun ? previous.nextAllowedStep : null),
    ledgerPath: opts.ledger,
    contextPath: opts.context || (sameRun ? previous.contextPath : null),
    updatedAt: new Date().toISOString(),
  };
  atomicJson(target, record, { overwrite: true, validate: parseActiveRun });
  console.log(`WROTE active-run ${relative(opts.repo, target)}`);
}

function migrateActiveRun(opts) {
  const target = path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  if (!fs.existsSync(target)) throw new Error("migrate-active-run requires docs/ai/ACEF_ACTIVE_RUN.json");
  const previous = parseActiveRun(target);
  if (previous.schema === "acef.active-run.v2" && !previous.executionMigrationRequired) {
    throw new Error("active run is already acef.active-run.v2");
  }
  if (previous.executionMigrationRequired && !opts.workflowId) {
    throw new Error("legacy guarded active run requires explicit --workflow-id quick-fix|lightweight|full-bmad");
  }
  const workflowId = opts.workflowId || previous.workflowId;
  const fullFlowContract = opts.fullFlowContract || previous.fullFlowContract;
  if (fullFlowContract && workflowId !== "full-bmad") {
    throw new Error("--full-flow-contract is only valid with --workflow-id full-bmad");
  }
  const assuranceProfile = opts.assurance || previous.assuranceProfile || "baseline";
  const scopeUnit = opts.scopeUnit || previous.scopeUnit || (previous.activeEpic ? "epic" : "story");
  const assuranceRationale = opts.assuranceRationale
    || previous.assuranceRationale
    || (assuranceProfile === "guarded" ? "migrated legacy guarded run" : null);
  const rawAssuranceApprovalId = opts.assuranceApproval || previous.assuranceApprovalId || null;
  const assuranceApprovalId = rawAssuranceApprovalId
    ? safeId(rawAssuranceApprovalId, "assurance approval id")
    : null;
  if (assuranceProfile === "guarded" && scopeUnit === "epic" && workflowId !== "full-bmad" && !assuranceApprovalId) {
    throw new Error("non-Full guarded epic migration requires --assurance-approval <typed approval id>");
  }
  const expectedStories = opts.expectedStory.length ? [...new Set(opts.expectedStory)] : previous.expectedStories;
  if (fullFlowContract === "four-actor-v3" && !expectedStories?.length) {
    throw new Error("four-actor-v3 migration requires at least one --expected-story inventory entry before lifecycle work begins");
  }
  if (fullFlowContract === "four-actor-v3" && scopeUnit === "story"
    && !expectedStories.some((story) => normalizedScope(story) === normalizedScope(previous.activeStory))) {
    throw new Error(`active story ${previous.activeStory} is not in the frozen expectedStories inventory`);
  }
  const {
    lane: _lane,
    laneRationale: legacyLaneRationale,
    schema: _schema,
    executionMigrationRequired: _migrationRequired,
    workflowId: _workflowId,
    fullFlowContract: _fullFlowContract,
    assuranceProfile: _assuranceProfile,
    scopeUnit: _scopeUnit,
    workflowRationale: previousWorkflowRationale,
    ...preserved
  } = previous;
  const record = {
    ...preserved,
    schema: "acef.active-run.v2",
    workflowId,
    ...(fullFlowContract ? { fullFlowContract } : {}),
    assuranceProfile,
    scopeUnit,
    ...(expectedStories ? { expectedStories } : {}),
    assuranceRationale,
    assuranceApprovalId,
    workflowRationale: opts.workflowRationale
      || opts.laneRationale
      || previousWorkflowRationale
      || legacyLaneRationale
      || null,
    track: previous.track === "guarded" ? null : (previous.track || null),
    updatedAt: new Date().toISOString(),
  };
  atomicJson(target, record, { overwrite: true, validate: parseActiveRun });
  console.log(`MIGRATED active-run ${relative(opts.repo, target)} workflow=${workflowId} assurance=${assuranceProfile}`);
}

function writeDirectRun(opts) {
  required(opts, ["runId", "status"]);
  const target = path.join(opts.repo, "docs", "ai", "ACEF_DIRECT_RUN.json");
  const existing = fs.existsSync(target) ? parseDirectRun(target) : null;
  const previous = existing?.runId === opts.runId ? existing : null;
  const dosingCandidates = [
    path.join(opts.repo, ".acef", "control-dosing.json"),
    path.resolve(__dirname, "..", "method", "control-dosing.json"),
  ];
  const dosingPath = dosingCandidates.find((candidate) => fs.existsSync(candidate));
  const directRetired = dosingPath
    ? parseControlDosing(dosingPath).retiredAdmissions.includes("direct")
    : true;
  if (!previous && directRetired) {
    throw new Error("new direct-run admission is retired; use the repository native workflow outside ACEF, or start a non-direct ACEF run when risk/control triggers apply");
  }
  const verification = opts.verificationCommand.length || opts.verificationExitCode.length
    ? opts.verificationCommand.map((command, index) => ({
      command,
      exitCode: Number(opts.verificationExitCode[index]),
    }))
    : (previous?.verification || []);
  if (opts.verificationCommand.length !== opts.verificationExitCode.length) {
    throw new Error("direct-run requires one --verification-exit-code for each --verification-command");
  }
  if (verification.some((item) => !Number.isInteger(item.exitCode))) {
    throw new Error("direct-run verification exit codes must be integers");
  }
  const promotionDecision = opts.promotionDecision || previous?.promotion?.decision || "stay-direct";
  const record = {
    schema: "acef.direct-run.v1",
    version: "1.0.0",
    runId: opts.runId,
    lane: "direct",
    status: opts.status,
    scope: opts.scope || previous?.scope || "",
    acceptance: opts.acceptance.length ? opts.acceptance : (previous?.acceptance || []),
    technicalBoundary: opts.technicalBoundary || previous?.technicalBoundary || "",
    reversible: opts.reversible !== undefined
      ? parseBoolean(opts.reversible, "--reversible")
      : previous?.reversible,
    riskTriggers: opts.riskTrigger.length ? opts.riskTrigger : (previous?.riskTriggers || []),
    baseCommit: opts.baseCommit || previous?.baseCommit || gitCommit(opts.repo),
    changedPaths: opts.changedPath.length ? opts.changedPath : (previous?.changedPaths || []),
    verification,
    promotion: {
      decision: promotionDecision,
      reasons: opts.promotionReason.length ? opts.promotionReason : (previous?.promotion?.reasons || []),
    },
    handoff: opts.summary || opts.unresolvedRisk.length
      ? {
        summary: opts.summary || previous?.handoff?.summary || "",
        unresolvedRisks: opts.unresolvedRisk.length ? opts.unresolvedRisk : (previous?.handoff?.unresolvedRisks || []),
      }
      : (previous?.handoff || undefined),
    updatedAt: new Date().toISOString(),
  };
  atomicJson(target, record, { overwrite: true, validate: parseDirectRun });
  console.log(`WROTE direct-run ${relative(opts.repo, target)} status=${record.status}`);
}

function writeActor(opts) {
  required(opts, ["id", "story", "phase", "role", "client", "contextProfile"]);
  let producedArtifactPath = null;
  let producedArtifactHash = opts.artifactHash || null;
  if (opts.artifactPath) {
    const artifactPath = path.resolve(opts.repo, opts.artifactPath);
    const relativeArtifactPath = relative(opts.repo, artifactPath);
    if (!relativeArtifactPath || relativeArtifactPath.startsWith("..") || path.isAbsolute(relativeArtifactPath)) {
      throw new Error("--artifact-path must stay inside the repository");
    }
    if (!fs.existsSync(artifactPath) || !fs.statSync(artifactPath).isFile()) throw new Error(`--artifact-path does not exist: ${opts.artifactPath}`);
    producedArtifactPath = relativeArtifactPath;
    const computedHash = sha256(fs.readFileSync(artifactPath));
    if (producedArtifactHash && producedArtifactHash !== computedHash) throw new Error("--artifact-hash does not match --artifact-path contents");
    producedArtifactHash = computedHash;
  }
  const activeRunPath = path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  const activeRun = fs.existsSync(activeRunPath) ? parseActiveRun(activeRunPath) : null;
  const v3 = activeRun?.fullFlowContract === "four-actor-v3";
  if (v3 && normalizedScope(opts.story) !== normalizedScope(activeRun.activeStory)) throw new Error("four-actor-v3 actor story must match active run scope");
  if (v3 && canonicalGatePhase(opts.phase) === "development" && !opts.sessionId) {
    throw new Error("four-actor-v3 Developer actor requires --session-id for repair continuity");
  }
  if (activeRun?.runtimeContract === "capsule-supervisor-v1") {
    if (opts.model !== "gpt-5.6-sol" || opts.effort !== "high") {
      throw new Error("capsule-supervisor-v1 semantic actor must bind manifest floor gpt-5.6-sol/high");
    }
  }
  const record = {
    actorInstanceId: opts.id,
    ...(v3 ? { runId: activeRun.runId, fullFlowContract: activeRun.fullFlowContract, storyInventory: activeRun.expectedStories } : {}),
    story: opts.story,
    phase: opts.phase,
    role: opts.role,
    client: opts.client,
    model: opts.model || null,
    reasoningEffort: opts.effort || null,
    sessionId: opts.sessionId || null,
    parentSessionId: opts.parentSessionId || null,
    promptArtifactHash: opts.promptHash || null,
    inputCommit: opts.inputCommit || gitCommit(opts.repo),
    inputTree: opts.inputTree || gitTree(opts.repo),
    allowedContextProfile: opts.contextProfile,
    producedArtifactHash,
    producedArtifactPath,
    createdAt: new Date().toISOString(),
  };
  const target = actorPath(opts.repo, opts.id);
  atomicJson(target, record, { validate: parseActorRecord });
  console.log(`WROTE actor ${relative(opts.repo, target)}`);
}

function writeWorkerScope(opts) {
  required(opts, ["story", "phase", "workerId"]);
  if (!opts.allow.length) throw new Error("worker-scope requires at least one --allow path");
  const activeRunPath = path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  if (!fs.existsSync(activeRunPath)) throw new Error("worker-scope requires docs/ai/ACEF_ACTIVE_RUN.json");
  const activeRun = parseActiveRun(activeRunPath);
  if (activeRun.status !== "active") throw new Error(`worker-scope requires active run status, got ${activeRun.status}`);
  if (String(activeRun.activeStory) !== String(opts.story)) {
    throw new Error(`worker-scope story ${opts.story} does not match active run story ${activeRun.activeStory}`);
  }
  const requiresRoundTrip = opts.requiresRoundTrip === undefined ? undefined : parseBoolean(opts.requiresRoundTrip, "--requires-round-trip");
  const record = {
    runId: activeRun.runId,
    activeStory: opts.story,
    phase: opts.phase,
    workerId: opts.workerId,
    allowedPaths: opts.allow,
    surfaces: opts.surface.length ? opts.surface : undefined,
    patternUse: opts.patternUse || undefined,
    requiresRoundTrip,
    inputOutputBindings: parseBinding(opts.binding),
    baseRef: opts.baseRef || gitCommit(opts.repo),
    maxCommits: opts.maxCommits ? Number(opts.maxCommits) : 1,
    canEditLedger: false,
    canSpawnAgents: false,
    createdAt: new Date().toISOString(),
  };
  const target = path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json");
  atomicJson(target, record, { overwrite: true, validate: parseWorkerScope });
  console.log(`WROTE worker-scope ${relative(opts.repo, target)}`);
}

function writeApproval(opts) {
  required(opts, ["id", "decision", "scope", "quote"]);
  const record = {
    approvalId: opts.id,
    decision: opts.decision,
    scope: opts.scope,
    targetEpic: opts.targetEpic ? Number(opts.targetEpic) : null,
    actorType: "human",
    userQuote: opts.quote,
    statementHash: sha256(opts.quote),
    repositoryCommit: gitCommit(opts.repo),
    sourceChannel: opts.sourceChannel || null,
    createdAt: new Date().toISOString(),
  };
  const target = path.join(opts.repo, "docs", "ai", "approvals", `${safeId(opts.id, "approval id")}.json`);
  atomicJson(target, record, { validate: parseApproval });
  console.log(`WROTE approval ${relative(opts.repo, target)}`);
}

function writeEvidence(opts) {
  required(opts, ["id", "kind", "actor", "story"]);
  if (!opts.satisfies.length) throw new Error("evidence-run requires at least one --satisfies value");
  if (!opts.commandArgv.length) throw new Error("evidence-run requires a command after --");
  if (opts.expectedTest.length && !opts.discoveryCommandJson) {
    throw new Error("evidence-run --expected-test requires --discovery-command-json");
  }
  if (opts.discoveryCommandJson && !opts.expectedTest.length) {
    throw new Error("evidence-run --discovery-command-json requires at least one --expected-test");
  }
  if (!["runtime-test", "static-check", "manual-smoke", "build", "lint", "typecheck", "other"].includes(opts.kind)) {
    throw new Error("evidence manifest kind must be one of: runtime-test, static-check, manual-smoke, build, lint, typecheck, other");
  }
  const rawPath = rawEvidencePath(opts.repo, opts.id);
  const target = evidencePath(opts.repo, opts.id);
  if (fs.existsSync(rawPath) || fs.existsSync(target)) {
    throw new Error(`Refusing to overwrite immutable evidence ${opts.id}`);
  }
  const beforeDirty = dirtyApplicationPaths(opts.repo);
  const activeRunPath = path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  const activeRun = fs.existsSync(activeRunPath) ? parseActiveRun(activeRunPath) : null;
  const actorFile = actorPath(opts.repo, opts.actor);
  const canonicalAtddId = `acef_${String(opts.story).toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "")}_atdd`;
  const mayCreateV3Atdd = activeRun?.fullFlowContract === "four-actor-v3" && !fs.existsSync(actorFile);
  if (mayCreateV3Atdd) {
    if (opts.kind !== "runtime-test" || opts.actor !== canonicalAtddId
      || normalizedScope(opts.story) !== normalizedScope(activeRun.activeStory)) {
      throw new Error("four-actor-v3 evidence may create only the canonical active-story ATDD actor for runtime-test evidence");
    }
    if (beforeDirty.length) {
      throw new Error(`four-actor-v3 ATDD evidence requires a clean committed test-only red tree before execution; dirty paths: ${beforeDirty.join(", ")}`);
    }
    const redCommit = gitCommit(opts.repo);
    let redParent = "";
    try { redParent = runGit(opts.repo, ["rev-parse", `${redCommit}^`]); } catch {}
    const redPaths = redParent ? applicationChangedSince(opts.repo, redParent, redCommit) : [];
    if (!redParent || !redPaths.length || !redPaths.every(testPath)) {
      throw new Error("four-actor-v3 ATDD evidence requires HEAD to be a new test-only commit before actor creation");
    }
    writeActor({
      repo: opts.repo,
      id: opts.actor,
      story: opts.story,
      phase: "atdd",
      role: "test-author",
      client: "codex",
      sessionId: `/root/${opts.actor}`,
      contextProfile: "atdd",
      inputCommit: redParent,
      inputTree: gitTreeAt(opts.repo, redParent),
      model: opts.model,
      effort: opts.effort,
    });
  }
  const actor = parseActorRecord(actorFile);
  if (actor.story !== opts.story) throw new Error(`actor story ${actor.story} does not match evidence story ${opts.story}`);
  const v3Atdd = activeRun?.fullFlowContract === "four-actor-v3" && canonicalGatePhase(actor.phase) === "atdd";
  if (v3Atdd) {
    if (beforeDirty.length) {
      throw new Error(`four-actor-v3 ATDD evidence requires a clean committed test-only red tree before execution; dirty paths: ${beforeDirty.join(", ")}`);
    }
    const redCommit = gitCommit(opts.repo);
    let redParent = "";
    try { redParent = runGit(opts.repo, ["rev-parse", `${redCommit}^`]); } catch {}
    const redPaths = redParent ? applicationChangedSince(opts.repo, redParent, redCommit) : [];
    if (!redParent || !redPaths.length || !redPaths.every(testPath)
      || actor.inputCommit === redCommit || !gitIsAncestor(opts.repo, actor.inputCommit, redCommit)) {
      throw new Error("four-actor-v3 ATDD evidence requires HEAD to be a new test-only commit descended from the ATDD actor input commit");
    }
  }

  let discovery = null;
  if (opts.discoveryCommandJson) {
    let discoveryArgv;
    try { discoveryArgv = JSON.parse(opts.discoveryCommandJson); }
    catch { throw new Error("--discovery-command-json must be a JSON argv array"); }
    if (!Array.isArray(discoveryArgv) || !discoveryArgv.length
      || discoveryArgv.some((entry) => typeof entry !== "string" || !entry)) {
      throw new Error("--discovery-command-json must be a non-empty JSON argv array of strings");
    }
    const discoveryExecution = cp.spawnSync(discoveryArgv[0], discoveryArgv.slice(1), {
      cwd: opts.repo, encoding: "utf8", env: process.env, maxBuffer: 100 * 1024 * 1024,
    });
    const discoveryExit = Number.isInteger(discoveryExecution.status) ? discoveryExecution.status : 1;
    const discoveryOutput = discoveryExecution.stdout || "";
    const discoveredTests = [...new Set(discoveryOutput.split(/\r?\n/)
      .map((line) => line.trim().replace(/^-\s+/, ""))
      .filter(Boolean))];
    const missingTests = [...new Set(opts.expectedTest)].filter((test) => !discoveredTests.includes(test));
    if (discoveryExit !== 0 || missingTests.length) {
      throw new Error(`test discovery contract failed; exit=${discoveryExit}; missing=${missingTests.join(", ") || "none"}`);
    }
    discovery = {
      command: discoveryArgv.map(quoteArg).join(" "),
      exitCode: 0,
      expectedTests: [...new Set(opts.expectedTest)],
      discoveredTests,
      stdoutSha256: sha256(discoveryOutput),
    };
  }

  const commandText = opts.commandArgv.map(quoteArg).join(" ");
  const startedAt = new Date().toISOString();
  const execution = cp.spawnSync(opts.commandArgv[0], opts.commandArgv.slice(1), {
    cwd: opts.repo,
    encoding: "utf8",
    env: process.env,
    maxBuffer: 100 * 1024 * 1024,
  });
  const finishedAt = new Date().toISOString();
  const exitCode = Number.isInteger(execution.status) ? execution.status : 1;
  const raw = [
    `command: ${commandText}`,
    `started_at: ${startedAt}`,
    `finished_at: ${finishedAt}`,
    `exit_code: ${exitCode}`,
    execution.signal ? `signal: ${execution.signal}` : "",
    "",
    "--- stdout ---",
    execution.stdout || "",
    "--- stderr ---",
    execution.stderr || execution.error?.message || "",
  ].filter((line) => line !== "").join("\n");
  fs.mkdirSync(path.dirname(rawPath), { recursive: true });
  fs.writeFileSync(rawPath, `${raw}\n`);

  const afterDirty = dirtyApplicationPaths(opts.repo);
  const record = {
    evidenceId: opts.id,
    kind: opts.kind,
    command: commandText,
    exitCode,
    startedAt,
    finishedAt,
    repositoryCommit: gitCommit(opts.repo),
    repositoryTree: gitTree(opts.repo),
    dirtyDigest: dirtyDigest(opts.repo),
    dirtyApplicationPathsBefore: beforeDirty,
    dirtyApplicationPathsAfter: afterDirty,
    environmentDigest: sha256(`${process.platform}\n${process.arch}\n${process.version}\n${os.release()}`),
    actorInstanceId: opts.actor,
    story: opts.story,
    rawArtifact: { path: relative(opts.repo, rawPath), sha256: sha256(fs.readFileSync(rawPath)) },
    ...(discovery ? { discovery } : {}),
    satisfies: opts.satisfies,
  };
  record.runnerProof = {
    schema: "acef-evidence-runner-proof-v1",
    runner: "acef-state evidence-run",
    sha256: evidenceRunnerProof(record),
  };
  atomicJson(target, record, { validate: parseEvidenceManifest });
  console.log(`WROTE evidence ${relative(opts.repo, target)} exit=${exitCode} raw=${record.rawArtifact.path}`);
  if (afterDirty.length) {
    console.error(`Evidence captured with dirty application paths: ${afterDirty.join(", ")}`);
  }
  if (exitCode !== 0) {
    process.exitCode = exitCode;
  }
}

function normalizedScope(value) {
  return String(value || "").toLowerCase().replace(/[^a-z0-9]+/g, "");
}

function canonicalGatePhase(value) {
  const phase = normalizedScope(value);
  const aliases = {
    dev: "development",
    developer: "development",
    review: "codereview",
    reviewer: "codereview",
    codereviewer: "codereview",
    testreview: "patchassurance",
    testreviewer: "patchassurance",
    verifypatch: "patchassurance",
    verifier: "patchassurance",
    processjudge: "processjudge",
    storyprocessjudge: "processjudge",
  };
  return aliases[phase] || phase;
}

function gitIsAncestor(repo, ancestor, descendant) {
  return cp.spawnSync("git", ["merge-base", "--is-ancestor", ancestor, descendant], {
    cwd: repo,
    stdio: "ignore",
  }).status === 0;
}

function applicationChangedSince(repo, fromCommit, toCommit = "HEAD") {
  try {
    const output = runGit(repo, ["diff", "--name-only", `${fromCommit}..${toCommit}`]);
    return output.split(/\r?\n/).filter(Boolean).filter((filePath) => !isControlPath(filePath));
  } catch {
    return ["<invalid-commit-range>"];
  }
}

function testPath(filePath) {
  return /(^|\/)(__tests__|tests?|specs?)(\/|$)|(\.|-)(test|spec)\.[cm]?[jt]sx?$|Test\.(php|py|rb|cs)$/i.test(String(filePath || ""));
}

function inferredSurfaces(paths) {
  const surfaces = new Set();
  for (const filePath of paths) {
    if (/(^|\/)(components|pages|screens|views|ui|frontend)(\/|$)|\.(tsx|jsx|vue|svelte)$/i.test(filePath)) surfaces.add("ui");
    if (/(^|\/)(mobile|ios|android)(\/|$)|\.(swift|kt)$/i.test(filePath)) surfaces.add("mobile");
    if (/(^|\/)(routes|controllers|api|http|server)(\/|$)|route|controller/i.test(filePath)) surfaces.add("api");
    if (/webhook/i.test(filePath)) surfaces.add("webhook");
    if (/(^|\/)(jobs|workers)(\/|$)|job/i.test(filePath)) surfaces.add("job");
    if (/(^|\/)(queues|queue)(\/|$)/i.test(filePath)) surfaces.add("queue");
    if (/(^|\/)(scheduler|cron)(\/|$)|schedule/i.test(filePath)) surfaces.add("scheduler");
    if (/(^|\/)(migrations|database|schema)(\/|$)/i.test(filePath)) surfaces.add("database");
    if (/(^|\/)(config|configs)(\/|$)|\.ya?ml$|\.toml$|\.env/i.test(filePath)) surfaces.add("config");
    if (/(^|\/)(cli|bin|commands?)(\/|$)|command/i.test(filePath)) surfaces.add("cli");
    if (/(^|\/)(lib|src|packages|modules)(\/|$)/i.test(filePath) && !surfaces.size) surfaces.add("library");
  }
  return [...surfaces];
}

function scopePatternMatches(pattern, filePath) {
  const escaped = String(pattern).replace(/[.+^$()|\\]/g, "\\$&")
    .replaceAll("**", "\u0000").replaceAll("*", "[^/]*").replaceAll("?", "[^/]")
    .replaceAll("\u0000", ".*");
  return new RegExp(`^${escaped}$`).test(filePath);
}

function scopeAllows(allowedPaths, filePath) {
  return allowedPaths.some((pattern) => pattern === filePath || scopePatternMatches(pattern, filePath));
}

function writeReviewScope(opts) {
  const activeRun = activeV3Run(opts.repo);
  if (activeRun.runtimeContract !== "capsule-supervisor-v1" || activeRun.scopeUnit !== "story"
    || canonicalGatePhase(activeRun.activePhase) !== "codereview") {
    throw new Error("review-scope requires an active story code review under capsule-supervisor-v1");
  }
  const target = activeRun.workerScopePath
    ? path.resolve(opts.repo, activeRun.workerScopePath)
    : path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json");
  if (!fs.existsSync(target)) throw new Error("review-scope requires the active worker scope");
  const scope = parseWorkerScope(target);
  if (scope.runId !== activeRun.runId
    || normalizedScope(scope.activeStory) !== normalizedScope(activeRun.activeStory)) {
    throw new Error("review-scope active run and worker scope do not match");
  }
  const productionPaths = applicationChangedSince(opts.repo, scope.baseRef, "HEAD").filter((filePath) => !testPath(filePath));
  const outsideScope = productionPaths.filter((filePath) => !scopeAllows(scope.allowedPaths, filePath));
  if (!productionPaths.length || outsideScope.length) {
    throw new Error(`review-scope requires non-test changes inside the frozen scope; outside=${outsideScope.join(", ") || "none"}`);
  }
  const surfaces = inferredSurfaces(productionPaths);
  if (!surfaces.length) surfaces.push("internal");
  const record = { ...scope, phase: activeRun.activePhase, surfaces };
  const serialized = `${JSON.stringify(record, null, 2)}\n`;
  if (fs.readFileSync(target, "utf8") === serialized) {
    console.log(`UNCHANGED review-scope ${relative(opts.repo, target)} surfaces=${surfaces.join(",")}`);
    return;
  }
  atomicJson(target, record, { overwrite: true, validate: parseWorkerScope });
  console.log(`WROTE review-scope ${relative(opts.repo, target)} surfaces=${surfaces.join(",")}`);
}

function normalizedScopePaths(paths) {
  return [...new Set((paths || []).map((entry) => String(entry || "").replaceAll("\\", "/")))].sort().map((entry) => {
    if (!entry || path.isAbsolute(entry) || entry.split("/").includes("..") || isControlPath(entry)) {
      throw new Error(`invalid story scope path ${entry || "(empty)"}`);
    }
    return entry;
  });
}

function applicationTreeDigest(repo, commit = "HEAD", scopePaths = null) {
  if (scopePaths) {
    const normalized = normalizedScopePaths(scopePaths);
    return sha256(normalized.map((filePath) => {
      const entry = runGit(repo, ["ls-tree", "--full-tree", commit, "--", filePath]);
      return `${filePath}\0${entry || "<missing>"}`;
    }).join("\n"));
  }
  const output = runGit(repo, ["ls-tree", "-r", "--full-tree", commit]);
  const applicationEntries = output.split(/\r?\n/).filter(Boolean).filter((line) => {
    const filePath = line.slice(line.indexOf("\t") + 1);
    return !isControlPath(filePath);
  });
  return sha256(applicationEntries.join("\n"));
}

function gateEvidence(repo, evidenceId, scope, { enforceScope = true } = {}) {
  const evidence = parseEvidenceManifest(evidencePath(repo, evidenceId));
  if (enforceScope && normalizedScope(evidence.story) !== normalizedScope(scope)) {
    throw new Error(`gate evidence ${evidenceId} belongs to ${evidence.story}, not ${scope}`);
  }
  const rawPath = path.resolve(repo, evidence.rawArtifact.path);
  if (!fs.existsSync(rawPath) || sha256(fs.readFileSync(rawPath)) !== evidence.rawArtifact.sha256) {
    throw new Error(`Evidence ${evidenceId} raw artifact hash mismatch`);
  }
  if (evidence.runnerProof?.schema !== "acef-evidence-runner-proof-v1"
    || evidence.runnerProof?.runner !== "acef-state evidence-run"
    || evidence.runnerProof?.sha256 !== evidenceRunnerProof(evidence)) {
    throw new Error(`Evidence ${evidenceId} runner proof mismatch`);
  }
  return evidence;
}

function parseUnresolvedFindings(entries) {
  return entries.map((entry) => {
    const [rawSeverity, ...idParts] = String(entry).split(":");
    const severity = rawSeverity.toUpperCase();
    const id = idParts.join(":");
    if (!["LOW", "MEDIUM", "HIGH", "CRITICAL"].includes(severity) || !id) {
      throw new Error("--unresolved-finding must be LOW|MEDIUM|HIGH|CRITICAL:id");
    }
    return { severity, id };
  });
}

function priorDeterministicStoryGates(repo, scope, activeRun) {
  const gateDir = path.join(repo, "docs", "ai", "gates");
  if (!fs.existsSync(gateDir)) return [];
  const records = [];
  for (const fileName of fs.readdirSync(gateDir).filter((name) => name.endsWith(".json")).sort()) {
    const filePath = path.join(gateDir, fileName);
    let gate;
    try {
      gate = parseGateVerdict(filePath);
    } catch (error) {
      throw new Error(`cannot compute deterministic repair cycle with invalid gate ${fileName}: ${error.message}`);
    }
    if (gate.gateType !== "deterministic-story-close-v3" || gate.runId !== activeRun.runId
      || gate.fullFlowContract !== activeRun.fullFlowContract || normalizedScope(gate.scope) !== normalizedScope(scope)) continue;
    records.push({ gate, fileName });
  }
  return records.sort((left, right) => {
    if (left.gate.reviewCycle !== right.gate.reviewCycle) return left.gate.reviewCycle - right.gate.reviewCycle;
    const timeOrder = String(left.gate.createdAt || "").localeCompare(String(right.gate.createdAt || ""));
    return timeOrder || left.fileName.localeCompare(right.fileName);
  });
}

function boundReviewReport(repo, actor, expectedPhase, scope, activeRun) {
  if (!actor.producedArtifactPath) throw new Error(`${expectedPhase} actor requires producedArtifactPath for v3 close`);
  const reportPath = path.resolve(repo, actor.producedArtifactPath);
  const relativePath = relative(repo, reportPath);
  if (!relativePath || relativePath.startsWith("..") || path.isAbsolute(relativePath) || !fs.existsSync(reportPath)) {
    throw new Error(`${expectedPhase} review report path is missing or escapes the repository`);
  }
  const reportHash = sha256(fs.readFileSync(reportPath));
  if (reportHash !== actor.producedArtifactHash) throw new Error(`${expectedPhase} review report hash does not match actor record`);
  const report = parseReviewReport(reportPath);
  if (report.actorInstanceId !== actor.actorInstanceId
    || report.runId !== activeRun.runId
    || report.fullFlowContract !== activeRun.fullFlowContract
    || actor.runId !== activeRun.runId
    || actor.fullFlowContract !== activeRun.fullFlowContract
    || normalizedScope(report.story) !== normalizedScope(scope)
    || canonicalGatePhase(report.phase) !== expectedPhase
    || report.inputCommit !== actor.inputCommit
    || report.inputTree !== actor.inputTree) {
    throw new Error(`${expectedPhase} review report identity/scope/input binding mismatch`);
  }
  if (activeRun.runtimeContract === "capsule-supervisor-v1") {
    if (!report.capsulePath || !report.capsuleSha256) throw new Error(`${expectedPhase} review report is missing capsule binding`);
    const capsulePath = path.resolve(repo, report.capsulePath);
    const capsuleRelative = relative(repo, capsulePath).replaceAll(path.sep, "/");
    if (!/^docs\/ai\/capsules\/[^/]+\.json$/.test(capsuleRelative) || !fs.existsSync(capsulePath)
      || sha256(fs.readFileSync(capsulePath)) !== report.capsuleSha256) {
      throw new Error(`${expectedPhase} review report capsule path/hash binding mismatch`);
    }
    const capsule = parseAssuranceCapsule(capsulePath);
    validateCapsuleIntegrity(repo, capsule);
    if (capsule.actorInstanceId !== actor.actorInstanceId || capsule.inputCommit !== report.inputCommit
      || capsule.inputTree !== report.inputTree) {
      throw new Error(`${expectedPhase} review report capsule actor/input binding mismatch`);
    }
  }
  return { report, path: relativePath, hash: reportHash };
}

function derivedReviewDispositions(codeReviewReport, patchAssuranceReport) {
  const findings = new Map();
  for (const report of [codeReviewReport, patchAssuranceReport]) {
    for (const finding of report.findings) {
      if (findings.has(finding.id)) throw new Error(`duplicate review finding id across reports: ${finding.id}`);
      findings.set(finding.id, finding);
    }
  }
  return [...findings.values()].map((finding) => {
    const disposition = { id: finding.id, severity: finding.severity, status: finding.status };
    if (finding.reason) disposition.reason = finding.reason;
    if (finding.approvalId) disposition.approvalId = finding.approvalId;
    return disposition;
  }).sort((left, right) => left.id.localeCompare(right.id));
}

function writeDeterministicStoryCloseGate(opts, activeRun) {
  required(opts, [
    "id", "scope", "atddActor", "developmentActor", "codeReviewActor", "patchAssuranceActor",
    "redEvidence", "greenEvidence",
  ]);
  if (normalizedScope(opts.scope) !== normalizedScope(activeRun.activeStory)) {
    throw new Error(`gate scope ${opts.scope} does not match active story ${activeRun.activeStory}`);
  }
  const actorIds = {
    atdd: opts.atddActor,
    development: opts.developmentActor,
    codeReview: opts.codeReviewActor,
    patchAssurance: opts.patchAssuranceActor,
  };
  const actors = Object.fromEntries(Object.entries(actorIds).map(([role, id]) => [role, parseActorRecord(actorPath(opts.repo, id))]));
  const expectedPhases = { atdd: "atdd", development: "development", codeReview: "codereview", patchAssurance: "patchassurance" };
  const failures = [];
  const actorSeparation = new Set(Object.values(actorIds)).size === 4;
  if (!actorSeparation) failures.push("four story-close actors are not distinct");
  let scopeBinding = true;
  for (const [role, actor] of Object.entries(actors)) {
    if (actor.runId !== activeRun.runId || actor.fullFlowContract !== activeRun.fullFlowContract) {
      scopeBinding = false;
      failures.push(`${role} actor run/contract binding mismatch`);
    }
    if (JSON.stringify(actor.storyInventory) !== JSON.stringify(activeRun.expectedStories)) {
      scopeBinding = false;
      failures.push(`${role} actor frozen story inventory mismatch`);
    }
    if (normalizedScope(actor.story) !== normalizedScope(opts.scope)) {
      scopeBinding = false;
      failures.push(`${role} actor belongs to ${actor.story}`);
    }
    if (canonicalGatePhase(actor.phase) !== expectedPhases[role]) {
      scopeBinding = false;
      failures.push(`${role} actor phase is ${actor.phase}`);
    }
  }

  const red = gateEvidence(opts.repo, opts.redEvidence, opts.scope);
  const green = gateEvidence(opts.repo, opts.greenEvidence, opts.scope);
  const head = gitCommit(opts.repo);
  const tree = gitTree(opts.repo);
  const priorGates = priorDeterministicStoryGates(opts.repo, opts.scope, activeRun);
  const priorGate = priorGates.length ? priorGates.at(-1).gate : null;
  const previousCycle = priorGate ? priorGate.reviewCycle : -1;
  if (previousCycle >= 2) {
    throw new Error("deterministic story close exhausted two repair cycles; REPLAN/SPLIT is required before another gate attempt");
  }
  if (priorGate && priorGate.verdict !== "REVISE") {
    throw new Error(`deterministic ${priorGate.verdict} gate is terminal; a repair gate may follow only REVISE`);
  }
  const reviewCycle = previousCycle + 1;
  if (opts.reviewCycle !== undefined && Number(opts.reviewCycle) !== reviewCycle) {
    throw new Error(`--review-cycle is mechanically derived as ${reviewCycle}; caller supplied ${opts.reviewCycle}`);
  }
  const redParent = runGit(opts.repo, ["rev-parse", `${red.repositoryCommit}^`]);
  const derivedScopePaths = normalizedScopePaths(applicationChangedSince(opts.repo, redParent, head));
  const scopePaths = reviewCycle > 0 ? normalizedScopePaths(priorGate.scopePaths) : derivedScopePaths;
  const scopeExpanded = reviewCycle > 0 && derivedScopePaths.some((filePath) => !scopePaths.includes(filePath));
  if (!scopePaths.length) failures.push("story scope has no application/test paths");
  if (scopeExpanded) {
    failures.push("repair expanded the frozen story scope");
  }
  const applicationTree = applicationTreeDigest(opts.repo, head, scopePaths);
  const redGreenChronology = red.exitCode !== 0
    && green.exitCode === 0
    && red.actorInstanceId === actorIds.atdd
    && [actorIds.development, actorIds.patchAssurance].includes(green.actorInstanceId)
    && red.command === green.command
    && gitIsAncestor(opts.repo, red.repositoryCommit, green.repositoryCommit)
    && (!red.finishedAt || !green.startedAt || new Date(red.finishedAt) <= new Date(green.startedAt));
  if (!redGreenChronology) failures.push("red-to-green evidence chronology or actor binding failed");
  let atddTestOnlyRed = false;
  try {
    const redPaths = applicationChangedSince(opts.repo, redParent, red.repositoryCommit);
    const redRaw = fs.readFileSync(path.resolve(opts.repo, red.rawArtifact.path), "utf8");
    const redSources = redPaths.map((filePath) => ({ filePath, source: runGit(opts.repo, ["show", `${red.repositoryCommit}:${filePath}`]) }));
    const greenSources = redPaths.map((filePath) => ({ filePath, source: runGit(opts.repo, ["show", `${green.repositoryCommit}:${filePath}`]) }));
    atddTestOnlyRed = redPaths.length > 0
      && redPaths.every(testPath)
      && red.repositoryTree === gitTreeAt(opts.repo, red.repositoryCommit)
      && gitIsAncestor(opts.repo, red.repositoryCommit, actors.development.inputCommit)
      && !atddRedExecutionFailure(red, redRaw, redPaths)
      && !atddTestSourceAuthenticityFailure(redSources)
      && !atddGreenTestContinuityFailure(redSources, greenSources);
  } catch {
    atddTestOnlyRed = false;
  }
  if (!atddTestOnlyRed) failures.push("ATDD red evidence must bind a failing test-only commit that precedes Development");

  // The deterministic close package is the durable red-to-green chain, not only
  // the final green receipt. Always cite both so package/experiment validators
  // can require both manifests and raw artifacts to be committed unchanged.
  const closingEvidenceIds = [...new Set([opts.redEvidence, opts.greenEvidence, ...opts.evidence])];
  let runnerProof = true;
  for (const evidenceId of closingEvidenceIds) {
    const evidence = gateEvidence(opts.repo, evidenceId, opts.scope);
    const expectedRed = evidenceId === opts.redEvidence;
    if ((!expectedRed && evidence.exitCode !== 0)
      || (expectedRed && evidence.exitCode === 0)
      || (!expectedRed && applicationChangedSince(opts.repo, evidence.repositoryCommit, head).some((filePath) => scopePaths.includes(filePath)))
      || (evidence.dirtyApplicationPathsBefore || []).length
      || (evidence.dirtyApplicationPathsAfter || []).length) {
      runnerProof = false;
      failures.push(`closing evidence ${evidenceId} is failed, dirty, or stale for application tree ${applicationTree}`);
    }
  }
  if (activeRun.runtimeContract === "capsule-supervisor-v1"
    && (!green.discovery || !green.discovery.expectedTests?.length
      || green.discovery.expectedTests.some((test) => !green.discovery.discoveredTests?.includes(test)))) {
    runnerProof = false;
    failures.push("green evidence is missing the frozen test-discovery contract required by capsule-supervisor-v1");
  }

  const finalTreeReview = gitIsAncestor(opts.repo, actors.codeReview.inputCommit, head)
    && applicationChangedSince(opts.repo, actors.codeReview.inputCommit, head)
      .filter((filePath) => scopePaths.includes(filePath) && !testPath(filePath)).length === 0;
  const patchAssurance = gitIsAncestor(opts.repo, actors.patchAssurance.inputCommit, head)
    && actors.patchAssurance.inputTree === gitTreeAt(opts.repo, actors.patchAssurance.inputCommit)
    && applicationTreeDigest(opts.repo, actors.patchAssurance.inputCommit, scopePaths) === applicationTree
    && applicationChangedSince(opts.repo, actors.patchAssurance.inputCommit, head)
      .filter((filePath) => scopePaths.includes(filePath)).length === 0;
  if (!finalTreeReview) failures.push("code-review actor did not inspect the final application tree");
  if (!patchAssurance) failures.push("patch-assurance actor did not inspect the final application tree");

  const codeReviewBinding = boundReviewReport(opts.repo, actors.codeReview, "codereview", opts.scope, activeRun);
  const patchAssuranceBinding = boundReviewReport(opts.repo, actors.patchAssurance, "patchassurance", opts.scope, activeRun);
  const reportHashes = { codeReview: codeReviewBinding.hash, patchAssurance: patchAssuranceBinding.hash };
  const reportPaths = { codeReview: codeReviewBinding.path, patchAssurance: patchAssuranceBinding.path };
  if (opts.codeReviewReportHash && opts.codeReviewReportHash !== reportHashes.codeReview) throw new Error("--code-review-report-hash does not match bound review report");
  if (opts.patchAssuranceReportHash && opts.patchAssuranceReportHash !== reportHashes.patchAssurance) throw new Error("--patch-assurance-report-hash does not match bound assurance report");
  const hashBinding = true;

  const findingDispositions = derivedReviewDispositions(codeReviewBinding.report, patchAssuranceBinding.report);
  const unresolvedFindings = findingDispositions
    .filter((finding) => finding.status === "OPEN")
    .map(({ severity, id }) => ({ severity, id }));
  if (opts.unresolvedFinding.length) {
    const claimed = parseUnresolvedFindings(opts.unresolvedFinding).sort((left, right) => left.id.localeCompare(right.id));
    if (JSON.stringify(claimed) !== JSON.stringify(unresolvedFindings)) {
      throw new Error("--unresolved-finding does not match findings derived from bound review reports");
    }
  }
  const findingsResolved = unresolvedFindings.length === 0
    && codeReviewBinding.report.verdict === "PASS"
    && patchAssuranceBinding.report.verdict === "PASS";
  if (!findingsResolved) failures.push(`unresolved findings remain: ${unresolvedFindings.map((finding) => `${finding.severity}:${finding.id}`).join(", ")}`);
  if (dirtyApplicationPaths(opts.repo).length) {
    runnerProof = false;
    failures.push("working tree contains uncommitted application paths");
  }

  let processJudge;
  if (opts.judgeTrigger || opts.processJudgeActor) {
    required(opts, ["judgeTrigger", "processJudgeActor", "judgeDecision"]);
    if (!["ambiguity", "waiver", "evidence-conflict", "gate-anomaly"].includes(opts.judgeTrigger)) {
      throw new Error("--judge-trigger must be ambiguity, waiver, evidence-conflict, or gate-anomaly");
    }
    const judge = parseActorRecord(actorPath(opts.repo, opts.processJudgeActor));
    if (normalizedScope(judge.story) !== normalizedScope(opts.scope)
      || canonicalGatePhase(judge.phase) !== "processjudge"
      || Object.values(actorIds).includes(opts.processJudgeActor)) {
      throw new Error("conditional Process Judge must be a distinct process-judge actor for the active story");
    }
    const decisionPath = path.resolve(opts.repo, opts.judgeDecision);
    const relativeDecisionPath = relative(opts.repo, decisionPath);
    if (!relativeDecisionPath || relativeDecisionPath.startsWith("..") || !fs.existsSync(decisionPath)) throw new Error("--judge-decision must be an existing repository file");
    const decisionSha256 = sha256(fs.readFileSync(decisionPath));
    const decision = parseProcessJudgeDecision(decisionPath);
    const expectedJudgeVerdict = opts.judgeTrigger === "waiver" ? "APPROVE_WAIVER" : "ACKNOWLEDGE";
    if (decision.runId !== activeRun.runId || decision.fullFlowContract !== activeRun.fullFlowContract
      || normalizedScope(decision.story) !== normalizedScope(opts.scope) || decision.trigger !== opts.judgeTrigger
      || decision.actorId !== opts.processJudgeActor || decision.gateId !== opts.id
      || JSON.stringify(decision.evidenceIds) !== JSON.stringify(closingEvidenceIds)
      || decision.verdict !== expectedJudgeVerdict) {
      throw new Error("conditional Process Judge decision run/gate/trigger/evidence binding mismatch");
    }
    processJudge = { trigger: opts.judgeTrigger, actorId: opts.processJudgeActor, decisionPath: relativeDecisionPath, decisionSha256, verdict: decision.verdict };
  }
  const deferredFindings = findingDispositions.filter((finding) => finding.status === "DEFERRED");
  if (deferredFindings.length) {
    if (processJudge?.trigger !== "waiver") throw new Error("DEFERRED findings require a conditional Story Process Judge with --judge-trigger waiver");
    for (const finding of deferredFindings) {
      const approval = parseApproval(path.join(opts.repo, "docs", "ai", "approvals", `${safeId(finding.approvalId, "finding approval id")}.json`));
      if (approval.actorType !== "human" || approval.decision !== "ACCEPT_RISK" || normalizedScope(approval.scope) !== normalizedScope(opts.scope)) {
        throw new Error(`DEFERRED finding ${finding.id} requires a human ACCEPT_RISK approval scoped to ${opts.scope}`);
      }
    }
  }

  const executedChecks = {
    actorSeparation,
    atddTestOnlyRed,
    redGreenChronology,
    finalTreeReview,
    patchAssurance,
    findingsResolved,
    runnerProof,
    scopeBinding,
    hashBinding,
  };
  const mechanicalPass = Object.values(executedChecks).every(Boolean);
  let repair;
  if (reviewCycle > 0) {
    if (priorGate.actors?.development !== actorIds.development) {
      throw new Error(`repair cycle ${reviewCycle} must reactivate original Developer ${priorGate.actors?.development || "missing"}`);
    }
    required(opts, ["repairReceipt"]);
    const receiptPath = path.resolve(opts.repo, opts.repairReceipt);
    const relativeReceiptPath = relative(opts.repo, receiptPath);
    if (!relativeReceiptPath || relativeReceiptPath.startsWith("..") || !fs.existsSync(receiptPath)) throw new Error("--repair-receipt must be an existing repository file");
    const receiptSha256 = sha256(fs.readFileSync(receiptPath));
    const receipt = parseDeveloperRepair(receiptPath);
    const findingsSha256 = sha256(JSON.stringify(priorGate.unresolvedFindings || []));
    if (receipt.runId !== activeRun.runId || receipt.fullFlowContract !== activeRun.fullFlowContract
      || normalizedScope(receipt.story) !== normalizedScope(opts.scope) || receipt.cycle !== reviewCycle
      || receipt.priorGateId !== priorGate.gateId || receipt.findingsSha256 !== findingsSha256
      || receipt.developerActorId !== actorIds.development || receipt.developerSessionId !== actors.development.sessionId
      || receipt.preCommit !== priorGate.applicationCommit || receipt.preTree !== priorGate.applicationTree
      || receipt.postTree !== applicationTree
      || !gitIsAncestor(opts.repo, receipt.preCommit, receipt.postCommit)
      || !gitIsAncestor(opts.repo, receipt.postCommit, head)
      || applicationChangedSince(opts.repo, receipt.preCommit, receipt.postCommit)
        .filter((filePath) => scopePaths.includes(filePath)).length === 0
      || applicationChangedSince(opts.repo, receipt.postCommit, head)
        .filter((filePath) => scopePaths.includes(filePath)).length !== 0) {
      throw new Error("Developer repair receipt run/findings/session/commit/tree binding mismatch");
    }
    repair = { cycle: reviewCycle, priorGateId: priorGate.gateId, developerActorId: actorIds.development, receiptPath: relativeReceiptPath, receiptSha256 };
  }
  const verdict = mechanicalPass ? "PASS" : (scopeExpanded || reviewCycle >= 2 ? "REPLAN" : "REVISE");
  if (opts.verdict && opts.verdict !== verdict) {
    throw new Error(`requested verdict ${opts.verdict} cannot override computed verdict ${verdict}: ${failures.join("; ")}`);
  }
  const record = {
    gateId: opts.id,
    runId: activeRun.runId,
    fullFlowContract: activeRun.fullFlowContract,
    storyInventory: activeRun.expectedStories,
    gateType: "deterministic-story-close-v3",
    decisionMode: "deterministic",
    scope: opts.scope,
    verdict,
    decidedBy: "acef-story-close-v3",
    repositoryCommit: head,
    repositoryTree: tree,
    applicationCommit: head,
    applicationTree,
    scopePaths,
    validatorVersion: "acef-story-close-v3.0.0",
    actors: actorIds,
    redEvidenceId: opts.redEvidence,
    greenEvidenceId: opts.greenEvidence,
    executedChecks,
    reviewCycle,
    ...(repair ? { repair } : {}),
    unresolvedFindings,
    findingDispositions,
    reportHashes,
    reportPaths,
    ...(processJudge ? { processJudge } : {}),
    evidenceIds: closingEvidenceIds,
    surfaceEvidence: parseSurfaceEvidence(opts.surfaceEvidence),
    inputOutputEvidence: parseBindingEvidence(opts.bindingEvidence),
    notes: [opts.notes, ...failures].filter(Boolean).join("; ") || null,
    createdAt: new Date().toISOString(),
  };
  const target = path.join(opts.repo, "docs", "ai", "gates", `${safeId(opts.id, "gate id")}.json`);
  atomicJson(target, record, { validate: parseGateVerdict });
  console.log(`WROTE deterministic story-close gate ${relative(opts.repo, target)} verdict=${verdict}`);
}

function writeLegacyGate(opts) {
  required(opts, ["id", "scope", "verdict", "decidedBy"]);
  const activeRunPath = path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  const activeRun = fs.existsSync(activeRunPath) ? parseActiveRun(activeRunPath) : null;
  const judge = parseActorRecord(actorPath(opts.repo, opts.decidedBy));
  if (activeRun?.fullFlowContract === "four-actor-v3"
    && (judge.runId !== activeRun.runId || judge.fullFlowContract !== activeRun.fullFlowContract
      || JSON.stringify(judge.storyInventory) !== JSON.stringify(activeRun.expectedStories)
      || normalizedScope(judge.story) !== normalizedScope(opts.scope))) {
    throw new Error("four-actor-v3 Epic gate actor must bind the active run/contract/scope");
  }
  if (/^\s*story\b/i.test(opts.scope) && normalizedScope(judge.story) !== normalizedScope(opts.scope)) {
    throw new Error(`gate actor ${opts.decidedBy} belongs to ${judge.story}, not ${opts.scope}`);
  }
  if (opts.verdict === "PASS" && !opts.evidence.length) throw new Error("PASS gate requires at least one --evidence id");
  for (const evidenceId of opts.evidence) {
    const evidence = gateEvidence(opts.repo, evidenceId, opts.scope, { enforceScope: /^\s*story\b/i.test(opts.scope) });
    if (opts.verdict === "PASS" && evidence.exitCode !== 0) throw new Error(`PASS gate cannot cite failed evidence ${evidenceId}`);
  }
  const record = {
    gateId: opts.id,
    ...(activeRun?.fullFlowContract === "four-actor-v3"
      ? { runId: activeRun.runId, fullFlowContract: activeRun.fullFlowContract, storyInventory: activeRun.expectedStories }
      : {}),
    gateType: "actor-decided-v1",
    decisionMode: "actor",
    scope: opts.scope,
    verdict: opts.verdict,
    decidedBy: opts.decidedBy,
    repositoryCommit: gitCommit(opts.repo),
    repositoryTree: gitTree(opts.repo),
    evidenceIds: opts.evidence,
    surfaceEvidence: parseSurfaceEvidence(opts.surfaceEvidence),
    inputOutputEvidence: parseBindingEvidence(opts.bindingEvidence),
    notes: opts.notes || null,
    createdAt: new Date().toISOString(),
  };
  if (activeRun?.fullFlowContract === "four-actor-v3" && activeRun.scopeUnit === "epic") {
    const storyGates = [];
    const gateDir = path.join(opts.repo, "docs", "ai", "gates");
    if (fs.existsSync(gateDir)) {
      for (const fileName of fs.readdirSync(gateDir).filter((name) => name.endsWith(".json"))) {
        const candidate = parseGateVerdict(path.join(gateDir, fileName));
        if (candidate.gateType === "deterministic-story-close-v3"
          && candidate.runId === activeRun.runId && candidate.fullFlowContract === activeRun.fullFlowContract) storyGates.push(candidate);
      }
    }
    const byStory = new Map();
    for (const candidate of storyGates) {
      const key = normalizedScope(candidate.scope);
      if (!byStory.has(key)) byStory.set(key, []);
      byStory.get(key).push(candidate);
    }
    const expectedKeys = new Map((activeRun.expectedStories || []).map((story) => [normalizedScope(story), story]));
    const missingStories = [...expectedKeys].filter(([key]) => !byStory.has(key)).map(([, story]) => story);
    const unexpectedStories = [...byStory].filter(([key]) => !expectedKeys.has(key)).map(([, entries]) => entries[0].scope);
    if (unexpectedStories.length || (opts.verdict === "PASS" && missingStories.length)) {
      throw new Error(`Epic story inventory mismatch; missing=${missingStories.join(", ") || "none"}; unexpected=${unexpectedStories.join(", ") || "none"}`);
    }
    record.missingStories = missingStories;
    record.storyGateVerdicts = {};
    for (const [key, story] of expectedKeys) {
      const entries = byStory.get(key);
      if (!entries) {
        record.storyGateVerdicts[story] = "MISSING";
        continue;
      }
      entries.sort((left, right) => left.reviewCycle - right.reviewCycle);
      const passes = entries.filter((candidate) => candidate.verdict === "PASS");
      record.storyGateVerdicts[story] = entries.at(-1).verdict;
      if (opts.verdict === "PASS" && (passes.length !== 1 || entries.at(-1).verdict !== "PASS")) {
        throw new Error(`${story} must have exactly one terminal deterministic PASS before Epic close`);
      }
      if (opts.verdict === "PASS" && !record.evidenceIds.includes(passes[0].greenEvidenceId)) {
        throw new Error(`Epic close must aggregate ${passes[0].scope} green evidence ${passes[0].greenEvidenceId}`);
      }
    }
  }
  const target = path.join(opts.repo, "docs", "ai", "gates", `${safeId(opts.id, "gate id")}.json`);
  atomicJson(target, record, { validate: parseGateVerdict });
  console.log(`WROTE gate ${relative(opts.repo, target)} verdict=${opts.verdict}`);
}

function activeV3Run(repo) {
  const activeRunPath = path.join(repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  if (!fs.existsSync(activeRunPath)) throw new Error("four-actor-v3 artifact writer requires docs/ai/ACEF_ACTIVE_RUN.json");
  const activeRun = parseActiveRun(activeRunPath);
  if (activeRun.status !== "active" || activeRun.fullFlowContract !== "four-actor-v3") {
    throw new Error("artifact writer requires an active four-actor-v3 run");
  }
  return activeRun;
}

function writePhaseTransition(opts) {
  required(opts, ["phase"]);
  const activeRun = activeV3Run(opts.repo);
  if (activeRun.runtimeContract !== "capsule-supervisor-v1" || activeRun.scopeUnit !== "story") {
    throw new Error("phase-transition requires an active capsule-supervisor story run");
  }
  const current = canonicalGatePhase(activeRun.activePhase);
  const requested = canonicalGatePhase(opts.phase);
  const allowed = (current === "readiness" && requested === "atdd")
    || (current === "atdd" && requested === "development")
    || (current === "development" && requested === "codereview");
  if (!allowed) throw new Error(`invalid capsule-supervisor phase transition ${activeRun.activePhase} -> ${opts.phase}`);
  let workerScopeTransition = null;
  let workerScopeTarget = null;
  if (current === "atdd" && requested === "development") {
    workerScopeTarget = activeRun.workerScopePath
      ? path.resolve(opts.repo, activeRun.workerScopePath)
      : path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json");
    if (!fs.existsSync(workerScopeTarget)) throw new Error("ATDD to Development requires the typed active worker scope");
    const workerScope = parseWorkerScope(workerScopeTarget);
    if (workerScope.runId !== activeRun.runId
      || normalizedScope(workerScope.activeStory) !== normalizedScope(activeRun.activeStory)) {
      throw new Error("ATDD to Development worker scope does not match the active run/story");
    }
    const storyToken = String(activeRun.activeStory).toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");
    workerScopeTransition = {
      ...workerScope,
      phase: "development",
      workerId: `acef_${storyToken}_development`,
      createdAt: new Date().toISOString(),
    };
  }
  const target = path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  const { lane: _compatibilityLane, ...storedRun } = activeRun;
  const record = { ...storedRun, activePhase: opts.phase, updatedAt: new Date().toISOString() };
  atomicJson(target, record, { overwrite: true, validate: parseActiveRun });
  if (workerScopeTransition) {
    atomicJson(workerScopeTarget, workerScopeTransition, { overwrite: true, validate: parseWorkerScope });
  }
  console.log(`WROTE phase-transition ${activeRun.activePhase} -> ${opts.phase}`);
}

function writeStoryTransition(opts) {
  const activeRun = activeV3Run(opts.repo);
  if (activeRun.runtimeContract !== "capsule-supervisor-v1" || activeRun.scopeUnit !== "story"
    || canonicalGatePhase(activeRun.activePhase) !== "codereview") {
    throw new Error("story-transition requires an active capsule-supervisor story in code-review");
  }
  const gates = priorDeterministicStoryGates(opts.repo, activeRun.activeStory, activeRun);
  const latest = gates.at(-1)?.gate;
  if (!latest || latest.verdict !== "PASS") {
    throw new Error("story-transition requires the active story's terminal deterministic PASS gate");
  }
  const storyIndex = activeRun.expectedStories.findIndex((story) => normalizedScope(story) === normalizedScope(activeRun.activeStory));
  if (storyIndex < 0) throw new Error("active story is absent from the frozen expectedStories inventory");
  const nextStory = activeRun.expectedStories[storyIndex + 1];
  const target = path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  const { lane: _compatibilityLane, ...storedRun } = activeRun;
  const record = nextStory
    ? {
      ...storedRun,
      scopeUnit: "story",
      activeStory: nextStory,
      activePhase: "atdd",
      workerRole: null,
      activeActorId: null,
      nextAllowedStep: "refresh current context and worker scope for the frozen next story",
      updatedAt: new Date().toISOString(),
    }
    : {
      ...storedRun,
      scopeUnit: "epic",
      activeStory: activeRun.activeEpic || "Epic closeout",
      activePhase: "epic-process-judge",
      workerRole: "epic-process-judge",
      activeActorId: null,
      nextAllowedStep: "run final integration verification, then dispatch the epic Process Judge",
      updatedAt: new Date().toISOString(),
    };
  atomicJson(target, record, { overwrite: true, validate: parseActiveRun });
  console.log(nextStory
    ? `WROTE story-transition ${activeRun.activeStory} -> ${nextStory}`
    : `WROTE story-transition ${activeRun.activeStory} -> ${record.activeStory}`);
}

function writeDeveloperRepair(opts) {
  required(opts, ["id", "priorGate", "developerActor"]);
  const activeRun = activeV3Run(opts.repo);
  const priorPath = path.join(opts.repo, "docs", "ai", "gates", `${safeId(opts.priorGate, "prior gate id")}.json`);
  const priorGate = parseGateVerdict(priorPath);
  const developer = parseActorRecord(actorPath(opts.repo, opts.developerActor));
  const cycle = priorGate.reviewCycle + 1;
  const postCommit = gitCommit(opts.repo);
  const scopePaths = normalizedScopePaths(priorGate.scopePaths);
  const postTree = applicationTreeDigest(opts.repo, postCommit, scopePaths);
  if (priorGate.gateType !== "deterministic-story-close-v3" || priorGate.verdict !== "REVISE"
    || priorGate.runId !== activeRun.runId || priorGate.fullFlowContract !== activeRun.fullFlowContract
    || normalizedScope(priorGate.scope) !== normalizedScope(activeRun.activeStory)
    || priorGate.actors?.development !== developer.actorInstanceId
    || developer.runId !== activeRun.runId || developer.fullFlowContract !== activeRun.fullFlowContract
    || !developer.sessionId || cycle < 1 || cycle > 2
    || !gitIsAncestor(opts.repo, priorGate.applicationCommit, postCommit)
    || applicationChangedSince(opts.repo, priorGate.applicationCommit, postCommit)
      .filter((filePath) => scopePaths.includes(filePath)).length === 0) {
    throw new Error("Developer repair can only bind the original Developer/session and a real post-REVISE application change");
  }
  const record = {
    schema: "acef.developer-repair.v3", runId: activeRun.runId, fullFlowContract: activeRun.fullFlowContract,
    story: activeRun.activeStory, cycle, priorGateId: priorGate.gateId,
    findingsSha256: sha256(JSON.stringify(priorGate.unresolvedFindings || [])),
    developerActorId: developer.actorInstanceId, developerSessionId: developer.sessionId,
    preCommit: priorGate.applicationCommit, preTree: priorGate.applicationTree,
    postCommit, postTree, createdAt: new Date().toISOString(),
  };
  const target = path.join(opts.repo, "docs", "ai", "repairs", `${safeId(opts.id, "repair id")}.json`);
  atomicJson(target, record, { validate: parseDeveloperRepair });
  console.log(`WROTE Developer repair ${relative(opts.repo, target)} cycle=${cycle}`);
}

function capsuleBlob(filePath, content) {
  const bytes = Buffer.from(String(content));
  return { path: filePath, sha256: sha256(bytes), bytes: bytes.length, content: String(content) };
}

function writeReviewCapsule(opts) {
  required(opts, ["id", "role", "actor", "baseCommit", "redEvidence", "greenEvidence"]);
  const activeRun = activeV3Run(opts.repo);
  if (activeRun.runtimeContract !== "capsule-supervisor-v1"
    || activeRun.scopeUnit !== "story" || canonicalGatePhase(activeRun.activePhase) !== "codereview") {
    throw new Error("review-capsule requires an active story review under capsule-supervisor-v1");
  }
  if (!["code-review", "patch-assurance"].includes(opts.role)) throw new Error("--role must be code-review or patch-assurance");
  const storyToken = String(activeRun.activeStory).toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");
  const cycle = opts.reviewCycle === undefined ? 0 : Number(opts.reviewCycle);
  const expectedActor = `acef_${storyToken}_${opts.role.replaceAll("-", "_")}${cycle ? `_retry${cycle}` : ""}`;
  if (opts.actor !== expectedActor || !Number.isInteger(cycle) || cycle < 0 || cycle > 2) {
    throw new Error("review-capsule actor/review-cycle does not match the canonical active-story identity");
  }
  const inputCommit = gitCommit(opts.repo);
  const inputTree = gitTree(opts.repo);
  if (!gitIsAncestor(opts.repo, opts.baseCommit, inputCommit)) throw new Error("review-capsule base commit is not an input ancestor");
  const red = gateEvidence(opts.repo, opts.redEvidence, activeRun.activeStory);
  const green = gateEvidence(opts.repo, opts.greenEvidence, activeRun.activeStory);
  if (red.exitCode === 0 || green.exitCode !== 0 || red.command !== green.command
    || !green.discovery || !green.discovery.expectedTests.length
    || !gitIsAncestor(opts.repo, red.repositoryCommit, green.repositoryCommit)
    || !gitIsAncestor(opts.repo, green.repositoryCommit, inputCommit)) {
    throw new Error("review-capsule requires bound red/green evidence and a passing frozen test-discovery contract");
  }
  let scopePaths = normalizedScopePaths(applicationChangedSince(opts.repo, opts.baseCommit, inputCommit));
  let repairReceipt = null;
  let previousFindings = [];
  if (cycle > 0) {
    required(opts, ["repairReceipt"]);
    const repairPath = path.resolve(opts.repo, opts.repairReceipt);
    const repair = parseDeveloperRepair(repairPath);
    const priorGatePath = path.join(opts.repo, "docs", "ai", "gates", `${safeId(repair.priorGateId, "prior gate id")}.json`);
    const priorGate = parseGateVerdict(priorGatePath);
    if (repair.runId !== activeRun.runId || repair.cycle !== cycle || priorGate.reviewCycle !== cycle - 1
      || priorGate.verdict !== "REVISE") throw new Error("review-capsule repair receipt/cycle mismatch");
    scopePaths = normalizedScopePaths(priorGate.scopePaths);
    repairReceipt = { path: relative(opts.repo, repairPath), sha256: sha256(fs.readFileSync(repairPath)), record: repair };
    for (const reportPath of Object.values(priorGate.reportPaths || {})) {
      const report = parseReviewReport(path.resolve(opts.repo, reportPath));
      previousFindings.push(...report.findings.filter((finding) => finding.status === "OPEN"));
    }
    previousFindings.sort((left, right) => left.id.localeCompare(right.id));
  }
  if (!scopePaths.length) throw new Error("review-capsule scope is empty");
  const contextPath = path.resolve(opts.repo, activeRun.contextPath || "docs/ai/ACEF_CURRENT_CONTEXT.md");
  if (!fs.existsSync(contextPath)) throw new Error("review-capsule current context is missing");
  const contextContent = fs.readFileSync(contextPath, "utf8");
  const diffContent = runGit(opts.repo, ["diff", "--no-ext-diff", "--unified=40", `${opts.baseCommit}..${inputCommit}`, "--", ...scopePaths]);
  const sourceBlobs = scopePaths.map((filePath) => {
    let content = "";
    try { content = runGit(opts.repo, ["show", `${inputCommit}:${filePath}`]); } catch {}
    return capsuleBlob(filePath, content);
  });
  const totalBytes = Buffer.byteLength(contextContent) + Buffer.byteLength(diffContent)
    + sourceBlobs.reduce((sum, blob) => sum + blob.bytes, 0);
  if (totalBytes > 400000) throw new Error(`review-capsule exceeds 400000-byte bounded context limit (${totalBytes})`);
  const reviewPolicy = opts.role === "code-review"
    ? ["Judge correctness, security, acceptance conformance, and scope.", "Consume the hash-bound runner proof; do not rerun it unless reporting a named evidence conflict.", "Do not edit files or consume the other reviewer conclusion.", "Use targeted follow-up reads only for a named uncertainty."]
    : ["Judge final-tree patch integrity, test quality, discovery proof, and runner evidence.", "Consume the hash-bound runner proof; rerun only when a named evidence conflict requires adjudication.", "Do not edit files or consume the Code Review conclusion.", "Use targeted follow-up reads only for a named uncertainty."];
  const payload = {
    schema: "acef.assurance-capsule.v1",
    runId: activeRun.runId,
    fullFlowContract: activeRun.fullFlowContract,
    runtimeContract: activeRun.runtimeContract,
    story: activeRun.activeStory,
    role: opts.role,
    actorInstanceId: opts.actor,
    reviewCycle: cycle,
    baseCommit: opts.baseCommit,
    inputCommit,
    inputTree,
    scopePaths,
    acceptanceIds: [...new Set([...red.satisfies, ...green.satisfies])],
    currentContext: capsuleBlob(relative(opts.repo, contextPath), contextContent),
    diff: capsuleBlob(`git-diff:${opts.baseCommit}..${inputCommit}`, diffContent),
    sourceBlobs,
    redEvidence: red,
    greenEvidence: green,
    previousFindings,
    repairReceipt,
    reviewPolicy,
    allowedCommands: [
      `.acef/bin/acef-state capsule-show --repo . --id ${opts.id}`,
      `.acef/bin/acef-state review-result --repo . --actor ${opts.actor} --model gpt-5.6-sol --effort high --verdict <PASS|REVISE|REPLAN>`,
    ],
  };
  const record = { ...payload, integrity: { algorithm: "sha256", payloadSha256: sha256(JSON.stringify(payload)) } };
  const target = path.join(opts.repo, "docs", "ai", "capsules", `${safeId(opts.id, "capsule id")}.json`);
  const serialized = `${JSON.stringify(record, null, 2)}\n`;
  if (fs.existsSync(target)) {
    if (fs.readFileSync(target, "utf8") !== serialized) throw new Error(`Refusing to replace non-identical capsule ${opts.id}`);
  } else {
    atomicJson(target, record, { validate: parseAssuranceCapsule });
  }
  console.log(`WROTE review capsule ${relative(opts.repo, target)} sha256=${sha256(serialized)}`);
}

function validateCapsuleIntegrity(repo, record) {
  const { integrity, ...payload } = record;
  if (integrity.payloadSha256 !== sha256(JSON.stringify(payload))) throw new Error("assurance capsule payload hash mismatch");
  if (record.inputTree !== gitTreeAt(repo, record.inputCommit)) throw new Error("assurance capsule input tree is stale or invalid");
  for (const blob of [record.currentContext, record.diff, ...record.sourceBlobs]) {
    if (sha256(Buffer.from(blob.content)) !== blob.sha256 || Buffer.byteLength(blob.content) !== blob.bytes) {
      throw new Error(`assurance capsule blob mismatch: ${blob.path}`);
    }
  }
}

function boundCurrentCapsule(repo, activeRun, actor) {
  const capsuleDir = path.join(repo, "docs", "ai", "capsules");
  if (!fs.existsSync(capsuleDir)) throw new Error(`review actor ${actor} has no assurance capsule`);
  const matches = fs.readdirSync(capsuleDir).filter((name) => name.endsWith(".json")).sort().map((name) => {
    const target = path.join(capsuleDir, name);
    const record = parseAssuranceCapsule(target);
    return { target, record };
  }).filter(({ record }) => record.actorInstanceId === actor && record.runId === activeRun.runId
    && normalizedScope(record.story) === normalizedScope(activeRun.activeStory));
  if (matches.length !== 1) throw new Error(`review actor ${actor} requires exactly one assurance capsule, found ${matches.length}`);
  const match = matches[0];
  validateCapsuleIntegrity(repo, match.record);
  const expectedRole = actor.includes("_code_review") ? "code-review" : "patch-assurance";
  if (match.record.role !== expectedRole || match.record.inputCommit !== gitCommit(repo)
    || match.record.inputTree !== gitTree(repo)) {
    throw new Error(`review actor ${actor} assurance capsule is wrong-role or not bound to current HEAD`);
  }
  const bytes = fs.readFileSync(match.target);
  return { ...match, relativePath: relative(repo, match.target).replaceAll(path.sep, "/"), sha256: sha256(bytes) };
}

function showCapsule(opts) {
  required(opts, ["id"]);
  const activeRun = activeV3Run(opts.repo);
  if (activeRun.runtimeContract !== "capsule-supervisor-v1" || activeRun.scopeUnit !== "story"
    || canonicalGatePhase(activeRun.activePhase) !== "codereview") {
    throw new Error("capsule-show requires the active capsule-supervisor story review phase");
  }
  const target = path.join(opts.repo, "docs", "ai", "capsules", `${safeId(opts.id, "capsule id")}.json`);
  const record = parseAssuranceCapsule(target);
  validateCapsuleIntegrity(opts.repo, record);
  if (record.runId !== activeRun.runId || normalizedScope(record.story) !== normalizedScope(activeRun.activeStory)
    || record.inputCommit !== gitCommit(opts.repo) || record.inputTree !== gitTree(opts.repo)) {
    throw new Error("assurance capsule is not bound to the active run/story/current HEAD");
  }
  console.log(JSON.stringify(record));
}

function writeReviewCompletion(opts) {
  required(opts, ["artifactPath", "actor"]);
  const activeRun = activeV3Run(opts.repo);
  const artifactPath = path.resolve(opts.repo, opts.artifactPath);
  const relativePath = relative(opts.repo, artifactPath).replaceAll(path.sep, "/");
  if (!/^docs\/ai\/reports\/[^/]+\.json$/.test(relativePath) || !fs.existsSync(artifactPath)) {
    throw new Error("review-completion artifact must be an existing docs/ai/reports/*.json file");
  }
  const bytes = fs.readFileSync(artifactPath);
  const report = parseReviewReport(artifactPath);
  const capsule = activeRun.runtimeContract === "capsule-supervisor-v1"
    ? boundCurrentCapsule(opts.repo, activeRun, opts.actor) : null;
  if (report.runId !== activeRun.runId || report.fullFlowContract !== activeRun.fullFlowContract
    || report.actorInstanceId !== opts.actor
    || normalizedScope(report.story) !== normalizedScope(activeRun.activeStory)
    || !["codereview", "patchassurance"].includes(canonicalGatePhase(report.phase))
    || report.inputCommit !== gitCommit(opts.repo) || report.inputTree !== gitTree(opts.repo)
    || (capsule && (report.capsulePath !== capsule.relativePath || report.capsuleSha256 !== capsule.sha256))) {
    throw new Error("review-completion report actor/run/story/phase/input commit/tree binding mismatch");
  }
  const role = report.phase === "code-review" ? "code-reviewer" : "patch-assurance-reviewer";
  writeActor({
    repo: opts.repo,
    id: opts.actor,
    story: report.story,
    phase: report.phase,
    role,
    client: "codex",
    model: opts.model,
    effort: opts.effort,
    sessionId: `/root/${opts.actor}`,
    contextProfile: report.phase,
    inputCommit: report.inputCommit,
    inputTree: report.inputTree,
    artifactPath: relativePath,
  });
  console.log(`REVIEW_REPORT_PATH=${relativePath}`);
  console.log(`REVIEW_REPORT_SHA256=${sha256(bytes)}`);
  console.log(`REVIEW_REPORT_BASE64=${bytes.toString("base64")}`);
  console.log(`REVIEW_INPUT_TREE=${report.inputTree}`);
}

function decodeReviewFindings(entries) {
  return entries.map((entry, index) => {
    let bytes;
    try { bytes = Buffer.from(String(entry), "base64"); }
    catch { throw new Error(`--finding ${index + 1} must be canonical base64 JSON`); }
    if (!bytes.length || bytes.toString("base64") !== String(entry)) {
      throw new Error(`--finding ${index + 1} must be canonical base64 JSON`);
    }
    let finding;
    try { finding = JSON.parse(bytes.toString("utf8")); }
    catch { throw new Error(`--finding ${index + 1} must decode to one JSON object`); }
    if (!finding || typeof finding !== "object" || Array.isArray(finding)) {
      throw new Error(`--finding ${index + 1} must decode to one JSON object`);
    }
    return finding;
  });
}

function typedReviewFindings(opts) {
  const counts = [opts.findingId.length, opts.findingSeverity.length, opts.findingReason.length];
  if (counts.every((count) => count === 0)) return [];
  if (new Set(counts).size !== 1) {
    throw new Error("typed review findings require one --finding-id, --finding-severity, and --finding-reason per finding");
  }
  return opts.findingId.map((id, index) => ({
    id: safeId(id, `finding ${index + 1} id`),
    severity: String(opts.findingSeverity[index]).toUpperCase(),
    status: "OPEN",
    reason: String(opts.findingReason[index]).trim(),
  }));
}

function writeReviewResult(opts) {
  required(opts, ["actor", "verdict"]);
  const activeRun = activeV3Run(opts.repo);
  if (activeRun.scopeUnit !== "story" || canonicalGatePhase(activeRun.activePhase) !== "codereview") {
    throw new Error("review-result requires the active four-actor-v3 story review phase");
  }
  const storyToken = String(activeRun.activeStory).toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");
  const actorPattern = new RegExp(`^acef_${storyToken}_(code_review|patch_assurance)(?:_retry[12])?$`);
  const actorMatch = String(opts.actor).match(actorPattern);
  if (!actorMatch) throw new Error("review-result actor must be the canonical active-story Code Review or Patch Assurance identity");
  const verdict = String(opts.verdict).toUpperCase();
  if (!["PASS", "REVISE", "REPLAN"].includes(verdict)) throw new Error("review-result verdict must be PASS, REVISE, or REPLAN");
  const phase = actorMatch[1] === "code_review" ? "code-review" : "patch-assurance";
  if (opts.finding.length && opts.findingId.length) {
    throw new Error("review-result cannot mix compatibility --finding with typed finding options");
  }
  const findings = opts.finding.length ? decodeReviewFindings(opts.finding) : typedReviewFindings(opts);
  const reportPath = path.join(opts.repo, "docs", "ai", "reports", `${safeId(opts.actor, "review actor id")}.json`);
  const reviewerPath = actorPath(opts.repo, opts.actor);
  if (fs.existsSync(reportPath) || fs.existsSync(reviewerPath)) {
    throw new Error(`Refusing to overwrite immutable review result ${opts.actor}`);
  }
  const capsule = activeRun.runtimeContract === "capsule-supervisor-v1"
    ? boundCurrentCapsule(opts.repo, activeRun, opts.actor) : null;
  const report = {
    schema: "acef.review-report.v3",
    runId: activeRun.runId,
    fullFlowContract: activeRun.fullFlowContract,
    actorInstanceId: opts.actor,
    story: activeRun.activeStory,
    phase,
    inputCommit: gitCommit(opts.repo),
    inputTree: gitTree(opts.repo),
    ...(capsule ? { capsulePath: capsule.relativePath, capsuleSha256: capsule.sha256 } : {}),
    verdict,
    findings,
  };
  try {
    atomicJson(reportPath, report, { validate: parseReviewReport });
    writeReviewCompletion({ repo: opts.repo, artifactPath: relative(opts.repo, reportPath), actor: opts.actor, model: opts.model, effort: opts.effort });
  } catch (error) {
    if (!fs.existsSync(reviewerPath)) fs.rmSync(reportPath, { force: true });
    throw error;
  }
}

function writeJudgeDecision(opts) {
  required(opts, ["id", "gateId", "actor", "trigger"]);
  if (!opts.evidence.length) throw new Error("judge-decision requires at least one --evidence id");
  if (!["ambiguity", "waiver", "evidence-conflict", "gate-anomaly"].includes(opts.trigger)) {
    throw new Error("--trigger must be ambiguity, waiver, evidence-conflict, or gate-anomaly");
  }
  const activeRun = activeV3Run(opts.repo);
  const judge = parseActorRecord(actorPath(opts.repo, opts.actor));
  if (judge.runId !== activeRun.runId || judge.fullFlowContract !== activeRun.fullFlowContract
    || normalizedScope(judge.story) !== normalizedScope(activeRun.activeStory)
    || canonicalGatePhase(judge.phase) !== "processjudge") {
    throw new Error("judge-decision actor must be a Process Judge bound to the active v3 run/story");
  }
  for (const evidenceId of opts.evidence) gateEvidence(opts.repo, evidenceId, activeRun.activeStory);
  const record = {
    schema: "acef.process-judge-decision.v3", runId: activeRun.runId, fullFlowContract: activeRun.fullFlowContract,
    story: activeRun.activeStory, trigger: opts.trigger, actorId: judge.actorInstanceId,
    gateId: opts.gateId, evidenceIds: [...new Set(opts.evidence)],
    verdict: opts.trigger === "waiver" ? "APPROVE_WAIVER" : "ACKNOWLEDGE", createdAt: new Date().toISOString(),
  };
  const target = path.join(opts.repo, "docs", "ai", "judges", `${safeId(opts.id, "judge decision id")}.json`);
  atomicJson(target, record, { validate: parseProcessJudgeDecision });
  console.log(`WROTE Process Judge decision ${relative(opts.repo, target)} verdict=${record.verdict}`);
}

function writeGate(opts) {
  const activeRunPath = path.join(opts.repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  const activeRun = fs.existsSync(activeRunPath) ? parseActiveRun(activeRunPath) : null;
  if (activeRun?.fullFlowContract === "four-actor-v3") {
    if (normalizedScope(opts.scope) !== normalizedScope(activeRun.activeStory)) {
      throw new Error(`four-actor-v3 cannot write a gate for inactive scope ${opts.scope}; active scope is ${activeRun.activeStory}`);
    }
    if (activeRun.scopeUnit === "epic") {
      if (!opts.decidedBy || opts.atddActor) throw new Error("four-actor-v3 Epic scope requires an actor-decided Epic Process Judge gate");
      return writeLegacyGate(opts);
    }
    if (activeRun.scopeUnit !== "story") throw new Error(`four-actor-v3 gate routing requires scopeUnit story or epic, got ${activeRun.scopeUnit}`);
    if (opts.decidedBy && !opts.atddActor) {
      throw new Error("four-actor-v3 story gates must use deterministic story-close inputs; actor-decided gates remain available for epic scope");
    }
    return writeDeterministicStoryCloseGate(opts, activeRun);
  }
  return writeLegacyGate(opts);
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  if (!opts.command || opts.command === "help" || opts.command === "--help" || opts.help) return usage(opts.command);
  runGit(opts.repo, ["rev-parse", "--git-dir"]);
  if (opts.command === "active-run") return writeActiveRun(opts);
  if (opts.command === "migrate-active-run") return migrateActiveRun(opts);
  if (opts.command === "direct-run") return writeDirectRun(opts);
  if (opts.command === "actor") return writeActor(opts);
  if (opts.command === "worker-scope") return writeWorkerScope(opts);
  if (opts.command === "phase-transition") return writePhaseTransition(opts);
  if (opts.command === "story-transition") return writeStoryTransition(opts);
  if (opts.command === "review-scope") return writeReviewScope(opts);
  if (opts.command === "approval") return writeApproval(opts);
  if (opts.command === "evidence-run") return writeEvidence(opts);
  if (opts.command === "developer-repair") return writeDeveloperRepair(opts);
  if (opts.command === "review-capsule") return writeReviewCapsule(opts);
  if (opts.command === "capsule-show") return showCapsule(opts);
  if (opts.command === "review-result") return writeReviewResult(opts);
  if (opts.command === "review-completion") return writeReviewCompletion(opts);
  if (opts.command === "judge-decision") return writeJudgeDecision(opts);
  if (opts.command === "gate") return writeGate(opts);
  throw new Error(`Unknown command: ${opts.command}`);
}

try {
  main();
} catch (error) {
  console.error(`ACEF_STATE_ERROR: ${error.message}`);
  process.exitCode = 1;
}
