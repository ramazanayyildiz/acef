function usage(command = "") {
  if (command === "direct-run") {
    console.log(`Usage: acef-state direct-run --repo <path> --run-id <existing-id> --status complete|promoted [options]

New direct-run admission is retired. Contained low-risk work uses the repository's native workflow outside ACEF with
focused verification. Keep this command only to close or promote an ACEF_DIRECT_RUN.json that already exists.

Close an existing record:
  acef-state direct-run --repo . --run-id <id> --status complete --changed-path <target> --verification-command <command> --verification-exit-code 0 --summary <handoff>

Promote an existing record before implementation continues:
  acef-state direct-run --repo . --run-id <id> --status promoted --promotion-decision <lane> --promotion-reason <reason>
  lane: promote-lightweight | promote-full-bmad | promote-guarded

The existing direct record is the compact compatibility context. Do not inspect ACEF schemas or CLI source to discover these options.`);
    return;
  }
  if (command === "worker-scope") {
    console.log("Usage: acef-state worker-scope --repo <path> --story <scope> --phase <phase> --worker-id <id> --allow <glob>... [--allow-command <exact-command>...] [options]\n\nThe active run must exist and be active; its runId is bound into the scope automatically. Capsule-supervisor story workers require at least one exact allowed command.");
    return;
  }
  console.log(`ACEF typed-state writer

Usage:
  acef-state active-run --repo <path> --run-id <id> --objective-id <id> --objective-scope <stable-parent-scope> --workflow-id quick-fix|lightweight|full-bmad [--objective-defect <id>...] [--replan-cause new-root-cause|scope-error|evidence-invalid] [options]
  acef-state objective-qa --repo <path> --objective-id <id> --status running|complete
  acef-state objective-defect --repo <path> --objective-id <id> --id <id> --source review|manual-qa|broad-suite --defect-class <class> --summary <text> --discovered-in-run <id> [--defect-status <status> --batch-key <key> --root-cause-key <key>]
