#!/usr/bin/env node
"use strict";
// Synthetic artifacts test binding/accounting only; no product browser claim.
const assert = require("node:assert/strict"), fs = require("node:fs"), cp = require("node:child_process"), path = require("node:path"), os = require("node:os"), crypto = require("node:crypto");
const objective = require("./lib/acef-objective-supervisor");
const validator = require("./acef-process-validator");
const { CONTRACT, REQUIRED, CONDITIONAL } = require("./lib/acef-product-review");
const { startInvocation, finishInvocation } = require("./lib/acef-invocation-ledger");
const repo = fs.mkdtempSync(path.join(os.tmpdir(), "acef-product-accounting-"));
const sha = (bytes) => crypto.createHash("sha256").update(bytes).digest("hex");
const write = (file, data) => { fs.mkdirSync(path.dirname(path.join(repo, file)), { recursive: true }); fs.writeFileSync(path.join(repo, file), typeof data === "string" ? data : JSON.stringify(data)); };
const git = (...args) => cp.execFileSync("git", args, { cwd: repo, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
const tree = (ref) => validator.applicationTreeDigest(repo, ref, ["README.md"]);
try {
  git("init", "-q"); git("config", "user.email", "fixture@example.invalid"); git("config", "user.name", "Fixture");
  write("README.md", "initial"); git("add", "."); git("commit", "-qm", "initial");
  const actor = { runId: "P01", story: "P01", client: "codex", inputCommit: git("rev-parse", "HEAD"), inputTree: git("rev-parse", "HEAD^{tree}"), allowedContextProfile: "scoped", createdAt: new Date(Date.now() - 10000).toISOString(), lightweightStateContract: "lightweight-state-v1" };
  write("docs/ai/actors/dev.json", { ...actor, actorInstanceId: "dev", sessionId: "dev-session", phase: "development", role: "developer" });
  write("docs/ai/actors/reviewer.json", { ...actor, actorInstanceId: "reviewer", sessionId: "review-session", phase: "code-review", role: "code-review" });
  const active = { schema: "acef.active-run.v2", runId: "P01", repo: "fixture", workflowId: "lightweight", assuranceProfile: "guarded", assuranceRationale: "Synthetic independent product-review fixture", status: "active", scopeUnit: "story", activeStory: "P01", activePhase: "development", ledgerPath: "docs/ai/runs/P01.md", productReviewContract: CONTRACT };
  write("docs/ai/ACEF_ACTIVE_RUN.json", active);
  objective.registerRun(repo, { objectiveId: "PRODUCT", objectiveScope: "Bounded fixture plus future work", runId: "P01", workflowId: "lightweight", assuranceProfile: "guarded", accountingVersion: "objective-accounting-v2" });
  write("docs/ai/reports/proof.txt", "Synthetic review observation artifact");
  const artifact = { id: "proof", kind: "screenshot", viewport: "desktop", path: "docs/ai/reports/proof.txt", sha256: sha("Synthetic review observation artifact") };
  for (let index = 1; index <= 3; index++) {
    write("README.md", "repair state " + index); git("add", "README.md"); git("commit", "-qm", "repair state " + index);
    const commit = git("rev-parse", "HEAD");
    write(`docs/ai/reports/failed-${index}.json`, { schema: "acef.product-review.v1", runId: "P01", verdict: "REVISE", reviewerActorId: "reviewer", sessionId: "review-session", reviewedAt: new Date().toISOString(), applicationCommit: commit, applicationTree: tree(commit), browser: { status: "VERIFIED" }, artifacts: [artifact], checks: { validation: { status: "FAIL", observation: "Synthetic failed rendered observation", artifactIds: ["proof"] } } });
    write(`docs/ai/gates/revise-${index}.json`, { gateId: "revise-" + index, runId: "P01", scope: "P01", verdict: "REVISE", decidedBy: "reviewer", repositoryCommit: commit, repositoryTree: git("rev-parse", "HEAD^{tree}"), lightweightStateContract: "lightweight-state-v1", applicationCommit: commit, applicationTree: tree(commit), scopePaths: ["README.md"], evidenceIds: [] });
  }
  assert.equal(objective.collectObjectiveReviews(repo, objective.loadObjective(repo, "PRODUCT")).length, 3);
  const reviewerPath = "docs/ai/actors/reviewer.json", reviewer = JSON.parse(fs.readFileSync(path.join(repo, reviewerPath)));
  write(reviewerPath, { ...reviewer, sessionId: "dev-session" });
  assert.equal(objective.collectObjectiveReviews(repo, objective.loadObjective(repo, "PRODUCT")).length, 0, "same session must not count review");
  write(reviewerPath, reviewer);
  delete active.productReviewContract; write("docs/ai/ACEF_ACTIVE_RUN.json", active);
  const legacyFixture = objective.loadObjective(repo, "PRODUCT");
  for (const run of legacyFixture.runs) delete run.productReviewContract;
  assert.equal(objective.collectObjectiveReviews(repo, legacyFixture).length, 0, "non-opt-in behavior unchanged");
  active.productReviewContract = CONTRACT; write("docs/ai/ACEF_ACTIVE_RUN.json", active);
  write("docs/ai/gates/unbound.json", { gateId: "unbound", runId: "P01", scope: "P01", verdict: "REVISE", decidedBy: "reviewer", repositoryCommit: actor.inputCommit, repositoryTree: actor.inputTree, lightweightStateContract: "lightweight-state-v1", applicationCommit: actor.inputCommit, applicationTree: tree(actor.inputCommit), scopePaths: ["README.md"], evidenceIds: [] });
  assert.equal(objective.collectObjectiveReviews(repo, objective.loadObjective(repo, "PRODUCT")).length, 3, "bare gate cannot inflate accounting");
  // Preserve the fourth failure discovered by actual visual inspection even
  // when its earlier behavioral harness was green; verdict and execution differ.
  write("README.md", "fourth reviewed state"); git("add", "README.md"); git("commit", "-qm", "fourth reviewed state");
  const fourthCommit = git("rev-parse", "HEAD");
  write("docs/ai/reports/failed-4.json", { schema: "acef.product-review.v1", runId: "P01", verdict: "REVISE", reviewerActorId: "reviewer", sessionId: "review-session", reviewedAt: new Date().toISOString(), applicationCommit: fourthCommit, applicationTree: tree(fourthCommit), browser: { status: "VERIFIED" }, artifacts: [artifact], checks: { responsiveKeyboard: { status: "FAIL", observation: "Synthetic manual overflow observation after green behavior", artifactIds: ["proof"] } } });
  write("docs/ai/gates/revise-4.json", { gateId: "revise-4", runId: "P01", scope: "P01", verdict: "REVISE", decidedBy: "reviewer", repositoryCommit: fourthCommit, repositoryTree: git("rev-parse", "HEAD^{tree}"), lightweightStateContract: "lightweight-state-v1", applicationCommit: fourthCommit, applicationTree: tree(fourthCommit), scopePaths: ["README.md"], evidenceIds: [] });
  assert.equal(objective.collectObjectiveReviews(repo, objective.loadObjective(repo, "PRODUCT")).length, 4);
  const reconciled = objective.reconcileObjective(repo, objective.loadObjective(repo, "PRODUCT"));
  objective.publishPreparedObjective({ path: objective.objectivePath(repo, "PRODUCT"), record: reconciled });
  Object.assign(active, { objectiveContract: "objective-supervisor-v1", objectiveId: "PRODUCT", objectivePath: "docs/ai/objectives/PRODUCT.json", scopeFingerprint: reconciled.scopeFingerprint });
  write("docs/ai/ACEF_ACTIVE_RUN.json", active);
  const cli = cp.spawnSync(process.execPath, [path.join(__dirname, "acef-process-validator"), "--repo", repo, "--check", "objective-supervision"], { encoding: "utf8" });
  assert.equal(cli.status, 0, cli.stderr);
  assert.match(cli.stdout, /4 review cycle/);
  assert.doesNotMatch(cli.stderr, /circular dependency|non-existent property/);
  write("README.md", "final product"); git("add", "README.md"); git("commit", "-qm", "final product");
  const commit = git("rev-parse", "HEAD"), applicationTree = tree(commit);
  const argv = [process.execPath, "-e", "process.stdout.write('actual fixture green\\n')"];
  startInvocation(repo, { invocationId: "INV", runId: "P01", actorId: "dev", evidenceId: "GREEN", kind: "runtime-test", scopeFingerprint: "a".repeat(64), commandArgv: argv });
  const result = cp.spawnSync(process.execPath, [path.join(__dirname, "acef-state"), "evidence-run", "--repo", repo, "--id", "GREEN", "--kind", "runtime-test", "--actor", "dev", "--story", "P01", "--satisfies", "focused green", "--", ...argv], { encoding: "utf8" });
  assert.equal(result.status, 0, result.stderr);
  finishInvocation(repo, { invocationId: "INV", runId: "P01", actorId: "dev", scopeFingerprint: "a".repeat(64), commandArgv: argv, exitCode: 0 });
  const gatePath = "docs/ai/gates/pass.json";
  write(gatePath, { gateId: "pass", runId: "P01", scope: "P01", verdict: "PASS", decidedBy: "reviewer", repositoryCommit: commit, repositoryTree: git("rev-parse", "HEAD^{tree}"), lightweightStateContract: "lightweight-state-v1", applicationCommit: commit, applicationTree, scopePaths: ["README.md"], greenEvidenceId: "GREEN", evidenceIds: ["GREEN"] });
  const input = { runId: "P01", terminalDisposition: "PASS", invocationId: "INV", gatePath, applicationTree };
  assert.throws(() => objective.prepareValidatedCompletion(repo, "PRODUCT", input), /ENOENT|lifecycle/);
  const reportPath = "docs/ai/reports/product.json";
  const artifacts = [artifact, { ...artifact, id: "mobile", viewport: "mobile" }, { ...artifact, id: "trace", kind: "browser-trace" }];
  const report = { schema: "acef.product-review.v1", runId: "P01", verdict: "PASS", reviewerActorId: "reviewer", sessionId: "review-session", reviewedAt: new Date().toISOString(), applicationCommit: commit, applicationTree, browser: { status: "VERIFIED", origin: "http://127.0.0.1:4173" }, artifacts, checks: Object.fromEntries([...REQUIRED, ...CONDITIONAL].map((name) => [name, { status: "PASS", observation: "Synthetic verified observation", artifactIds: ["trace"] }])) };
  report.checks.componentReuse.reuseAudit = { existing: [{ path: "README.md", usage: "Synthetic existing source reused" }], introduced: [], sharedChanges: [], duplicationReview: "Synthetic source duplication audit" };
  write(reportPath, report);
  const lifecycle = { schema: "acef.lightweight-run.v2", runId: "P01", workflowId: "lightweight", assuranceProfile: "guarded", status: "complete", implementationActorId: "dev", reviewActorId: "reviewer", productReviewContract: CONTRACT, productReview: { reportPath, sha256: sha(fs.readFileSync(path.join(repo, reportPath))) }, steps: ["preflight-current-context", "reuse-before-create", "implementation", "independent-review", "focused-verification", "closeout-evidence"].map((name) => ({ name, status: "PASS", evidencePaths: [reportPath] })), promotion: { decision: "stay-lightweight", triggers: [] } };
  write("docs/ai/ACEF_LIGHTWEIGHT_RUN.json", lifecycle);
  objective.publishPreparedObjective(objective.prepareValidatedCompletion(repo, "PRODUCT", input));
  const completed = objective.loadObjective(repo, "PRODUCT");
  assert.equal(completed.reviewCycleCount, 5, "four REVISE plus PASS remain cumulative");
  assert.equal(completed.accounting.successfulCompletionCount, 1);
  assert.equal(completed.status, "EXECUTING", "bounded completion does not close future parent work");
  assert.ok(completed.runs[0].successfulCompletion.artifactHashes[reportPath]);
  // Audited budget uses this authentic synthetic terminal, never invented proof.
  Object.assign(active, { status: "complete", activePhase: "closeout", terminalDisposition: "PASS", terminalGateId: "pass", terminalReason: "Synthetic completed product", lightweightStateContract: "lightweight-state-v1", redOwnershipContract: "integrated-developer-v1", workerRole: "code-review", fullLedgerAccess: "denied", maxLines: 120 });
  write("docs/ai/ACEF_ACTIVE_RUN.json", active);
  const timed = objective.loadObjective(repo, "PRODUCT");
  timed.progress.activeControlSeconds = 1800;
  timed.progress.lastObservedAt = new Date().toISOString();
  objective.publishPreparedObjective({ path: objective.objectivePath(repo, "PRODUCT"), record: objective.reconcileObjective(repo, timed) });
  const nextOptions = { objectiveId: "PRODUCT", objectiveScope: "Bounded fixture plus future work", runId: "MEDIA", previousRun: active, workflowId: "lightweight", assuranceProfile: "guarded", productReviewContract: CONTRACT, accountingVersion: "objective-accounting-v2" };
  assert.throws(() => objective.prepareRegisterRun(repo, nextOptions), /CONSOLIDATING/);
  write("docs/ai/reports/authority.md", "Explicit synthetic coordinator authorizes exactly one named run and finite additional control time.");
  const budget = { terminalRunId: "P01", terminalGateId: "pass", decisionId: "BUDGET-1", eligibleRunId: "MEDIA", authorityRef: "docs/ai/reports/authority.md", reason: "Synthetic explicit one-run control budget, no threshold or counter reset", additionalSeconds: 1800, expiresAt: new Date(Date.now() + 3600000).toISOString() };
  const beforeBudget = objective.loadObjective(repo, "PRODUCT");
  assert.throws(() => objective.prepareControlBudget(repo, "PRODUCT", { ...budget, terminalRunId: "wrong" }), /authentic/);
  assert.throws(() => objective.prepareControlBudget(repo, "PRODUCT", { ...budget, expiresAt: new Date(Date.now() - 1000).toISOString() }), /bounded control/);
  assert.throws(() => objective.prepareControlBudget(repo, "PRODUCT", { ...budget, additionalSeconds: 3601 }), /bounded control/);
  assert.throws(() => objective.prepareControlBudget(repo, "PRODUCT", { ...budget, authorityRef: "../escape.md" }), /authority/);
  const budgetArgs = ["objective-control-budget", "--repo", repo, "--objective-id", "PRODUCT", "--run-id", "P01", "--decision-id", budget.decisionId, "--eligible-run-id", budget.eligibleRunId, "--authority-ref", budget.authorityRef, "--reason", budget.reason, "--additional-seconds", "1800", "--expires-at", budget.expiresAt];
  const objectivePath = "docs/ai/objectives/PRODUCT.json", activePath = "docs/ai/ACEF_ACTIVE_RUN.json";
  const immutableBefore = [objectivePath, activePath].map((f) => fs.readFileSync(path.join(repo, f)));
  write(activePath, { ...active, terminalGateId: "does-not-exist" });
  const wrongActiveBytes = fs.readFileSync(path.join(repo, activePath));
  const wrongGateCLI = cp.spawnSync(process.execPath, [path.join(__dirname, "acef-state"), ...budgetArgs], { encoding: "utf8" });
  assert.equal(wrongGateCLI.status, 1); assert.match(wrongGateCLI.stderr, /terminal gate binding/);
  assert.deepEqual(fs.readFileSync(path.join(repo, objectivePath)), immutableBefore[0]); assert.deepEqual(fs.readFileSync(path.join(repo, activePath)), wrongActiveBytes);
  write(activePath, active);
  const resultBudget = cp.spawnSync(process.execPath, [path.join(__dirname, "acef-state"), "objective-control-budget", "--repo", repo, "--objective-id", "PRODUCT", "--run-id", "P01", "--decision-id", budget.decisionId, "--eligible-run-id", budget.eligibleRunId, "--authority-ref", budget.authorityRef, "--reason", budget.reason, "--additional-seconds", "1800", "--expires-at", budget.expiresAt], { encoding: "utf8" });
  assert.equal(resultBudget.status, 0, resultBudget.stdout + resultBudget.stderr);
  const granted = objective.loadObjective(repo, "PRODUCT");
  assert.equal(granted.runCount, beforeBudget.runCount); assert.deepEqual(granted.runs, beforeBudget.runs); assert.deepEqual(granted.accounting, beforeBudget.accounting);
  assert.ok(granted.progress.activeControlSeconds >= beforeBudget.progress.activeControlSeconds, "grant must not reset observed time");
  assert.throws(() => objective.prepareControlBudget(repo, "PRODUCT", budget), /already recorded/);
  assert.throws(() => objective.prepareControlBudget(repo, "PRODUCT", { ...budget, decisionId: "RENAMED", eligibleRunId: "OTHER" }), /already recorded/, "same terminal cannot grant twice with renamed identifiers");
  for (const status of ["DONE", "CLOSEOUT", "SUSPENDED_OVER_BUDGET"]) {
    objective.publishPreparedObjective({ path: objective.objectivePath(repo, "PRODUCT"), record: { ...granted, status } });
    assert.throws(() => objective.prepareControlBudget(repo, "PRODUCT", { ...budget, decisionId: "NEW" }), /cannot extend/);
  }
  objective.publishPreparedObjective({ path: objective.objectivePath(repo, "PRODUCT"), record: granted });
  assert.throws(() => objective.prepareRegisterRun(repo, { ...nextOptions, runId: "OTHER" }), /CONSOLIDATING/);
  assert.throws(() => objective.prepareRegisterRun(repo, { ...nextOptions, assuranceProfile: "baseline" }), /Standard/);
  assert.equal(objective.prepareRegisterRun(repo, nextOptions).record.status, "EXECUTING");
  const stateCLI = (args) => cp.spawnSync(process.execPath, [path.join(__dirname, "acef-state"), ...args, "--repo", repo], { encoding: "utf8" });
  const admitArgs = ["active-run", "--run-id", "MEDIA", "--objective-id", "PRODUCT", "--objective-scope", "Bounded fixture plus future work", "--workflow-id", "lightweight", "--assurance", "guarded", "--scope-unit", "story", "--status", "active", "--story", "MEDIA", "--phase", "development", "--ledger", "docs/ai/runs/MEDIA.md", "--product-review-contract", CONTRACT];
  const recordedSecurity = stateCLI(["objective-defect", "--objective-id", "PRODUCT", "--id", "SEC", "--source", "review", "--defect-class", "security", "--summary", "Actual synthetic unresolved critical source review finding after grant", "--discovered-in-run", "P01"]);
  assert.equal(recordedSecurity.status, 0, recordedSecurity.stderr);
  const beforeSecurityAdmit = [objectivePath, activePath].map((f) => fs.readFileSync(path.join(repo, f)));
  const securityAdmit = stateCLI(admitArgs); assert.equal(securityAdmit.status, 1); assert.match(securityAdmit.stderr, /unresolved critical/);
  for (const [i, f] of [objectivePath, activePath].entries()) assert.deepEqual(fs.readFileSync(path.join(repo, f)), beforeSecurityAdmit[i]);
  objective.publishPreparedObjective({ path: objective.objectivePath(repo, "PRODUCT"), record: granted });
  const closedCLI = stateCLI(["objective-close", "--objective-id", "PRODUCT", "--run-id", "P01", "--completion-evidence", "GREEN"]);
  assert.equal(closedCLI.status, 0, closedCLI.stderr); assert.equal(objective.loadObjective(repo, "PRODUCT").status, "DONE");
  const beforeDoneAdmit = [objectivePath, activePath].map((f) => fs.readFileSync(path.join(repo, f)));
  const doneAdmit = stateCLI(admitArgs); assert.equal(doneAdmit.status, 1); assert.match(doneAdmit.stderr, /terminal status/);
  for (const [i, f] of [objectivePath, activePath].entries()) assert.deepEqual(fs.readFileSync(path.join(repo, f)), beforeDoneAdmit[i]);
  objective.publishPreparedObjective({ path: objective.objectivePath(repo, "PRODUCT"), record: granted });
  const originalNow = Date.now;
  try { Date.now = () => Date.parse(budget.expiresAt) + 1; assert.throws(() => objective.prepareRegisterRun(repo, nextOptions), /unexpired/); }
  finally { Date.now = originalNow; }
  write("docs/ai/reports/authority.md", "tampered authority");
  assert.throws(() => objective.prepareRegisterRun(repo, nextOptions), /CONSOLIDATING/);
  write("docs/ai/reports/authority.md", "Explicit synthetic coordinator authorizes exactly one named run and finite additional control time.");
  const newRun = objective.prepareRegisterRun(repo, nextOptions).record;
  assert.equal(newRun.controlBudgetDecisions[0].observedActiveControlSeconds, granted.controlBudgetDecisions[0].observedActiveControlSeconds);
  const replanned = JSON.parse(JSON.stringify(newRun));
  replanned.replanEvents = [1, 2, 3].map((n) => ({ eventId: "RP" + n, runId: "MEDIA", cause: "scope-error", createdAt: new Date().toISOString() }));
  assert.equal(objective.reconcileObjective(repo, replanned).status, "CONSOLIDATING", "time grant must not bypass replan guard");
  const duplicated = JSON.parse(JSON.stringify(granted)); duplicated.controlBudgetDecisions.push({ ...duplicated.controlBudgetDecisions[0], decisionId: "RENAMED" });
  assert.throws(() => objective.validateObjective(duplicated), /duplicate/);
  const corrupt = JSON.parse(JSON.stringify(granted)); corrupt.controlBudgetDecisions[0].terminalGateSha256 = "0".repeat(64);
  assert.throws(() => objective.validateObjective(corrupt), /binding/);
  const expiryRecord = JSON.parse(JSON.stringify(newRun));
  expiryRecord.progress.activeControlSeconds = 3600;
  expiryRecord.progress.lastObservedAt = new Date().toISOString();
  assert.equal(objective.reconcileObjective(repo, expiryRecord).status, "CONSOLIDATING", "named active run has finite ceiling");
  const nextRunRecord = JSON.parse(JSON.stringify(newRun)); nextRunRecord.runs.push({ runId: "OTHER", openedAt: new Date().toISOString() }); nextRunRecord.runCount++;
  assert.equal(objective.reconcileObjective(repo, nextRunRecord).status, "CONSOLIDATING", "grant cannot carry to later run");
  const qaRecord = JSON.parse(JSON.stringify(granted)); qaRecord.manualQa.status = "running";
  objective.publishPreparedObjective({ path: objective.objectivePath(repo, "PRODUCT"), record: qaRecord });
  assert.throws(() => objective.prepareRegisterRun(repo, nextOptions), /manual QA/);
  objective.publishPreparedObjective({ path: objective.objectivePath(repo, "PRODUCT"), record: granted });
  console.log("PASS explicit budget CLI: default blocked, authentic terminal binding, one named run, no reset, finite expiry/ceiling, wrongrun/tamper/duplicate/baseline/manual-QA rejected");
  write("docs/ai/ACEF_LIGHTWEIGHT_RUN.json", { later: "different story" });
  delete active.productReviewContract; write("docs/ai/ACEF_ACTIVE_RUN.json", active);
  assert.equal(objective.collectObjectiveReviews(repo, completed).length, 5, "frozen per-run opt-in survives singleton replacement");
  report.browser.status = "UNVERIFIED"; write(reportPath, report);
  assert.throws(() => objective.prepareCloseObjective(repo, "PRODUCT", { completionEvidenceId: "GREEN" }), /no longer valid|review/);
  console.log("PASS product accounting synthetic regression: 3 then 4 REVISE + PASS, independent session, unbound gate rejection, report-required completion, durable review binding, legacy unaffected");
} finally { fs.rmSync(repo, { recursive: true, force: true }); }
