#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");
const crypto = require("node:crypto");
const cp = require("node:child_process");
const {
  parseActiveRun,
  parseActiveRunRecovery,
  parseActorRecord,
  parseEvidenceManifest,
  parseGateVerdict,
  parseReviewReport,
  parseDeveloperRepair,
  parseAssuranceCapsule,
  parseAtddCorrection,
  parseWorkerScope,
} = require("./lib/acef-state-parser");
const { loadModelRoutingPolicy, resolveRoleRuntime } = require("./lib/acef-model-routing");
const { validateDurableStoryClosePackage } = require("./lib/acef-story-close");
const { installationFreshnessFailures } = require("./lib/acef-installation");
const { objectiveFailures } = require("./lib/acef-objective-supervisor");

function sha256(value) {
  return crypto.createHash("sha256").update(value).digest("hex");
}

function parseArgs(argv) {
  const opts = { repo: process.cwd() };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--repo") opts.repo = argv[++index] || "";
    else if (arg === "--help" || arg === "-h") opts.help = true;
    else throw new Error(`Unknown argument: ${arg}`);
  }
  opts.repo = path.resolve(opts.repo);
  return opts;
}

function files(dir) {
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir).filter((name) => name.endsWith(".json")).sort().map((name) => path.join(dir, name));
}

function readRecord(parser, filePath) {
  try { return parser(filePath); }
  catch (error) { throw new Error(`${filePath}: ${error.message}`); }
}

function discoverCurrentRunActors(repo, dir, run, storyKey) {
  const records = [];
  const ignoredPaths = [];
  for (const filePath of files(dir)) {
    let raw;
    try { raw = JSON.parse(fs.readFileSync(filePath, "utf8")); }
    catch {
      // An unreadable candidate cannot prove that it belongs to another run,
      // so the strict parser below must fail closed with the canonical error.
    }
    const rawRecord = raw && typeof raw === "object" && !Array.isArray(raw) ? raw : null;
    const hasRawRunId = rawRecord !== null && Object.hasOwn(rawRecord, "runId");
    const rawRunId = typeof rawRecord?.runId === "string" && rawRecord.runId.trim()
      ? rawRecord.runId : null;
    const rawStoryKey = typeof rawRecord?.story === "string" && rawRecord.story.trim()
      ? token(rawRecord.story) : null;
    const differentRun = rawRunId !== null && rawRunId !== run.runId;
    const unrelatedLegacyStory = !hasRawRunId && rawStoryKey !== null && rawStoryKey !== storyKey;
    if (differentRun || unrelatedLegacyStory) {
      ignoredPaths.push(path.relative(repo, filePath).replaceAll(path.sep, "/"));
      continue;
    }
    const record = readRecord(parseActorRecord, filePath);
    if (token(record.story) === storyKey && record.runId === run.runId) records.push(record);
  }
  return { records, ignoredPaths };
}

function discoverCurrentStoryEvidence(repo, dir, run, storyKey) {
  const records = [];
  const ignoredPaths = [];
  for (const filePath of files(dir)) {
    let raw;
    try { raw = JSON.parse(fs.readFileSync(filePath, "utf8")); }
    catch {
      // An unreadable record cannot prove that it is historical, so the
      // strict parser below must fail closed with the canonical error.
    }
    const rawRecord = raw && typeof raw === "object" && !Array.isArray(raw) ? raw : null;
    const rawStoryKey = typeof rawRecord?.story === "string" && rawRecord.story.trim()
      ? token(rawRecord.story) : null;
    const rawEvidenceId = typeof rawRecord?.evidenceId === "string" && rawRecord.evidenceId.trim()
      ? rawRecord.evidenceId : null;
    const v2RunPrefix = `${token(run.runId)}-`;
    const unrelatedUnscopedV2Evidence = run.runtimeContract === "capsule-supervisor-v2"
      && rawStoryKey === null
      && rawEvidenceId !== null
      && !rawEvidenceId.startsWith(v2RunPrefix);
    if ((rawStoryKey !== null && rawStoryKey !== storyKey) || unrelatedUnscopedV2Evidence) {
      ignoredPaths.push(path.relative(repo, filePath).replaceAll(path.sep, "/"));
      continue;
    }
    records.push(readRecord(parseEvidenceManifest, filePath));
  }
  return { records, ignoredPaths };
}

function discoverCurrentRunRecords(repo, dir, run, storyKey, parser, { filterScope = true, decorate = null } = {}) {
  const records = [];
  const ignoredPaths = [];
  for (const filePath of files(dir)) {
    let raw;
    try { raw = JSON.parse(fs.readFileSync(filePath, "utf8")); }
    catch {
      // Unreadable candidates remain subject to strict parsing below.
    }
    const rawRecord = raw && typeof raw === "object" && !Array.isArray(raw) ? raw : null;
    const rawRunId = typeof rawRecord?.runId === "string" && rawRecord.runId.trim()
      ? rawRecord.runId
      : (typeof rawRecord?.run?.runId === "string" && rawRecord.run.runId.trim()
        ? rawRecord.run.runId : null);
    const rawScope = typeof rawRecord?.story === "string" && rawRecord.story.trim()
      ? rawRecord.story
      : (typeof rawRecord?.scope === "string" && rawRecord.scope.trim() ? rawRecord.scope : null);
    const differentRun = rawRunId !== null && rawRunId !== run.runId;
    const unrelatedScope = filterScope && rawScope !== null && token(rawScope) !== storyKey;
    if (differentRun || unrelatedScope) {
      ignoredPaths.push(path.relative(repo, filePath).replaceAll(path.sep, "/"));
      continue;
    }
    const record = readRecord(parser, filePath);
    records.push(decorate ? decorate(record, filePath) : record);
  }
  return { records, ignoredPaths };
}

function readCapsule(filePath) {
  const record = readRecord(parseAssuranceCapsule, filePath);
  const { integrity, ...payload } = record;
  if (integrity.payloadSha256 !== sha256(JSON.stringify(payload))) {
    throw new Error(`${filePath}: assurance capsule payload hash mismatch`);
  }
  for (const blob of [record.currentContext, record.diff, ...(record.sourceBlobs || [])]) {
    if (blob.sha256 !== sha256(Buffer.from(blob.content)) || blob.bytes !== Buffer.byteLength(blob.content)) {
      throw new Error(`${filePath}: assurance capsule blob mismatch ${blob.path}`);
    }
  }
  for (const ref of record.sourceRefs || []) {
    if (!/^[a-f0-9]{64}$/.test(ref.sha256) || !Number.isInteger(ref.bytes) || ref.bytes < 0) {
      throw new Error(`${filePath}: assurance capsule source reference metadata mismatch ${ref.path}`);
    }
  }
  return record;
}

function git(repo, args) {
  const result = cp.spawnSync("git", args, { cwd: repo, encoding: "utf8" });
  if (result.status !== 0) throw new Error(`git ${args.join(" ")} failed: ${(result.stderr || result.stdout).trim()}`);
  return result.stdout.trim();
}

function changedPaths(repo, from, to) {
  return git(repo, ["diff", "--name-only", `${from}..${to}`]).split(/\r?\n/).filter(Boolean);
}

function committedAtHead(repo, relativePath) {
  return cp.spawnSync("git", ["cat-file", "-e", `HEAD:${relativePath}`], {
    cwd: repo,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  }).status === 0;
}

function isControlPath(filePath) {
  return /^docs\/ai\//.test(filePath);
}

function isTestPath(filePath) {
  return /(^|\/)(__tests__|tests?|specs?)(\/|$)|(\.|-)(test|spec)\.[cm]?[jt]sx?$|Test\.(php|py|rb|cs)$/i.test(filePath);
}

function token(value) {
  return String(value || "").toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");
}

function capsuleRuntime(run) {
  return ["capsule-supervisor-v1", "capsule-supervisor-v2"].includes(run?.runtimeContract);
}

function quote(value) {
  return `'${String(value).replaceAll("'", `'\\''`)}'`;
}

function phase(value) {
  const normalized = token(value).replaceAll("_", "");
  const aliases = {
    dev: "development", developer: "development", review: "codereview", reviewer: "codereview",
    codereviewer: "codereview", processjudge: "processjudge", epicprocessjudge: "processjudge",
  };
  return aliases[normalized] || normalized;
}

function build(repo) {
  const freshnessFailures = installationFreshnessFailures(repo);
  if (freshnessFailures.length) throw new Error(freshnessFailures.join("; "));
  const activeRunPath = path.join(repo, "docs", "ai", "ACEF_ACTIVE_RUN.json");
  if (!fs.existsSync(activeRunPath)) throw new Error("missing docs/ai/ACEF_ACTIVE_RUN.json");
  const run = parseActiveRun(activeRunPath);
  const parentFailures = objectiveFailures(repo, run);
  if (parentFailures.length) throw new Error(parentFailures.join("; "));
  if (run.status !== "active" || run.workflowId !== "full-bmad"
    || run.fullFlowContract !== "four-actor-v3" || !capsuleRuntime(run)) {
    throw new Error("supervisor requires an active full-bmad/four-actor-v3/capsule-supervisor run");
  }
  const routingPolicy = loadModelRoutingPolicy(repo);
  const runtime = {
    atdd: resolveRoleRuntime(routingPolicy.record, "atdd"),
    development: resolveRoleRuntime(routingPolicy.record, "development"),
    "code-review": resolveRoleRuntime(routingPolicy.record, "code-review"),
    "patch-assurance": resolveRoleRuntime(routingPolicy.record, "patch-assurance"),
    "story-judge": resolveRoleRuntime(routingPolicy.record, "process-judge"),
    "epic-judge": resolveRoleRuntime(routingPolicy.record, "epic-process-judge"),
  };
  const story = run.activeStory;
  const storyKey = token(story);
  const headCommit = git(repo, ["rev-parse", "HEAD"]);
  const headTree = git(repo, ["rev-parse", "HEAD^{tree}"]);
  const actorDiscovery = discoverCurrentRunActors(path.resolve(repo), path.join(repo, "docs", "ai", "actors"), run, storyKey);
  const actors = actorDiscovery.records;
  const evidenceDiscovery = discoverCurrentStoryEvidence(path.resolve(repo), path.join(repo, "docs", "ai", "evidence"), run, storyKey);
  const allEvidence = evidenceDiscovery.records;
  const evidence = allEvidence
    .filter((record) => token(record.story) === storyKey
      && actors.some((actor) => actor.actorInstanceId === record.actorInstanceId))
    .sort((left, right) => String(left.finishedAt || left.startedAt || "").localeCompare(String(right.finishedAt || right.startedAt || ""))
      || left.evidenceId.localeCompare(right.evidenceId));
  const gateDiscovery = discoverCurrentRunRecords(path.resolve(repo), path.join(repo, "docs", "ai", "gates"), run, storyKey, parseGateVerdict, { filterScope: false });
  const allGates = gateDiscovery.records;
  const gates = allGates
    .filter((record) => token(record.scope) === storyKey && record.runId === run.runId)
    .sort((left, right) => Number(left.reviewCycle || 0) - Number(right.reviewCycle || 0));
  const reportDiscovery = discoverCurrentRunRecords(path.resolve(repo), path.join(repo, "docs", "ai", "reports"), run, storyKey, parseReviewReport);
  const reports = reportDiscovery.records
    .filter((record) => token(record.story) === storyKey && record.runId === run.runId);
  const repairDiscovery = discoverCurrentRunRecords(path.resolve(repo), path.join(repo, "docs", "ai", "repairs"), run, storyKey, parseDeveloperRepair);
  const repairs = repairDiscovery.records
    .filter((record) => token(record.story) === storyKey && record.runId === run.runId);
  const correctionDiscovery = discoverCurrentRunRecords(path.resolve(repo), path.join(repo, "docs", "ai", "corrections"), run, storyKey, parseAtddCorrection, {
    decorate: (record, filePath) => ({ ...record, supervisorFilePath: filePath }),
  });
  const corrections = correctionDiscovery.records
    .filter((record) => record.schema === "acef.atdd-correction.v2"
      && token(record.story) === storyKey && record.runId === run.runId);
  const capsuleDiscovery = discoverCurrentRunRecords(path.resolve(repo), path.join(repo, "docs", "ai", "capsules"), run, storyKey, readCapsule, {
    decorate: (record, filePath) => ({ ...record, supervisorFilePath: filePath }),
  });
  const capsules = capsuleDiscovery.records
    .filter((record) => token(record.story) === storyKey && record.runId === run.runId);
  const currentPhase = phase(run.activePhase);
  const workerScopePath = run.workerScopePath
    ? path.resolve(repo, run.workerScopePath)
    : path.join(repo, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json");
  const workerScope = fs.existsSync(workerScopePath) ? readRecord(parseWorkerScope, workerScopePath) : null;
  const latestGate = gates.at(-1) || null;
  const reviewCycle = latestGate?.verdict === "REVISE" ? Number(latestGate.reviewCycle) + 1 : Number(latestGate?.reviewCycle || 0);
  const runKey = token(run.runId);
  const actorPrefix = run.runtimeContract === "capsule-supervisor-v2"
    ? `acef_${runKey}_${storyKey}` : `acef_${storyKey}`;
  const actorId = (role, cycle = 0) => `${actorPrefix}_${role}${cycle ? `_retry${cycle}` : ""}`;
  const hasActor = (id) => actors.some((record) => record.actorInstanceId === id);
  const developerEvidence = evidence.filter((record) => record.actorInstanceId === actorId("development"));
  const latestDeveloperEvidence = developerEvidence.at(-1) || null;
  const activeCorrection = corrections.at(-1) || null;
  const activeAtddActorId = activeCorrection?.correctionActorId || actorId("atdd");
  const activeRedEvidence = evidence.find((record) => record.actorInstanceId === activeAtddActorId && record.exitCode !== 0) || null;
  let action;
  if (run.scopeUnit === "epic") {
    const contextPath = run.contextPath ? path.resolve(repo, run.contextPath) : null;
    const contextContent = contextPath && fs.existsSync(contextPath) ? fs.readFileSync(contextPath, "utf8") : "";
    const contextFresh = contextContent.includes(`- Active story: \`${run.activeStory}\``)
      && contextContent.includes(`- Active phase: \`${run.activePhase}\``)
      && contextContent.includes(`- Scope unit: \`${run.scopeUnit}\``);
    const terminal = latestGate && ["PASS", "FAIL", "REPLAN", "BLOCKED"].includes(latestGate.verdict);
    const judgeId = run.runtimeContract === "capsule-supervisor-v2"
      ? `acef_${runKey}_epic_process_judge` : "acef_epic_process_judge";
    const judgeExists = hasActor(judgeId);
    const storyPassGates = (run.expectedStories || []).map((expectedStory) => allGates
      .filter((record) => record.runId === run.runId && record.fullFlowContract === run.fullFlowContract
        && ["deterministic-story-close-v3", "recovered-story-close-v1"].includes(record.gateType)
        && token(record.scope) === token(expectedStory) && record.verdict === "PASS")
      .sort((left, right) => Number(left.reviewCycle || 0) - Number(right.reviewCycle || 0)).at(-1))
      .filter(Boolean);
    const greenEvidenceIds = [...new Set(storyPassGates.map((record) => record.greenEvidenceId).filter(Boolean))];
    const epicGateId = `${token(run.runId)}-epic-close`;
    const epicClosePaths = [
      "docs/ai/ACEF_ACTIVE_RUN.json",
      run.contextPath || "docs/ai/ACEF_CURRENT_CONTEXT.md",
      `docs/ai/actors/${judgeId}.json`,
      `docs/ai/gates/${epicGateId}.json`,
    ];
    const gateCommand = (verdict) => `.acef/bin/acef-state gate --repo . --id ${epicGateId} --scope ${quote(story)}`
      + ` --verdict ${verdict} --decided-by ${judgeId}`
      + (verdict === "PASS" ? greenEvidenceIds.map((id) => ` --evidence ${id}`).join("") : "");
    action = !contextFresh
      ? { type: "transition", nextPhase: "epic-process-judge", command: ".acef/bin/acef-state context-sync --repo .",
        reason: "synchronize the bounded Current Context from typed epic state before the one-shot Judge" }
      : terminal
      ? {
        type: "complete-epic",
        disposition: latestGate.verdict,
        completionCommand: `.acef/bin/acef-state epic-complete --repo . --gate-id ${latestGate.gateId}`,
        commitCommand: `git add -- ${epicClosePaths.map(quote).join(" ")} && git commit -m ${quote(`chore(acef): close ${run.runId}`)} -- ${epicClosePaths.map(quote).join(" ")}`,
        committedPaths: epicClosePaths,
        reason: "terminal Epic Judge gate exists; complete typed state and commit the exact control-only close package",
      }
      : judgeExists
        ? { type: "replan", reason: "the non-retryable epic Process Judge exists without a terminal epic gate" }
        : {
          type: "dispatch", role: "epic-judge", actorInstanceId: judgeId, runtime: runtime["epic-judge"],
          registrationCommand: `.acef/bin/acef-state actor --repo . --id ${judgeId} --story ${quote(story)}`
            + ` --phase epic-process-judge --role process-judge --client codex --session-id /root/${judgeId}`
            + ` --context-profile epic-process-judge --model ${runtime["epic-judge"].model} --effort ${runtime["epic-judge"].reasoningEffort}`,
          decisionCommands: {
            PASS: gateCommand("PASS"), FAIL: gateCommand("FAIL"), REPLAN: gateCommand("REPLAN"), BLOCKED: gateCommand("BLOCKED"),
          },
          storyGateIds: storyPassGates.map((record) => record.gateId),
          greenEvidenceIds,
          reason: "register the one-shot independent epic Judge and give it state-writer-owned terminal commands",
        };
  } else if (currentPhase === "readiness") {
    action = {
      type: "transition",
      nextPhase: "atdd",
      command: ".acef/bin/acef-state phase-transition --repo . --phase atdd",
      reason: "readiness and reuse are deterministic conductor gates; enter the compiled actor lifecycle",
    };
  } else if (currentPhase === "atdd") {
    const scopeReady = workerScope && workerScope.runId === run.runId
      && token(workerScope.activeStory) === storyKey;
    const red = evidence.find((record) => record.actorInstanceId === actorId("atdd") && record.exitCode !== 0);
    const frozenTestPaths = (workerScope?.allowedPaths || []).filter(isTestPath);
    action = !scopeReady
      ? { type: "blocked", reason: "refresh the typed worker scope for the active frozen story before ATDD dispatch" }
      : red
        ? { type: "transition", nextPhase: "development", command: ".acef/bin/acef-state phase-transition --repo . --phase development", reason: "typed red evidence exists" }
        : { type: "dispatch", role: "atdd", actorInstanceId: actorId("atdd"), runtime: runtime.atdd,
          precheckCommand: `.acef/bin/acef-state atdd-precheck --repo .${frozenTestPaths.map((filePath) => ` --test-path ${quote(filePath)}`).join("")}`,
          reason: "run the deterministic test-harness precheck after editing and before the clean red commit" };
  } else if (currentPhase === "atddcorrection") {
    const bindingPath = activeCorrection?.supervisorFilePath || "";
    const bindingRelative = bindingPath ? path.relative(repo, bindingPath).replaceAll(path.sep, "/") : "";
    let bindingCommitted = false;
    if (bindingRelative) {
      try { bindingCommitted = git(repo, ["show", `HEAD:${bindingRelative}`]) === fs.readFileSync(bindingPath, "utf8").trim(); }
      catch {}
    }
    if (!activeCorrection) {
      action = { type: "replan", reason: "ATDD correction phase lacks its immutable v2 correction binding" };
    } else if (!bindingCommitted) {
      const controlPaths = [
        bindingRelative,
        "docs/ai/ACEF_ACTIVE_RUN.json",
        "docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json",
        run.contextPath || "docs/ai/ACEF_CURRENT_CONTEXT.md",
      ];
      action = {
        type: "commit-control",
        command: `git add -- ${controlPaths.map(quote).join(" ")} && git commit -m ${quote(`chore(acef): start ${story} ATDD correction`)} -- ${controlPaths.map(quote).join(" ")}`,
        committedPaths: controlPaths,
        reason: "commit the bounded correction binding and restricted worker scope before fresh ATDD correction dispatch",
      };
    } else if (activeRedEvidence) {
      action = {
        type: "transition", nextPhase: "development",
        command: ".acef/bin/acef-state phase-transition --repo . --phase development",
        reason: "replacement test-only red evidence is bound; resume the original Developer session",
      };
    } else {
      const originalRed = evidence.find((record) => record.evidenceId === activeCorrection.originalRedEvidenceId);
      if (!originalRed?.commandArgv?.length || !originalRed.discovery?.argv?.length) {
        action = { type: "replan", reason: "original red evidence lacks replayable command/discovery argv" };
      } else {
        const replacementId = run.runtimeContract === "capsule-supervisor-v2"
          ? `${runKey}-${storyKey}-red-correction1` : `${storyKey}-red-correction1`;
        const evidenceCommand = [
          ".acef/bin/acef-state", "evidence-run", "--repo", ".", "--id", replacementId,
          "--kind", "runtime-test", "--actor", activeCorrection.correctionActorId, "--story", story,
          "--model", runtime.atdd.model, "--effort", runtime.atdd.reasoningEffort,
          "--discovery-command-json", JSON.stringify(originalRed.discovery.argv),
          ...originalRed.discovery.expectedTests.flatMap((identity) => ["--expected-test", identity]),
          ...originalRed.satisfies.flatMap((acceptance) => ["--satisfies", acceptance]),
          "--", ...originalRed.commandArgv,
        ].map(quote).join(" ");
        action = {
          type: "dispatch", role: "atdd-correction", actorInstanceId: activeCorrection.correctionActorId,
          runtime: runtime.atdd,
          precheckCommand: `.acef/bin/acef-state atdd-precheck --repo .${activeCorrection.allowedPaths.map((filePath) => ` --test-path ${quote(filePath)}`).join("")}`,
          stageCommand: `git add -- ${activeCorrection.allowedPaths.map(quote).join(" ")}`,
          commitCommand: `git commit -m ${quote(`test(acef): correct ${story} red semantics`)} -- ${activeCorrection.allowedPaths.map(quote).join(" ")}`,
          redEvidenceId: replacementId,
          redEvidenceCommand: evidenceCommand,
          correctionBindingPath: bindingRelative,
          correctionBindingSha256: sha256(fs.readFileSync(bindingPath)),
          reason: "fresh independent ATDD actor must repair only frozen tests and bind replacement behavioral red evidence",
        };
      }
    }
  } else if (currentPhase === "recoveryreview") {
    const judgeId = actorId("recovery_process_judge");
    const recoveryGate = gates.find((record) => record.gateType === "recovered-story-close-v1") || null;
    const receiptPath = path.join(repo, "docs", "ai", "recoveries", `${run.runId}-legacy-dispatch-recovery.json`);
    if (!fs.existsSync(receiptPath)) {
      action = { type: "blocked", reason: "recovery-review phase lacks its immutable pending-review receipt" };
    } else if (!recoveryGate) {
      const receipt = readRecord(parseActiveRunRecovery, receiptPath);
      if (hasActor(judgeId)) {
        action = { type: "replan", reason: "recovery Process Judge actor exists without its immutable decision/gate" };
      } else {
        const base = `.acef/bin/acef-state recovery-review --repo . --actor ${judgeId} --session-id /root/${judgeId}`;
        action = {
          type: "dispatch",
          role: "recovery-review",
          actorInstanceId: judgeId,
          runtime: runtime["story-judge"],
          recoveryReceipt: {
            path: path.relative(repo, receiptPath).replaceAll(path.sep, "/"),
            sha256: sha256(fs.readFileSync(receiptPath)),
            changedRedTests: receipt.changedRedTests,
            outOfScopeProductTestPaths: receipt.outOfScopeProductTestPaths,
          },
          decisionCommands: {
            PASS: `${base} --verdict PASS`,
            REPLAN: `${base} --verdict REPLAN`,
          },
          reason: "dispatch exactly one calibrated Process Judge over the hash-bound recovered RED/product/PASS package",
        };
      }
    } else if (recoveryGate.verdict !== "PASS") {
      action = { type: "replan", reason: "independent recovery Process Judge returned REPLAN" };
    } else {
      const gatePath = path.join(repo, "docs", "ai", "gates", `${recoveryGate.gateId}.json`);
      const closePackage = validateDurableStoryClosePackage(repo, recoveryGate, gatePath);
      if (closePackage.ok) {
        action = {
          type: "transition",
          nextPhase: "next-story-or-epic-close",
          command: ".acef/bin/acef-state story-transition --repo .",
          storyCloseCommit: closePackage.packageCommit,
          reason: "independent recovery PASS and its exact close package are durably committed",
        };
      } else if (!closePackage.gateCommitted) {
        const pathspec = closePackage.packagePaths.map(quote).join(" ");
        action = {
          type: "commit-story-close",
          gateId: recoveryGate.gateId,
          packagePaths: closePackage.packagePaths,
          stageCommand: `git add -f -- ${pathspec}`,
          commitCommand: `git commit -m ${quote(`chore(acef): close recovered ${story}`)} -- ${pathspec}`,
          reason: "commit the exact recovered receipt/raw/Judge/gate/state package before story transition",
        };
      } else {
        action = { type: "replan", reason: `committed recovered story-close package is invalid: ${closePackage.failures.join("; ")}` };
      }
    }
  } else if (currentPhase === "development") {
    const pendingRepair = latestGate?.verdict === "REVISE"
      && !repairs.some((record) => record.cycle === reviewCycle);
    const postGateEvidence = pendingRepair
      ? developerEvidence.filter((record) => String(record.finishedAt || record.startedAt || "") > String(latestGate.createdAt || ""))
      : [];
    const latestRepairEvidence = postGateEvidence.at(-1) || null;
    const repairReceiptId = `${storyKey}-repair${reviewCycle}`;
    const repairReceiptPath = `docs/ai/repairs/${repairReceiptId}.json`;
    const repairCommand = latestGate
      ? `.acef/bin/acef-state developer-repair --repo . --id ${repairReceiptId} --prior-gate ${latestGate.gateId} --developer-actor ${actorId("development")}`
      : null;
    if (pendingRepair && !latestRepairEvidence) {
      action = {
        type: "resume", role: "development", actorInstanceId: actorId("development"), runtime: runtime.development,
        repairCycle: reviewCycle, repairCommand, repairReceiptPath,
        reason: "review findings returned the existing work contract atomically to the original Developer",
      };
    } else if (pendingRepair && latestRepairEvidence?.exitCode === 0 && latestRepairEvidence.discovery) {
      action = { type: "replan", reason: `Developer repair returned green evidence without the exact supervisor-owned receipt ${repairReceiptPath}` };
    } else if (!hasActor(actorId("development"))) {
      const developerId = actorId("development");
      action = {
        type: "dispatch",
        role: "development",
        actorInstanceId: developerId,
        runtime: runtime.development,
        registrationCommand: `.acef/bin/acef-state actor --repo . --id ${developerId} --story ${quote(story)} --phase development --role developer --client codex --session-id /root/${developerId} --context-profile development --model ${runtime.development.model} --effort ${runtime.development.reasoningEffort}`,
        reason: "register the one canonical story Developer before spawn so green evidence can bind its session",
      };
    } else if (activeCorrection && !activeRedEvidence) {
      action = { type: "replan", reason: "post-red ATDD correction exists without replacement red evidence" };
    } else if (activeCorrection && !latestDeveloperEvidence) {
      action = {
        type: "resume", role: "development", actorInstanceId: actorId("development"), runtime: runtime.development,
        correctionActorInstanceId: activeCorrection.correctionActorId,
        requiredFinalMarker: `POST_RED_ATDD_CORRECTION=${activeCorrection.correctionActorId}`,
        reason: "resume the original Developer only after independent replacement red evidence",
      };
    } else if (latestDeveloperEvidence?.exitCode === 0 && latestDeveloperEvidence.discovery) {
      action = { type: "transition", nextPhase: "code-review", command: ".acef/bin/acef-state phase-transition --repo . --phase code-review", reason: "green evidence and discovery contract exist" };
    } else {
      action = { type: "replan", reason: "Developer returned without accepted green evidence; attempts belong inside the one Developer turn" };
    }
  } else if (currentPhase === "codereview") {
    if (latestGate?.verdict === "PASS") {
      const gatePath = path.join(repo, "docs", "ai", "gates", `${latestGate.gateId}.json`);
      const closePackage = validateDurableStoryClosePackage(repo, latestGate, gatePath);
      if (closePackage.ok) {
        action = {
          type: "transition",
          nextPhase: "next-story-or-epic-close",
          command: ".acef/bin/acef-state story-transition --repo .",
          storyCloseCommit: closePackage.packageCommit,
          reason: "deterministic story PASS and its exact close package are durably committed",
        };
      } else if (!closePackage.gateCommitted) {
        const precommittedOwnedPaths = closePackage.closeOwnedPaths
          .filter((relativePath) => relativePath !== `docs/ai/gates/${latestGate.gateId}.json`)
          .filter((relativePath) => committedAtHead(repo, relativePath));
        const missingPaths = closePackage.packagePaths.filter((relativePath) => !fs.existsSync(path.join(repo, relativePath)));
        if (precommittedOwnedPaths.length || missingPaths.length) {
          action = {
            type: "replan",
            reason: precommittedOwnedPaths.length
              ? `story-close ownership was split before the PASS gate: ${precommittedOwnedPaths.join(", ")}`
              : `story-close package paths are missing: ${missingPaths.join(", ")}`,
          };
        } else {
          const pathspec = closePackage.packagePaths.map(quote).join(" ");
          action = {
            type: "commit-story-close",
            gateId: latestGate.gateId,
            packagePaths: closePackage.packagePaths,
            stageCommand: `git add -f -- ${pathspec}`,
            commitCommand: `git commit -m ${quote(`chore(acef): close ${story}`)} -- ${pathspec}`,
            reason: "commit the exact gate-bound control package before any story or epic transition",
          };
        }
      } else {
        action = {
          type: "replan",
          reason: `committed story-close package is invalid and immutable: ${closePackage.failures.join("; ")}`,
        };
      }
    } else if (latestGate?.verdict === "REVISE"
      && [latestGate.actors?.codeReview, latestGate.actors?.patchAssurance]
        .map((id) => reports.find((report) => report.actorInstanceId === id))
        .every((report) => report?.verdict === "PASS")
      && Object.entries(latestGate.executedChecks || {}).some(([, passed]) => passed !== true)) {
      const failedChecks = Object.entries(latestGate.executedChecks || {})
        .filter(([, passed]) => passed !== true).map(([check]) => check);
      action = {
        type: "replan",
        reason: `mechanical story gate failed with semantic reviewers PASS: ${failedChecks.join(", ") || "unknown check"}`,
      };
    } else if (latestGate?.verdict === "REVISE" && !repairs.some((record) => record.cycle === reviewCycle)) {
      action = {
        type: "transition", nextPhase: "development",
        command: ".acef/bin/acef-state phase-transition --repo . --phase development",
        reason: "REVISE atomically returns run and worker scope to the original Developer before repair",
      };
    } else {
      const repair = reviewCycle > 0 ? repairs.find((record) => record.cycle === reviewCycle) : null;
      const priorCodeReport = latestGate?.reportPaths?.codeReview
        ? readRecord(parseReviewReport, path.resolve(repo, latestGate.reportPaths.codeReview)) : null;
      const productionRepair = repair
        ? changedPaths(repo, repair.preCommit, repair.postCommit).some((filePath) => !isControlPath(filePath) && !isTestPath(filePath))
        : false;
      const retainCodeReview = reviewCycle > 0 && priorCodeReport?.verdict === "PASS" && !productionRepair;
      const codeId = retainCodeReview ? priorCodeReport.actorInstanceId : actorId("code_review", reviewCycle);
      const assuranceId = actorId("patch_assurance", reviewCycle);
      const codeReport = reports.find((record) => record.actorInstanceId === codeId);
      const assuranceReport = reports.find((record) => record.actorInstanceId === assuranceId);
      const currentCapsule = (id) => capsules.find((record) => record.actorInstanceId === id
        && record.inputCommit === headCommit && record.inputTree === headTree && record.reviewCycle === reviewCycle);
      const requiredReviewerIds = retainCodeReview ? [assuranceId] : [codeId, assuranceId];
      const missingCapsuleIds = requiredReviewerIds.filter((id) => !currentCapsule(id));
      if (missingCapsuleIds.length) {
        const red = activeRedEvidence;
        const green = [...developerEvidence].reverse().find((record) => record.exitCode === 0 && record.discovery);
        const baseCommit = reviewCycle > 0 ? latestGate?.applicationCommit : workerScope?.baseRef;
        const repairReceipt = reviewCycle > 0 ? `docs/ai/repairs/${storyKey}-repair${reviewCycle}.json` : null;
        if (!red || !green || !baseCommit || (reviewCycle > 0 && !repairs.some((record) => record.cycle === reviewCycle))) {
          action = { type: "blocked", reason: "review capsule inputs are incomplete" };
        } else {
          const capsuleCommand = (role, actor) => {
            const id = `${storyKey}-${role}${reviewCycle ? `-retry${reviewCycle}` : ""}`;
            return `.acef/bin/acef-state review-capsule --repo . --id ${id} --role ${role} --actor ${actor} --base-commit ${baseCommit} --red-evidence ${red.evidenceId} --green-evidence ${green.evidenceId} --review-cycle ${reviewCycle}${repairReceipt ? ` --repair-receipt ${repairReceipt}` : ""}`;
          };
          action = {
            type: "prepare-review-capsules", reviewCycle,
            roles: retainCodeReview ? ["patch-assurance"] : ["code-review", "patch-assurance"], runtime: null,
            scopeCommand: ".acef/bin/acef-state review-scope --repo .",
            scopeCommitPolicy: reviewCycle === 0 ? "commit-if-changed-before-capsules" : "revalidate-only-no-repair-layer-commit",
            capsuleCommands: retainCodeReview
              ? [capsuleCommand("patch-assurance", assuranceId)]
              : [capsuleCommand("code-review", codeId), capsuleCommand("patch-assurance", assuranceId)],
            reason: retainCodeReview
              ? "test-only repair retains prior Code Review PASS; create only Patch Assurance capsule"
              : "derive current committed surfaces, then create exact role capsules",
          };
        }
      } else if (!codeReport || !assuranceReport) {
        const pending = [];
        const reviewerAction = (role, id) => {
          const capsule = currentCapsule(id);
          const capsuleId = path.basename(capsule.supervisorFilePath, ".json");
          const capsulePath = path.relative(repo, capsule.supervisorFilePath).replaceAll(path.sep, "/");
          return {
            role, actorInstanceId: id, runtime: runtime[role],
            capsule: {
              id: capsuleId,
              path: capsulePath,
              sha256: sha256(fs.readFileSync(capsule.supervisorFilePath)),
              showCommand: `.acef/bin/acef-state capsule-show --repo . --id ${capsuleId}`,
            },
          };
        };
        if (!codeReport) pending.push(reviewerAction("code-review", codeId));
        if (!assuranceReport) pending.push(reviewerAction("patch-assurance", assuranceId));
        action = {
          type: pending.length > 1 ? "dispatch-parallel" : "dispatch",
          reviewCycle,
          ...(pending.length > 1 ? {
            actors: pending,
            concurrency: {
              preferred: 2,
              minimum: 1,
              fallback: "sequential-same-input-tree",
              rule: "Never wait for an extra slot and never drop a required reviewer; dispatch sequentially when only one worker slot is available.",
            },
          } : pending[0]),
        };
      } else {
        const red = activeRedEvidence;
        const green = [...developerEvidence].reverse().find((record) => record.exitCode === 0 && record.discovery);
        const codeActor = actors.find((record) => record.actorInstanceId === codeId);
        const assuranceActor = actors.find((record) => record.actorInstanceId === assuranceId);
        if (!red || !green || !codeActor?.producedArtifactHash || !assuranceActor?.producedArtifactHash) {
          action = { type: "blocked", reason: "typed story-gate inputs are incomplete" };
        } else if (!workerScope?.surfaces?.length) {
          action = { type: "blocked", reason: "typed story-gate inputs require derived worker-scope surfaces" };
        } else {
          const gateId = `${storyKey}-review-cycle${reviewCycle}`;
          const repairArg = reviewCycle > 0 ? ` --repair-receipt docs/ai/repairs/${storyKey}-repair${reviewCycle}.json` : "";
          const roundTripRequired = workerScope.requiresRoundTrip === true || workerScope.patternUse === "new-reusable-pattern";
          const firstUsePattern = workerScope.patternUse === "new-reusable-pattern";
          const surfaceArgs = workerScope.surfaces.map((surface) => ` --surface-evidence ${surface}:${green.evidenceId}:${roundTripRequired}:${firstUsePattern}`).join("");
          const bindingArgs = (workerScope.inputOutputBindings || []).map((binding) =>
            ` --binding-evidence ${quote(`${binding.inputSurface}>${binding.outputSurface}:${binding.field}:${green.evidenceId}:true:${binding.defaultMaskingRisk === true}`)}`
          ).join("");
          const command = `.acef/bin/acef-state gate --repo . --id ${gateId} --scope ${quote(story)}`
            + ` --atdd-actor ${activeAtddActorId} --development-actor ${actorId("development")}`
            + ` --code-review-actor ${codeId} --patch-assurance-actor ${assuranceId}`
            + ` --red-evidence ${red.evidenceId} --green-evidence ${green.evidenceId}`
            + ` --code-review-report-hash ${codeActor.producedArtifactHash} --patch-assurance-report-hash ${assuranceActor.producedArtifactHash}`
            + ` --review-cycle ${reviewCycle}${repairArg}${surfaceArgs}${bindingArgs}`;
          action = { type: "write-story-gate", reviewCycle, command, runtime: null,
            expectedDisposition: [codeReport.verdict, assuranceReport.verdict].every((verdict) => verdict === "PASS") ? "PASS" : "REVISE_OR_REPLAN",
            reason: "both independent typed review results are present; deterministic gate computes disposition" };
        }
      }
    }
  } else if (currentPhase === "processjudge") {
    action = { type: "dispatch", role: run.scopeUnit === "epic" ? "epic-judge" : "story-judge", actorInstanceId: run.scopeUnit === "epic"
      ? (run.runtimeContract === "capsule-supervisor-v2" ? `acef_${runKey}_epic_process_judge` : "acef_epic_process_judge")
      : actorId("process_judge"), runtime: runtime[run.scopeUnit === "epic" ? "epic-judge" : "story-judge"] };
  } else {
    action = { type: "blocked", reason: `unsupported active phase ${run.activePhase}` };
  }
  const state = {
    runId: run.runId, story, phase: run.activePhase, scopeUnit: run.scopeUnit,
    counts: { actors: actors.length, evidence: evidence.length, gates: gates.length, reports: reports.length, repairs: repairs.length, capsules: capsules.length },
  };
  return {
    schema: "acef.supervisor-action.v1",
    runtimeContract: run.runtimeContract,
    stateSha256: sha256(JSON.stringify(state)),
    state,
    action,
    diagnostics: [
      ...(actorDiscovery.ignoredPaths.length ? [{
        code: "ignored-unrelated-actor-records",
        count: actorDiscovery.ignoredPaths.length,
        samplePaths: actorDiscovery.ignoredPaths.slice(0, 5),
        truncated: actorDiscovery.ignoredPaths.length > 5,
      }] : []),
      ...(evidenceDiscovery.ignoredPaths.length ? [{
        code: "ignored-unrelated-evidence-records",
        count: evidenceDiscovery.ignoredPaths.length,
        samplePaths: evidenceDiscovery.ignoredPaths.slice(0, 5),
        truncated: evidenceDiscovery.ignoredPaths.length > 5,
      }] : []),
      ...([gateDiscovery, reportDiscovery, repairDiscovery, correctionDiscovery, capsuleDiscovery]
        .flatMap((discovery) => discovery.ignoredPaths).length ? [{
          code: "ignored-unrelated-runtime-records",
          count: [gateDiscovery, reportDiscovery, repairDiscovery, correctionDiscovery, capsuleDiscovery]
            .flatMap((discovery) => discovery.ignoredPaths).length,
          samplePaths: [gateDiscovery, reportDiscovery, repairDiscovery, correctionDiscovery, capsuleDiscovery]
            .flatMap((discovery) => discovery.ignoredPaths).slice(0, 5),
          truncated: [gateDiscovery, reportDiscovery, repairDiscovery, correctionDiscovery, capsuleDiscovery]
            .flatMap((discovery) => discovery.ignoredPaths).length > 5,
        }] : []),
    ],
    modelPolicy: {
      active: routingPolicy.record.policyId,
      provider: routingPolicy.record.activeProvider,
      policySha256: routingPolicy.sha256,
      mechanicalOperations: "no-model",
      roles: runtime,
      note: "Role assignments use provider-neutral execution classes and reasoning tiers; provider mappings are replaceable only through a calibrated policy artifact.",
    },
  };
}

try {
  const opts = parseArgs(process.argv.slice(2));
  if (opts.help) {
    console.log("Usage: acef-supervisor --repo <path>");
  } else {
    console.log(JSON.stringify(build(opts.repo), null, 2));
  }
} catch (error) {
  console.error(`ACEF_SUPERVISOR_ERROR: ${error.message}`);
  process.exitCode = 1;
}
