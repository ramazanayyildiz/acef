#!/usr/bin/env node
const cp = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");
const {
  chooseUpdateProfile,
  dropInstallationComponent,
  readCommittedManifest,
  readInstallationManifest,
  rewriteInstallationUpdateCommand,
  writeCanonicalRootMarker,
} = require("./lib/acef-installation");

const defaultSourceRoot = path.resolve(__dirname, "..");

function usage() {
  console.log(`Usage: scripts/update-acef-installation --repo <path> [--profile slice|core|full] [--all-worktrees] [--review-lenses] [--all-core] [--global-dispatcher]

Profiles: slice = recorded skills (default codex + 4 skills) and the Slice lane kit, no .acef tools, no BMAD guard;
core = tools + skills, no BMAD guard; full = tools + skills + BMAD guard.
Without --profile the recorded profile and the recorded tool/skill selection are reused.
A record without a profile: if it lists the BMAD guard but any guard file (.acef/hooks/acef-bmad-hard-wall.mjs,
.acef/hooks/acef-precommit-gate.sh, .opencode/plugins/acef-bmad-hard-wall.js) is missing, the host removed the guard,
so core is used, bmadGuard is dropped from the record and a warning is printed; otherwise full. The chosen profile is
written into the record. An update never reinstalls a removed guard unless --profile full is passed.

Refreshes a target repo from this ACEF checkout:
  1. repo-local ACEF tools, schemas, workflows, and support libraries
  2. repo-local ACEF skills for Codex, Claude, and OpenCode
  3. repo-local BMAD hard-wall guard
  4. docs/ai/ACEF_INSTALLATION.json source/version stamp
  5. .acef/CANONICAL_ROOT explicit portable root marker

A file the host changed since ACEF installed it is kept and reported ("kept host-modified <path>"), never overwritten;
.acef/model-routing-policy.json is merged (host values kept, only new keys added).

The stamp records this ACEF checkout path, commit, branch, dirty/clean state, installed components, and the update command.`);
}

function parseArgs(argv) {
  const opts = {
    repo: "",
    reviewLenses: false,
    allCore: false,
    globalDispatcher: false,
    allWorktrees: false,
    profile: "",
  };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--repo" || arg === "--target") {
      opts.repo = argv[++index] || "";
    } else if (arg === "--review-lenses") {
      opts.reviewLenses = true;
    } else if (arg === "--all-core") {
      opts.allCore = true;
    } else if (arg === "--global-dispatcher") {
      opts.globalDispatcher = true;
    } else if (arg === "--profile") {
      opts.profile = argv[++index] || "";
      if (!["slice", "core", "full"].includes(opts.profile)) throw new Error(`Unknown profile: ${opts.profile}`);
    } else if (arg === "--all-worktrees") {
      opts.allWorktrees = true;
    } else if (arg === "-h" || arg === "--help") {
      usage();
      process.exit(0);
    } else {
      throw new Error(`Unknown argument: ${arg}`);
    }
  }
  if (!opts.repo) throw new Error("--repo is required");
  opts.repo = path.resolve(opts.repo);
  return opts;
}

function resolveSourceRoot(targetRepo) {
  const directInstaller = path.join(defaultSourceRoot, "scripts", "install-acef-tools");
  if (fs.existsSync(directInstaller)) return defaultSourceRoot;

  if (process.env.ACEF_SOURCE && fs.existsSync(path.join(process.env.ACEF_SOURCE, "scripts", "install-acef-tools"))) {
    return path.resolve(process.env.ACEF_SOURCE);
  }
  const manifest = readInstallationManifest(targetRepo);
  if (!manifest) {
    throw new Error("cannot locate ACEF source checkout; missing docs/ai/ACEF_INSTALLATION.json");
  }
  const sourcePath = manifest.acefVersion?.sourcePath;
  if (!sourcePath || !fs.existsSync(path.join(sourcePath, "scripts", "install-acef-tools"))) {
    throw new Error("ACEF_INSTALLATION.json does not point at a usable ACEF source checkout");
  }
  return sourcePath;
}

function run(sourceRoot, script, args, env = {}) {
  const output = cp.execFileSync(process.execPath, [path.join(sourceRoot, "scripts", script), ...args], {
    cwd: sourceRoot,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    env: { ...process.env, ...env },
  });
  process.stdout.write(output);
}

function targetWorktrees(repo, allWorktrees) {
  if (!allWorktrees) return [repo];
  const output = cp.execFileSync("git", ["-C", repo, "worktree", "list", "--porcelain"], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
  const targets = output.split(/\r?\n/)
    .filter((line) => line.startsWith("worktree "))
    .map((line) => path.resolve(line.slice("worktree ".length)));
  return [...new Set(targets)];
}

// Re-apply exactly what was selected before (owner decision 2026-10-25): a selective install must never silently
// grow into a full one. A record without a profile is decided by chooseUpdateProfile (owner decision 2026-10-27): a
// guard the host removed is never reinstalled without an explicit --profile full.
// Host-modified files are kept (owner decision 2026-10-27; see createOwnedFileWriter in lib/acef-installation.js). The
// first installer rewrites the record's source path, so the checkout that made the previous install is passed on: a
// legacy record without file hashes reads its baseline from that checkout at the recorded commit.
function updateTarget(sourceRoot, targetRepo, opts) {
  const record = readCommittedManifest(targetRepo) || {};
  const previousSource = readInstallationManifest(targetRepo)?.acefVersion?.sourcePath;
  const env = previousSource ? { ACEF_PREVIOUS_SOURCE_PATH: previousSource } : {};
  const choice = chooseUpdateProfile(record, opts.profile, targetRepo);
  const profile = choice.profile;
  if (choice.warning) console.log(choice.warning);
  if (choice.dropBmadGuard) dropInstallationComponent(targetRepo, "bmadGuard");
  const recorded = record.components?.skills || {};
  if (profile !== "slice") run(sourceRoot, "install-acef-tools", ["--repo", targetRepo], env);
  const skillArgs = ["--repo", targetRepo, "--profile", profile];
  const tools = recorded.tools && recorded.tools.length ? recorded.tools : null;
  if (tools && !opts.profile) for (const tool of tools) skillArgs.push("--tool", tool);
  if (recorded.skills && recorded.skills.length && !opts.profile && !opts.allCore) for (const skill of recorded.skills) skillArgs.push("--skill", skill);
  const dirs = recorded.skillsDirs || {};
  if (tools && tools.length === 1 && !opts.profile) {
    const fallback = { codex: ".codex/skills", claude: ".claude/skills", opencode: ".opencode/skills" }[tools[0]];
    if (dirs[tools[0]] && dirs[tools[0]] !== fallback) skillArgs.push("--skills-dir", dirs[tools[0]]);
  }
  if (opts.reviewLenses || recorded.reviewLenses === true) skillArgs.push("--review-lenses");
  if (opts.allCore || recorded.allCore === true) skillArgs.push("--all-core");
  run(sourceRoot, "install-acef-skills", skillArgs, env);
  if (profile === "slice" || record.components?.sliceKit) {
    run(sourceRoot, "install-acef-slice-kit", ["--repo", targetRepo]);
  }
  if (profile === "full") {
    const guardArgs = ["--repo", targetRepo];
    if (opts.globalDispatcher) guardArgs.push("--global-dispatcher");
    run(sourceRoot, "install-acef-bmad-guard", guardArgs, env);
    // The hard-wall guard reads this marker to bind discovery to the owning repository.
    writeCanonicalRootMarker(targetRepo);
  }
  rewriteInstallationUpdateCommand(targetRepo, sourceRoot, { allWorktrees: opts.allWorktrees });
  console.log(`UPDATED_WORKTREE ${targetRepo}`);
}

try {
  const opts = parseArgs(process.argv.slice(2));
  const sourceRoot = resolveSourceRoot(opts.repo);
  for (const targetRepo of targetWorktrees(opts.repo, opts.allWorktrees)) {
    updateTarget(sourceRoot, targetRepo, opts);
  }
} catch (error) {
  console.error(`update-acef-installation: ${error.message}`);
  process.exitCode = 1;
}
