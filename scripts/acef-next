#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");
const { parseWorkflow } = require("./lib/acef-state-parser");
const { inspectRunAuthorization } = require("./lib/acef-run-authorization");
const { displayName } = require("./lib/acef-execution-policy");
const { installationFreshnessFailures } = require("./lib/acef-installation");
const { loadObjective, objectiveFailures } = require("./lib/acef-objective-supervisor");

function usage() {
  console.log(`Usage: acef-next --repo <path> [--role <role>] [--format json]

Prints the bounded next-action packet for the active ACEF state.
It is read-only: it does not advance state, edit ledgers, approve gates, or spawn workers.`);
}

function parseArgs(argv) {
  const opts = { repo: process.cwd(), role: null, format: "json" };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--repo") {
      opts.repo = argv[++index] || "";
    } else if (arg === "--role") {
      opts.role = argv[++index] || "";
    } else if (arg === "--format") {
      opts.format = argv[++index] || "";
    } else if (arg === "--help" || arg === "-h") {
      opts.help = true;
    } else {
      throw new Error(`Unknown argument: ${arg}`);
    }
  }
  if (opts.format !== "json") throw new Error("--format currently supports only json");
  opts.repo = path.resolve(opts.repo);
  return opts;
}

function normalize(value) {
  return String(value || "").toLowerCase();
}

function deriveNextAllowedAction(activeRun) {
  if (activeRun.nextAllowedStep) return activeRun.nextAllowedStep;
  const phase = normalize(activeRun.activePhase);
  const role = normalize(activeRun.workerRole);
  if (phase.includes("atdd") || role.includes("atdd")) return "write_failing_tests";
  if (phase.includes("dev") || phase.includes("implement") || role.includes("developer")) return "implement_to_green";
  if (phase.includes("review") || role.includes("reviewer")) return "review_report_only";
  if (phase.includes("verify") || phase.includes("patch")) return "apply_required_review_patch";
  if (phase.includes("judge") || phase.includes("process")) return "judge_current_story_or_phase";
  if (phase.includes("epic")) return "audit_epic_gate_chain";
  if (phase.includes("plan") || role.includes("planner")) return "write_or_update_story_artifact";
  return "follow_active_run_next_step";
}

function evidenceFor(activeRun, roleOverride) {
  const phase = normalize(activeRun.activePhase);
  const role = normalize(roleOverride || activeRun.workerRole);
  if (phase.includes("atdd") || role.includes("atdd")) return [
    "failing_test_command",
    "test_intent_matrix",
    "target_test_paths",
  ];
  if (phase.includes("dev") || phase.includes("implement") || role.includes("developer")) return [
    "failing_before_implementation",
    "green_test_command",
    "changed_files_summary",
  ];
  if (phase.includes("review") || role.includes("reviewer")) return [
    "file_line_findings",
    "AC_trace",
    "focused_test_evidence",
  ];
  if (phase.includes("verify") || phase.includes("patch")) return [
    "patch_summary",
    "regression_command",
    "review_disposition_evidence",
  ];
  if (phase.includes("judge") || phase.includes("process")) return [
    "actor_records",
    "evidence_manifests",
    "gate_checklist",
  ];
  if (phase.includes("epic")) return [
    "epic_evidence_trace",
    "story_gates",
    "runtime_smoke",
  ];
  return ["repo_backed_evidence"];
}

function phaseCanWrite(activeRun, workerScope) {
  if (!workerScope.record) return false;
  const action = normalize(deriveNextAllowedAction(activeRun.record));
  return [
    "write_failing_tests",
    "implement_to_green",
    "apply_required_review_patch",
    "write_or_update_story_artifact",
  ].includes(action);
}

function loadWorkflow(repo, activeRunRecord) {
  if (!activeRunRecord?.workflowPath) return { path: null, record: null, node: null, error: null };
  const workflowPath = path.join(repo, activeRunRecord.workflowPath);
  if (!fs.existsSync(workflowPath)) return { path: activeRunRecord.workflowPath, record: null, node: null, error: `workflow not found: ${activeRunRecord.workflowPath}` };
  try {
    const record = parseWorkflow(workflowPath);
    const node = activeRunRecord.workflowNodeId
      ? record.nodes.find((entry) => entry.id === activeRunRecord.workflowNodeId)
      : null;
    if (activeRunRecord.workflowNodeId && !node) {
      return { path: activeRunRecord.workflowPath, record, node: null, error: `workflow node not found: ${activeRunRecord.workflowNodeId}` };
    }
    if (!activeRunRecord.workflowNodeId) {
      return { path: activeRunRecord.workflowPath, record, node: null, error: "active run has workflowPath but no workflowNodeId" };
    }
    return { path: activeRunRecord.workflowPath, record, node, error: null };
  } catch (error) {
    return { path: activeRunRecord.workflowPath, record: null, node: null, error: error.message };
  }
}

function buildDirectNext(repo, authorization) {
  const run = authorization.directRun;
  const active = authorization.ok && run?.status === "active";
  return {
    schema: "acef.next.v1",
    repo,
    status: authorization.ok ? "ready" : "blocked",
    blockers: authorization.blockers,
    active_state: run ? {
      lane: "direct",
      phase: run.status,
      story: run.scope,
      role: "single-actor",
      last_passed_gate: null,
      next_allowed_action: active ? "implement_and_focused_verify" : null,
      workflow_node_id: null,
    } : null,
    allowed: {
      can_write: active,
      paths: run?.changedPaths || [],
      commands: run?.verification?.map((item) => item.command) || [],
    },
    forbidden: {
      paths: ["docs/ai/ACEF_* except ACEF_DIRECT_RUN.json"],
      actions: ["spawn_worker", "approve_gate", "edit_ledger", "start_next_story"],
    },
    context: {
      current_context: "docs/ai/ACEF_DIRECT_RUN.json",
      ledger: null,
      worker_scope: null,
      workflow: null,
      inputs: ["docs/ai/ACEF_DIRECT_RUN.json"],
      outputs: ["focused verification", "direct handoff"],
    },
    workflow_node: null,
    evidence_required: active
      ? ["focused_verification_command", "changed_files_summary", "promotion_check"]
      : [],
    stop_condition: run?.status === "complete"
      ? "direct_handoff_complete"
      : authorization.ok
        ? "complete_or_promote_then_report"
        : "fix_blockers_then_rerun_acef_next",
  };
}

function buildNext(repo, roleOverride) {
  const authorization = inspectRunAuthorization(repo, {
    allowDirect: true,
    allowedStatuses: ["active", "complete"],
    requireScopeRunId: true,
    allowFinalStoryScopeAtV3EpicClose: true,
  });
  if (authorization.mode === "direct") return buildDirectNext(repo, authorization);
  const activeRun = {
    exists: Boolean(authorization.activeRun),
    record: authorization.activeRun,
    error: null,
  };
  const workerScope = {
    exists: Boolean(authorization.workerScope),
    record: authorization.workerScope,
    error: null,
    path: authorization.workerScopePath,
  };
  const workflow = loadWorkflow(repo, activeRun.record);
  const contextPath = authorization.contextPath;
  const ledgerPath = authorization.ledgerPath;
  const blockers = [...authorization.blockers];

  if (!fs.existsSync(path.join(repo, "AGENTS.md"))) blockers.push("missing AGENTS.md");
  if (workflow.error) blockers.push(`invalid workflow state: ${workflow.error}`);
  blockers.push(...installationFreshnessFailures(repo));
  if (activeRun.record) blockers.push(...objectiveFailures(repo, activeRun.record));
  const objective = activeRun.record?.objectiveId ? loadObjective(repo, activeRun.record.objectiveId) : null;

  const base = {
    schema: "acef.next.v1",
    repo,
    status: blockers.length ? "blocked" : "ready",
    blockers,
    active_state: null,
    objective: objective ? {
      objective_id: objective.objectiveId,
      status: objective.status,
      run_count: objective.runCount,
      replan_count: objective.replanCount,
      review_cycle_count: objective.reviewCycleCount,
      warnings: objective.warnings || [],
    } : null,
    allowed: { can_write: false, paths: [], commands: [] },
    forbidden: {
      paths: ["docs/ai/ACEF_*"],
      actions: ["start_next_story", "start_next_epic", "spawn_worker", "push", "approve_gate", "edit_ledger"],
    },
    context: {
      current_context: contextPath,
      ledger: ledgerPath,
      worker_scope: workerScope.exists ? workerScope.path : null,
      workflow: workflow.path,
      inputs: workflow.node?.inputs || [],
      outputs: workflow.node?.outputs || [],
    },
    workflow_node: workflow.node ? {
      id: workflow.node.id,
      type: workflow.node.type,
      requires: workflow.node.requires,
      inputs: workflow.node.inputs,
      outputs: workflow.node.outputs,
    } : null,
    evidence_required: [],
    stop_condition: "fix_blockers_then_rerun_acef_next",
  };

  if (!activeRun.record) return base;

  const action = deriveNextAllowedAction(activeRun.record);
  const role = roleOverride || activeRun.record.workerRole || workerScope.record?.workerId || null;
  base.active_state = {
    lane: activeRun.record.lane,
    workflow: activeRun.record.workflowId,
    full_flow_contract: activeRun.record.workflowId === "full-bmad"
      ? (activeRun.record.fullFlowContract || "six-actor-v2")
      : null,
    assurance: activeRun.record.assuranceProfile,
    scope_unit: activeRun.record.scopeUnit,
    execution_path: displayName(activeRun.record),
    phase: activeRun.record.activePhase,
    story: activeRun.record.activeStory,
    role,
    last_passed_gate: activeRun.record.lastPassedGate || null,
    terminal_disposition: activeRun.record.terminalDisposition || null,
    next_allowed_action: blockers.length ? null : action,
    workflow_node_id: activeRun.record.workflowNodeId || null,
  };
  base.allowed = {
    can_write: !blockers.length && phaseCanWrite(activeRun, workerScope),
    paths: workerScope.record?.allowedPaths || [],
    commands: [],
  };
  base.evidence_required = blockers.length ? [] : evidenceFor(activeRun.record, roleOverride);
  base.stop_condition = blockers.length
    ? "fix_blockers_then_rerun_acef_next"
    : activeRun.record.status === "complete"
      ? "exact_terminal_control_commit_then_report"
    : workerScope.record
      ? `max_${workerScope.record.maxCommits}_commit_then_report`
      : "report_then_stop";
  return base;
}

try {
  const opts = parseArgs(process.argv.slice(2));
  if (opts.help) {
    usage();
    process.exit(0);
  }
  const next = buildNext(opts.repo, opts.role);
  console.log(JSON.stringify(next, null, 2));
  if (next.blockers.length) process.exitCode = 2;
} catch (error) {
  console.error(`acef-next: ${error.message}`);
  process.exitCode = 1;
}
