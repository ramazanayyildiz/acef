#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");
const { validateSkillMetadata } = require("./lib/acef-skill-metadata");
const { createOwnedFileWriter, writeInstallationManifest } = require("./lib/acef-installation");

const repoRoot = path.resolve(__dirname, "..");
const sourceSkillsDir = path.join(repoRoot, "skills");
const defaultSkills = [
  "acef",
  "acef-adapter",
  "acef-router",
  "acef-test-bootstrap",
  "map-codebase",
  "spec-readiness",
];
const reviewLensSkills = ["bug-hunter", "implementation-shape-review"];
// Profiles (owner decision 2026-10-25): slice = one tool, the four skills the Slice lane needs; core/full = all tools.
const profiles = {
  slice: { tools: ["codex"], skills: ["acef", "acef-adapter", "acef-router", "map-codebase"] },
  core: { tools: ["all"], skills: defaultSkills },
  full: { tools: ["all"], skills: defaultSkills },
};

const toolSkillDirs = {
  codex: [".codex", "skills"],
  claude: [".claude", "skills"],
  opencode: [".opencode", "skills"],
};

function usage() {
  console.log(`Usage: scripts/install-acef-skills --repo <path> [--profile slice|core|full] [--tool codex|claude|opencode|all] [--skill name ...] [--skills-dir <dir>] [--review-lenses] [--all-core]

Installs ACEF skills repo-locally. Defaults:
  --tool all
  --skill acef acef-adapter acef-router acef-test-bootstrap map-codebase

Examples:
  scripts/install-acef-skills --repo /path/to/repo
  scripts/install-acef-skills --repo /path/to/repo --review-lenses
  scripts/install-acef-skills --repo /path/to/repo --tool codex --skill acef --skill map-codebase
  scripts/install-acef-skills --repo /path/to/repo --all-core`);
}

function parseArgs(argv) {
  const opts = {
    repo: "",
    tools: null,
    skills: [],
    skillsDir: "",
    profile: "",
    reviewLenses: false,
    allCore: false,
  };

  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--repo" || arg === "--target") {
      opts.repo = argv[++i];
    } else if (arg === "--tool") {
      opts.tools = [...(opts.tools || []), argv[++i]];
    } else if (arg === "--profile") {
      opts.profile = argv[++i];
      if (!profiles[opts.profile]) throw new Error(`Unknown profile: ${opts.profile} (slice|core|full)`);
    } else if (arg === "--skills-dir") {
      opts.skillsDir = argv[++i];
    } else if (arg === "--skill") {
      opts.skills.push(argv[++i]);
    } else if (arg === "--all-core") {
      opts.allCore = true;
    } else if (arg === "--review-lenses") {
      opts.reviewLenses = true;
    } else if (arg === "-h" || arg === "--help") {
      usage();
      process.exit(0);
    } else {
      throw new Error(`Unknown argument: ${arg}`);
    }
  }

  if (!opts.repo) throw new Error("--repo is required");
  opts.repo = path.resolve(opts.repo);
  if (!opts.tools) opts.tools = opts.profile ? [...profiles[opts.profile].tools] : ["all"];
  if (opts.skillsDir && (opts.tools.includes("all") || opts.tools.length !== 1)) {
    throw new Error("--skills-dir needs exactly one --tool");
  }
  return opts;
}

function sourceFiles(dir, base = dir) {
  const result = [];
  for (const entry of fs.readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
    const filePath = path.join(dir, entry.name);
    if (entry.isDirectory()) result.push(...sourceFiles(filePath, base));
    else if (entry.isFile()) result.push(path.relative(base, filePath));
  }
  return result;
}

// File by file through the owned-file writer (no more rm -rf of the skill folder): a host-modified file is kept and
// reported, files ACEF stopped shipping are removed only when unmodified, and host-added files are left alone.
function copySkill(skill, targetBase, writer) {
  const source = path.join(sourceSkillsDir, skill);
  if (!fs.existsSync(source)) throw new Error(`Skill source not found: ${source}`);
  const toPosix = (value) => value.split(path.sep).join("/");
  const prefix = `${toPosix(path.join(targetBase, skill))}/`;
  const written = [];
  for (const file of sourceFiles(source)) {
    const target = `${prefix}${toPosix(file)}`;
    const mode = fs.statSync(path.join(source, file)).mode & 0o777;
    writer.write(target, fs.readFileSync(path.join(source, file)), { mode, sourceRel: toPosix(path.join("skills", skill, file)) });
    written.push(target);
  }
  writer.removeStale(prefix, written);
}

function commandBody(skill) {
  return `---
description: Use the ${skill} ACEF skill in this repo
---

Use the \`${skill}\` skill for this request.

Load the project-local skill from this repo, follow its instructions, and keep the response lean:
- use the active repo ledger and local ACEF files;
- do not paste large artifacts or logs into chat;
- write durable evidence to disk when the skill requires it.

User request:
{{args}}
`;
}

function installOpenCodeCommands(repo, skills, writer) {
  const commandDir = path.join(repo, ".opencode", "commands");
  for (const skill of skills) {
    writer.write(`.opencode/commands/${skill}.md`, commandBody(skill), { generated: true });
  }
  console.log(`Installed ${skills.length} OpenCode command(s): ${commandDir}`);
}

function selectedTools(tools) {
  const values = tools.includes("all") ? Object.keys(toolSkillDirs) : tools;
  for (const tool of values) {
    if (!toolSkillDirs[tool]) throw new Error(`Unknown tool: ${tool}`);
  }
  return values;
}

function selectedSkills(opts) {
  if (opts.allCore) {
    return fs.readdirSync(sourceSkillsDir)
      .filter((name) => fs.existsSync(path.join(sourceSkillsDir, name, "SKILL.md")))
      .sort();
  }
  const base = opts.profile ? profiles[opts.profile].skills : defaultSkills;
  const selected = opts.skills.length ? [...opts.skills] : [...base];
  if (opts.reviewLenses) selected.push(...reviewLensSkills);
  return [...new Set(selected)].sort();
}

const opts = parseArgs(process.argv.slice(2));
const tools = selectedTools(opts.tools);
const skills = selectedSkills(opts);

for (const skill of skills) {
  const source = path.join(sourceSkillsDir, skill, "SKILL.md");
  if (!fs.existsSync(source)) throw new Error(`Skill source not found: ${source}`);
  const { errors } = validateSkillMetadata(source, skill);
  if (errors.length) throw new Error(`Invalid skill metadata for ${skill}: ${errors.join("; ")}`);
}

const skillsDirs = {};
const writer = createOwnedFileWriter(opts.repo, repoRoot, "skills");
for (const tool of tools) {
  const relativeBase = opts.skillsDir ? opts.skillsDir : path.join(...toolSkillDirs[tool]);
  if (path.isAbsolute(relativeBase) || relativeBase.split(/[\\/]/).includes("..")) {
    throw new Error(`--skills-dir must be a path inside the repo: ${relativeBase}`);
  }
  skillsDirs[tool] = relativeBase.split(path.sep).join("/");
  const targetBase = path.join(opts.repo, relativeBase);
  for (const skill of skills) {
    copySkill(skill, relativeBase, writer);
  }
  console.log(`Installed ${skills.length} ACEF skill(s) for ${tool}: ${targetBase}`);
  if (tool === "opencode") {
    installOpenCodeCommands(opts.repo, skills, writer);
  }
}
const { files } = writer.finish("install-acef-skills");
console.log(`Updated ACEF installation manifest: ${writeInstallationManifest(opts.repo, repoRoot, "skills", {
  tools,
  skills,
  skillsDirs,
  reviewLenses: opts.reviewLenses,
  allCore: opts.allCore,
  files,
}, opts.profile || null)}`);
