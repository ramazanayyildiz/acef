#!/usr/bin/env node
// Installs the Slice lane kit into an application (owner decision 2026-10-25: the documented manual adoption
// in method/SLICE_LANE.md "Adoption in an application", made repeatable and update-safe).
//
// ACEF-owned files (templates, the method snapshot, the four slice scripts) are tracked by hash in the installation
// record. On a later run a file is replaced only when the host copy still equals what ACEF installed; a host-edited
// copy is kept and reported. Host configuration (slice-method.json, stack profile) is written only when missing.
const crypto = require("node:crypto");
const fs = require("node:fs");
const path = require("node:path");
const { readCommittedManifest, sourceInfo, writeInstallationManifest } = require("./lib/acef-installation");

const sourceRoot = path.resolve(__dirname, "..");

function usage() {
  console.log(`Usage: scripts/install-acef-slice-kit --repo <path> [--stack <name>] [--templates-dir <dir>] [--scripts-dir <dir>]

Defaults: --templates-dir docs/slices/_templates  --scripts-dir scripts
Installs: templates/slice/*, a method/SLICE_LANE.md snapshot, scripts/slice/{gate.sh,standards-check.sh,codex-review.sh,metrics.py};
with --stack also stacks/<stack>/profile.json (as scripts/stack-profile.json) and the slice-method example, only when missing.`);
}

function parseArgs(argv) {
  const opts = { repo: "", stack: "", templatesDir: "", scriptsDir: "" };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--repo" || arg === "--target") opts.repo = argv[++i] || "";
    else if (arg === "--stack") opts.stack = argv[++i] || "";
    else if (arg === "--templates-dir") opts.templatesDir = argv[++i] || "";
    else if (arg === "--scripts-dir") opts.scriptsDir = argv[++i] || "";
    else if (arg === "-h" || arg === "--help") { usage(); process.exit(0); }
    else throw new Error(`Unknown argument: ${arg}`);
  }
  if (!opts.repo) throw new Error("--repo is required");
  opts.repo = path.resolve(opts.repo);
  return opts;
}

function insideRepo(relative) {
  if (path.isAbsolute(relative) || relative.split(/[\\/]/).includes("..")) throw new Error(`path must stay inside the repo: ${relative}`);
  return relative.split(path.sep).join("/");
}

const sha = (buffer) => crypto.createHash("sha256").update(buffer).digest("hex");

function plan(opts, previous) {
  const templatesDir = insideRepo(opts.templatesDir || previous.templatesDir || "docs/slices/_templates");
  const scriptsDir = insideRepo(opts.scriptsDir || previous.scriptsDir || "scripts");
  const owned = [];
  for (const name of fs.readdirSync(path.join(sourceRoot, "templates", "slice")).sort()) {
    const from = path.join(sourceRoot, "templates", "slice", name);
    if (fs.statSync(from).isFile()) owned.push({ to: `${templatesDir}/${name}`, content: fs.readFileSync(from) });
  }
  const { sourceShortCommit, sourceCommit } = sourceInfo(sourceRoot);
  const method = fs.readFileSync(path.join(sourceRoot, "method", "SLICE_LANE.md"), "utf8");
  owned.push({
    to: `${templatesDir}/SLICE_LANE.md`,
    content: Buffer.from(`<!-- ACEF method snapshot from acef@${sourceShortCommit || "unknown"} (${sourceCommit || "unknown"}). Do not edit; update with scripts/update-acef-installation. -->\n\n${method}`),
  });
  for (const name of ["gate.sh", "standards-check.sh", "codex-review.sh", "metrics.py"]) {
    owned.push({ to: `${scriptsDir}/${name}`, content: fs.readFileSync(path.join(sourceRoot, "scripts", "slice", name)), mode: 0o755 });
  }
  const hostOnce = [];
  const stack = opts.stack || previous.stack || "";
  if (stack) {
    const stackRoot = path.join(sourceRoot, "stacks", stack);
    if (!fs.existsSync(path.join(stackRoot, "profile.json"))) throw new Error(`unknown stack: ${stack}`);
    hostOnce.push({ to: `${scriptsDir}/stack-profile.json`, content: fs.readFileSync(path.join(stackRoot, "profile.json")) });
  }
  const example = path.join(sourceRoot, "docs", "slice-lane", "examples", "slice-method.example.json");
  if (fs.existsSync(example)) hostOnce.push({ to: "slice-method.json", content: fs.readFileSync(example) });
  return { templatesDir, scriptsDir, stack, owned, hostOnce };
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const previous = readCommittedManifest(opts.repo)?.components?.sliceKit || {};
  const previousHashes = previous.files || {};
  const p = plan(opts, previous);
  const files = {};
  const kept = [];
  for (const item of p.owned) {
    const target = path.join(opts.repo, item.to);
    const next = sha(item.content);
    if (fs.existsSync(target)) {
      const current = sha(fs.readFileSync(target));
      // host-edited: it differs from both what ACEF installed last time and what ACEF would install now
      if (current !== next && current !== previousHashes[item.to]) {
        kept.push(item.to);
        files[item.to] = previousHashes[item.to] || current;
        continue;
      }
    }
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, item.content);
    if (item.mode) fs.chmodSync(target, item.mode);
    files[item.to] = next;
  }
  for (const item of p.hostOnce) {
    const target = path.join(opts.repo, item.to);
    if (fs.existsSync(target)) continue;
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, item.content);
    console.log(`Created host config (edit it for this project): ${item.to}`);
  }
  for (const file of kept) console.log(`KEPT_HOST_EDIT ${file} (differs from the ACEF copy; merge by hand)`);
  console.log(`Installed Slice lane kit: ${Object.keys(files).length - kept.length} file(s) written, ${kept.length} kept`);
  const sorted = Object.fromEntries(Object.entries(files).sort(([a], [b]) => a.localeCompare(b)));
  console.log(`Updated ACEF installation manifest: ${writeInstallationManifest(opts.repo, sourceRoot, "sliceKit", {
    templatesDir: p.templatesDir,
    scriptsDir: p.scriptsDir,
    ...(p.stack ? { stack: p.stack } : {}),
    files: sorted,
  })}`);
}

try {
  main();
} catch (error) {
  console.error(`install-acef-slice-kit: ${error.message}`);
  process.exitCode = 1;
}
