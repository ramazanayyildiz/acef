#!/usr/bin/env node
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const cp = require("node:child_process");

const repoRoot = path.resolve(__dirname, "..");
const next = path.join(repoRoot, "scripts", "acef-next");
const state = path.join(repoRoot, "scripts", "acef-state");
const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "acef-next-"));

function run(command, args, options = {}) {
  return cp.spawnSync(command, args, {
    cwd: tmp,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    ...options,
  });
}

function mustRun(command, args) {
  const result = run(command, args);
  if (result.status !== 0) {
    throw new Error(`${command} ${args.join(" ")} failed:\n${result.stdout}\n${result.stderr}`);
  }
  return result.stdout;
}

try {
  fs.writeFileSync(path.join(tmp, "AGENTS.md"), "# Agent entry\n");
  fs.mkdirSync(path.join(tmp, "docs", "ai"), { recursive: true });
  mustRun("git", ["init", "-q"]);
  mustRun("git", ["config", "user.email", "acef@example.test"]);
  mustRun("git", ["config", "user.name", "ACEF Test"]);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_demo_DELIVERY_AUDIT.md"), [
    "# Demo",
    "",
    "## Session Handoff",
    "last_passed_gate: Story 2.1 ATDD PASS",
    "",
  ].join("\n"));
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_LEDGER"), "docs/ai/ACEF_demo_DELIVERY_AUDIT.md\n");
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_CURRENT_CONTEXT.md"), [
    "source_ledger: docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
    "active_story: Story 2.2",
    "active_phase: development",
    "last_passed_gate: Story 2.1 ATDD PASS",
    "",
    "## Current Work",
    "Story 2.2",
  ].join("\n"));
  fs.mkdirSync(path.join(tmp, "workflows"), { recursive: true });
  fs.writeFileSync(path.join(tmp, "workflows", "lightweight-review.yaml"), [
    "workflow: lightweight-review",
    "version: 1",
    "nodes:",
    "  - id: implement",
    "    type: agent",
    "    role: developer",
    "    inputs:",
    "      - docs/ai/ACEF_CURRENT_CONTEXT.md",
    "      - docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json",
    "    outputs:",
    "      - docs/ai/reports/story-2-2-dev.md",
  ].join("\n"));
  mustRun("git", ["add", "."]);
  mustRun("git", ["commit", "-qm", "fixture"]);

  const missing = run(next, ["--repo", tmp]);
  if (missing.status !== 2) throw new Error("acef-next should exit 2 when active run is missing");
  const missingJson = JSON.parse(missing.stdout);
  if (missingJson.schema !== "acef.next.v1") throw new Error("acef-next missing schema");
  if (missingJson.status !== "blocked") throw new Error("acef-next missing active run should be blocked");
  if (missingJson.active_state !== null) throw new Error("acef-next should not invent active_state without active run");
  if (!missingJson.blockers.some((entry) => entry.includes("ACEF_ACTIVE_RUN"))) {
    throw new Error("acef-next did not explain missing active run");
  }

  mustRun(state, [
    "active-run", "--repo", tmp,
    "--run-id", "RUN-next-test",
    "--lane", "lightweight",
    "--status", "active",
    "--story", "Story 2.2",
    "--phase", "development",
    "--worker-role", "developer",
    "--ledger", "docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
    "--context", "docs/ai/ACEF_CURRENT_CONTEXT.md",
    "--last-passed-gate", "Story 2.1 ATDD PASS",
    "--workflow", "workflows/lightweight-review.yaml",
    "--workflow-node", "implement",
  ]);
  mustRun(state, [
    "worker-scope", "--repo", tmp,
    "--story", "Story 2.2",
    "--phase", "development",
    "--worker-id", "dev-22",
    "--allow", "tests/Feature/Story22Test.php",
    "--allow", "app/Story22.php",
    "--allow-command", "php artisan test tests/Feature/Story22Test.php",
    "--max-commits", "1",
  ]);

  const ready = mustRun(next, ["--repo", tmp, "--role", "developer"]);
  const readyJson = JSON.parse(ready);
  if (readyJson.status !== "ready") throw new Error(`acef-next was not ready:\n${ready}`);
  if (readyJson.active_state.next_allowed_action !== "implement_to_green") throw new Error("acef-next did not derive dev action");
  if (readyJson.active_state.story !== "Story 2.2") throw new Error("acef-next lost active story");
  if (readyJson.allowed.can_write !== true) throw new Error("acef-next should allow scoped dev writes");
  if (!readyJson.allowed.paths.includes("app/Story22.php")) throw new Error("acef-next lost worker allowed paths");
  if (readyJson.allowed.commands[0] !== "php artisan test tests/Feature/Story22Test.php") {
    throw new Error("acef-next lost the worker's exact allowed command");
  }
  if (!readyJson.forbidden.actions.includes("start_next_story")) throw new Error("acef-next missing no-next-story boundary");
  if (!readyJson.forbidden.actions.includes("spawn_worker")) throw new Error("acef-next missing no-spawn boundary");
  if (!readyJson.evidence_required.includes("green_test_command")) throw new Error("acef-next missing dev evidence requirement");
  if (readyJson.context.ledger !== "docs/ai/ACEF_demo_DELIVERY_AUDIT.md") throw new Error("acef-next lost ledger path");
  if (readyJson.active_state.workflow_node_id !== "implement") throw new Error("acef-next lost workflow node id");
  if (readyJson.workflow_node.id !== "implement") throw new Error("acef-next did not load workflow node");
  if (!readyJson.context.inputs.includes("docs/ai/ACEF_CURRENT_CONTEXT.md")) throw new Error("acef-next lost workflow inputs");
  if (!readyJson.context.outputs.includes("docs/ai/reports/story-2-2-dev.md")) throw new Error("acef-next lost workflow outputs");
  if (readyJson.stop_condition !== "max_1_commit_then_report") throw new Error("acef-next lost worker stop condition");

  const invalidCapsuleAtdd = {
    schema: "acef.active-run.v2", runId: "RUN-invalid-atdd", repo: "next-fixture",
    workflowId: "full-bmad", fullFlowContract: "four-actor-v3", runtimeContract: "capsule-supervisor-v1",
    assuranceProfile: "baseline", scopeUnit: "story", expectedStories: ["Story 2.2"], status: "active",
    activeStory: "Story 2.2", activePhase: "atdd", workerScopePath: "docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json",
    ledgerPath: "docs/ai/ACEF_demo_DELIVERY_AUDIT.md", contextPath: "docs/ai/ACEF_CURRENT_CONTEXT.md",
  };
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), `${JSON.stringify(invalidCapsuleAtdd, null, 2)}\n`);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json"), `${JSON.stringify({
    runId: invalidCapsuleAtdd.runId, activeStory: "Story 2.2", phase: "atdd",
    workerId: "acef_story_2_2_atdd", allowedPaths: ["tests/Feature/Story22Test.php"],
    baseRef: "HEAD", maxCommits: 1, canEditLedger: false, canSpawnAgents: false,
  }, null, 2)}\n`);
  const invalidAtdd = JSON.parse(run(next, ["--repo", tmp]).stdout);
  if (!invalidAtdd.blockers.some((entry) => entry.includes("missing exact allowedCommands"))
    || !invalidAtdd.blockers.some((entry) => entry.includes("non-control implementation path"))) {
    throw new Error("acef-next did not fail fast on an incomplete capsule ATDD worker scope");
  }

  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_INSTALLATION.json"), `${JSON.stringify({
    schema: "acef.installation.v1",
    components: { tools: { dispatchReadinessContract: "full-v3-dispatch-readiness-v1" } },
  }, null, 2)}\n`);
  const readinessRun = { ...invalidCapsuleAtdd, runId: "RUN-next-readiness", activePhase: "readiness", workerRole: "test-author" };
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), `${JSON.stringify(readinessRun, null, 2)}\n`);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json"), `${JSON.stringify({
    runId: readinessRun.runId, activeStory: "Story 2.2", phase: "readiness",
    workerId: "acef_story_2_2_atdd", allowedPaths: ["tests/Feature/Story22Test.php", "app/Story22.php"],
    allowedCommands: ["php artisan test tests/Feature/Story22Test.php"],
    baseRef: "HEAD", maxCommits: 1, canEditLedger: false, canSpawnAgents: false,
  }, null, 2)}\n`);
  const readinessNext = JSON.parse(run(next, ["--repo", tmp]).stdout);
  if (!readinessNext.dispatch_readiness.length
    || !readinessNext.dispatch_readiness.some((entry) => entry.name === "current-context")) {
    throw new Error("acef-next did not expose mandatory dispatch gates during readiness");
  }

  const epicCloseRun = {
    schema: "acef.active-run.v2",
    runId: "RUN-next-epic-close",
    repo: "next-fixture",
    workflowId: "full-bmad",
    fullFlowContract: "four-actor-v3",
    runtimeContract: "capsule-supervisor-v1",
    assuranceProfile: "baseline",
    scopeUnit: "epic",
    expectedStories: ["Story 2.2"],
    status: "active",
    activeStory: "Epic closeout",
    activePhase: "epic-process-judge",
    workerRole: "epic-process-judge",
    nextAllowedStep: "run exact terminal closeout command",
    workerScopePath: "docs/ai/ACEF_ACTIVE_WORKER_SCOPE.json",
    ledgerPath: "docs/ai/ACEF_demo_DELIVERY_AUDIT.md",
    contextPath: "docs/ai/ACEF_CURRENT_CONTEXT.md",
  };
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), `${JSON.stringify(epicCloseRun, null, 2)}\n`);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json"), `${JSON.stringify({
    runId: epicCloseRun.runId,
    activeStory: "Story 2.2",
    phase: "patch-assurance",
    workerId: "story-2-2-patch-assurance",
    allowedPaths: ["app/Story22.php"],
    baseRef: "HEAD",
    maxCommits: 1,
    canEditLedger: false,
    canSpawnAgents: false,
  }, null, 2)}\n`);
  const epicClose = JSON.parse(mustRun(next, ["--repo", tmp, "--role", "epic-process-judge"]));
  if (epicClose.status !== "ready" || epicClose.allowed.can_write !== false
    || epicClose.active_state.next_allowed_action !== "run exact terminal closeout command") {
    throw new Error("acef-next did not expose a read-only terminal epic closeout action");
  }
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"), `${JSON.stringify({
    ...epicCloseRun,
    status: "complete",
    activePhase: "closeout",
    activeActorId: "acef_epic_process_judge",
    terminalDisposition: "REPLAN",
    terminalGateId: "next-terminal-gate",
    nextAllowedStep: "commit exact terminal control artifacts",
  }, null, 2)}\n`);
  fs.mkdirSync(path.join(tmp, "docs", "ai", "gates"), { recursive: true });
  fs.writeFileSync(path.join(tmp, "docs", "ai", "gates", "next-terminal-gate.json"), `${JSON.stringify({
    gateId: "next-terminal-gate",
    runId: epicCloseRun.runId,
    fullFlowContract: "four-actor-v3",
    storyInventory: epicCloseRun.expectedStories,
    gateType: "actor-decided-v1",
    decisionMode: "actor",
    scope: "Epic closeout",
    verdict: "REPLAN",
    decidedBy: "acef_epic_process_judge",
    repositoryCommit: "fixture",
  }, null, 2)}\n`);
  fs.mkdirSync(path.join(tmp, "docs", "ai", "actors"), { recursive: true });
  fs.writeFileSync(path.join(tmp, "docs", "ai", "actors", "acef_epic_process_judge.json"), `${JSON.stringify({
    actorInstanceId: "acef_epic_process_judge", runId: epicCloseRun.runId,
    fullFlowContract: "four-actor-v3", storyInventory: epicCloseRun.expectedStories,
    story: "Epic closeout", phase: "epic-process-judge", role: "process-judge", client: "codex",
    inputCommit: "fixture", allowedContextProfile: "epic-process-judge",
  }, null, 2)}\n`);
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_CURRENT_CONTEXT.md"), [
    "# ACEF Current Context", "", `- Run: \`${epicCloseRun.runId}\``,
    "- Scope unit: `epic`", "- Active story: `Epic closeout`", "- Active phase: `closeout`",
    "- Terminal disposition: `REPLAN`", "",
  ].join("\n"));
  const completedEpic = JSON.parse(mustRun(next, ["--repo", tmp]));
  if (completedEpic.status !== "ready" || completedEpic.allowed.can_write !== false
    || completedEpic.stop_condition !== "exact_terminal_control_commit_then_report"
    || completedEpic.active_state.terminal_disposition !== "REPLAN") {
    throw new Error("acef-next did not keep a completed epic read-only and observable");
  }

  fs.rmSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_RUN.json"));
  fs.rmSync(path.join(tmp, "docs", "ai", "ACEF_ACTIVE_WORKER_SCOPE.json"));
  fs.writeFileSync(path.join(tmp, "docs", "ai", "ACEF_DIRECT_RUN.json"), `${JSON.stringify({
    schema: "acef.direct-run.v1",
    version: "1.0.0",
    runId: "DIRECT-next-test",
    lane: "direct",
    status: "active",
    scope: "Contained Story 2.2 UI copy",
    acceptance: ["Copy is updated"],
    technicalBoundary: "localized-ui",
    reversible: true,
    riskTriggers: [],
    baseCommit: null,
    changedPaths: ["app/Story22.php"],
    verification: [],
    promotion: { decision: "stay-direct", reasons: [] },
  }, null, 2)}\n`);

  const direct = mustRun(next, ["--repo", tmp]);
  const directJson = JSON.parse(direct);
  if (directJson.status !== "ready" || directJson.active_state.lane !== "direct") {
    throw new Error(`acef-next did not select the active direct record:\n${direct}`);
  }
  if (directJson.context.current_context !== "docs/ai/ACEF_DIRECT_RUN.json") {
    throw new Error("acef-next did not use the direct record as its compact context");
  }
  if (directJson.allowed.can_write !== true || !directJson.allowed.paths.includes("app/Story22.php")) {
    throw new Error("acef-next did not expose the bounded direct write target");
  }
  if (!directJson.forbidden.actions.includes("spawn_worker")) {
    throw new Error("acef-next direct packet should forbid worker spawning");
  }

  console.log("acef-next tests passed");
} finally {
  fs.rmSync(tmp, { recursive: true, force: true });
}
